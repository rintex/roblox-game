  <Item class="ServerScriptService" referent="6">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="7">
      <Properties>
        <string name="Name">Modules</string>
      </Properties>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">HouseWorld</string>
          <string name="Source"><![CDATA[-- Physical tycoon plots. This module only draws the world; the server owns money
-- and all purchase decisions. Rebuilding Structure never deletes a prompt.
local World = {}

local DEFAULT_POSITIONS = {
	Vector3.new(-48, 0, -48),
	Vector3.new(48, 0, -48),
	Vector3.new(-48, 0, 48),
	Vector3.new(48, 0, 48),
}

local HOUSE_COLORS = {
	Color3.fromRGB(174, 216, 213),
	Color3.fromRGB(190, 205, 233),
	Color3.fromRGB(229, 193, 178),
	Color3.fromRGB(212, 206, 233),
}

local CREAM = Color3.fromRGB(247, 238, 216)
local WOOD = Color3.fromRGB(151, 115, 83)
local DARK = Color3.fromRGB(56, 77, 94)
local GOLD = Color3.fromRGB(255, 199, 66)
local CYAN = Color3.fromRGB(77, 221, 218)

local function child(parent, className, name)
	local existing = parent:FindFirstChild(name)
	if existing then
		assert(existing:IsA(className), name .. " has the wrong object type")
		return existing
	end
	local object = Instance.new(className)
	object.Name = name
	object.Parent = parent
	return object
end

local function part(parent, name, size, position, color, material, canCollide)
	local object = child(parent, "Part", name)
	object.Anchored = true
	object.Size = size
	object.CFrame = CFrame.new(position)
	object.Color = color
	object.Material = material or Enum.Material.SmoothPlastic
	object.Shape = Enum.PartType.Block
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	object.CanCollide = canCollide ~= false
	object.CanTouch = false
	object.CanQuery = true
	return object
end

local function prompt(parent, name, actionText, objectText, enabled)
	local object = child(parent, "ProximityPrompt", name)
	object.ActionText = actionText
	object.ObjectText = objectText
	object.MaxActivationDistance = 10
	object.RequiresLineOfSight = false
	object.HoldDuration = 0.25
	object.KeyboardKeyCode = Enum.KeyCode.E
	object.Enabled = enabled
	return object
end

local function label(parent, name, text, offset, width, height)
	local gui = child(parent, "BillboardGui", name)
	gui.Size = UDim2.new(0, width or 210, 0, height or 50)
	gui.StudsOffset = offset or Vector3.new(0, 3, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 90
	local textLabel = child(gui, "TextLabel", "TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundColor3 = DARK
	textLabel.BackgroundTransparency = 0.1
	textLabel.BorderSizePixel = 0
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextColor3 = CREAM
	textLabel.TextScaled = true
	textLabel.TextWrapped = true
	textLabel.Text = text
	return textLabel
end

local function pad(plot, origin, name, x, color, promptName, actionText, objectText, enabled)
	local object = part(plot, name, Vector3.new(6, 0.35, 4), origin + Vector3.new(x, 0.55, -17), color, Enum.Material.Neon)
	prompt(object, promptName, actionText, objectText, enabled)
	label(object, "PadLabel", objectText, Vector3.new(0, 2.3, 0), 140, 38)
	return object
end

-- A door is an opening in the wall, so the entrance is always walkable.
local function frontWall(structure, origin, floor, y, wallColor)
	local z = -10
	part(structure, "FrontLeft" .. floor, Vector3.new(10, 10.5, 0.7), origin + Vector3.new(-9, y + 5.25, z), wallColor)
	part(structure, "FrontRight" .. floor, Vector3.new(10, 10.5, 0.7), origin + Vector3.new(9, y + 5.25, z), wallColor)
	part(structure, "FrontLintel" .. floor, Vector3.new(8, 3, 0.7), origin + Vector3.new(0, y + 9, z), CREAM)
	if floor > 1 then
		-- A closed upper window; only the ground floor is the main entrance.
		local pane = part(structure, "FrontWindow" .. floor, Vector3.new(7.5, 6.8, 0.25), origin + Vector3.new(0, y + 3.9, z), CYAN, Enum.Material.Glass)
		pane.Transparency = 0.5
	end
end

local function rearWall(structure, origin, floor, y, wallColor)
	part(structure, "RearLeft" .. floor, Vector3.new(7, 10.5, 0.7), origin + Vector3.new(-10.5, y + 5.25, 14), wallColor)
	part(structure, "RearMiddle" .. floor, Vector3.new(8, 10.5, 0.7), origin + Vector3.new(0, y + 5.25, 14), wallColor)
	if floor == 2 then
		part(structure, "RearDoorLintel2", Vector3.new(7, 3, 0.7), origin + Vector3.new(10.5, y + 9, 14), CREAM)
	else
		part(structure, "RearRight" .. floor, Vector3.new(7, 10.5, 0.7), origin + Vector3.new(10.5, y + 5.25, 14), wallColor)
	end
	for _, x in ipairs({ -5.5, 5.5 }) do
		local suffix = if x < 0 then "Left" else "Right"
		part(structure, "RearWindowSill" .. suffix .. floor, Vector3.new(3, 2.5, 0.7), origin + Vector3.new(x, y + 1.25, 14), CREAM)
		part(structure, "RearWindowTop" .. suffix .. floor, Vector3.new(3, 2, 0.7), origin + Vector3.new(x, y + 9.5, 14), CREAM)
		local pane = part(structure, "RearWindow" .. suffix .. floor, Vector3.new(3, 6, 0.25), origin + Vector3.new(x, y + 5.5, 14), CYAN, Enum.Material.Glass)
		pane.Transparency = 0.5
	end
end

local function rightWall(structure, origin, floor, y, wallColor)
	-- Floor 2 enters through the rear wall; floor 3 uses this side doorway.
	local doorCenter = -7
	if floor < 3 then
		part(structure, "RightWall" .. floor, Vector3.new(0.7, 10.5, 24), origin + Vector3.new(14, y + 5.25, 2), wallColor)
		return
	end
	local beforeLength = doorCenter - 3 - (-10)
	local afterLength = 14 - (doorCenter + 3)
	if beforeLength > 0 then
		part(structure, "RightFront" .. floor, Vector3.new(0.7, 10.5, beforeLength), origin + Vector3.new(14, y + 5.25, -10 + beforeLength / 2), wallColor)
	end
	if afterLength > 0 then
		part(structure, "RightRear" .. floor, Vector3.new(0.7, 10.5, afterLength), origin + Vector3.new(14, y + 5.25, doorCenter + 3 + afterLength / 2), wallColor)
	end
	part(structure, "SideDoorLintel" .. floor, Vector3.new(0.7, 3, 6), origin + Vector3.new(14, y + 9, doorCenter), CREAM)
end

local function buildDropper(structure, origin, floor, floorTop)
	local model = child(structure, "Model", "Dropper" .. floor)
	local position = origin + Vector3.new(-7, floorTop, 7)
	local color = if floor == 3 then GOLD elseif floor == 2 then CYAN else Color3.fromRGB(122, 179, 239)
	part(model, "MachineBase", Vector3.new(8, 0.6, 8), position + Vector3.new(0, 0.3, 0), DARK, Enum.Material.Metal)
	part(model, "MachineBack", Vector3.new(7, 5, 1), position + Vector3.new(0, 3, 3), color, Enum.Material.Metal)
	part(model, "MachineTop", Vector3.new(7, 1, 5), position + Vector3.new(0, 5.8, 1), color, Enum.Material.Metal)
	part(model, "Nozzle", Vector3.new(1.5, 0.7, 1.5), position + Vector3.new(0, 4.95, -0.7), GOLD, Enum.Material.Neon, false)
	part(model, "Conveyor", Vector3.new(5, 0.4, 6), position + Vector3.new(0, 0.8, -0.5), WOOD, Enum.Material.WoodPlanks)
	for index = 1, 5 do
		part(model, "BeltStripe" .. index, Vector3.new(5, 0.04, 0.18), position + Vector3.new(0, 1.03, -3.3 + index), CREAM, Enum.Material.SmoothPlastic, false)
	end
	local start = part(model, "DropletStart", Vector3.new(0.2, 0.2, 0.2), position + Vector3.new(0, 4.55, -0.7), color, Enum.Material.SmoothPlastic, false)
	local finish = part(model, "DropletEnd", Vector3.new(0.2, 0.2, 0.2), position + Vector3.new(0, 1.25, -0.7), color, Enum.Material.SmoothPlastic, false)
	start.Transparency = 1
	finish.Transparency = 1
	start.CanQuery = false
	finish.CanQuery = false
	label(model:FindFirstChild("MachineBack"), "MachineLabel", if floor == 3 then "ЗОЛОТОЙ ГЕНЕРАТОР" else "ГЕНЕРАТОР " .. floor, Vector3.new(0, 2.4, 0), 150, 40)
end

local function buildStairs(structure, origin, targetFloor)
	local startingTop = 0.8 + (targetFloor - 2) * 12
	local laneX = if targetFloor == 2 then 16.25 else 20
	-- Separate lanes keep the second flight above neither the player's head
	-- nor the first flight. Thin treads leave the space below them open.
	if targetFloor == 2 then
		part(structure, "StairStart", Vector3.new(3.5, 0.4, 3), origin + Vector3.new(laneX, 0.6, -10.5), WOOD, Enum.Material.WoodPlanks)
	end
	-- 24 half-stud risers are climbable by the standard Roblox character.
	for step = 1, 24 do
		local height = step * 0.5
		local z = if targetFloor == 2 then -9.5 + step else 15.5 - step
		part(structure, "Stair" .. targetFloor .. "Step" .. step, Vector3.new(3.5, 0.4, 1), origin + Vector3.new(laneX, startingTop + height - 0.2, z), WOOD, Enum.Material.WoodPlanks)
	end
	-- A landing starts beyond the final step instead of over the approaching
	-- character. The rear porch connects the second floor's broad rear door.
	local landingZ = if targetFloor == 2 then 16 else -9.5
	local landingDepth = if targetFloor == 2 then 3 else 4
	part(structure, "StairLanding" .. targetFloor, Vector3.new(8.25, 0.4, landingDepth), origin + Vector3.new(17.625, startingTop + 11.8, landingZ), WOOD, Enum.Material.WoodPlanks)
	if targetFloor == 2 then
		part(structure, "RearPorch2", Vector3.new(7, 0.4, 3.5), origin + Vector3.new(10.5, startingTop + 11.8, 15.5), WOOD, Enum.Material.WoodPlanks)
	end
	-- The rail is outside the walking width, never across the doorway.
	part(structure, "LandingRail" .. targetFloor, Vector3.new(0.3, 2.5, landingDepth), origin + Vector3.new(21.85, startingTop + 13.25, landingZ), CREAM)
	part(structure, "LandingRailPost" .. targetFloor, Vector3.new(0.3, 3, 0.3), origin + Vector3.new(21.85, startingTop + 13.5, landingZ), DARK)
end

local function buildThirdFloorExtras(structure, origin, floorTop)
	-- The third floor opens onto a broad balcony above the front walkway.
	local oldWindow = structure:FindFirstChild("FrontWindow3")
	if oldWindow then
		oldWindow:Destroy()
	end
	part(structure, "Balcony", Vector3.new(28, 0.4, 5), origin + Vector3.new(0, floorTop - 0.2, -12.5), WOOD, Enum.Material.WoodPlanks)
	part(structure, "BalconyFrontRail", Vector3.new(28, 2.5, 0.4), origin + Vector3.new(0, floorTop + 1.25, -14.8), GOLD, Enum.Material.Metal)
	part(structure, "BalconyLeftRail", Vector3.new(0.4, 2.5, 5), origin + Vector3.new(-13.8, floorTop + 1.25, -12.5), CREAM)
	part(structure, "BalconyRightRail", Vector3.new(0.4, 2.5, 5), origin + Vector3.new(13.8, floorTop + 1.25, -12.5), CREAM)
	part(structure, "BonusChest", Vector3.new(4.5, 2.6, 3), origin + Vector3.new(6, floorTop + 1.3, 6), GOLD, Enum.Material.Metal)
	part(structure, "BonusChestLid", Vector3.new(4.8, 0.5, 3.3), origin + Vector3.new(6, floorTop + 2.85, 6), CREAM, Enum.Material.Metal)
	part(structure, "BonusChestLock", Vector3.new(0.8, 1, 0.3), origin + Vector3.new(6, floorTop + 1.9, 4.35), GOLD, Enum.Material.Neon, false)
	part(structure, "GoldCarpet", Vector3.new(8, 0.04, 5), origin + Vector3.new(6, floorTop + 0.03, 0), GOLD, Enum.Material.SmoothPlastic, false)
	label(structure:FindFirstChild("BonusChest"), "ChestLabel", "БОНУСЫ 3 ЭТАЖА", Vector3.new(0, 3, 0), 170, 40)
end

function World.UpdatePlot(plot, floorNumber, ownerName)
	local base = plot:FindFirstChild("Base")
	assert(base and base:IsA("BasePart"), "Tycoon plot needs its Base")
	local origin = base.Position - Vector3.new(0, 0.15, 0)
	local floors = math.clamp(math.floor(floorNumber or 0), 0, 3)
	local previous = plot:FindFirstChild("Structure")
	if previous then
		assert(previous:IsA("Folder"), "Plot Structure must be a Folder")
		previous:Destroy()
	end
	local structure = child(plot, "Folder", "Structure")
	local plotId = plot:GetAttribute("PlotId") or 1
	local wallColor = HOUSE_COLORS[((plotId - 1) % #HOUSE_COLORS) + 1]
	part(structure, "Foundation", Vector3.new(29, 0.3, 25), origin + Vector3.new(0, 0.45, 2), CREAM, Enum.Material.Concrete)
	for floor = 1, floors do
		local top = 0.8 + (floor - 1) * 12
		part(structure, "Floor" .. floor, Vector3.new(28, 0.4, 24), origin + Vector3.new(0, top - 0.2, 2), WOOD, Enum.Material.WoodPlanks)
		frontWall(structure, origin, floor, top, wallColor)
		rearWall(structure, origin, floor, top, wallColor)
		rightWall(structure, origin, floor, top, wallColor)
		part(structure, "LeftWall" .. floor, Vector3.new(0.7, 10.5, 24), origin + Vector3.new(-14, top + 5.25, 2), wallColor)
		part(structure, "FrontCornice" .. floor, Vector3.new(29, 0.5, 0.9), origin + Vector3.new(0, top + 10.75, -10), CREAM)
		part(structure, "RearCornice" .. floor, Vector3.new(29, 0.5, 0.9), origin + Vector3.new(0, top + 10.75, 14), CREAM)
		buildDropper(structure, origin, floor, top)
		if floor >= 2 then
			buildStairs(structure, origin, floor)
		end
	end
	if floors > 0 then
		local roofTop = 0.8 + (floors - 1) * 12 + 11.5
		part(structure, "Roof", Vector3.new(30, 0.5, 26), origin + Vector3.new(0, roofTop, 2), DARK, Enum.Material.Slate)
		part(structure, "RoofAccent", Vector3.new(28, 0.15, 24), origin + Vector3.new(0, roofTop + 0.325, 2), if floors == 3 then GOLD else wallColor)
	end
	if floors == 3 then
		buildThirdFloorExtras(structure, origin, 24.8)
	end
	-- Keep this Part and its prompt stable: the server connects to it once.
	-- It becomes an invisible interaction point on the third-floor chest.
	local bonusPad = plot:FindFirstChild("BonusPad")
	if bonusPad then
		bonusPad.Size = Vector3.new(1, 1, 0.35)
		bonusPad.CFrame = CFrame.new(origin + Vector3.new(6, if floors == 3 then 26.7 else 0.55, if floors == 3 then 4 else -17))
		bonusPad.Transparency = 1
		bonusPad.CanCollide = false
		bonusPad.CanQuery = false
		local bonusLabel = bonusPad:FindFirstChild("PadLabel")
		if bonusLabel then
			bonusLabel.Enabled = false
		end
	end
	local sign = plot:FindFirstChild("PlotSign")
	local gui = sign and sign:FindFirstChild("PlotLabel")
	local textLabel = gui and gui:FindFirstChild("TextLabel")
	if textLabel then
		local name = if type(ownerName) == "string" and ownerName ~= "" then ownerName else "Свободный участок"
		textLabel.Text = name .. "\nЭтажи: " .. floors .. " / 3"
	end
	return structure
end

function World.BuildPlots(workspace, config)
	local folder = child(workspace, "Folder", "TycoonPlots")
	local positions = if config and config.PlotPositions then config.PlotPositions else DEFAULT_POSITIONS
	local plots = {}
	for index, origin in ipairs(positions) do
		local plot = child(folder, "Model", "Plot" .. index)
		plot:SetAttribute("PlotId", index)
		plot:SetAttribute("OwnerUserId", 0)
		plot:SetAttribute("OwnerName", "")
		plot:SetAttribute("Floor", 0)
		plot:SetAttribute("Bank", 0)
		plot:SetAttribute("DropperTier", 0)
		plot:SetAttribute("OwnerReady", false)
		local base = part(plot, "Base", Vector3.new(44, 0.3, 44), origin + Vector3.new(0, 0.15, 0), Color3.fromRGB(166, 191, 144), Enum.Material.Grass)
		plot.PrimaryPart = base
		part(plot, "FrontWalk", Vector3.new(30, 0.1, 10), origin + Vector3.new(0, 0.35, -16), CREAM, Enum.Material.Concrete)
		local claim = part(plot, "ClaimPad", Vector3.new(7, 0.3, 2.5), origin + Vector3.new(0, 0.6, -20), Color3.fromRGB(88, 231, 156), Enum.Material.Neon)
		prompt(claim, "ClaimPrompt", "Занять", "Свободный дом", true)
		pad(plot, origin, "Collector", -10.5, Color3.fromRGB(99, 222, 159), "CollectPrompt", "Забрать", "КОПИЛКА", false)
		pad(plot, origin, "UpgradePad", -3.5, Color3.fromRGB(108, 185, 248), "FloorPrompt", "Построить", "ЭТАЖ", false)
		pad(plot, origin, "DropperUpgradePad", 3.5, Color3.fromRGB(175, 137, 242), "DropperPrompt", "Улучшить", "ГЕНЕРАТОР", false)
		pad(plot, origin, "BonusPad", 10.5, GOLD, "BonusPrompt", "Получить", "БОНУС III", false)
		local sign = part(plot, "PlotSign", Vector3.new(1, 4.5, 1), origin + Vector3.new(-18, 2.55, -18), WOOD, Enum.Material.Wood)
		label(sign, "PlotLabel", "Свободный участок\nЭтажи: 0 / 3", Vector3.new(0, 3.2, 0), 225, 65)
		World.UpdatePlot(plot, 0, "")
		table.insert(plots, plot)
	end
	return plots
end

return World
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">ProfileSchema</string>
          <string name="Source"><![CDATA[-- Проверка сохранённого профиля. Уровень вычисляется из XP, а не хранится отдельно.
local Schema = {}

local function boundedInteger(value, default, maximum)
	if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then
		return default
	end
	return math.clamp(math.floor(value), 0, maximum)
end

function Schema.New(config)
	return { Coins = config.StartingCoins, XP = 0, Floor = 0, DropperTier = 0, Bank = 0, BonusReadyAt = 0 }
end

function Schema.Normalize(data, config, now)
	if type(data) ~= "table" then
		return Schema.New(config)
	end
	local floor = boundedInteger(data.Floor, 0, #config.Floors)
	return {
		Coins = boundedInteger(data.Coins, config.StartingCoins, config.MaxCoins),
		XP = boundedInteger(data.XP, 0, config.MaxXP),
		Floor = floor,
		DropperTier = if floor == 0 then 0 else boundedInteger(data.DropperTier, 0, #config.DropperCosts),
		Bank = if floor == 0 then 0 else boundedInteger(data.Bank, 0, config.MaxBank),
		BonusReadyAt = boundedInteger(data.BonusReadyAt, 0, now + 86400),
	}
end

function Schema.Copy(profile)
	return {
		Coins = profile.Coins, XP = profile.XP, Floor = profile.Floor,
		DropperTier = profile.DropperTier, Bank = profile.Bank, BonusReadyAt = profile.BonusReadyAt,
	}
end

return Schema
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">ProfileService</string>
          <string name="Source"><![CDATA[-- DataStore + блокировка сессии: два сервера не перезаписывают один профиль.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Schema = require(script.Parent:WaitForChild("ProfileSchema"))

local ProfileService = {}
ProfileService.__index = ProfileService

function ProfileService.new(config)
	local self = setmetatable({
		config = config,
		records = {},
		closing = false,
		sessionId = game.JobId .. ":" .. HttpService:GenerateGUID(false),
		store = nil,
	}, ProfileService)
	if game.GameId ~= 0 then
		local ok, store = pcall(function()
			return DataStoreService:GetDataStore(config.Persistence.StoreName)
		end)
		if ok then self.store = store end
	end
		task.spawn(function()
			while not self.closing do
				task.wait(config.Persistence.SaveInterval)
				if self.closing then break end
				for player, record in pairs(self.records) do
					if record.ready and not record.saving and not record.releasing then
						task.spawn(function()
							if record.cancelled then self:Release(player) else self:Save(player) end
						end)
					end
				end
			end
		end)
	game:BindToClose(function()
		self.closing = true
		local pending = 0
		for player in pairs(self.records) do
			pending += 1
			task.spawn(function()
				self:Release(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 27
		while pending > 0 and os.clock() < deadline do task.wait(0.1) end
	end)
	return self
end

function ProfileService:IsClosing()
	return self.closing
end

function ProfileService:_update(key, callback)
	local lastError
	for attempt = 1, self.config.Persistence.MaxRetries do
		local ok, result = pcall(function() return self.store:UpdateAsync(key, callback) end)
		if ok then return true, result end
		lastError = result
		if attempt < self.config.Persistence.MaxRetries then task.wait(0.8 * attempt) end
	end
	return false, lastError
end

function ProfileService:_sessionProfile(player, record)
	if record.cancelled then
		record.loading = false
		self.records[player] = nil
		return nil, "Игрок вышел во время загрузки"
	end
	record.profile = Schema.New(self.config)
	record.ready = true
	record.mode = "session"
	record.loading = false
	player:SetAttribute("PersistenceMode", "session")
	player:SetAttribute("PersistenceStatus", "session")
	return record.profile
end

function ProfileService:Load(player)
	if self.closing then return nil, "Сервер завершает работу" end
	if self.records[player] then return nil, "Профиль уже загружается" end
	local record = {
		key = "Player_" .. player.UserId,
		token = self.sessionId .. ":" .. player.UserId .. ":" .. HttpService:GenerateGUID(false),
		ready = false, loading = true, cancelled = false, saving = false, player = player,
	}
	self.records[player] = record
	player:SetAttribute("PersistenceStatus", "loading")
	if not self.store then
		if RunService:IsStudio() then return self:_sessionProfile(player, record) end
		self.records[player] = nil
		record.loading = false
		return nil, "Хранилище прогресса недоступно"
	end
	local reason
	local ok, stored = self:_update(record.key, function(old)
		reason = nil
		if record.cancelled then reason = "Игрок вышел"; return nil end
		if old ~= nil and (type(old) ~= "table" or old.Version ~= 1 or type(old.Data) ~= "table") then
			reason = "Неизвестный формат сохранения"; return nil
		end
		local now = os.time()
		local lock = old and old.Session
		if type(lock) == "table" and lock.Id ~= record.token
			and type(lock.ExpiresAt) == "number" and lock.ExpiresAt > now then
			reason = "Профиль ещё открыт на другом сервере. Попробуйте войти позже."; return nil
		end
		return {
			Version = 1, Data = Schema.Normalize(old and old.Data, self.config, now),
			Session = { Id = record.token, ExpiresAt = now + self.config.Persistence.LockSeconds },
			UpdatedAt = now,
		}
	end)
	if record.cancelled then
		-- Не сохраняем стартовые значения, если игрок вышел во время UpdateAsync.
		if ok and stored and stored.Session and stored.Session.Id == record.token then
			self:_update(record.key, function(old)
				if old and old.Session and old.Session.Id == record.token then
					old.Session = nil
					return old
				end
				return nil
			end)
		end
		self.records[player] = nil
		record.loading = false
		return nil, "Игрок вышел во время загрузки"
	end
	if not ok then
		if RunService:IsStudio() then return self:_sessionProfile(player, record) end
		self.records[player] = nil
		record.loading = false
		return nil, "Не удалось загрузить прогресс. Попробуйте войти позже."
	end
	if not stored or not stored.Session or stored.Session.Id ~= record.token then
		self.records[player] = nil
		record.loading = false
		return nil, reason or "Не удалось получить блокировку профиля"
	end
	record.profile = Schema.Normalize(stored.Data, self.config, os.time())
	record.ready = true
	record.mode = "saved"
	record.loading = false
	player:SetAttribute("PersistenceMode", "saved")
	player:SetAttribute("PersistenceStatus", "saved")
	return record.profile
end

function ProfileService:Get(player)
	local record = self.records[player]
	return if record and record.ready and not record.cancelled then record.profile else nil
end

function ProfileService:_persist(record, release)
	if record.mode == "session" then return true end
	local deadline = os.clock() + 12
	while record.saving and os.clock() < deadline do task.wait(0.1) end
	if record.saving then return false, "Предыдущее сохранение ещё выполняется" end
	if not record.ready or (record.cancelled and not release) then return false, "Профиль закрыт" end
	record.saving = true
	record.player:SetAttribute("PersistenceStatus", "saving")
	local snapshot = Schema.Copy(record.profile)
	local lostLock = false
	local ok, stored = self:_update(record.key, function(old)
		lostLock = false
		if not old or type(old) ~= "table" or old.Version ~= 1
			or type(old.Session) ~= "table" or old.Session.Id ~= record.token then
			lostLock = true; return nil
		end
		local now = os.time()
		return {
			Version = 1, Data = snapshot, UpdatedAt = now,
			Session = if release then nil else { Id = record.token, ExpiresAt = now + self.config.Persistence.LockSeconds },
		}
	end)
	record.saving = false
	if not ok or not stored then
		record.player:SetAttribute("PersistenceStatus", "error")
		if lostLock then
			record.ready = false
			record.player:SetAttribute("DataReady", false)
			record.player:Kick("Профиль открыт в другой сессии. Войдите в игру снова.")
		end
		warn("Не удалось сохранить профиль пользователя " .. record.player.UserId)
		return false, "Сохранение не подтверждено"
	end
	record.player:SetAttribute("PersistenceStatus", "saved")
	return true
end

function ProfileService:Save(player)
	local record = self.records[player]
	if not record or record.cancelled then return false, "Профиль не загружен" end
	return self:_persist(record, false)
end

function ProfileService:Release(player)
	local record = self.records[player]
	if not record then return true end
	record.cancelled = true
	player:SetAttribute("DataReady", false)
	-- Выход и BindToClose могут одновременно ждать одну загрузку/запись.
	local deadline = os.clock() + 25
	while (record.loading or record.releasing) and os.clock() < deadline do task.wait(0.1) end
	if record.loading or record.releasing then return false, "Загрузка или сохранение ещё выполняются" end
	if self.records[player] ~= record then return true end
	if not record.ready then self.records[player] = nil; return true end
	record.releasing = true
	local ok, message = self:_persist(record, true)
	record.releasing = false
	-- При сетевой ошибке сохраняем снимок в памяти для следующей попытки.
	if ok or not record.ready then self.records[player] = nil end
	return ok, message
end

return ProfileService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">TycoonService</string>
          <string name="Source"><![CDATA[-- Авторитетная экономика и владение участками. Клиент не задаёт цены и награды.
local TycoonService = {}
TycoonService.__index = TycoonService

-- Чистые функции экономики также используются в автоматических проверках.
local Economy = {}
TycoonService.Economy = Economy

local function result(ok, text, kind)
	return { ok = ok, text = text, kind = kind or (ok and "success" or "error") }
end

function Economy.Income(config, profile)
	return config.IncomeFor(profile.Floor, profile.DropperTier)
end

function Economy.Accrue(config, profile, ticks)
	local added = math.min(config.MaxBank - profile.Bank, Economy.Income(config, profile) * (ticks or 1))
	if added <= 0 then
		return 0
	end
	profile.Bank += added
	return added
end

function Economy.Collect(config, profile)
	local amount = math.min(profile.Bank, config.MaxCoins - profile.Coins)
	if amount <= 0 then
		if profile.Bank > 0 then
			return result(false, "Кошелёк заполнен. Потратьте монеты на улучшения.")
		end
		return result(false, "Копилка пока пуста. Сначала постройте этаж и немного подождите.", "info")
	end
	profile.Bank -= amount
	profile.Coins += amount
	profile.XP = math.min(config.MaxXP, profile.XP + amount)
	return result(true, "+" .. amount .. " монет и +" .. amount .. " XP из копилки!")
end

function Economy.BuyFloor(config, profile)
	local nextFloor = profile.Floor + 1
	local floor = config.Floors[nextFloor]
	if not floor then
		return result(false, "Все три этажа уже построены!", "info")
	end
	if profile.Coins < floor.Cost then
		return result(false, "Для этажа " .. nextFloor .. " нужно " .. floor.Cost .. " монет.")
	end
	profile.Coins -= floor.Cost
	profile.Floor = nextFloor
	profile.XP = math.min(config.MaxXP, profile.XP + floor.XP)
	local suffix = nextFloor == 3 and " Доступны бонусный сундук и ускорение персонажа!" or " Генератор приносит больше монет."
	return result(true, "Этаж " .. nextFloor .. " построен!" .. suffix)
end

function Economy.BuyDropper(config, profile)
	if profile.Floor < 1 then
		return result(false, "Сначала постройте первый этаж.")
	end
	local nextTier = profile.DropperTier + 1
	local cost = config.DropperCosts[nextTier]
	if not cost then
		return result(false, "Генератор уже улучшен до максимума!", "info")
	end
	if profile.Coins < cost then
		return result(false, "Для улучшения генератора нужно " .. cost .. " монет.")
	end
	profile.Coins -= cost
	profile.DropperTier = nextTier
	return result(true, "Генератор улучшен! Доход: " .. Economy.Income(config, profile) .. " монет/сек.")
end

function Economy.ClaimBonus(config, profile, now)
	if profile.Floor < 3 then
		return result(false, "Бонусный сундук откроется на третьем этаже.")
	end
	if now < profile.BonusReadyAt then
		return result(false, "Следующий бонус через " .. math.ceil(profile.BonusReadyAt - now) .. " сек.", "info")
	end
	local amount = math.min(config.BonusCoins, config.MaxCoins - profile.Coins)
	if amount <= 0 then
		return result(false, "Кошелёк заполнен. Сначала потратьте монеты.")
	end
	profile.Coins += amount
	profile.XP = math.min(config.MaxXP, profile.XP + config.BonusXP)
	profile.BonusReadyAt = now + config.BonusCooldown
	return result(true, "Бонус третьего этажа: +" .. amount .. " монет и +" .. config.BonusXP .. " XP!")
end

function TycoonService.new(config, profiles, world, plots, notice)
	return setmetatable({
		config = config,
		profiles = profiles,
		world = world,
		plots = plots,
		notice = notice,
		players = game:GetService("Players"),
		runService = game:GetService("RunService"),
		states = {},
		owners = {},
		connections = {},
		started = false,
		elapsed = 0,
	}, TycoonService)
end

function TycoonService:_notify(player, text, kind)
	if player.Parent == self.players then
		self.notice:FireClient(player, { text = text, kind = kind or "info" })
	end
end

local function findPrompt(plot, partName, promptName)
	local part = plot:FindFirstChild(partName)
	assert(part and part:IsA("BasePart"), "На участке отсутствует " .. partName)
	local prompt = part:FindFirstChild(promptName)
	assert(prompt and prompt:IsA("ProximityPrompt"), "На участке отсутствует " .. promptName)
	return prompt
end

function TycoonService:_refreshPlot(plot)
	local state = self.owners[plot]
	local ready = state ~= nil and state.profile ~= nil and state.player:GetAttribute("DataReady") == true
	local profile = ready and state.profile or nil
	local prompts = self.promptSets[plot]
	prompts.claim.Enabled = state == nil
	prompts.floor.Enabled = ready and profile.Floor < #self.config.Floors
	prompts.dropper.Enabled = ready and profile.Floor > 0 and profile.DropperTier < #self.config.DropperCosts
	prompts.collect.Enabled = ready and profile.Floor > 0
	prompts.bonus.Enabled = ready and profile.Floor >= 3
	plot:SetAttribute("OwnerReady", ready)
	plot:SetAttribute("Bank", profile and profile.Bank or 0)
	plot:SetAttribute("DropperTier", profile and profile.DropperTier or 0)
	plot:SetAttribute("Income", profile and Economy.Income(self.config, profile) or 0)
	if profile then
		local nextFloor = self.config.Floors[profile.Floor + 1]
		prompts.floor.ActionText = "Построить этаж " .. (profile.Floor + 1)
		prompts.floor.ObjectText = nextFloor and (nextFloor.Cost .. " монет") or "Дом достроен"
		local cost = self.config.DropperCosts[profile.DropperTier + 1]
		prompts.dropper.ActionText = "Улучшить генератор"
		prompts.dropper.ObjectText = cost and (cost .. " монет") or "Максимум"
		prompts.collect.ActionText = "Забрать монеты"
		prompts.collect.ObjectText = "Копилка: " .. profile.Bank
		prompts.bonus.ActionText = "Открыть бонус"
		prompts.bonus.ObjectText = "+" .. self.config.BonusCoins .. " монет"
	end
end

function TycoonService:_sync(state)
	local profile = state.profile
	local player = state.player
	if not profile or player.Parent ~= self.players then
		return
	end
	state.coins.Value = profile.Coins
	state.level.Value = self.config.GetLevel(profile.XP)
	player:SetAttribute("Floor", profile.Floor)
	player:SetAttribute("DropperTier", profile.DropperTier)
	player:SetAttribute("Bank", profile.Bank)
	player:SetAttribute("Income", Economy.Income(self.config, profile))
	player:SetAttribute("XP", profile.XP)
	player:SetAttribute("BonusReadyAt", profile.BonusReadyAt)
	if state.plot then
		self:_refreshPlot(state.plot)
	end
end

function TycoonService:_rebuild(state)
	self.world.UpdatePlot(state.plot, state.profile.Floor, state.player.DisplayName)
	state.plot:SetAttribute("OwnerUserId", state.player.UserId)
	state.plot:SetAttribute("OwnerName", state.player.DisplayName)
	state.plot:SetAttribute("Floor", state.profile.Floor)
	self:_refreshPlot(state.plot)
end

function TycoonService:_applyPerks(state, character)
	-- WaitForChild имеет таймаут: удалённый персонаж не оставит вечную задачу.
	task.spawn(function()
		local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
		if not humanoid or not humanoid:IsA("Humanoid") then
			return
		end
		if self.states[state.player] ~= state or state.player.Character ~= character then
			return
		end
		local unlocked = state.profile and state.profile.Floor >= 3 and state.player:GetAttribute("DataReady") == true
		humanoid.WalkSpeed = unlocked and self.config.ThirdFloorWalkSpeed or self.config.DefaultWalkSpeed
	end)
end

local function getValue(parent, name, className)
	local value = parent:FindFirstChild(name)
	if value then
		assert(value:IsA(className), name .. " должен быть " .. className)
		return value
	end
	value = Instance.new(className)
	value.Name = name
	value.Parent = parent
	return value
end

function TycoonService:_addPlayer(player)
	if self.states[player] then
		return
	end
	local state = { player = player, profile = nil, plot = nil, lastActionAt = -math.huge, leaving = false }
	self.states[player] = state
	player:SetAttribute("DataReady", false)
	player:SetAttribute("PlotId", "")
	state.characterConnection = player.CharacterAdded:Connect(function(character)
		self:_applyPerks(state, character)
	end)
	if player.Character then
		self:_applyPerks(state, player.Character)
	end
	local profile, loadError = self.profiles:Load(player)
	if player.Parent ~= self.players or state.leaving or self.states[player] ~= state or self.profiles:IsClosing() then
		self.profiles:Release(player)
		return
	end
	if not profile then
		player:SetAttribute("PersistenceStatus", "error")
		warn("Tycoon: профиль игрока " .. player.UserId .. " недоступен: " .. tostring(loadError))
		self:_notify(player, "Прогресс не удалось загрузить. Переподключитесь; покупки временно отключены.", "error")
		return
	end
	state.profile = profile
	local leaderstats = getValue(player, "leaderstats", "Folder")
	state.coins = getValue(leaderstats, "Coins", "IntValue")
	state.level = getValue(leaderstats, "Level", "IntValue")
	self:_sync(state)
	player:SetAttribute("DataReady", true)
	if player.Character then
		self:_applyPerks(state, player.Character)
	end
	local sessionOnly = player:GetAttribute("PersistenceMode") == "session"
	local text = sessionOnly and "Тестовый режим: прогресс действует до выхода. Займите свободный участок!"
		or "Прогресс загружен. Займите свободный участок!"
	self:_notify(player, text, "info")
end

function TycoonService:_removePlayer(player)
	local state = self.states[player]
	if not state then
		self.profiles:Release(player)
		return
	end
	state.leaving = true
	player:SetAttribute("DataReady", false)
	if state.characterConnection then
		state.characterConnection:Disconnect()
	end
	if state.plot then
		local plot = state.plot
		self.owners[plot] = nil
		state.plot = nil
		plot:SetAttribute("OwnerUserId", 0)
		plot:SetAttribute("OwnerName", "")
		plot:SetAttribute("Floor", 0)
		self.world.UpdatePlot(plot, 0, "")
		self:_refreshPlot(plot)
	end
	self.states[player] = nil
	self.profiles:Release(player)
end

function TycoonService:_validate(player, plot, prompt, needsOwner)
	local state = self.states[player]
	if self.profiles:IsClosing() then
		return nil
	end
	if not state or not state.profile or state.leaving or player.Parent ~= self.players then
		return nil
	end
	if player:GetAttribute("DataReady") ~= true or self.profiles:Get(player) ~= state.profile then
		return nil
	end
	if not plot.Parent or not prompt.Enabled or not prompt:IsDescendantOf(plot) then
		return nil
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil
	end
	local pad = prompt.Parent
	if not pad or not pad:IsA("BasePart") then
		return nil
	end
	-- Triggered может быть вызван эксплойтом: сервер сам измеряет расстояние.
	local distance = (root.Position - pad.Position).Magnitude
	if distance ~= distance or distance > prompt.MaxActivationDistance + 2 then
		return nil
	end
	-- Сундук нужно открывать с третьего этажа, а не с площадки под ним.
	if prompt.Name == "BonusPrompt" and math.abs(root.Position.Y - pad.Position.Y) > 7 then
		return nil
	end
	local now = os.clock()
	if now - state.lastActionAt < self.config.ActionCooldown then
		return nil
	end
	state.lastActionAt = now
	if needsOwner and (state.plot ~= plot or self.owners[plot] ~= state or plot:GetAttribute("OwnerUserId") ~= player.UserId) then
		self:_notify(player, "Это чужой дом. Займите свой свободный участок.", "error")
		return nil
	end
	return state
end

function TycoonService:_claim(player, plot, prompt)
	local state = self:_validate(player, plot, prompt, false)
	if not state then
		return
	end
	if state.plot then
		self:_notify(player, "У вас уже есть участок. Улучшайте свой дом!", "info")
		return
	end
	if self.owners[plot] or plot:GetAttribute("OwnerUserId") ~= 0 then
		return
	end
	-- Захват и обновление не содержат yield: два игрока не займут один участок.
	self.owners[plot] = state
	state.plot = plot
	player:SetAttribute("PlotId", plot:GetAttribute("PlotId") or plot.Name)
	self:_rebuild(state)
	self:_sync(state)
	local text = state.profile.Floor == 0 and ("Участок ваш! Постройте первый этаж за " .. self.config.Floors[1].Cost .. " монет на синей площадке.")
		or "Участок ваш! Сохранённый дом восстановлен."
	self:_notify(player, text, "success")
end

function TycoonService:_action(player, plot, prompt, action)
	local state = self:_validate(player, plot, prompt, true)
	if not state then
		return
	end
	local outcome
	if action == "floor" then
		outcome = Economy.BuyFloor(self.config, state.profile)
	elseif action == "dropper" then
		outcome = Economy.BuyDropper(self.config, state.profile)
	elseif action == "collect" then
		outcome = Economy.Collect(self.config, state.profile)
	elseif action == "bonus" then
		outcome = Economy.ClaimBonus(self.config, state.profile, os.time())
	else
		return
	end
	if outcome.ok then
		if action == "floor" then
			self:_rebuild(state)
			if player.Character then
				self:_applyPerks(state, player.Character)
			end
		end
		self:_sync(state)
	end
	self:_notify(player, outcome.text, outcome.kind)
end

function TycoonService:Start()
	assert(not self.started, "TycoonService уже запущен")
	self.started = true
	self.promptSets = {}
	for _, plot in ipairs(self.plots) do
		local prompts = {
			claim = findPrompt(plot, "ClaimPad", "ClaimPrompt"),
			floor = findPrompt(plot, "UpgradePad", "FloorPrompt"),
			dropper = findPrompt(plot, "DropperUpgradePad", "DropperPrompt"),
			collect = findPrompt(plot, "Collector", "CollectPrompt"),
			bonus = findPrompt(plot, "BonusPad", "BonusPrompt"),
		}
		self.promptSets[plot] = prompts
		table.insert(self.connections, prompts.claim.Triggered:Connect(function(player)
			self:_claim(player, plot, prompts.claim)
		end))
		for _, action in ipairs({ "floor", "dropper", "collect", "bonus" }) do
			local actionName = action
			local actionPrompt = prompts[actionName]
			table.insert(self.connections, actionPrompt.Triggered:Connect(function(player)
				self:_action(player, plot, actionPrompt, actionName)
			end))
		end
		self:_refreshPlot(plot)
	end
	table.insert(self.connections, self.players.PlayerAdded:Connect(function(player)
		self:_addPlayer(player)
	end))
	table.insert(self.connections, self.players.PlayerRemoving:Connect(function(player)
		self:_removePlayer(player)
	end))
	table.insert(self.connections, self.runService.Heartbeat:Connect(function(delta)
		if self.profiles:IsClosing() then
			return
		end
		self.elapsed += delta
		local ticks = math.floor(self.elapsed / self.config.IncomeInterval)
		if ticks < 1 then
			return
		end
		self.elapsed -= ticks * self.config.IncomeInterval
		for _, state in pairs(self.states) do
			if state.profile and state.plot then
				if state.player:GetAttribute("DataReady") == true then
					Economy.Accrue(self.config, state.profile, ticks)
					self:_sync(state)
				else
					self:_refreshPlot(state.plot)
				end
			end
		end
	end))
	for _, player in ipairs(self.players:GetPlayers()) do
		task.spawn(function()
			self:_addPlayer(player)
		end)
	end
end

function TycoonService:Destroy()
	for _, connection in ipairs(self.connections) do
		connection:Disconnect()
	end
	table.clear(self.connections)
	for _, state in pairs(self.states) do
		if state.characterConnection then
			state.characterConnection:Disconnect()
		end
	end
	self.started = false
end

return TycoonService
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="12">
      <Properties>
        <string name="Name">Stage1Map</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Этап 1: карта и точка появления. Поместите Script в ServerScriptService.
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local map = Workspace:FindFirstChild("SimulatorMap")
if map then
	assert(map:IsA("Folder"), "SimulatorMap должен быть Folder")
else
	map = Instance.new("Folder")
	map.Name = "SimulatorMap"
	map.Parent = Workspace
end

-- Повторный запуск использует детали с теми же именами.
local function makePart(name, size, position, color, material)
	local part = map:FindFirstChild(name)
	if part then
		assert(part.ClassName == "Part", name .. " должен быть Part")
	else
		part = Instance.new("Part")
		part.Name = name
		part.Parent = map
	end
	part.Anchored = true
	part.CanCollide = true
	part.Size = size
	part.CFrame = CFrame.new(position)
	part.Color = color
	part.Material = material
	part.Shape = Enum.PartType.Block
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

local grass = Color3.fromRGB(105, 167, 100)
local stone = Color3.fromRGB(224, 215, 192)
local wood = Color3.fromRGB(116, 82, 57)

makePart("Ground", Vector3.new(180, 2, 180), Vector3.new(0, -1, 0), grass, Enum.Material.Grass)
makePart("Plaza", Vector3.new(28, 0.3, 28), Vector3.new(0, 0.15, 0), stone, Enum.Material.SmoothPlastic)

-- Дорожки заканчиваются у центральной площади.
makePart("NorthPath", Vector3.new(8, 0.2, 68), Vector3.new(0, 0.1, -48), stone, Enum.Material.SmoothPlastic)
makePart("SouthPath", Vector3.new(8, 0.2, 68), Vector3.new(0, 0.1, 48), stone, Enum.Material.SmoothPlastic)
makePart("WestPath", Vector3.new(68, 0.2, 8), Vector3.new(-48, 0.1, 0), stone, Enum.Material.SmoothPlastic)
makePart("EastPath", Vector3.new(68, 0.2, 8), Vector3.new(48, 0.1, 0), stone, Enum.Material.SmoothPlastic)

-- Низкое ограждение помогает не упасть с края карты.
local borderColor = Color3.fromRGB(151, 169, 133)
makePart("NorthBorder", Vector3.new(180, 4, 2), Vector3.new(0, 2, -89), borderColor, Enum.Material.Slate)
makePart("SouthBorder", Vector3.new(180, 4, 2), Vector3.new(0, 2, 89), borderColor, Enum.Material.Slate)
makePart("WestBorder", Vector3.new(2, 4, 176), Vector3.new(-89, 2, 0), borderColor, Enum.Material.Slate)
makePart("EastBorder", Vector3.new(2, 4, 176), Vector3.new(89, 2, 0), borderColor, Enum.Material.Slate)

local treePositions = {
	Vector3.new(-77, 0, -77), Vector3.new(77, 0, -77),
	Vector3.new(-77, 0, 77), Vector3.new(77, 0, 77),
	Vector3.new(-77, 0, -30), Vector3.new(77, 0, -30),
	Vector3.new(-77, 0, 30), Vector3.new(77, 0, 30),
}

for index, position in ipairs(treePositions) do
	makePart("TreeTrunk" .. index, Vector3.new(2, 8, 2), position + Vector3.new(0, 4, 0), wood, Enum.Material.Wood)
	local leaves = makePart("TreeLeaves" .. index, Vector3.new(12, 12, 12), position + Vector3.new(0, 10, 0), Color3.fromRGB(65, 130 + index * 3, 77), Enum.Material.SmoothPlastic)
	leaves.Shape = Enum.PartType.Ball
	leaves.CanCollide = false
end

local rockPositions = {
	Vector3.new(-77, 1.5, -10), Vector3.new(77, 1.5, -10),
	Vector3.new(-77, 1.5, 10), Vector3.new(77, 1.5, 10),
}

for index, position in ipairs(rockPositions) do
	local rock = makePart("Rock" .. index, Vector3.new(6, 3, 5), position, Color3.fromRGB(144, 153, 152), Enum.Material.Slate)
	rock.Shape = Enum.PartType.Ball
end

-- В шаблоне Baseplate уже есть SpawnLocation: используем его.
local spawns = {}
for _, object in ipairs(Workspace:GetDescendants()) do
	if object:IsA("SpawnLocation") then
		table.insert(spawns, object)
	end
end
assert(#spawns <= 1, "Найдено несколько SpawnLocation. Для этапа 1 оставьте только нужную стартовую точку.")

local spawn = spawns[1] or Instance.new("SpawnLocation")
spawn.Name = "StartSpawn"
spawn.Size = Vector3.new(7, 0.8, 7)
spawn.CFrame = CFrame.new(0, 0.7, 6)
spawn.Anchored = true
spawn.CanCollide = true
spawn.Neutral = true
spawn.Enabled = true
spawn.AllowTeamChangeOnTouch = false
spawn.Duration = 0
spawn.Color = Color3.fromRGB(111, 210, 181)
spawn.Material = Enum.Material.Neon
spawn.TopSurface = Enum.SurfaceType.Smooth
spawn.BottomSurface = Enum.SurfaceType.Smooth
spawn.Parent = map

Lighting.ClockTime = 14
Lighting.Brightness = 2
Lighting.GlobalShadows = true
Lighting.Ambient = Color3.fromRGB(110, 120, 135)
Lighting.OutdoorAmbient = Color3.fromRGB(150, 155, 160)

map:SetAttribute("MapReady", true)
print("Карта готова: SimulatorMap и точка появления StartSpawn.")
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="13">
      <Properties>
        <string name="Name">TycoonServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Небольшая точка входа: карта, сохранения и экономика находятся в модулях.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("TycoonConfig"))
local modules = script.Parent:WaitForChild("Modules")
local ProfileService = require(modules:WaitForChild("ProfileService"))
local HouseWorld = require(modules:WaitForChild("HouseWorld"))
local TycoonService = require(modules:WaitForChild("TycoonService"))
local notice = ReplicatedStorage:WaitForChild("TycoonRemotes"):WaitForChild("Notice")

local map = Workspace:WaitForChild("SimulatorMap")
if map:GetAttribute("MapReady") ~= true then
	-- Stage1Map создаёт геометрию до установки MapReady.
	while map.Parent and map:GetAttribute("MapReady") ~= true do
		map:GetAttributeChangedSignal("MapReady"):Wait()
	end
end

local plots = HouseWorld.BuildPlots(Workspace, config)
local profiles = ProfileService.new(config)
local tycoon = TycoonService.new(config, profiles, HouseWorld, plots, notice)
tycoon:Start()

print("Домики готовы: займите участок, стройте 3 этажа, забирайте монеты и улучшайте генератор.")
]]></string>
      </Properties>
    </Item>
