      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[-- Game Pass ownership is checked by Roblox; clients never grant entitlements.
local Players=game:GetService('Players')
local MarketplaceService=game:GetService('MarketplaceService')
local Service={};Service.__index=Service
function Service.new(config,profiles,notice,request)
 return setmetatable({config=config,profiles=profiles,notice=notice,request=request,connections={},states={},destroyed=false},Service)
end
local function create(parent,class,name)
 local object=parent:FindFirstChild(name)
 if object then if object:IsA(class) then return object else return nil end end
 object=Instance.new(class);object.Name=name;object.Parent=parent;return object
end
function Service:_cosmetics(player)
 if self.destroyed or not self.states[player] or player.Parent~=Players then return end
 local character=player.Character
 if character then
  local head=character:FindFirstChild('Head')
  if head then
   local title=head:FindFirstChild('HeroClubTitle')
   local earned=player:GetAttribute('DisplayTitle')
   earned=if type(earned)=='string' and #earned<=240 then earned else ''
   local vip=player:GetAttribute('HasVIP')==true
   if vip or earned~='' then
    title=create(head,'BillboardGui','HeroClubTitle')
    if title then
     title.Size=UDim2.fromOffset(220,34);title.StudsOffset=Vector3.new(0,2.5,0);title.MaxDistance=75
     local label=create(title,'TextLabel','Title')
     if label then
      label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=1
      label.Text=if vip and earned~='' then 'КЛУБ ГЕРОЕВ · '..earned elseif vip then 'КЛУБ ГЕРОЕВ' else earned
      label.TextColor3=if vip then Color3.fromRGB(255,218,89) else Color3.fromRGB(101,225,196)
      label.Font=Enum.Font.GothamBold;label.TextScaled=true
     end
    end
   elseif title then title:Destroy() end
  end
 end
 local containers={}
 if character then table.insert(containers,character) end
 local backpack=player:FindFirstChildOfClass('Backpack');if backpack then table.insert(containers,backpack) end
 for _,container in ipairs(containers) do
  for _,tool in ipairs(container:GetChildren()) do
   if tool:IsA('Tool') and tool:GetAttribute('HeroWeapon') then
    local handle=tool:FindFirstChild('Handle')
    if handle and handle:IsA('BasePart') then
     if player:GetAttribute('HasNeon')==true then
      local a=create(handle,'Attachment','HeroNeonA');local b=create(handle,'Attachment','HeroNeonB')
      local trail=create(handle,'Trail','HeroNeonTrail')
      if a and b and trail then
       a.Position=Vector3.new(0,0.5,0);b.Position=Vector3.new(0,-0.5,0)
       trail.Attachment0=a;trail.Attachment1=b;trail.Lifetime=0.25
       trail.Color=ColorSequence.new(Color3.fromRGB(91,233,239));trail.Transparency=NumberSequence.new(0.25)
      end
     else
      for _,name in ipairs({'HeroNeonTrail','HeroNeonA','HeroNeonB'}) do
       local object=handle:FindFirstChild(name);if object then object:Destroy() end
      end
     end
    end
   end
  end
 end
end
function Service:_ready(player)
 return not self.destroyed and self.states[player]~=nil and player.Parent==Players and player:GetAttribute('DataReady')==true
  and self.profiles:Get(player)~=nil and not self.profiles:IsClosing()
end
function Service:_verify(player,key)
 local state=self.states[player]
 if not state or not self:_ready(player) or (key~='VIP' and key~='Neon') then return false end
 local pass=self.config.GamePasses[key]
 if not pass or type(pass.Id)~='number' or pass.Id<=0 then return false end
 local ok,owned=pcall(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId,pass.Id) end)
 if ok and owned==true and self.states[player]==state and self:_ready(player) then
  player:SetAttribute(key=='VIP' and 'HasVIP' or 'HasNeon',true)
  self:_cosmetics(player);return true
 end
 return false
end
function Service:_request(player,key)
 local state=self.states[player]
 if type(key)~='string' or not state or not self:_ready(player) then return end
 local pass=self.config.GamePasses[key]
 if not pass or (key~='VIP' and key~='Neon') then return end
 local now=os.clock();if now-state.last<3 then return end;state.last=now
 if type(pass.Id)~='number' or pass.Id<=0 then return end
 if self:_verify(player,key) then
  self.notice:FireClient(player,{kind='info',text='Этот пропуск уже у вас.'});return
 end
 if self.states[player]~=state or not self:_ready(player) then return end
 local ok,info=pcall(function() return MarketplaceService:GetProductInfo(pass.Id,Enum.InfoType.GamePass) end)
 if self.states[player]~=state or not self:_ready(player) then return end
 if not ok or type(info)~='table' or info.IsForSale~=true then
  self.notice:FireClient(player,{kind='error',text='Покупка сейчас недоступна. Попробуйте позже.'})
  return
 end
 local prompted=pcall(function() MarketplaceService:PromptGamePassPurchase(player,pass.Id) end)
 if not prompted then self.notice:FireClient(player,{kind='error',text='Не удалось открыть покупку Roblox.'}) end
end
function Service:_add(player)
 if self.destroyed or player.Parent~=Players or self.states[player] then return end
 local state={last=-math.huge,connections={},characterConnections={}};self.states[player]=state
 player:SetAttribute('HasVIP',false);player:SetAttribute('HasNeon',false)
 local function connect(signal,fn) table.insert(state.connections,signal:Connect(fn)) end
 local function load()
  if self.states[player]==state and self:_ready(player) then for key in pairs(self.config.GamePasses) do self:_verify(player,key) end end
 end
 connect(player:GetAttributeChangedSignal('DataReady'),function() task.spawn(load) end)
 connect(player:GetAttributeChangedSignal('HasVIP'),function() self:_cosmetics(player) end)
 connect(player:GetAttributeChangedSignal('HasNeon'),function() self:_cosmetics(player) end)
 connect(player:GetAttributeChangedSignal('DisplayTitle'),function() self:_cosmetics(player) end)
 local function watch(container,list,characterOnly)
  table.insert(list,container.ChildAdded:Connect(function() task.defer(function()
   if self.states[player]==state and (not characterOnly or player.Character==container) then self:_cosmetics(player) end
  end) end))
  self:_cosmetics(player)
 end
 local function characterAdded(character)
  if self.destroyed or self.states[player]~=state or player.Character~=character then return end
  for _,connection in ipairs(state.characterConnections) do connection:Disconnect() end
  table.clear(state.characterConnections)
  watch(character,state.characterConnections,true)
  task.spawn(function()
   character:WaitForChild('Head',5)
   if self.states[player]==state and player.Character==character then self:_cosmetics(player) end
  end)
 end
 connect(player.CharacterAdded,characterAdded)
 if player.Character then characterAdded(player.Character) end
 task.spawn(function()
  local backpack=player:WaitForChild('Backpack',10)
  if backpack and self.states[player]==state then watch(backpack,state.connections,false) end
 end)
 task.spawn(load)
end
function Service:Start()
 assert(not self.started and not self.destroyed,'MonetizationService is already running or destroyed');self.started=true
 table.insert(self.connections,self.request.OnServerEvent:Connect(function(player,key) self:_request(player,key) end))
 table.insert(self.connections,MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player,id,purchased)
  if purchased~=true or not self:_ready(player) then return end
  for key,pass in pairs(self.config.GamePasses) do
   if pass.Id>0 and pass.Id==id and self:_verify(player,key) then
    self.notice:FireClient(player,{kind='success',text='Покупка подтверждена Roblox: '..pass.Name});return
   end
  end
 end))
 table.insert(self.connections,Players.PlayerAdded:Connect(function(player) self:_add(player) end))
 table.insert(self.connections,Players.PlayerRemoving:Connect(function(player)
  self:_remove(player)
 end))
 for _,player in ipairs(Players:GetPlayers()) do self:_add(player) end
end
function Service:_remove(player)
 local state=self.states[player];self.states[player]=nil
 if not state then return end
 for _,connection in ipairs(state.connections or {}) do connection:Disconnect() end
 for _,connection in ipairs(state.characterConnections or {}) do connection:Disconnect() end
end
function Service:Destroy()
 if self.destroyed then return end;self.destroyed=true
 for _,c in ipairs(self.connections) do c:Disconnect() end
 table.clear(self.connections)
 for player in pairs(self.states) do self:_remove(player) end
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">ObbyService</string>
          <string name="Source"><![CDATA[-- Server checkpoints and sequential progress. The client never chooses stage or reward.
local Service={};Service.__index=Service
local function finite(value) return type(value)=='number' and value==value and math.abs(value)~=math.huge end
local function near(root,part,horizontal,vertical)
 local offset=root.Position-part.Position
 return finite(offset.X) and finite(offset.Y) and finite(offset.Z)
  and math.abs(offset.X)<=horizontal and math.abs(offset.Z)<=horizontal and math.abs(offset.Y)<=vertical
end
function Service.new(config,profiles,tycoon,notice,request,world,heroes)
 return setmetatable({config=config,profiles=profiles,tycoon=tycoon,notice=notice,request=request,world=world,heroes=heroes,
  players=game:GetService('Players'),runService=game:GetService('RunService'),runs={},connections={},playerConnections={},lastRequest={},started=false,destroyed=false},Service)
end
function Service:_context(player,allowDetachedWorld)
 if self.destroyed or (not allowDetachedWorld and self.world.Parent~=workspace) or self.profiles:IsClosing() or player.Parent~=self.players or player:GetAttribute('DataReady')~=true then return nil end
 local profile=self.profiles:Get(player);local state=self.tycoon:GetState(player)
 if not profile or not state or state.profile~=profile or state.leaving then return nil end
 local character=player.Character
 local humanoid=character and character:FindFirstChildOfClass('Humanoid')
 local root=character and character:FindFirstChild('HumanoidRootPart')
 if not humanoid or not (humanoid.Health>0) or not root or not root:IsA('BasePart') then return nil end
 return profile,humanoid,root
end
function Service:_notice(player,text,kind)
 if player.Parent==self.players then self.notice:FireClient(player,{text=text,kind=kind or 'info'}) end
end
function Service:_syncRun(player,run)
 player:SetAttribute('ObbyActive',run~=nil)
 player:SetAttribute('ObbyStage',run and run.stage or 0)
 player:SetAttribute('ObbyCheckpoint',run and run.checkpoint or 0)
 player:SetAttribute('ObbyStartedAt',run and run.serverStartedAt or 0)
end
function Service:_standardMovement(humanoid)
 local settings=self.config.Obby
 humanoid.WalkSpeed=settings.WalkSpeed;humanoid.JumpPower=settings.JumpPower;humanoid.JumpHeight=settings.JumpHeight
end
function Service:_teleport(root,index)
 local point=self.config.Obby.Platforms[index]
 root.CFrame=CFrame.new(point.X,point.Y+4,point.Z)
 root.AssemblyLinearVelocity=Vector3.zero;root.AssemblyAngularVelocity=Vector3.zero
end
function Service:_start(player,prompt)
 local profile,humanoid,root=self:_context(player)
 if not profile or not prompt.Enabled or not prompt.Parent or not near(root,prompt.Parent,12,8) then return end
 local now=os.clock()
 if now-(self.lastRequest[player] or -math.huge)<1 then return end
 self.lastRequest[player]=now
 local original=self.runs[player]
 local run={stage=1,checkpoint=1,startedAt=now,serverStartedAt=workspace:GetServerTimeNow(),lastStageAt=now,lastRecoveryAt=-math.huge,
  jumpPower=original and original.jumpPower or humanoid.JumpPower,jumpHeight=original and original.jumpHeight or humanoid.JumpHeight}
 self.runs[player]=run
 player:SetAttribute('ArenaCombatOptIn',false)
 self:_syncRun(player,run);self:_standardMovement(humanoid);self:_teleport(root,1)
 self:_notice(player,'Обби началось! Зелёные крыши — контрольные точки. После падения можно продолжить.','info')
end
function Service:_end(player,teleport)
 local run=self.runs[player];self.runs[player]=nil;self:_syncRun(player,nil)
 local profile,humanoid,root=self:_context(player,true)
 if profile then
  if run then humanoid.JumpPower=run.jumpPower;humanoid.JumpHeight=run.jumpHeight end
  self.heroes:ApplyPerks(player,humanoid,profile)
  if teleport then
   root.CFrame=CFrame.new(-27,5,75);root.AssemblyLinearVelocity=Vector3.zero;root.AssemblyAngularVelocity=Vector3.zero
  end
 end
end
function Service:_recover(player)
 local run=self.runs[player];if not run then return end
 local profile,humanoid,root=self:_context(player);if not profile then return end
 local now=os.clock()
 if now-run.lastRecoveryAt<0.8 then return end
 run.lastRecoveryAt=now;run.stage=run.checkpoint;run.lastStageAt=now
 self:_standardMovement(humanoid);self:_teleport(root,run.checkpoint);self:_syncRun(player,run)
end
function Service:_visit(player,index,platform)
 local run=self.runs[player];if not run or index~=run.stage+1 then return end
 local profile,_,root=self:_context(player);if not profile then return end
 local now=os.clock();local settings=self.config.Obby
 if now-run.startedAt>settings.MaximumRunSeconds then
  self:_end(player,true);self:_notice(player,'Забег закончился. Начни заново на стартовой площадке.');return
 end
 if not platform:IsDescendantOf(self.world) or not near(root,platform,5.5,5)
  or now-run.lastStageAt<settings.StageMinimumSeconds then return end
 if index==#settings.Platforms and now-run.startedAt<settings.MinimumRunSeconds then
  if not run.finishScheduled then
   run.finishScheduled=true
   local remaining=settings.MinimumRunSeconds-(now-run.startedAt)
   self:_notice(player,'Ты на финише! Подтверждаем результат — останься на золотой крыше.')
   task.delay(remaining+0.05,function()
    if self.runs[player]==run and run.stage==index-1 then self:_visit(player,index,platform) end
   end)
  end
  return
 end
 run.stage=index;run.lastStageAt=now
 for _,checkpoint in ipairs(settings.Checkpoints) do
  if index==checkpoint then run.checkpoint=index;self:_notice(player,'Контрольная точка '..index..' сохранена!','success');break end
 end
 self:_syncRun(player,run)
 if index~=#settings.Platforms then return end
 local milliseconds=math.floor((now-run.startedAt)*1000+0.5)
 local wallTime=os.time()
 if wallTime>=(profile.ObbyReadyAt or 0) then
  local coins=math.min(settings.RewardCoins,self.config.MaxCoins-profile.Coins)
  if coins>0 then
   profile.Coins+=coins;profile.XP=math.min(self.config.MaxXP,profile.XP+settings.RewardXP)
   profile.ObbyReadyAt=wallTime+settings.RewardCooldown
   self:_notice(player,'Финиш! +'..coins..' монет и +'..settings.RewardXP..' XP.','success')
  else self:_notice(player,'Финиш! Кошелёк заполнен; награда не списана.','info') end
 else
  self:_notice(player,'Финиш! Следующая денежная награда через '..math.ceil(profile.ObbyReadyAt-wallTime)..' сек.','info')
 end
 profile.ObbyWins=math.min(self.config.MaxCoins,(profile.ObbyWins or 0)+1)
 if (profile.ObbyBestMilliseconds or 0)==0 or milliseconds<profile.ObbyBestMilliseconds then profile.ObbyBestMilliseconds=milliseconds end
 -- The reward is already committed to the server profile. A HUD sync failure
 -- must never leave the run active or allow a second finish to grant it again.
 local synced=pcall(function() self.tycoon:SyncPlayer(player) end)
 self:_end(player,false)
 if not synced then warn('Obby: не удалось обновить интерфейс после финиша') end
end
function Service:_step(now)
 if self.destroyed then return end
 if self.profiles:IsClosing() or self.world.Parent~=workspace then self:Destroy();return end
 for player,run in pairs(self.runs) do
  if now-run.startedAt>self.config.Obby.MaximumRunSeconds then
   self:_end(player,true);self:_notice(player,'Время забега вышло. Начни заново на стартовой площадке.')
  end
 end
end
function Service:_playerFromHit(hit)
 if not hit then return nil end
 local node=hit.Parent
 while node and node~=workspace do
  if node:IsA('Model') then
   local player=self.players:GetPlayerFromCharacter(node);if player then return player end
  end
  node=node.Parent
 end
 return nil
end
function Service:_watch(player)
 if self.playerConnections[player] then return end
 self:_syncRun(player,nil)
 self.playerConnections[player]={
  player.CharacterAdded:Connect(function(character)
   local run=self.runs[player];if not run then return end
   task.spawn(function()
    character:WaitForChild('HumanoidRootPart',10);character:WaitForChild('Humanoid',10)
    if player.Character==character and self.runs[player]==run then
     run.lastRecoveryAt=-math.huge;self:_recover(player)
    end
   end)
  end),
  player:GetAttributeChangedSignal('DataReady'):Connect(function()
   if player:GetAttribute('DataReady')~=true and self.runs[player] then self:_end(player,false) end
  end),
 }
end
function Service:Start()
 assert(not self.started and not self.destroyed,'ObbyService is already running or destroyed');self.started=true
 local platforms=self.world:FindFirstChild('Platforms')
 for index=2,#self.config.Obby.Platforms do
  local platform=platforms:FindFirstChild('Stage'..index)
  assert(platform and platform:IsA('BasePart'),'Missing obby stage '..index)
  table.insert(self.connections,platform.Touched:Connect(function(hit)
   local player=self:_playerFromHit(hit);if player then self:_visit(player,index,platform) end
  end))
 end
 local start=self.world:FindFirstChild('StartStand');local prompt=start:FindFirstChild('StartObbyPrompt')
 table.insert(self.connections,prompt.Triggered:Connect(function(player) self:_start(player,prompt) end))
 local recovery=self.world:FindFirstChild('RecoveryField')
 table.insert(self.connections,recovery.Touched:Connect(function(hit)
  local player=self:_playerFromHit(hit);if player then self:_recover(player) end
 end))
 table.insert(self.connections,self.request.OnServerEvent:Connect(function(player,command)
  if type(command)~='string' or (command~='Checkpoint' and command~='Exit') or not self.runs[player] then return end
  local now=os.clock();if now-(self.lastRequest[player] or -math.huge)<1 then return end
  self.lastRequest[player]=now
  if command=='Checkpoint' then self:_recover(player) else self:_end(player,true) end
 end))
 table.insert(self.connections,self.players.PlayerAdded:Connect(function(player) self:_watch(player) end))
 table.insert(self.connections,self.players.PlayerRemoving:Connect(function(player)
  self.runs[player]=nil;self.lastRequest[player]=nil
  for _,connection in ipairs(self.playerConnections[player] or {}) do connection:Disconnect() end
  self.playerConnections[player]=nil
 end))
 local accumulated=0
 table.insert(self.connections,self.runService.Heartbeat:Connect(function(seconds)
  accumulated+=seconds
  if accumulated<1 then return end
  accumulated=0;self:_step(os.clock())
 end))
 for _,player in ipairs(self.players:GetPlayers()) do self:_watch(player) end
end
function Service:Destroy()
 if self.destroyed then return end
 for player in pairs(self.runs) do self:_end(player,false) end
 self.destroyed=true
 for _,connection in ipairs(self.connections) do connection:Disconnect() end
 for _,connections in pairs(self.playerConnections) do for _,connection in ipairs(connections) do connection:Disconnect() end end
 table.clear(self.connections);table.clear(self.playerConnections);table.clear(self.lastRequest);self.started=false
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">ObbyWorld</string>
          <string name="Source"><![CDATA[-- Rooftop route geometry; ObbyService owns checkpoints and rewards.
local World = {}
local Style = require(script.Parent:WaitForChild("VisualStyle"))
local function child(parent, class, name)
 local value=parent:FindFirstChild(name)
 if not value then value=Instance.new(class);value.Name=name;value.Parent=parent
 else assert(value:IsA(class),name..' has the wrong type') end
 return value
end
local function part(parent,name,size,position,color,material,collide)
 local value=child(parent,'Part',name)
 value.Size=size;value.CFrame=CFrame.new(position);value.Color=color
 value.Material=material;value.Anchored=true;value.CanCollide=collide~=false
 value.CanTouch=true;value.CanQuery=value.CanCollide
 value.TopSurface=Enum.SurfaceType.Smooth;value.BottomSurface=Enum.SurfaceType.Smooth
 return value
end
local function label(part,name,text,color)
 local gui=child(part,'BillboardGui',name)
 gui.Size=UDim2.new(0,210,0,52);gui.StudsOffset=Vector3.new(0,4,0);gui.MaxDistance=80
 local value=child(gui,'TextLabel','Text')
 value.Size=UDim2.new(1,0,1,0);value.BackgroundColor3=Style.Palette.Ink
 value.BackgroundTransparency=0.15;value.BorderSizePixel=0
 value.TextColor3=color;value.Text=text;value.TextScaled=true;value.TextWrapped=true
 value.Font=Enum.Font.GothamBold
 child(value,'UICorner','Round').CornerRadius=UDim.new(0,8)
end
function World.Build(workspace,config)
 local folder=child(workspace,'Folder','RooftopObby')
 local platforms=child(folder,'Folder','Platforms')
 local decor=child(folder,'Folder','Decor')
 local checkpoint={}
 for _,index in ipairs(config.Obby.Checkpoints) do checkpoint[index]=true end
 for index,point in ipairs(config.Obby.Platforms) do
  local color=if checkpoint[index] then Style.Palette.Mint elseif index==#config.Obby.Platforms then Style.Palette.Gold else Style.Palette.Ink
  local value=part(platforms,'Stage'..index,Vector3.new(7,0.8,7),Vector3.new(point.X,point.Y,point.Z),color,Enum.Material.Slate)
  value:SetAttribute('ObbyStage',index)
  if checkpoint[index] then label(value,'StageLabel','ТОЧКА '..index,color)
  elseif index==#config.Obby.Platforms then label(value,'StageLabel','ФИНИШ · +300 монет',color) end
  local trim=part(decor,'RoofTrim'..index,Vector3.new(7.1,0.12,0.4),Vector3.new(point.X,point.Y+0.46,point.Z-3.3),color,Enum.Material.Neon,false)
  trim.CanTouch=false;trim.CanQuery=false
  for _,side in ipairs({-1,1}) do
   local edge=part(decor,'RoofEdge'..index..side,Vector3.new(0.17,0.06,6.8),Vector3.new(point.X+side*3.3,point.Y+0.44,point.Z),Style.Palette.Stone,Enum.Material.Metal,false)
   edge.CanTouch=false
  end
  local tile=part(decor,'LandingTile'..index,Vector3.new(2.8,0.025,2.8),Vector3.new(point.X,point.Y+0.415,point.Z),if checkpoint[index] then Style.Palette.Paper else Style.Palette.Road,Enum.Material.DiamondPlate,false)
  tile.CanTouch=false
  local bracket=part(decor,'RoofBracket'..index,Vector3.new(5,0.3,5),Vector3.new(point.X,point.Y-0.55,point.Z),Style.Palette.Stone,Enum.Material.Concrete,false)
  bracket.CanTouch=false
  if checkpoint[index] then
   local flag=part(decor,'CheckpointMarker'..index,Vector3.new(0.18,3,0.18),Vector3.new(point.X+4.2,point.Y+1.5,point.Z),Style.Palette.Ink,Enum.Material.Metal,false)
   flag.CanTouch=false
   local panel=part(decor,'CheckpointFlag'..index,Vector3.new(1.7,0.9,0.1),Vector3.new(point.X+5,point.Y+2.5,point.Z),color,Enum.Material.Fabric,false)
   panel.CanTouch=false
  end
 end
 local recovery=part(folder,'RecoveryField',Vector3.new(72,0.25,76),Vector3.new(0,0.4,112),Style.Palette.Mint,Enum.Material.Glass,false)
 recovery.Transparency=0.88
 local start=part(folder,'StartStand',Vector3.new(8,0.5,6),Vector3.new(-27,0.6,78),Style.Palette.Gold,Enum.Material.Neon)
 local prompt=child(start,'ProximityPrompt','StartObbyPrompt')
 prompt.ActionText='Начать обби';prompt.ObjectText='Крыши квартала · 16 этапов'
 prompt.MaxActivationDistance=10;prompt.HoldDuration=0.25;prompt.RequiresLineOfSight=false
 prompt.KeyboardKeyCode=Enum.KeyCode.E;prompt.Enabled=true
 label(start,'StartLabel','КРЫШИ КВАРТАЛА\nОББИ С КОНТРОЛЬНЫМИ ТОЧКАМИ',Style.Palette.Gold)
 for _,side in ipairs({-1,1}) do
  local post=part(decor,'StartGatePost'..side,Vector3.new(0.7,8,0.7),Vector3.new(-27+side*5,4,81),Style.Palette.Ink,Enum.Material.Metal,false)
  post.CanTouch=false
 end
 local beam=part(decor,'StartGateTop',Vector3.new(11,0.5,0.8),Vector3.new(-27,8.2,81),Style.Palette.Gold,Enum.Material.Neon,false)
 beam.CanTouch=false
 local endPoint=config.Obby.Platforms[#config.Obby.Platforms]
 local finish=part(decor,'FinishArch',Vector3.new(9,0.4,0.65),Vector3.new(endPoint.X,endPoint.Y+6,endPoint.Z),Style.Palette.Gold,Enum.Material.Neon,false)
 finish.CanTouch=false
 for _,side in ipairs({-1,1}) do
  local post=part(decor,'FinishPost'..side,Vector3.new(0.45,5.6,0.45),Vector3.new(endPoint.X+side*4.2,endPoint.Y+3,endPoint.Z),Style.Palette.Ink,Enum.Material.Metal,false)
  post.CanTouch=false
 end
 -- Decorative building shells stay away from the route and below jump height.
 for index,point in ipairs({{X=-43,Z=101,H=8},{X=43,Z=125,H=11},{X=-42,Z=139,H=6},{X=40,Z=86,H=7}}) do
  part(decor,'CityBlock'..index,Vector3.new(13,point.H,16),Vector3.new(point.X,point.H/2,point.Z),Color3.fromRGB(160+index*12,157,143),Enum.Material.Brick)
  local roof=part(decor,'CityBlockRoof'..index,Vector3.new(14,0.35,17),Vector3.new(point.X,point.H+0.2,point.Z),Style.Palette.Ink,Enum.Material.Slate)
  roof.CanTouch=false
  local vent=part(decor,'CityBlockVent'..index,Vector3.new(2.5,0.8,3),Vector3.new(point.X-3,point.H+0.85,point.Z+3),Style.Palette.Stone,Enum.Material.Metal)
  vent.CanTouch=false
  for row=1,2 do
   for column=1,3 do
    local window=part(decor,'Window'..index..'_'..row..'_'..column,Vector3.new(2,1.4,0.12),Vector3.new(point.X-4+column*2,1+row*2,point.Z-8.1),Style.Palette.Window,Enum.Material.Glass,false)
    window.CanTouch=false;window.CanQuery=false
   end
  end
 end
 folder:SetAttribute('ObbyReady',true)
 return folder
end
return World
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">PlayerJourney</string>
          <string name="Source"><![CDATA[-- Чистые серверные правила обучения и достижений. Клиент не отмечает цели выполненными.
local Journey = {}

function Journey.GetProgress(config, profile, field)
	if field == "Floor" then return (profile.Rebirths or 0) > 0 and #config.Floors or profile.Floor end
	if field == "WeaponTypes" then
		local total = 0
		for _, weapon in ipairs(config.Weapons) do
			local copies = (profile.Inventory or {})[weapon.Id]
			if type(copies) == "number" and copies > 0 and copies < math.huge then total += 1 end
		end
		return total
	end
	local allowed = {CollectedTotal = true, EnemiesDefeated = true, BossDefeated = true, ObbyWins = true, Rebirths = true}
	return allowed[field] and (profile[field] or 0) or 0
end

local function completed(config, profile, ownsPlot, target)
	if target == "plot" then return ownsPlot end
	if target == "floor" then return ownsPlot and profile.Floor >= 1 end
	if target == "collect" then return (profile.CollectedTotal or 0) > 0 end
	if target == "generator" then return profile.DropperTier >= 1 or (profile.Rebirths or 0) > 0 end
	if target == "hero" then return config.CanUseHero(profile, config.GetHero(profile.EquippedHero)) end
	if target == "combat" then return profile.CombatPractice == true end
	return false
end

function Journey.Advance(config, profile, ownsPlot)
	local events = {}
	local step = profile.TutorialStep or 1
	while step <= #config.TutorialSteps do
		local definition = config.TutorialSteps[step]
		if not completed(config, profile, ownsPlot, definition.Target) then break end
		if profile.Coins > config.MaxCoins - definition.Coins then break end
		profile.Coins += definition.Coins
		profile.XP = math.min(config.MaxXP, profile.XP + definition.XP)
		step += 1
		profile.TutorialStep = step
		table.insert(events, {kind = "success", text = definition.Title .. ": выполнено! +" .. definition.Coins .. " монет, +" .. definition.XP .. " XP."})
	end
	profile.TutorialStep = step
	return events
end

function Journey.ClaimAchievement(config, profile, id)
	local definition = config.GetAchievement(id)
	if not definition then return {ok = false, kind = "error", text = "Такого достижения нет."} end
	profile.AchievementClaims = profile.AchievementClaims or {}
	if profile.AchievementClaims[id] then return {ok = false, kind = "info", text = "Награда уже получена."} end
	if Journey.GetProgress(config, profile, definition.Field) < definition.Target then
		return {ok = false, kind = "info", text = "Условие достижения ещё не выполнено."}
	end
	if profile.Coins > config.MaxCoins - definition.RewardCoins then return {ok = false, kind = "error", text = "Потрать монеты, чтобы освободить место для награды."} end
	-- Изменение профиля атомарно: повторный запрос не выдаст награду второй раз.
	profile.Coins += definition.RewardCoins
	profile.XP = math.min(config.MaxXP, profile.XP + definition.RewardXP)
	profile.AchievementClaims[id] = true
	if definition.TitleReward and (profile.EquippedTitle or "") == "" then profile.EquippedTitle = id end
	return {ok = true, kind = "success", text = "Достижение «" .. definition.Title .. "»: +" .. definition.RewardCoins .. " монет!"}
end

function Journey.EquipTitle(config, profile, id)
	if id == "" then profile.EquippedTitle = ""; return {ok = true, kind = "info", text = "Титул скрыт."} end
	local definition = config.GetAchievement(id)
	if not definition or not definition.TitleReward or not (profile.AchievementClaims or {})[id] then
		return {ok = false, kind = "error", text = "Сначала получи награду за это достижение."}
	end
	profile.EquippedTitle = id
	return {ok = true, kind = "success", text = "Титул «" .. definition.TitleReward .. "» выбран."}
end

return Journey
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">ProfileSchema</string>
          <string name="Source"><![CDATA[-- Проверка сохранённого профиля. Уровень вычисляется из XP, а не хранится отдельно.
local Schema = {}

local function boundedInteger(value, default, maximum)
	if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then
		return default
	end
	return math.clamp(math.floor(value), 0, maximum)
end

function Schema.New(config)
	return { Coins = config.StartingCoins, XP = 0, Floor = 0, DropperTier = 0, Bank = 0, BonusReadyAt = 0,
		Rebirths = 0, EquippedHero = "", CollectedTotal = 0, EnemiesDefeated = 0, DailyReadyAt = 0, QuestClaims = {},
		Inventory = {}, EquippedWeapon = "", WeaponUpgrades = {}, ObbyReadyAt = 0, ObbyWins = 0, ObbyBestMilliseconds = 0,
		DailyLastClaimAt = 0, DailyStreak = 0, AchievementClaims = {}, EquippedTitle = "", TutorialStep = 1, CombatPractice = false, BossDefeated = 0 }
end

function Schema.Normalize(data, config, now)
	if type(data) ~= "table" then
		return Schema.New(config)
	end
	local floor = boundedInteger(data.Floor, 0, #config.Floors)
	local rebirths = boundedInteger(data.Rebirths, 0, config.MaxRebirths or 20)
	local hero = config.GetHero and config.GetHero(data.EquippedHero)
	local equipped = if hero and config.CanUseHero({ Floor = floor, Rebirths = rebirths }, hero) then hero.Id else ""
	local claims = {}
	for _, quest in ipairs(config.Quests or {}) do
		if type(data.QuestClaims) == "table" and data.QuestClaims[quest.Id] == true then claims[quest.Id] = true end
	end
	local inventory = {}
	for _, weapon in ipairs(config.Weapons or {}) do
		local count = if type(data.Inventory) == "table" then boundedInteger(data.Inventory[weapon.Id], 0, config.MaxWeaponCopies or 99) else 0
		if count > 0 then inventory[weapon.Id] = count end
	end
	local equippedWeapon = if type(data.EquippedWeapon) == "string" and inventory[data.EquippedWeapon] then data.EquippedWeapon else ""
	local upgrades = {}
	local savedUpgrades = if type(data.WeaponUpgrades) == "table" then data.WeaponUpgrades else {}
	for _, heroDefinition in ipairs(config.Heroes or {}) do
		local key = "hero:" .. heroDefinition.Id
		local level = boundedInteger(savedUpgrades[key], 0, #config.WeaponUpgradeCosts)
		if level > 0 then upgrades[key] = level end
	end
	for id in pairs(inventory) do
		local key = "loot:" .. id
		local level = boundedInteger(savedUpgrades[key], 0, #config.WeaponUpgradeCosts)
		if level > 0 then upgrades[key] = level end
	end
	local achievementClaims = {}
	for _, definition in ipairs(config.Achievements or {}) do
		if type(data.AchievementClaims) == "table" and data.AchievementClaims[definition.Id] == true then achievementClaims[definition.Id] = true end
	end
	local title = config.GetAchievement(data.EquippedTitle)
	local equippedTitle = if title and title.TitleReward and achievementClaims[title.Id] then title.Id else ""
	-- Старым развитым профилям не навязываем повторное обучение и не выдаём его награды заново.
	local hasPriorProgress = floor > 0 or rebirths > 0 or (type(data.XP) == "number" and data.XP > 0)
		or (type(data.CollectedTotal) == "number" and data.CollectedTotal > 0) or next(inventory) ~= nil
	local tutorialDefault = if hasPriorProgress then #config.TutorialSteps + 1 else 1
	local tutorialStep = math.max(1, boundedInteger(data.TutorialStep, tutorialDefault, #config.TutorialSteps + 1))
	return {
		Coins = boundedInteger(data.Coins, config.StartingCoins, config.MaxCoins),
		XP = boundedInteger(data.XP, 0, config.MaxXP),
		Floor = floor,
		DropperTier = if floor == 0 then 0 else boundedInteger(data.DropperTier, 0, #config.DropperCosts),
		Bank = if floor == 0 then 0 else boundedInteger(data.Bank, 0, config.MaxBank),
		BonusReadyAt = boundedInteger(data.BonusReadyAt, 0, now + 86400),
		Rebirths = rebirths, EquippedHero = equipped,
		CollectedTotal = boundedInteger(data.CollectedTotal, 0, config.MaxCoins),
		EnemiesDefeated = boundedInteger(data.EnemiesDefeated, 0, config.MaxCoins),
		DailyReadyAt = boundedInteger(data.DailyReadyAt, 0, now + (config.DailyCooldown or 86400)),
		QuestClaims = claims,
		Inventory = inventory, EquippedWeapon = equippedWeapon,
		WeaponUpgrades = upgrades,
		DailyLastClaimAt = boundedInteger(data.DailyLastClaimAt, 0, now),
		DailyStreak = boundedInteger(data.DailyStreak, 0, #config.DailyRewards),
		AchievementClaims = achievementClaims, EquippedTitle = equippedTitle,
		TutorialStep = tutorialStep, CombatPractice = data.CombatPractice == true,
		BossDefeated = boundedInteger(data.BossDefeated, 0, config.MaxCoins),
		ObbyReadyAt = boundedInteger(data.ObbyReadyAt, 0, now + config.Obby.RewardCooldown),
		ObbyWins = boundedInteger(data.ObbyWins, 0, config.MaxCoins),
		ObbyBestMilliseconds = boundedInteger(data.ObbyBestMilliseconds, 0, config.Obby.MaximumRunSeconds * 1000),
	}
end

function Schema.Copy(profile)
	local claims = {}
	for id, claimed in pairs(profile.QuestClaims or {}) do if claimed == true then claims[id] = true end end
	local inventory = {}
	for id, count in pairs(profile.Inventory or {}) do inventory[id] = count end
	local upgrades = {}
	for id, level in pairs(profile.WeaponUpgrades or {}) do upgrades[id] = level end
	local achievements = {}
	for id, value in pairs(profile.AchievementClaims or {}) do if value == true then achievements[id] = true end end
	return {
		Coins = profile.Coins, XP = profile.XP, Floor = profile.Floor,
		DropperTier = profile.DropperTier, Bank = profile.Bank, BonusReadyAt = profile.BonusReadyAt,
		Rebirths = profile.Rebirths or 0, EquippedHero = profile.EquippedHero or "",
		CollectedTotal = profile.CollectedTotal or 0, EnemiesDefeated = profile.EnemiesDefeated or 0,
		DailyReadyAt = profile.DailyReadyAt or 0, QuestClaims = claims,
		Inventory = inventory, EquippedWeapon = profile.EquippedWeapon or "",
		WeaponUpgrades = upgrades,
		DailyLastClaimAt = profile.DailyLastClaimAt or 0, DailyStreak = profile.DailyStreak or 0,
		AchievementClaims = achievements, EquippedTitle = profile.EquippedTitle or "",
		TutorialStep = profile.TutorialStep or 1, CombatPractice = profile.CombatPractice == true, BossDefeated = profile.BossDefeated or 0,
		ObbyReadyAt = profile.ObbyReadyAt or 0, ObbyWins = profile.ObbyWins or 0, ObbyBestMilliseconds = profile.ObbyBestMilliseconds or 0,
	}
end

return Schema
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">ProfileService</string>
          <string name="Source"><![CDATA[-- DataStore + блокировка сессии: два сервера не перезаписывают один профиль.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Schema = require(script.Parent:WaitForChild("ProfileSchema"))

local ProfileService = {}
ProfileService.__index = ProfileService

function ProfileService.new(config)
	local self = setmetatable({
		config = config,
		records = {},
		closing = false,
		sessionId = game.JobId .. ":" .. HttpService:GenerateGUID(false),
		store = nil,
	}, ProfileService)
	if game.GameId ~= 0 then
		local ok, store = pcall(function()
			return DataStoreService:GetDataStore(config.Persistence.StoreName)
		end)
		if ok then self.store = store end
	end
		task.spawn(function()
			while not self.closing do
				task.wait(config.Persistence.SaveInterval)
				if self.closing then break end
				for player, record in pairs(self.records) do
					if record.ready and not record.saving and not record.releasing then
						task.spawn(function()
							if record.cancelled then self:Release(player) else self:Save(player) end
						end)
					end
				end
			end
		end)
	game:BindToClose(function()
		self.closing = true
		self.closingDeadline = os.clock() + 27
		local pending = 0
		for player in pairs(self.records) do
			pending += 1
			task.spawn(function()
				-- A short outage must not abandon an unsaved profile while the
				-- shutdown budget still permits another final attempt.
				repeat
					local released = self:Release(player)
					if released or not self.records[player] then break end
					if os.clock() + 0.5 >= self.closingDeadline then break end
					task.wait(0.5)
				until os.clock() >= self.closingDeadline
				pending -= 1
			end)
		end
		while pending > 0 and os.clock() < self.closingDeadline do task.wait(0.1) end
	end)
	return self
end

function ProfileService:IsClosing()
	return self.closing
end

function ProfileService:_update(key, callback)
	local lastError
	for attempt = 1, self.config.Persistence.MaxRetries do
		if self.closingDeadline and os.clock() >= self.closingDeadline then
			return false, "Время завершения сервера истекло"
		end
		local ok, result = pcall(function() return self.store:UpdateAsync(key, callback) end)
		if ok then return true, result end
		lastError = result
		if attempt < self.config.Persistence.MaxRetries then task.wait(0.8 * attempt) end
	end
	return false, lastError
end

function ProfileService:_sessionProfile(player, record)
	if record.cancelled then
		record.loading = false
		self.records[player] = nil
		return nil, "Игрок вышел во время загрузки"
	end
	record.profile = Schema.New(self.config)
	record.ready = true
	record.mode = "session"
	record.loading = false
	player:SetAttribute("PersistenceMode", "session")
	player:SetAttribute("PersistenceStatus", "session")
	return record.profile
end

function ProfileService:Load(player)
	if self.closing then return nil, "Сервер завершает работу" end
	if self.records[player] then return nil, "Профиль уже загружается" end
	local record = {
		key = "Player_" .. player.UserId,
		token = self.sessionId .. ":" .. player.UserId .. ":" .. HttpService:GenerateGUID(false),
		ready = false, loading = true, cancelled = false, saving = false, player = player,
	}
	self.records[player] = record
	player:SetAttribute("PersistenceStatus", "loading")
	if not self.store then
		if RunService:IsStudio() then return self:_sessionProfile(player, record) end
		self.records[player] = nil
		record.loading = false
		return nil, "Хранилище прогресса недоступно"
	end
	local reason
	local ok, stored = self:_update(record.key, function(old)
		reason = nil
		if record.cancelled then reason = "Игрок вышел"; return nil end
		if old ~= nil and (type(old) ~= "table" or old.Version ~= 1 or type(old.Data) ~= "table") then
			reason = "Неизвестный формат сохранения"; return nil
		end
		local now = os.time()
		local lock = old and old.Session
		if type(lock) == "table" and lock.Id ~= record.token
			and type(lock.ExpiresAt) == "number" and lock.ExpiresAt > now then
			reason = "Профиль ещё открыт на другом сервере. Попробуйте войти позже."; return nil
		end
		return {
			Version = 1, Data = Schema.Normalize(old and old.Data, self.config, now),
			Session = { Id = record.token, ExpiresAt = now + self.config.Persistence.LockSeconds },
			UpdatedAt = now,
		}
	end)
	if record.cancelled then
		-- Не сохраняем стартовые значения, если игрок вышел во время UpdateAsync.
		if ok and stored and stored.Session and stored.Session.Id == record.token then
			self:_update(record.key, function(old)
				if old and old.Session and old.Session.Id == record.token then
					old.Session = nil
					return old
				end
				return nil
			end)
		end
		self.records[player] = nil
		record.loading = false
		return nil, "Игрок вышел во время загрузки"
	end
	if not ok then
		if RunService:IsStudio() then return self:_sessionProfile(player, record) end
		self.records[player] = nil
		record.loading = false
		return nil, "Не удалось загрузить прогресс. Попробуйте войти позже."
	end
	if not stored or not stored.Session or stored.Session.Id ~= record.token then
		self.records[player] = nil
		record.loading = false
		return nil, reason or "Не удалось получить блокировку профиля"
	end
	record.profile = Schema.Normalize(stored.Data, self.config, os.time())
	record.ready = true
	record.mode = "saved"
	record.loading = false
	player:SetAttribute("PersistenceMode", "saved")
	player:SetAttribute("PersistenceStatus", "saved")
	return record.profile
end

function ProfileService:Get(player)
	local record = self.records[player]
	return if record and record.ready and not record.cancelled then record.profile else nil
end

function ProfileService:_persist(record, release)
	if record.mode == "session" then return true end
	local deadline = os.clock() + 12
	if self.closingDeadline then deadline = math.min(deadline, self.closingDeadline) end
	while record.saving and os.clock() < deadline do task.wait(0.1) end
	if record.saving then return false, "Предыдущее сохранение ещё выполняется" end
	if not record.ready or (record.cancelled and not release) then return false, "Профиль закрыт" end
	record.saving = true
	record.player:SetAttribute("PersistenceStatus", "saving")
	local snapshot = Schema.Copy(record.profile)
	local lostLock = false
	local ok, stored = self:_update(record.key, function(old)
		lostLock = false
		if not old or type(old) ~= "table" or old.Version ~= 1
			or type(old.Session) ~= "table" or old.Session.Id ~= record.token then
			lostLock = true; return nil
		end
		local now = os.time()
		return {
			Version = 1, Data = snapshot, UpdatedAt = now,
			Session = if release then nil else { Id = record.token, ExpiresAt = now + self.config.Persistence.LockSeconds },
		}
	end)
	record.saving = false
	if not ok or not stored then
		record.player:SetAttribute("PersistenceStatus", "error")
		if lostLock then
			record.ready = false
			record.player:SetAttribute("DataReady", false)
			record.player:Kick("Профиль открыт в другой сессии. Войдите в игру снова.")
		end
		warn("Не удалось сохранить профиль пользователя " .. record.player.UserId)
		return false, "Сохранение не подтверждено"
	end
	record.player:SetAttribute("PersistenceStatus", "saved")
	return true
end

function ProfileService:Save(player)
	local record = self.records[player]
	if not record or record.cancelled then return false, "Профиль не загружен" end
	return self:_persist(record, false)
end

function ProfileService:Release(player)
	local record = self.records[player]
	if not record then return true end
	record.cancelled = true
	player:SetAttribute("DataReady", false)
	-- Выход и BindToClose могут одновременно ждать одну загрузку/запись.
	local deadline = os.clock() + 25
	if self.closingDeadline then deadline = math.min(deadline, self.closingDeadline) end
	while (record.loading or record.releasing) and os.clock() < deadline do task.wait(0.1) end
	if record.loading or record.releasing then return false, "Загрузка или сохранение ещё выполняются" end
	if self.records[player] ~= record then return true end
	if not record.ready then self.records[player] = nil; return true end
	record.releasing = true
	local ok, message = self:_persist(record, true)
	record.releasing = false
	-- При сетевой ошибке сохраняем снимок в памяти для следующей попытки.
	if ok or not record.ready then self.records[player] = nil end
	return ok, message
end

return ProfileService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">ProgressionService</string>
          <string name="Source"><![CDATA[-- Ежедневная награда, задания, перерождения и безопасные действия общего меню.
local ProgressionService = {}
ProgressionService.__index = ProgressionService
local Journey = require(script.Parent:WaitForChild("PlayerJourney"))
local Economy = {}
ProgressionService.Economy = Economy

local function outcome(ok, text, kind)
	return { ok = ok, text = text, kind = kind or (ok and "success" or "error") }
end

function Economy.GetQuestProgress(config, profile, id)
	local definition
	for _, quest in ipairs(config.Quests) do
		if quest.Id == id then definition = quest; break end
	end
	if not definition then return 0, nil end
	return Journey.GetProgress(config, profile, definition.Field), definition
end

function Economy.ClaimQuest(config, profile, id)
	local progress, quest = Economy.GetQuestProgress(config, profile, id)
	if not quest then return outcome(false, "Такого задания нет.") end
	profile.QuestClaims = profile.QuestClaims or {}
	if profile.QuestClaims[id] == true then
		return outcome(false, "Награда за это задание уже получена.", "info")
	end
	if progress < quest.Target then
		return outcome(false, "Задание пока не выполнено: " .. math.min(progress, quest.Target) .. "/" .. quest.Target .. ".", "info")
	end
	if profile.Coins > config.MaxCoins - quest.RewardCoins then
		return outcome(false, "Потратьте монеты, чтобы в кошельке хватило места для награды.")
	end
	profile.Coins += quest.RewardCoins
	profile.XP = math.min(config.MaxXP, profile.XP + quest.RewardXP)
	profile.QuestClaims[id] = true
	return outcome(true, "Задание выполнено: +" .. quest.RewardCoins .. " монет и +" .. quest.RewardXP .. " XP!")
end

function Economy.ClaimDaily(config, profile, now)
	if now < (profile.DailyReadyAt or 0) then
		local minutes = math.max(1, math.ceil((profile.DailyReadyAt - now) / 60))
		return outcome(false, "Следующая ежедневная награда через " .. minutes .. " мин.", "info")
	end
	local reward, day = config.NextDailyReward(profile, now)
	if profile.Coins > config.MaxCoins - reward then
		return outcome(false, "Потратьте монеты, чтобы в кошельке хватило места для награды.")
	end
	profile.Coins += reward
	profile.DailyReadyAt = now + config.DailyCooldown
	profile.DailyLastClaimAt = now
	profile.DailyStreak = day
	return outcome(true, "День " .. day .. ": +" .. reward .. " монет! Следующая награда через 24 часа.")
end

function Economy.Rebirth(config, profile)
	local count = profile.Rebirths or 0
	if count >= config.MaxRebirths then
		return outcome(false, "Достигнуто максимальное число перерождений.", "info")
	end
	if profile.Floor < #config.Floors or profile.DropperTier < #config.DropperCosts then
		return outcome(false, "Для перерождения нужны три этажа и все улучшения генератора.")
	end
	local cost = config.RebirthCost(count)
	if profile.Coins < cost then
		return outcome(false, "Для перерождения нужно " .. cost .. " монет.")
	end
	-- Это один шаг без yield: клиент не выбирает число перерождений или цену.
	profile.Rebirths = count + 1
	profile.Coins = config.StartingCoins
	profile.Floor = 0
	profile.DropperTier = 0
	profile.Bank = 0
	profile.BonusReadyAt = 0
	return outcome(true, "Перерождение " .. profile.Rebirths .. "! Дом сброшен, доход навсегда увеличен.")
end

function ProgressionService.new(config, profiles, tycoon, notice, request, worldFolder, heroCombat)
	return setmetatable({
		config = config, profiles = profiles, tycoon = tycoon, notice = notice,
		request = request, worldFolder = worldFolder, heroCombat = heroCombat,
		players = game:GetService("Players"), connections = {}, lastActions = {}, started = false,
	}, ProgressionService)
end

function ProgressionService:_notify(player, response)
	if player.Parent == self.players then self.notice:FireClient(player, response) end
end

function ProgressionService:_context(player, prompt, needsPlot)
	if self.profiles:IsClosing() or player.Parent ~= self.players or player:GetAttribute("DataReady") ~= true then return nil end
	local state = self.tycoon:GetState(player)
	local profile = self.profiles:Get(player)
	if not state or state.leaving or not profile or state.profile ~= profile then return nil end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not (humanoid.Health > 0) or not root or not root:IsA("BasePart") then return nil end
	if prompt then
		local pad = prompt.Parent
		if not prompt.Enabled or not pad or not pad:IsA("BasePart") or not pad:IsDescendantOf(workspace) then return nil end
		local distance = (root.Position - pad.Position).Magnitude
		if distance ~= distance or distance > prompt.MaxActivationDistance + 2 then return nil end
	end
	local now = os.clock()
	if now - (self.lastActions[player] or -math.huge) < 0.4 then return nil end
	self.lastActions[player] = now
	if needsPlot and (not state.plot or state.plot:GetAttribute("OwnerUserId") ~= player.UserId) then
		self:_notify(player, { kind = "error", text = "Сначала займите собственный участок." })
		return nil
	end
	return { state = state, profile = profile, root = root }
end

function ProgressionService:_perform(player, context, command, id)
	local response
	if command == "ClaimQuest" then
		response = Economy.ClaimQuest(self.config, context.profile, id)
	elseif command == "ClaimAchievement" then
		response = Journey.ClaimAchievement(self.config, context.profile, id)
	elseif command == "EquipTitle" then
		response = Journey.EquipTitle(self.config, context.profile, id)
	elseif command == "ClaimDaily" then
		response = Economy.ClaimDaily(self.config, context.profile, os.time())
	elseif command == "Rebirth" then
		response = Economy.Rebirth(self.config, context.profile)
		if response.ok then
			self.tycoon:RebuildPlayer(player)
			if self.heroCombat then
				if self.heroCombat.Refresh then self.heroCombat:Refresh(player)
				elseif self.heroCombat.RefreshPlayer then self.heroCombat:RefreshPlayer(player) end
			end
		end
	elseif command == "EquipHero" then
		if not self.heroCombat then return end
		local ok, message = self.heroCombat:Equip(player, id)
		response = outcome(ok == true, message or (ok and "Герой выбран!" or "Этот герой пока недоступен."))
	elseif command == "EquipWeapon" then
		if not self.heroCombat or not self.heroCombat.EquipWeapon then return end
		local ok, message = self.heroCombat:EquipWeapon(player, id)
		response = outcome(ok == true, message or (ok and "Оружие выбрано!" or "Такого оружия нет в инвентаре."))
	elseif command == "UpgradeWeapon" then
		if not self.heroCombat then return end
		local ok, message = self.heroCombat:UpgradeWeapon(player, id)
		response = outcome(ok == true, message)
	else
		return
	end
	if response.ok then self.tycoon:SyncPlayer(player) end
	self:_notify(player, response)
end

function ProgressionService:_request(player, command, id)
	-- Данные клиента лишь выбирают известное действие; цены и награды серверные.
	local commands = { EquipHero = true, EquipWeapon = true, UpgradeWeapon = true, ClaimQuest = true, ClaimAchievement = true, EquipTitle = true, ClaimDaily = true, Rebirth = true }
	if type(command) ~= "string" or not commands[command] then return end
	if command ~= "ClaimDaily" and command ~= "Rebirth" and (type(id) ~= "string" or #id > 48) then return end
	local context = self:_context(player, nil, command == "Rebirth")
	if context then self:_perform(player, context, command, id) end
end

function ProgressionService:_claimAll(player, prompt)
	local context = self:_context(player, prompt, false)
	if not context then return end
	local completed = 0
	local eligible = 0
	for _, quest in ipairs(self.config.Quests) do
		local progress = Economy.GetQuestProgress(self.config, context.profile, quest.Id)
		if progress >= quest.Target and not (context.profile.QuestClaims or {})[quest.Id] then
			eligible += 1
			local response = Economy.ClaimQuest(self.config, context.profile, quest.Id)
			self:_notify(player, response)
			if response.ok then completed += 1 end
		end
	end
	if completed > 0 then self.tycoon:SyncPlayer(player)
	elseif eligible == 0 then self:_notify(player, { kind = "info", text = "Нет готовых наград. Собирайте монеты, стройте дом и побеждайте на арене!" }) end
end

function ProgressionService:_bindPrompt(container, partName, promptName, callback)
	local part = container:FindFirstChild(partName)
	assert(part and part:IsA("BasePart"), "Для прогрессии отсутствует " .. partName)
	local prompt = part:FindFirstChild(promptName)
	assert(prompt and prompt:IsA("ProximityPrompt"), "Для прогрессии отсутствует " .. promptName)
	table.insert(self.connections, prompt.Triggered:Connect(function(player) callback(player, prompt) end))
end

function ProgressionService:Start()
	assert(not self.started, "ProgressionService уже запущен")
	self.started = true
	table.insert(self.connections, self.request.OnServerEvent:Connect(function(player, command, id) self:_request(player, command, id) end))
	table.insert(self.connections, self.players.PlayerRemoving:Connect(function(player) self.lastActions[player] = nil end))
	self:_bindPrompt(self.worldFolder, "DailyStand", "ClaimDailyPrompt", function(player, prompt)
		local context = self:_context(player, prompt, false)
		if context then self:_perform(player, context, "ClaimDaily") end
	end)
	self:_bindPrompt(self.worldFolder, "QuestStand", "QuestPrompt", function(player, prompt) self:_claimAll(player, prompt) end)
	self:_bindPrompt(self.worldFolder, "RebirthStand", "RebirthPrompt", function(player, prompt)
		local context = self:_context(player, prompt, true)
		if context then self:_perform(player, context, "Rebirth") end
	end)
	self:_bindPrompt(self.worldFolder, "ArenaPortal", "EnterArenaPrompt", function(player, prompt)
		local context = self:_context(player, prompt, false)
		if context then
			player:SetAttribute("ArenaCombatOptIn", true)
			context.root.CFrame = CFrame.new(0, 5, -98)
			context.root.AssemblyLinearVelocity = Vector3.zero
			context.root.AssemblyAngularVelocity = Vector3.zero
			self:_notify(player, { kind = "info", text = "Арена: выберите героя и сражайтесь с бандитами и другими игроками!" })
		end
	end)
	self:_bindPrompt(self.worldFolder, "ReturnStand", "ReturnPrompt", function(player, prompt)
		local context = self:_context(player, prompt, false)
		if context then
			player:SetAttribute("ArenaCombatOptIn", false)
			context.root.CFrame = CFrame.new(0, 5, 14)
			context.root.AssemblyLinearVelocity = Vector3.zero
			context.root.AssemblyAngularVelocity = Vector3.zero
		end
	end)
	for _, plot in ipairs(self.tycoon.plots) do
		self:_bindPrompt(plot, "HeroPad", "HeroPrompt", function(player, prompt)
			local context = self:_context(player, prompt, true)
			if context and context.state.plot == plot then
				self:_notify(player, { kind = "heroes", text = "Выберите героя и отправляйтесь на арену!" })
			end
		end)
	end
end

function ProgressionService:Destroy()
	for _, connection in ipairs(self.connections) do connection:Disconnect() end
	table.clear(self.connections)
	table.clear(self.lastActions)
	self.started = false
end

return ProgressionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">TycoonService</string>
          <string name="Source"><![CDATA[-- Авторитетная экономика и владение участками. Клиент не задаёт цены и награды.
local TycoonService = {}
TycoonService.__index = TycoonService
local Journey = require(script.Parent:WaitForChild("PlayerJourney"))

-- Чистые функции экономики также используются в автоматических проверках.
local Economy = {}
TycoonService.Economy = Economy

local function result(ok, text, kind)
	return { ok = ok, text = text, kind = kind or (ok and "success" or "error") }
end

function Economy.Income(config, profile)
	return config.IncomeFor(profile.Floor, profile.DropperTier, profile.Rebirths or 0)
end

function Economy.Accrue(config, profile, ticks)
	local added = math.min(config.MaxBank - profile.Bank, Economy.Income(config, profile) * (ticks or 1))
	if added <= 0 then
		return 0
	end
	profile.Bank += added
	return added
end

function Economy.Collect(config, profile)
	local amount = math.min(profile.Bank, config.MaxCoins - profile.Coins)
	if amount <= 0 then
		if profile.Bank > 0 then
			return result(false, "Кошелёк заполнен. Потратьте монеты на улучшения.")
		end
		return result(false, "Копилка пока пуста. Сначала постройте этаж и немного подождите.", "info")
	end
	profile.Bank -= amount
	profile.Coins += amount
	profile.XP = math.min(config.MaxXP, profile.XP + amount)
	profile.CollectedTotal = math.min(config.MaxCoins, (profile.CollectedTotal or 0) + amount)
	return result(true, "+" .. amount .. " монет и +" .. amount .. " XP из копилки!")
end

function Economy.BuyFloor(config, profile)
	local nextFloor = profile.Floor + 1
	local floor = config.Floors[nextFloor]
	if not floor then
		return result(false, "Все три этажа уже построены!", "info")
	end
	if profile.Coins < floor.Cost then
		return result(false, "Для этажа " .. nextFloor .. " нужно " .. floor.Cost .. " монет.")
	end
	profile.Coins -= floor.Cost
	profile.Floor = nextFloor
	profile.XP = math.min(config.MaxXP, profile.XP + floor.XP)
	local suffix = nextFloor == 3 and " Доступны бонусный сундук и ускорение персонажа!" or " Генератор приносит больше монет."
	return result(true, "Этаж " .. nextFloor .. " построен!" .. suffix)
end

function Economy.BuyDropper(config, profile)
	if profile.Floor < 1 then
		return result(false, "Сначала постройте первый этаж.")
	end
	local nextTier = profile.DropperTier + 1
	local cost = config.DropperCosts[nextTier]
	if not cost then
		return result(false, "Генератор уже улучшен до максимума!", "info")
	end
	if profile.Coins < cost then
		return result(false, "Для улучшения генератора нужно " .. cost .. " монет.")
	end
	profile.Coins -= cost
	profile.DropperTier = nextTier
	return result(true, "Генератор улучшен! Доход: " .. Economy.Income(config, profile) .. " монет/сек.")
end

function Economy.ClaimBonus(config, profile, now)
	if profile.Floor < 3 then
		return result(false, "Бонусный сундук откроется на третьем этаже.")
	end
	if now < profile.BonusReadyAt then
		return result(false, "Следующий бонус через " .. math.ceil(profile.BonusReadyAt - now) .. " сек.", "info")
	end
	local amount = math.min(config.BonusCoins, config.MaxCoins - profile.Coins)
	if amount <= 0 then
		return result(false, "Кошелёк заполнен. Сначала потратьте монеты.")
	end
	profile.Coins += amount
	profile.XP = math.min(config.MaxXP, profile.XP + config.BonusXP)
	profile.BonusReadyAt = now + config.BonusCooldown
	return result(true, "Бонус третьего этажа: +" .. amount .. " монет и +" .. config.BonusXP .. " XP!")
end

function TycoonService.new(config, profiles, world, plots, notice)
	return setmetatable({
		config = config,
		profiles = profiles,
		world = world,
		plots = plots,
		notice = notice,
		players = game:GetService("Players"),
		httpService = game:GetService("HttpService"),
		runService = game:GetService("RunService"),
		states = {},
		owners = {},
		connections = {},
		started = false,
		elapsed = 0,
	}, TycoonService)
end

function TycoonService:_notify(player, text, kind)
	if player.Parent == self.players then
		self.notice:FireClient(player, { text = text, kind = kind or "info" })
	end
end

local function findPrompt(plot, partName, promptName)
	local part = plot:FindFirstChild(partName)
	assert(part and part:IsA("BasePart"), "На участке отсутствует " .. partName)
	local prompt = part:FindFirstChild(promptName)
	assert(prompt and prompt:IsA("ProximityPrompt"), "На участке отсутствует " .. promptName)
	return prompt
end

function TycoonService:_refreshPlot(plot)
	local state = self.owners[plot]
	local ready = state ~= nil and state.profile ~= nil and state.player:GetAttribute("DataReady") == true
	local profile = ready and state.profile or nil
	local prompts = self.promptSets[plot]
	prompts.claim.Enabled = state == nil
	prompts.floor.Enabled = ready and profile.Floor < #self.config.Floors
	prompts.dropper.Enabled = ready and profile.Floor > 0 and profile.DropperTier < #self.config.DropperCosts
	prompts.collect.Enabled = ready and profile.Floor > 0
	prompts.bonus.Enabled = ready and profile.Floor >= 3
	local heroPad = plot:FindFirstChild("HeroPad")
	local heroPrompt = heroPad and heroPad:FindFirstChild("HeroPrompt")
	if heroPrompt then
		heroPrompt.Enabled = ready and (profile.Floor >= 1 or (profile.Rebirths or 0) > 0)
	end
	plot:SetAttribute("OwnerReady", ready)
	plot:SetAttribute("Bank", profile and profile.Bank or 0)
	plot:SetAttribute("DropperTier", profile and profile.DropperTier or 0)
	plot:SetAttribute("Income", profile and Economy.Income(self.config, profile) or 0)
	if profile then
		local nextFloor = self.config.Floors[profile.Floor + 1]
		prompts.floor.ActionText = "Построить этаж " .. (profile.Floor + 1)
		prompts.floor.ObjectText = nextFloor and (nextFloor.Cost .. " монет") or "Дом достроен"
		local cost = self.config.DropperCosts[profile.DropperTier + 1]
		prompts.dropper.ActionText = "Улучшить генератор"
		prompts.dropper.ObjectText = cost and (cost .. " монет") or "Максимум"
		prompts.collect.ActionText = "Забрать монеты"
		prompts.collect.ObjectText = "Копилка: " .. profile.Bank
		prompts.bonus.ActionText = "Открыть бонус"
		prompts.bonus.ObjectText = "+" .. self.config.BonusCoins .. " монет"
	end
end

function TycoonService:_sync(state)
	local profile = state.profile
	local player = state.player
	if not profile or player.Parent ~= self.players then
		return
	end
	local journeyEvents = Journey.Advance(self.config, profile, state.plot ~= nil)
	state.coins.Value = profile.Coins
	state.level.Value = self.config.GetLevel(profile.XP)
	player:SetAttribute("Floor", profile.Floor)
	player:SetAttribute("DropperTier", profile.DropperTier)
	player:SetAttribute("Bank", profile.Bank)
	player:SetAttribute("Income", Economy.Income(self.config, profile))
	player:SetAttribute("XP", profile.XP)
	player:SetAttribute("BonusReadyAt", profile.BonusReadyAt)
	player:SetAttribute("Rebirths", profile.Rebirths or 0)
	player:SetAttribute("EquippedHero", profile.EquippedHero or "")
	player:SetAttribute("EquippedWeapon", profile.EquippedWeapon or "")
	player:SetAttribute("WeaponInventory", self.httpService:JSONEncode(profile.Inventory or {}))
	player:SetAttribute("WeaponUpgrades", self.httpService:JSONEncode(profile.WeaponUpgrades or {}))
	player:SetAttribute("CollectedTotal", profile.CollectedTotal or 0)
	player:SetAttribute("EnemiesDefeated", profile.EnemiesDefeated or 0)
	player:SetAttribute("DailyReadyAt", profile.DailyReadyAt or 0)
	player:SetAttribute("DailyStreak", profile.DailyStreak or 0)
	local dailyReward, nextDay = self.config.NextDailyReward(profile, os.time())
	player:SetAttribute("DailyNextReward", dailyReward)
	player:SetAttribute("DailyNextDay", nextDay)
	player:SetAttribute("TutorialStep", profile.TutorialStep or 1)
	player:SetAttribute("BossDefeated", profile.BossDefeated or 0)
	local title = self.config.GetAchievement(profile.EquippedTitle)
	local titleOwned = title and (profile.AchievementClaims or {})[title.Id] == true
	player:SetAttribute("EquippedTitle", titleOwned and title.Id or "")
	player:SetAttribute("DisplayTitle", titleOwned and title.TitleReward or "")
	player:SetAttribute("ObbyReadyAt", profile.ObbyReadyAt or 0)
	player:SetAttribute("ObbyWins", profile.ObbyWins or 0)
	player:SetAttribute("ObbyBestMilliseconds", profile.ObbyBestMilliseconds or 0)
	local claims = profile.QuestClaims or {}
	player:SetAttribute("QuestCollectorDone", claims.collector == true)
	player:SetAttribute("QuestBuilderDone", claims.builder == true)
	player:SetAttribute("QuestFighterDone", claims.fighter == true)
	for _, quest in ipairs(self.config.Quests) do
		player:SetAttribute("Quest_" .. quest.Id, claims[quest.Id] == true)
		player:SetAttribute("QuestProgress_" .. quest.Id, Journey.GetProgress(self.config, profile, quest.Field))
	end
	local achievementClaims = profile.AchievementClaims or {}
	local count = 0
	for _, achievement in ipairs(self.config.Achievements) do
		local progress = Journey.GetProgress(self.config, profile, achievement.Field)
		local claimed = achievementClaims[achievement.Id] == true
		if claimed then count += 1 end
		player:SetAttribute("Achievement_" .. achievement.Id, claimed)
		player:SetAttribute("AchievementProgress_" .. achievement.Id, progress)
		player:SetAttribute("AchievementReady_" .. achievement.Id, not claimed and progress >= achievement.Target)
	end
	player:SetAttribute("AchievementsClaimed", count)
	if state.plot then
		self:_refreshPlot(state.plot)
	end
	for _, event in ipairs(journeyEvents) do self:_notify(player, event.text, event.kind) end
end

function TycoonService:_rebuild(state)
	self.world.UpdatePlot(state.plot, state.profile.Floor, state.player.DisplayName)
	state.plot:SetAttribute("OwnerUserId", state.player.UserId)
	state.plot:SetAttribute("OwnerName", state.player.DisplayName)
	state.plot:SetAttribute("Floor", state.profile.Floor)
	self:_refreshPlot(state.plot)
end

function TycoonService:_applyPerks(state, character)
	-- WaitForChild имеет таймаут: удалённый персонаж не оставит вечную задачу.
	task.spawn(function()
		local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
		if not humanoid or not humanoid:IsA("Humanoid") then
			return
		end
		if self.states[state.player] ~= state or state.player.Character ~= character then
			return
		end
		if self.perkHandler and state.profile and state.player:GetAttribute("DataReady") == true then
			self.perkHandler(state.player, humanoid, state.profile)
			return
		end
		local unlocked = state.profile and (state.profile.Floor >= 3 or (state.profile.Rebirths or 0) > 0)
			and state.player:GetAttribute("DataReady") == true
		humanoid.WalkSpeed = unlocked and self.config.ThirdFloorWalkSpeed or self.config.DefaultWalkSpeed
	end)
end

-- Узкий серверный API для прогрессии и боя. Балансы остаются в общем профиле.
function TycoonService:GetState(player)
	return self.states[player]
end

function TycoonService:SyncPlayer(player)
	local state = self.states[player]
	if not state or not state.profile or state.leaving or self.profiles:IsClosing() or self.profiles:Get(player) ~= state.profile
		or not state.coins or not state.level then
		return false
	end
	self:_sync(state)
	return true
end

function TycoonService:RebuildPlayer(player)
	local state = self.states[player]
	if not state or not state.profile then
		return false
	end
	if state.plot then
		self:_rebuild(state)
	end
	self:_sync(state)
	if player.Character then
		self:_applyPerks(state, player.Character)
	end
	return true
end

function TycoonService:SetPerkHandler(callback)
	assert(type(callback) == "function", "PerkHandler должен быть функцией")
	self.perkHandler = callback
	for _, state in pairs(self.states) do
		if state.profile and state.player.Character then
			self:_applyPerks(state, state.player.Character)
		end
	end
end

local function getValue(parent, name, className)
	local value = parent:FindFirstChild(name)
	if value then
		assert(value:IsA(className), name .. " должен быть " .. className)
		return value
	end
	value = Instance.new(className)
	value.Name = name
	value.Parent = parent
	return value
end

function TycoonService:_addPlayer(player)
	if self.states[player] then
		return
	end
	local state = { player = player, profile = nil, plot = nil, lastActionAt = -math.huge, leaving = false }
	self.states[player] = state
	player:SetAttribute("DataReady", false)
	player:SetAttribute("PlotId", "")
	state.characterConnection = player.CharacterAdded:Connect(function(character)
		self:_applyPerks(state, character)
	end)
	if player.Character then
		self:_applyPerks(state, player.Character)
	end
	local profile, loadError = self.profiles:Load(player)
	if player.Parent ~= self.players or state.leaving or self.states[player] ~= state or self.profiles:IsClosing() then
		self.profiles:Release(player)
		return
	end
	if not profile then
		player:SetAttribute("PersistenceStatus", "error")
		warn("Tycoon: профиль игрока " .. player.UserId .. " недоступен: " .. tostring(loadError))
		self:_notify(player, "Прогресс не удалось загрузить. Переподключитесь; покупки временно отключены.", "error")
		return
	end
	state.profile = profile
	local leaderstats = getValue(player, "leaderstats", "Folder")
	state.coins = getValue(leaderstats, "Coins", "IntValue")
	state.level = getValue(leaderstats, "Level", "IntValue")
	self:_sync(state)
	player:SetAttribute("DataReady", true)
	if player.Character then
		self:_applyPerks(state, player.Character)
	end
	local sessionOnly = player:GetAttribute("PersistenceMode") == "session"
	local text = sessionOnly and "Тестовый режим: прогресс действует до выхода. Займите свободный участок!"
		or "Прогресс загружен. Займите свободный участок!"
	self:_notify(player, text, "info")
end

function TycoonService:_removePlayer(player)
	local state = self.states[player]
	if not state then
		self.profiles:Release(player)
		return
	end
	state.leaving = true
	player:SetAttribute("DataReady", false)
	if state.characterConnection then
		state.characterConnection:Disconnect()
	end
	if state.plot then
		local plot = state.plot
		self.owners[plot] = nil
		state.plot = nil
		plot:SetAttribute("OwnerUserId", 0)
		plot:SetAttribute("OwnerName", "")
		plot:SetAttribute("Floor", 0)
		self.world.UpdatePlot(plot, 0, "")
		self:_refreshPlot(plot)
	end
	self.states[player] = nil
	self.profiles:Release(player)
end

function TycoonService:_validate(player, plot, prompt, needsOwner)
	local state = self.states[player]
	if self.profiles:IsClosing() then
		return nil
	end
	if not state or not state.profile or state.leaving or player.Parent ~= self.players then
		return nil
	end
	if player:GetAttribute("DataReady") ~= true or self.profiles:Get(player) ~= state.profile then
		return nil
	end
	if not plot.Parent or not plot:IsDescendantOf(workspace) or not prompt.Enabled or not prompt:IsDescendantOf(plot) then
		return nil
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not (humanoid.Health > 0) or not root or not root:IsA("BasePart") then
		return nil
	end
	local pad = prompt.Parent
	if not pad or not pad:IsA("BasePart") then
		return nil
	end
	-- Triggered может быть вызван эксплойтом: сервер сам измеряет расстояние.
	local distance = (root.Position - pad.Position).Magnitude
	if distance ~= distance or distance > prompt.MaxActivationDistance + 2 then
		return nil
	end
	-- Сундук нужно открывать с третьего этажа, а не с площадки под ним.
	if prompt.Name == "BonusPrompt" and math.abs(root.Position.Y - pad.Position.Y) > 7 then
		return nil
	end
	local now = os.clock()
	if now - state.lastActionAt < self.config.ActionCooldown then
		return nil
	end
	state.lastActionAt = now
	if needsOwner and (state.plot ~= plot or self.owners[plot] ~= state or plot:GetAttribute("OwnerUserId") ~= player.UserId) then
		self:_notify(player, "Это чужой дом. Займите свой свободный участок.", "error")
		return nil
	end
	return state
end

function TycoonService:_claim(player, plot, prompt)
	local state = self:_validate(player, plot, prompt, false)
	if not state then
		return
	end
	if state.plot then
		self:_notify(player, "У вас уже есть участок. Улучшайте свой дом!", "info")
		return
	end
	if self.owners[plot] or plot:GetAttribute("OwnerUserId") ~= 0 then
		return
	end
	-- Захват и обновление не содержат yield: два игрока не займут один участок.
	self.owners[plot] = state
	state.plot = plot
	player:SetAttribute("PlotId", plot:GetAttribute("PlotId") or plot.Name)
	self:_rebuild(state)
	self:_sync(state)
	local text = state.profile.Floor == 0 and ("Участок ваш! Постройте первый этаж за " .. self.config.Floors[1].Cost .. " монет на синей площадке.")
		or "Участок ваш! Сохранённый дом восстановлен."
	self:_notify(player, text, "success")
end

function TycoonService:_action(player, plot, prompt, action)
	local state = self:_validate(player, plot, prompt, true)
	if not state then
		return
	end
	local outcome
	if action == "floor" then
		outcome = Economy.BuyFloor(self.config, state.profile)
	elseif action == "dropper" then
		outcome = Economy.BuyDropper(self.config, state.profile)
	elseif action == "collect" then
		outcome = Economy.Collect(self.config, state.profile)
	elseif action == "bonus" then
		outcome = Economy.ClaimBonus(self.config, state.profile, os.time())
	else
		return
	end
	if outcome.ok then
		if action == "floor" then
			self:_rebuild(state)
			if player.Character then
				self:_applyPerks(state, player.Character)
			end
		end
		self:_sync(state)
	end
	self:_notify(player, outcome.text, outcome.kind)
end

function TycoonService:Start()
	assert(not self.started, "TycoonService уже запущен")
	self.started = true
	self.promptSets = {}
	for _, plot in ipairs(self.plots) do
		local prompts = {
			claim = findPrompt(plot, "ClaimPad", "ClaimPrompt"),
			floor = findPrompt(plot, "UpgradePad", "FloorPrompt"),
			dropper = findPrompt(plot, "DropperUpgradePad", "DropperPrompt"),
			collect = findPrompt(plot, "Collector", "CollectPrompt"),
			bonus = findPrompt(plot, "BonusPad", "BonusPrompt"),
		}
		self.promptSets[plot] = prompts
		table.insert(self.connections, prompts.claim.Triggered:Connect(function(player)
			self:_claim(player, plot, prompts.claim)
		end))
		for _, action in ipairs({ "floor", "dropper", "collect", "bonus" }) do
			local actionName = action
			local actionPrompt = prompts[actionName]
			table.insert(self.connections, actionPrompt.Triggered:Connect(function(player)
				self:_action(player, plot, actionPrompt, actionName)
			end))
		end
		self:_refreshPlot(plot)
	end
	table.insert(self.connections, self.players.PlayerAdded:Connect(function(player)
		self:_addPlayer(player)
	end))
	table.insert(self.connections, self.players.PlayerRemoving:Connect(function(player)
		self:_removePlayer(player)
	end))
	table.insert(self.connections, self.runService.Heartbeat:Connect(function(delta)
		if self.profiles:IsClosing() then
			return
		end
		self.elapsed += delta
		local ticks = math.floor(self.elapsed / self.config.IncomeInterval)
		if ticks < 1 then
			return
		end
		self.elapsed -= ticks * self.config.IncomeInterval
		for _, state in pairs(self.states) do
			if state.profile and state.plot then
				if state.player:GetAttribute("DataReady") == true then
					Economy.Accrue(self.config, state.profile, ticks)
					self:_sync(state)
				else
					self:_refreshPlot(state.plot)
				end
			end
		end
	end))
	for _, player in ipairs(self.players:GetPlayers()) do
		task.spawn(function()
			self:_addPlayer(player)
		end)
	end
end

function TycoonService:Destroy()
	for _, connection in ipairs(self.connections) do
		connection:Disconnect()
	end
	table.clear(self.connections)
	for _, state in pairs(self.states) do
		if state.characterConnection then
			state.characterConnection:Disconnect()
		end
	end
	self.started = false
end

return TycoonService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">VisualStyle</string>
          <string name="Source"><![CDATA[-- Built-in material textures and drawn costume surfaces need no uploaded IDs.
local Style = {}
-- Warm stone, deep blue metal and mint accents are shared by the whole city.
Style.Palette = {
	Ink = Color3.fromRGB(34, 48, 66),
	Stone = Color3.fromRGB(232, 227, 211),
	Paper = Color3.fromRGB(247, 241, 224),
	Mint = Color3.fromRGB(92, 217, 191),
	Gold = Color3.fromRGB(246, 190, 76),
	Road = Color3.fromRGB(68, 79, 90),
	Grass = Color3.fromRGB(88, 144, 112),
	Wood = Color3.fromRGB(146, 105, 73),
	Window = Color3.fromRGB(130, 192, 211),
	Danger = Color3.fromRGB(225, 101, 84),
}
local function child(parent, className, name)
	local object = parent:FindFirstChild(name)
	if not object then
		object = Instance.new(className); object.Name = name; object.Parent = parent
	else assert(object:IsA(className), name .. " has an unexpected type") end
	return object
end
local function canvas(part, name, background)
	local gui = child(part, "SurfaceGui", name)
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(256, 256)
	gui.LightInfluence = 0.35; gui.AlwaysOnTop = false; gui.MaxDistance = 85
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	local root = child(gui, "Frame", "Canvas")
	root.Size = UDim2.new(1, 0, 1, 0); root.BackgroundColor3 = background
	root.BorderSizePixel = 0; root.ClipsDescendants = true
	return root
end
local function rectangle(root, name, x, y, width, height, color, rotation)
	local frame = child(root, "Frame", name)
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Position = UDim2.new(0, math.round(x), 0, math.round(y))
	frame.Size = UDim2.new(0, math.round(width), 0, math.round(height))
	frame.BackgroundColor3 = color; frame.BorderSizePixel = 0; frame.Rotation = rotation or 0
	-- Explicit layers preserve the drawing when Rojo sorts saved GUI children.
	frame.ZIndex = 2
	if string.find(name, "EyeOutline") or string.find(name, "EyeShadow") or name == "ReactorRim"
		or string.find(name, "Spider") or string.find(name, "LegA") or string.find(name, "LegB") then frame.ZIndex = 3 end
	if name == "Eye" or string.match(name, "^Eye%-?%d") or string.find(name, "EyeGlow") or name == "ReactorGlow" then frame.ZIndex = 4 end
	if string.find(name, "Pupil") or name == "ReactorCore" or name == "Teeth" then frame.ZIndex = 5 end
	return frame
end
local function circle(root, name, x, y, diameter, color)
	local frame = rectangle(root, name, x, y, diameter, diameter, color)
	child(frame, "UICorner", "Round").CornerRadius = UDim.new(1, 0)
	return frame
end
local function line(root, name, x1, y1, x2, y2, width, color)
	local dx, dy = x2 - x1, y2 - y1
	return rectangle(root, name, (x1 + x2) / 2, (y1 + y2) / 2,
		math.sqrt(dx * dx + dy * dy), width, color, math.deg(math.atan2(dy, dx)))
end
function Style.Sign(part, title, subtitle, accent, face)
	local root = canvas(part, "CitySign", Style.Palette.Ink)
	root.Parent.Face = face or Enum.NormalId.Front
	root.Parent.CanvasSize = Vector2.new(512, 192)
	root.Parent.LightInfluence = 0.15
	root.Parent.MaxDistance = 100
	rectangle(root, "Accent", 14, 96, 10, 166, accent or Style.Palette.Mint)
	local heading = child(root, "TextLabel", "Title")
	heading.Size = UDim2.new(1, -46, 0, 112)
	heading.Position = UDim2.new(0, 32, 0, 10)
	heading.BackgroundTransparency = 1
	heading.Font = Enum.Font.GothamBold
	heading.TextColor3 = Style.Palette.Paper
	heading.TextScaled = true
	heading.TextWrapped = true
	heading.Text = title
	heading.ZIndex = 3
	local detail = child(root, "TextLabel", "Subtitle")
	detail.Size = UDim2.new(1, -46, 0, 43)
	detail.Position = UDim2.new(0, 32, 0, 131)
	detail.BackgroundTransparency = 1
	detail.Font = Enum.Font.GothamBold
	detail.TextColor3 = accent or Style.Palette.Mint
	detail.TextScaled = true
	detail.TextWrapped = true
	detail.Text = subtitle or ""
	detail.ZIndex = 3
	return root.Parent
end
local BLACK = Color3.fromRGB(18, 22, 30)
local WHITE = Color3.fromRGB(245, 247, 239)
local RED = Color3.fromRGB(184, 36, 40)
local GOLD = Color3.fromRGB(223, 177, 74)
local BLUE = Color3.fromRGB(29, 64, 132)
local GREEN = Color3.fromRGB(100, 166, 67)
local CYAN = Color3.fromRGB(152, 242, 255)
local function fabric(root, base)
	-- Тонкое переплетение и швы рисуются в самом файле, без внешних asset ID.
	for index = 1, 15 do
		local stitch = rectangle(root, "WeaveV" .. index, index * 17, 128, 1, 256, base)
		stitch.BackgroundTransparency = 0.86
		local cross = rectangle(root, "WeaveH" .. index, 128, index * 17, 256, 1, base)
		cross.BackgroundTransparency = 0.86
	end
	for _, side in ipairs({-1, 1}) do
		local seam = line(root, "Seam" .. side, 128 + side * 99, 0, 128 + side * 77, 256, 2, WHITE)
		seam.BackgroundTransparency = 0.78
	end
end
function Style.Face(part, kind)
	local color = if kind == "spider" then RED elseif kind == "symbiote" then BLACK
		elseif kind == "iron" or kind == "iron_gold" then GOLD elseif kind == "hulk" then GREEN
		else Color3.fromRGB(218, 174, 137)
	local root = canvas(part, "CostumeFace", color)
	if kind == "spider" or kind == "symbiote" then fabric(root, WHITE) end
	if kind == "spider" or kind == "symbiote" then
		local web = if kind == "spider" then BLACK else Color3.fromRGB(78, 82, 94)
		for index = 1, 5 do
			line(root, "WebH" .. index, 0, index * 42, 256, index * 42, 2, web)
			line(root, "WebV" .. index, index * 42, 0, index * 42, 256, 2, web)
		end
		line(root, "WebDiagonalA", 0, 0, 256, 256, 3, web)
		line(root, "WebDiagonalB", 256, 0, 0, 256, 3, web)
		for _, side in ipairs({ -1, 1 }) do
			local x = 128 + side * 67
			rectangle(root, "EyeOutline" .. side, x, 109, 102, 66, BLACK, side * -20)
			rectangle(root, "Eye" .. side, x, 107, 82, 43, WHITE, side * -20)
		end
	elseif kind == "iron" or kind == "iron_gold" then
		rectangle(root, "HelmetTop", 128, 22, 256, 43, RED)
		for _, side in ipairs({ -1, 1 }) do
			rectangle(root, "HelmetSide" .. side, 128 + side * 116, 134, 33, 250, RED)
			rectangle(root, "EyeShadow" .. side, 128 + side * 59, 113, 85, 23, BLACK, side * -9)
			rectangle(root, "EyeGlow" .. side, 128 + side * 59, 110, 73, 12, CYAN, side * -9)
		end
		line(root, "NoseLeft", 113, 117, 107, 173, 4, Color3.fromRGB(165, 127, 49))
		line(root, "NoseRight", 143, 117, 149, 173, 4, Color3.fromRGB(165, 127, 49))
		rectangle(root, "Mouth", 128, 193, 72, 8, BLACK)
		rectangle(root, "Chin", 128, 240, 158, 33, RED)
	else
		rectangle(root, "Hair", 128, 17, 256, 49, if kind == "thor" then GOLD else BLACK)
		for _, side in ipairs({ -1, 1 }) do
			rectangle(root, "Brow" .. side, 128 + side * 58, 80, 79, 14, BLACK, side * 12)
			rectangle(root, "Eye" .. side, 128 + side * 56, 106, 53, 24, WHITE)
			circle(root, "Pupil" .. side, 128 + side * 51, 107, 15, BLACK)
		end
		rectangle(root, "Nose", 128, 141, 18, 28, if kind == "hulk" then Color3.fromRGB(65, 117, 41) else Color3.fromRGB(176, 124, 91))
		rectangle(root, "Mouth", 128, 191, 92, 21, BLACK)
		rectangle(root, "Teeth", 128, 184, 78, 10, WHITE)
		if kind == "thor" then rectangle(root, "Beard", 128, 224, 165, 65, Color3.fromRGB(155, 111, 47)) end
	end
end
function Style.Chest(part, kind)
	local color = if kind == "symbiote" then BLACK elseif kind == "hulk" then GREEN
		elseif kind == "thor" then Color3.fromRGB(54, 62, 72) elseif kind == "iron_gold" then GOLD else RED
	local root = canvas(part, "CostumeChest", color)
	if kind == "spider" or kind == "symbiote" or kind == "thor" then fabric(root, WHITE) end
	if kind == "spider" or kind == "symbiote" then
		local emblem = if kind == "symbiote" then WHITE else BLACK
		if kind == "spider" then
			rectangle(root, "SideLeft", 13, 128, 26, 256, BLUE)
			rectangle(root, "SideRight", 243, 128, 26, 256, BLUE)
			for index = 1, 5 do
				line(root, "FabricH" .. index, 26, index * 43, 230, index * 43, 2, BLACK)
				line(root, "FabricV" .. index, index * 42, 0, index * 42, 256, 2, BLACK)
			end
		end
		circle(root, "SpiderHead", 128, 85, 28, emblem)
		rectangle(root, "SpiderBody", 128, 122, 29, 63, emblem)
		for leg = 1, 4 do
			for _, side in ipairs({ -1, 1 }) do
				local id = leg .. "_" .. side; local y = 75 + leg * 17
				line(root, "LegA" .. id, 128, y, 128 + side * 53, y - 14, 7, emblem)
				line(root, "LegB" .. id, 128 + side * 53, y - 14, 128 + side * 72, y + (leg - 2) * 18, 7, emblem)
			end
		end
	elseif kind == "iron" or kind == "iron_gold" then
		for row = 1, 4 do
			for _, side in ipairs({-1, 1}) do
				local panel = rectangle(root, "ArmorSegment" .. row .. "_" .. side, 128 + side * 100, 36 + row * 43, 36, 35, Color3.fromRGB(132, 25, 30), side * 8)
				panel.BackgroundTransparency = 0.25
				circle(root, "Rivet" .. row .. "_" .. side, 128 + side * 99, 33 + row * 43, 5, GOLD)
			end
		end
		for _, side in ipairs({ -1, 1 }) do
			rectangle(root, "ChestPlate" .. side, 128 + side * 86, 69, 71, 101, GOLD, side * 12)
			line(root, "Panel" .. side, 128 + side * 104, 162, 128 + side * 76, 232, 8, BLACK)
		end
		circle(root, "ReactorRim", 128, 104, 88, BLACK)
		circle(root, "ReactorGlow", 128, 104, 68, CYAN)
		circle(root, "ReactorCore", 128, 104, 44, WHITE)
		for row = 1, 3 do rectangle(root, "Abs" .. row, 128, 157 + row * 24, 97, 13, GOLD) end
	elseif kind == "hulk" then
		local shadow = Color3.fromRGB(70, 129, 44)
		line(root, "PecsLeft", 21, 70, 113, 101, 7, shadow)
		line(root, "PecsRight", 235, 70, 143, 101, 7, shadow)
		line(root, "Center", 128, 74, 128, 239, 6, shadow)
		for row = 1, 3 do line(root, "Abs" .. row, 83, 132 + row * 30, 173, 132 + row * 30, 5, shadow) end
	else
		for row = 1, 3 do
			for _, side in ipairs({ -1, 1 }) do
				circle(root, "ArmorDisc" .. row .. side, 128 + side * 68, 40 + row * 47, 42, Color3.fromRGB(163, 177, 194))
			end
		end
		rectangle(root, "Belt", 128, 227, 256, 28, GOLD)
	end
end
function Style.Material(object)
	local name = object.Name
	if string.match(name, "^LeftWall%d+$") or string.match(name, "^RightWall%d+$") or string.find(name, "FrontLeft") or string.find(name, "FrontRight")
		or string.find(name, "RearLeft") or string.find(name, "RearRight") or string.find(name, "RearMiddle") then
		object.Material = Enum.Material.Brick
	elseif string.match(name, "Path$") or string.match(name, "^HouseRoad") or string.match(name, "^HouseEntry") then object.Material = Enum.Material.Asphalt
	elseif name == "Plaza" or name == "FrontWalk" or name == "Foundation" or name == "Pedestal" then
		object.Material = Enum.Material.Cobblestone
	elseif name == "MachineBack" or name == "MachineBase" or name == "MachineTop" or name == "Crate" then
		object.Material = Enum.Material.DiamondPlate
	end
end
return Style
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="37">
      <Properties>
        <string name="Name">Stage1Map</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- A spacious campus shared by the six spacious house plots, gallery and arena.
-- All geometry is anchored and uses simple Parts; no asset downloads needed.
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local Style = require(script.Parent:WaitForChild("Modules"):WaitForChild("VisualStyle"))

local map = Workspace:FindFirstChild("SimulatorMap")
if map then
	assert(map:IsA("Folder"), "SimulatorMap должен быть Folder")
else
	map = Instance.new("Folder")
	map.Name = "SimulatorMap"
	map.Parent = Workspace
end

local function makePart(name, size, position, color, material, canCollide)
	local object = map:FindFirstChild(name)
	if object then
		assert(object.ClassName == "Part", name .. " должен быть Part")
	else
		object = Instance.new("Part")
		object.Name = name
		object.Parent = map
	end
	object.Anchored = true
	object.CanCollide = canCollide ~= false
	object.CanTouch = false
	object.CanQuery = object.CanCollide
	object.Size = size
	object.CFrame = CFrame.new(position)
	object.Color = color
	object.Material = material
	Style.Material(object)
	object.Shape = Enum.PartType.Block
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	return object
end

local grass = Style.Palette.Grass
local paving = Style.Palette.Stone
local cyan = Style.Palette.Mint
local navy = Style.Palette.Ink
local wood = Style.Palette.Wood
local asphalt = Style.Palette.Road

makePart("Ground", Vector3.new(480, 2, 480), Vector3.new(0, -1, 0), grass, Enum.Material.Grass)
makePart("Plaza", Vector3.new(72, 0.3, 72), Vector3.new(0, 0.15, 0), paving, Enum.Material.Concrete)

-- Roads stop at the plaza and continue through the public campus activities.
for _, side in ipairs({ -1, 1 }) do
	local suffix = if side < 0 then "North" else "South"
	makePart(suffix .. "Sidewalk", Vector3.new(20, 0.18, 178), Vector3.new(0, 0.09, side * 125), paving, Enum.Material.Concrete)
	makePart(suffix .. "Path", Vector3.new(12, 0.2, 178), Vector3.new(0, 0.1, side * 125), asphalt, Enum.Material.Asphalt)
	for lane = 1, 8 do
		makePart(suffix .. "Lane" .. lane, Vector3.new(0.22, 0.025, 6), Vector3.new(0, 0.215, side * (46 + lane * 20)), Style.Palette.Paper, Enum.Material.SmoothPlastic, false)
	end
end
makePart("WestPath", Vector3.new(66, 0.2, 12), Vector3.new(-69, 0.1, 0), paving, Enum.Material.Concrete)
makePart("EastPath", Vector3.new(66, 0.2, 12), Vector3.new(69, 0.1, 0), paving, Enum.Material.Concrete)

-- The crosswalks frame the safe plaza without creating a physical obstacle.
for _, side in ipairs({ -1, 1 }) do
	for stripe = 1, 6 do
		makePart("PlazaCrosswalk" .. side .. "_" .. stripe, Vector3.new(9.5, 0.025, 0.9), Vector3.new(0, 0.22, side * (37 + stripe * 1.6)), paving, Enum.Material.SmoothPlastic, false)
	end
end

for _, side in ipairs({ -1, 1 }) do
	local suffix = if side < 0 then "West" else "East"
	makePart("PlazaTrim" .. suffix, Vector3.new(0.45, 0.05, 72), Vector3.new(side * 35.5, 0.325, 0), cyan, Enum.Material.Neon, false)
	makePart("PlazaTrim" .. (if side < 0 then "North" else "South"), Vector3.new(72, 0.05, 0.45), Vector3.new(0, 0.325, side * 35.5), cyan, Enum.Material.Neon, false)
end

local rows = { -156, 0, 156 }
for rowIndex, rowZ in ipairs(rows) do
	for _, side in ipairs({ -1, 1 }) do
		local suffix = (if side < 0 then "West" else "East") .. rowIndex
		makePart("HouseSidewalk" .. suffix, Vector3.new(148, 0.18, 16), Vector3.new(side * 74, 0.09, rowZ - 39), paving, Enum.Material.Concrete)
		makePart("HouseRoad" .. suffix, Vector3.new(148, 0.2, 8), Vector3.new(side * 74, 0.1, rowZ - 39), asphalt, Enum.Material.Asphalt)
		makePart("HouseEntry" .. suffix, Vector3.new(12, 0.2, 9), Vector3.new(side * 148, 0.1, rowZ - 33), paving, Enum.Material.Concrete)
		for stripe = 1, 6 do
			makePart("RoadMark" .. suffix .. stripe, Vector3.new(8, 0.025, 0.2), Vector3.new(side * (14 + stripe * 19), 0.215, rowZ - 39), Style.Palette.Paper, Enum.Material.SmoothPlastic, false)
		end
		for _, edge in ipairs({ -1, 1 }) do
			makePart("RoadCurb" .. suffix .. edge, Vector3.new(142, 0.24, 0.35), Vector3.new(side * 77, 0.17, rowZ - 39 + edge * 4.35), paving, Enum.Material.Concrete, false)
		end
		makePart("RoadLamp" .. suffix, Vector3.new(0.65, 8, 0.65), Vector3.new(side * 110, 4, rowZ - 45), navy, Enum.Material.Metal)
		local glow = makePart("RoadLampGlow" .. suffix, Vector3.new(1.6, 1.6, 1.6), Vector3.new(side * 110, 8.2, rowZ - 45), cyan, Enum.Material.Neon, false)
		glow.Shape = Enum.PartType.Ball
		local sign = makePart("BlockSign" .. suffix, Vector3.new(7, 2, 0.3), Vector3.new(side * 110, 6.1, rowZ - 45.6), navy, Enum.Material.Metal, false)
		Style.Sign(sign, "КВАРТАЛ " .. rowIndex, "ДОМА " .. (rowIndex * 2 - 1) .. "–" .. rowIndex * 2, cyan)
	end
end

-- Low walls mark the edge without obstructing any plot or public walkway.
local border = Color3.fromRGB(109, 132, 139)
makePart("NorthBorder", Vector3.new(480, 5, 2), Vector3.new(0, 2.5, -239), border, Enum.Material.Slate)
makePart("SouthBorder", Vector3.new(480, 5, 2), Vector3.new(0, 2.5, 239), border, Enum.Material.Slate)
makePart("WestBorder", Vector3.new(2, 5, 476), Vector3.new(-239, 2.5, 0), border, Enum.Material.Slate)
makePart("EastBorder", Vector3.new(2, 5, 476), Vector3.new(239, 2.5, 0), border, Enum.Material.Slate)

local treePositions = {}
for _, side in ipairs({ -1, 1 }) do
	for _, z in ipairs({ -210, -140, -70, 0, 70, 140, 210 }) do
		table.insert(treePositions, Vector3.new(side * 215, 0, z))
	end
	for _, x in ipairs({ -150, -80, 80, 150 }) do
		table.insert(treePositions, Vector3.new(x, 0, side * 218))
	end
end
for index, position in ipairs(treePositions) do
	makePart("TreeTrunk" .. index, Vector3.new(2.5, 10, 2.5), position + Vector3.new(0, 5, 0), wood, Enum.Material.Wood)
	local leaves = makePart("TreeLeaves" .. index, Vector3.new(15, 15, 15), position + Vector3.new(0, 13, 0), Color3.fromRGB(56, 119 + index % 5 * 8, 91), Enum.Material.SmoothPlastic, false)
	leaves.Shape = Enum.PartType.Ball
	local crown = makePart("TreeCrown" .. index, Vector3.new(9, 8, 9), position + Vector3.new(0, 19, 0), Color3.fromRGB(75, 143 + index % 3 * 6, 106), Enum.Material.SmoothPlastic, false)
	crown.Shape = Enum.PartType.Ball
end

-- A compact plaza medallion makes the spawn recognizable from any approach.
makePart("SpawnFoundation", Vector3.new(12, 0.2, 12), Vector3.new(0, 0.4, 6), navy, Enum.Material.Slate)
for _, side in ipairs({ -1, 1 }) do
	makePart("SpawnTrimX" .. side, Vector3.new(0.2, 0.06, 11), Vector3.new(side * 5.2, 0.55, 6), cyan, Enum.Material.Neon, false)
	makePart("SpawnTrimZ" .. side, Vector3.new(11, 0.06, 0.2), Vector3.new(0, 0.55, 6 + side * 5.2), cyan, Enum.Material.Neon, false)
end
for index, position in ipairs({ Vector3.new(-9, 0, 12), Vector3.new(9, 0, 12) }) do
	makePart("SpawnPlanter" .. index, Vector3.new(3, 0.9, 3), position + Vector3.new(0, 0.6, 0), paving, Enum.Material.Concrete)
	local shrub = makePart("SpawnShrub" .. index, Vector3.new(2.8, 2, 2.8), position + Vector3.new(0, 1.5, 0), grass, Enum.Material.Grass, false)
	shrub.Shape = Enum.PartType.Ball
end

for index, position in ipairs({
	Vector3.new(-214, 2, -105), Vector3.new(214, 2, -105),
	Vector3.new(-214, 2, 105), Vector3.new(214, 2, 105),
	Vector3.new(-110, 2, -220), Vector3.new(110, 2, -220),
	Vector3.new(-110, 2, 220), Vector3.new(110, 2, 220),
}) do
	local rock = makePart("Rock" .. index, Vector3.new(9, 4, 7), position, Color3.fromRGB(127, 145, 158), Enum.Material.Slate)
	rock.Shape = Enum.PartType.Ball
end

for index, position in ipairs({
	Vector3.new(-32, 0, -32), Vector3.new(32, 0, -32),
	Vector3.new(-32, 0, 32), Vector3.new(32, 0, 32),
}) do
	makePart("PlazaLamp" .. index, Vector3.new(0.8, 10, 0.8), position + Vector3.new(0, 5.3, 0), navy, Enum.Material.Metal)
	makePart("PlazaLampCap" .. index, Vector3.new(2.5, 0.5, 2.5), position + Vector3.new(0, 10.5, 0), cyan, Enum.Material.Neon, false)
end

-- A small park landmark stays outside roads, plot entrances and arena bounds.
-- Water is static, translucent geometry; no server loop or particle workload.
local fountainOrigin = Vector3.new(-75, 0, -72)
makePart("ParkFountainBase", Vector3.new(12, 0.45, 10), fountainOrigin + Vector3.new(0, 0.25, 0), paving, Enum.Material.Cobblestone)
for _, side in ipairs({ -1, 1 }) do
	makePart("ParkFountainRimX" .. side, Vector3.new(0.65, 0.9, 9), fountainOrigin + Vector3.new(side * 5.1, 0.9, 0), paving, Enum.Material.Concrete)
	makePart("ParkFountainRimZ" .. side, Vector3.new(10.8, 0.9, 0.65), fountainOrigin + Vector3.new(0, 0.9, side * 4.2), paving, Enum.Material.Concrete)
end
local parkWater = makePart("ParkFountainWater", Vector3.new(9.5, 0.12, 7.6), fountainOrigin + Vector3.new(0, 0.95, 0), Style.Palette.Window, Enum.Material.Glass, false)
parkWater.Transparency = 0.35
makePart("ParkFountainSpout", Vector3.new(1, 2.3, 1), fountainOrigin + Vector3.new(0, 1.65, 0), paving, Enum.Material.Slate, false)
local parkJet = makePart("ParkFountainJet", Vector3.new(0.35, 1.8, 0.35), fountainOrigin + Vector3.new(0, 3.2, 0), cyan, Enum.Material.Glass, false)
parkJet.Transparency = 0.52
local parkSplash = makePart("ParkFountainSplash", Vector3.new(2.4, 0.28, 2.4), fountainOrigin + Vector3.new(0, 2.65, 0), Style.Palette.Window, Enum.Material.Glass, false)
parkSplash.Shape = Enum.PartType.Ball
parkSplash.Transparency = 0.6

-- Reuse an existing singleton spawn. Duplicate spawns require a deliberate
-- Studio decision, rather than silently moving or deleting someone else's.
local spawns = {}
for _, object in ipairs(Workspace:GetDescendants()) do
	if object:IsA("SpawnLocation") then
		table.insert(spawns, object)
	end
end
assert(#spawns <= 1, "Найдено несколько SpawnLocation. Оставьте одну стартовую точку.")
local spawn = spawns[1] or Instance.new("SpawnLocation")
spawn.Name = "StartSpawn"
spawn.Size = Vector3.new(7, 0.8, 7)
spawn.CFrame = CFrame.new(0, 0.7, 6)
spawn.Anchored = true
spawn.CanCollide = true
spawn.Neutral = true
spawn.Enabled = true
spawn.AllowTeamChangeOnTouch = false
spawn.Duration = 0
spawn.Color = cyan
spawn.Material = Enum.Material.SmoothPlastic
spawn.TopSurface = Enum.SurfaceType.Smooth
spawn.BottomSurface = Enum.SurfaceType.Smooth
spawn.Parent = map

Lighting.ClockTime = 14
Lighting.Brightness = 2.35
Lighting.GlobalShadows = true
Lighting.Ambient = Color3.fromRGB(118, 123, 135)
Lighting.OutdoorAmbient = Color3.fromRGB(163, 171, 177)

-- Soft daylight and restrained neon bloom keep the city bright and readable.
local function lightingEffect(name, className)
	local effect = Lighting:FindFirstChild(name)
	if effect then
		assert(effect:IsA(className), name .. " имеет неверный тип")
	else
		effect = Instance.new(className)
		effect.Name = name
		effect.Parent = Lighting
	end
	return effect
end
local sky = lightingEffect("HeroCitySky", "Sky")
-- These six textures ship with the Roblox client; no uploaded asset IDs.
sky.SkyboxBk = "rbxasset://textures/sky/sky512_bk.tex"
sky.SkyboxDn = "rbxasset://textures/sky/sky512_dn.tex"
sky.SkyboxFt = "rbxasset://textures/sky/sky512_ft.tex"
sky.SkyboxLf = "rbxasset://textures/sky/sky512_lf.tex"
sky.SkyboxRt = "rbxasset://textures/sky/sky512_rt.tex"
sky.SkyboxUp = "rbxasset://textures/sky/sky512_up.tex"
sky.CelestialBodiesShown = true
sky.StarCount = 750
sky.SunAngularSize = 14
sky.MoonAngularSize = 9
local atmosphere = lightingEffect("HeroCityAtmosphere", "Atmosphere")
atmosphere.Density = 0.18
atmosphere.Offset = 0.05
atmosphere.Color = Color3.fromRGB(188, 214, 238)
atmosphere.Decay = Color3.fromRGB(107, 123, 151)
atmosphere.Glare = 0.1
atmosphere.Haze = 0.6
local bloom = lightingEffect("HeroCityBloom", "BloomEffect")
bloom.Intensity = 0.18
bloom.Size = 24
bloom.Threshold = 2
local color = lightingEffect("HeroCityColor", "ColorCorrectionEffect")
color.Brightness = 0.01
color.Contrast = 0.03
color.Saturation = 0.1
color.TintColor = Color3.fromRGB(255, 250, 242)

map:SetAttribute("MapReady", true)
print("Кампус готов: большая карта, площадь, дороги к шести домам и StartSpawn.")
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="38">
      <Properties>
        <string name="Name">TycoonServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Small bootstrap: server-owned construction, persistence, progression and heroes.
local ReplicatedStorage=game:GetService('ReplicatedStorage')
local Workspace=game:GetService('Workspace')
local config=require(ReplicatedStorage:WaitForChild('Shared'):WaitForChild('TycoonConfig'))
local modules=script.Parent:WaitForChild('Modules')
local function module(name) return require(modules:WaitForChild(name)) end
local ProfileService=module('ProfileService')
local HouseWorld=module('HouseWorld')
local HeroWorld=module('HeroWorld')
local ObbyWorld=module('ObbyWorld')
local ObbyService=module('ObbyService')
local TycoonService=module('TycoonService')
local ProgressionService=module('ProgressionService')
local HeroCombatService=module('HeroCombatService')
local CostumePadService=module('CostumePadService')
local LootDropService=module('LootDropService')
local MonetizationService=module('MonetizationService')
local AdminService=module('AdminService')
local remotes=ReplicatedStorage:WaitForChild('TycoonRemotes')
local map=Workspace:WaitForChild('SimulatorMap')
while map.Parent and map:GetAttribute('MapReady')~=true do map:GetAttributeChangedSignal('MapReady'):Wait() end
local plots=HouseWorld.BuildPlots(Workspace,config)
local campus=HeroWorld.Build(Workspace,config)
local obby=ObbyWorld.Build(Workspace,config)
local profiles=ProfileService.new(config)
local tycoon=TycoonService.new(config,profiles,HouseWorld,plots,remotes.Notice)
local heroes=HeroCombatService.new(config,profiles,tycoon,remotes.Notice,remotes.SkillRequest,remotes.Effect)
heroes:Start()
CostumePadService.new(config,heroes,campus):Start()
tycoon:Start()
ObbyService.new(config,profiles,tycoon,remotes.Notice,remotes.ObbyRequest,obby,heroes):Start()
LootDropService.new(config,profiles,tycoon,remotes.Notice,remotes.LootResult):Start()
ProgressionService.new(config,profiles,tycoon,remotes.Notice,remotes.ActionRequest,campus,heroes):Start()
MonetizationService.new(config,profiles,remotes.Notice,remotes.MonetizationRequest):Start()
AdminService.new(config,profiles,tycoon,remotes.Notice,remotes.AdminRequest):Start()
print(config.GameTitle..' готов: шесть больших домов, площадки костюмов, агрессивные бандиты, прокачка оружия и обби.')
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterGui" referent="39">
