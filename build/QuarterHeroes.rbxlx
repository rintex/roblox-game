  <Item class="StarterPlayer" referent="41">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="42">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="43">
        <Properties>
          <string name="Name">AdminPanel</string>
          <string name="Source"><![CDATA[-- The panel only requests actions. Admin rights and rewards are checked on the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Theme = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("UITheme"))
local scope = Theme.Scope()

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local request = ReplicatedStorage:WaitForChild("TycoonRemotes"):WaitForChild("AdminRequest")
local old = playerGui:FindFirstChild("TycoonAdminHUD")
if old then
	local stop = old:FindFirstChild("Stop")
	if stop and stop:IsA("BindableEvent") then stop:Fire() end
	old:Destroy()
end

local gui = Instance.new("ScreenGui")
gui.Name = "TycoonAdminHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.DisplayOrder = 15
gui.Enabled = player:GetAttribute("IsGameAdmin") == true
gui.Parent = playerGui
local stop = Instance.new("BindableEvent")
stop.Name = "Stop"
stop.Parent = gui

local alive = true
local connections = {}
local function connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(connections, connection)
	return connection
end

local panelColor = Theme.Colors.panel
local cardColor = Theme.Colors.card
local textColor = Theme.Colors.text
local accent = Theme.Colors.gold
local muted = Theme.Colors.muted
local function make(className, properties, parent)
	local object = Instance.new(className)
	for name, value in pairs(properties) do object[name] = value end
	object.Parent = parent
 if className == "TextButton" then Theme.DecorateButton(scope, object, accent) end
	return object
end
local function corner(object, radius)
	make("UICorner", { CornerRadius = UDim.new(0, radius) }, object)
end
local function text(parent, name, value, size, position, fontSize, color)
	return make("TextLabel", {
		Name = name, BackgroundTransparency = 1, Text = value, Size = size, Position = position,
		TextColor3 = color or textColor, TextSize = fontSize, Font = Enum.Font.GothamMedium,
		TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
	}, parent)
end

local toggle = make("TextButton", {
	Name = "AdminButton", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -204),
	Size = UDim2.fromOffset(110, 42), BackgroundColor3 = panelColor, BorderSizePixel = 0,
	Text = "Админ", TextColor3 = accent, TextSize = 15, Font = Enum.Font.GothamBold,
	Visible = false,
}, gui)
corner(toggle, 12)
local backdrop = make("TextButton", {
	Name = "Backdrop", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(6, 11, 22),
	BackgroundTransparency = 0.25, Text = "", AutoButtonColor = false, Visible = false, ZIndex = 2,
}, gui)
local panel = make("Frame", {
	Name = "OwnerPanel", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(440, 520), BackgroundColor3 = panelColor, BorderSizePixel = 0,
	Visible = false, ZIndex = 3,
}, gui)
Theme.Surface(panel, 18, accent)
text(panel, "Title", "Панель владельца", UDim2.new(1, -84, 0, 34), UDim2.fromOffset(18, 10), 21, accent)
text(panel, "Subtitle", "Действия применяются только к твоему персонажу.", UDim2.new(1, -36, 0, 38), UDim2.fromOffset(18, 46), 12, muted)
local close = make("TextButton", {
	Name = "Close", Position = UDim2.new(1, -56, 0, 8), Size = UDim2.fromOffset(44, 44),
	BackgroundColor3 = cardColor, BorderSizePixel = 0, Text = "×", TextSize = 26,
	Font = Enum.Font.GothamBold, TextColor3 = textColor,
}, panel)
corner(close, 10)

local list = make("ScrollingFrame", {
	Name = "Actions", Position = UDim2.fromOffset(18, 98), Size = UDim2.new(1, -36, 1, -138),
	BackgroundTransparency = 1, BorderSizePixel = 0, CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4,
	ScrollBarImageColor3 = accent, ScrollingDirection = Enum.ScrollingDirection.Y,
}, panel)
make("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, list)
local status = text(panel, "Status", "Действия доступны только владельцу игры.", UDim2.new(1, -36, 0, 28), UDim2.new(0, 18, 1, -34), 11, muted)

local lastSent = 0
local actions = {
	{ "GrantCoins", "+25 000 монет себе" },
	{ "Heal", "Восстановить здоровье" },
	{ "TeleportHome", "Вернуться на свой участок" },
}
if RunService:IsStudio() then
	table.insert(actions, { "PreviewVIP", "Studio: пример VIP-титула" })
	table.insert(actions, { "PreviewNeon", "Studio: пример неонового оружия" })
end
for index, action in ipairs(actions) do
	local button = make("TextButton", {
		Name = action[1], Size = UDim2.new(1, -8, 0, 46), LayoutOrder = index,
		BackgroundColor3 = cardColor, BorderSizePixel = 0, Text = action[2],
		TextColor3 = textColor, TextSize = 14, Font = Enum.Font.GothamBold,
	}, list)
	corner(button, 10)
	connect(button.Activated, function()
		if not alive or player:GetAttribute("IsGameAdmin") ~= true then return end
		if player:GetAttribute("DataReady") ~= true then
			status.Text = "Дождись загрузки прогресса."
			return
		end
		if os.clock() - lastSent < 0.5 then return end
		lastSent = os.clock()
		request:FireServer(action[1])
		status.Text = "Запрос отправлен. Результат появится в уведомлении."
	end)
end

local setup = make("Frame", {
	Name = "GamePassSetup", LayoutOrder = 10, Size = UDim2.new(1, -8, 0, 170),
	BackgroundColor3 = cardColor, BorderSizePixel = 0,
}, list)
corner(setup, 12)
text(setup, "Heading", "Как подключить пропуска", UDim2.new(1, -24, 0, 28), UDim2.fromOffset(12, 8), 15, accent)
text(setup, "Instructions", "Пропуска создаются в Creator Hub после публикации игры.\ncreate.roblox.com\n\nСоздай свои пропуска VIP и Neon, затем укажи их ID в ReplicatedStorage → Shared → TycoonConfig → GamePasses. Без настоящих ID покупки скрыты.", UDim2.new(1, -24, 1, -44), UDim2.fromOffset(12, 38), 12, textColor)

local modal = Theme.RegisterModal("Admin", panel, backdrop, nil, close)
local function setOpen(open)
 local allowed = player:GetAttribute("IsGameAdmin") == true and player:GetAttribute("ObbyActive") ~= true
 if open and allowed then modal:Open() else modal:Close() end
end
local function updateToggle()
 -- Access lives in Settings so the owner has no extra floating control.
 toggle.Visible = false
 if player:GetAttribute("ObbyActive") == true then modal:Close(true) end
end
connect(playerGui:GetAttributeChangedSignal("QuarterModalOpen"), updateToggle)
connect(player:GetAttributeChangedSignal("ObbyActive"), updateToggle)
updateToggle()
connect(toggle.Activated, function() setOpen(not modal.open) end)
connect(close.Activated, function() setOpen(false) end)
connect(backdrop.Activated, function() setOpen(false) end)
connect(player:GetAttributeChangedSignal("IsGameAdmin"), function()
	gui.Enabled = player:GetAttribute("IsGameAdmin") == true
	if not gui.Enabled then setOpen(false) end
end)

local cameraConnection
local function resize()
	local camera = Workspace.CurrentCamera
	if camera then
		local size = camera.ViewportSize
		panel.Size = UDim2.fromOffset(math.min(440, math.max(260, size.X - 28)), math.min(520, math.max(230, size.Y - 80)))
  toggle.Position = UDim2.new(.5, 0, 1, if size.Y >= 420 then -204 else -144)
	end
end
local function bindCamera()
	if cameraConnection then cameraConnection:Disconnect() end
	local camera = Workspace.CurrentCamera
	if camera then cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(resize) end
	resize()
end
connect(Workspace:GetPropertyChangedSignal("CurrentCamera"), bindCamera)
bindCamera()
local function cleanup()
	if not alive then return end
	alive = false
 modal:Destroy()
 scope:Destroy()
	for _, connection in ipairs(connections) do connection:Disconnect() end
	if cameraConnection then cameraConnection:Disconnect() end
	gui:Destroy()
end
connect(stop.Event, cleanup)
connect(script.Destroying, cleanup)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="44">
        <Properties>
          <string name="Name">DropperEffects</string>
          <string name="Source"><![CDATA[-- Локальные эффекты города. Генераторы, покупки и груз считаются сервером.
-- Один редкий цикл обслуживает только ближайшие объекты; физики и Heartbeat нет.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local player = Players.LocalPlayer
local GOLD = Color3.fromRGB(255, 210, 104)
local TEAL = Color3.fromRGB(98, 221, 192)
local SPARK_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"
local PING_SOUND = "rbxasset://sounds/electronicpingshort.wav"

local oldFolder = Workspace:FindFirstChild("ClientTycoonEffects")
if oldFolder then
	local oldStop = oldFolder:FindFirstChild("Stop")
	if oldStop and oldStop:IsA("BindableEvent") then oldStop:Fire() end
	oldFolder:Destroy()
end
local effects = Instance.new("Folder")
effects.Name = "ClientTycoonEffects"
effects.Parent = Workspace
local stopEvent = Instance.new("BindableEvent")
stopEvent.Name = "Stop"
stopEvent.Parent = effects

local alive = true
local pairsByStart, active, highlights = {}, {}, {}
local connections, plotConnections, crateConnections = {}, {}, {}
local activeCount = 0
local plots, crateFolder, config = nil, nil, nil
local nextPortalAt, nextSoundAt = 0, 0

local function quality()
	local value = player:GetAttribute("EffectsQuality")
	return if value == "Off" or value == "Low" then value else "High"
end
local function effectLimit() return if quality() == "Low" then 16 else 48 end
local function rootPart()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return root and root:IsA("BasePart") and root or nil
end
local function near(position, maximum)
	local root = rootPart()
	return root and (root.Position - position).Magnitude <= (maximum or (if quality() == "Low" then 80 else 130))
end
local function connect(signal, callback, group)
	local connection = signal:Connect(callback)
	table.insert(group or connections, connection)
end
local function disconnect(group)
	for _, connection in ipairs(group) do connection:Disconnect() end
	table.clear(group)
end
local function removeEffect(object)
	local entry = active[object]
	if not entry then return end
	active[object] = nil
	activeCount -= 1
	if entry.connection then entry.connection:Disconnect() end
	if entry.tween then entry.tween:Cancel() end
	object:Destroy()
end
local function track(object, duration, tween)
	if not alive or activeCount >= effectLimit() then object:Destroy(); return nil end
	active[object] = {tween = tween}
	activeCount += 1
	if tween then
		active[object].connection = tween.Completed:Connect(function() removeEffect(object) end)
		tween:Play()
	end
	task.delay(duration + 0.2, function() removeEffect(object) end)
	return object
end
local function visualPart(name, size, cframe, color)
	if not alive or quality() == "Off" or activeCount >= effectLimit() then return nil end
	local part = Instance.new("Part")
	part.Name, part.Size, part.CFrame, part.Color = name, size, cframe, color
	part.Material, part.Shape = Enum.Material.Neon, Enum.PartType.Ball
	part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery = true, false, false, false
	part.CastShadow = false
	part.Parent = effects
	return part
end
local function ring(position, radius, color, duration, name)
	local part = visualPart(name or "CityPulse", Vector3.new(0.07, 1.5, 1.5),
		CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2), color)
	if not part then return end
	part.Shape, part.Transparency = Enum.PartType.Cylinder, 0.75
	track(part, duration, TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.05, radius * 2, radius * 2), Transparency = 1,
	}))
end
local function particles(position, color, count)
	if quality() ~= "High" then return end
	local anchor = visualPart("CityParticles", Vector3.new(0.1, 0.1, 0.1), CFrame.new(position), color)
	if not anchor then return end
	anchor.Transparency = 1
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name, emitter.Texture = "SparkBurst", SPARK_TEXTURE
	emitter.Rate, emitter.LightEmission = 0, 0.7
	emitter.Color = ColorSequence.new(color)
	emitter.Lifetime, emitter.Speed = NumberRange.new(0.3, 0.75), NumberRange.new(3, 7)
	emitter.Drag, emitter.SpreadAngle = 3, Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0)})
	emitter.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1)})
	emitter.Parent = anchor
	if track(anchor, 1) then emitter:Emit(math.clamp(count or 10, 1, 18)) end
end
local function feedbackSound(pitch)
	local root = rootPart()
	if not alive or not root or player:GetAttribute("SoundEnabled") == false or os.clock() < nextSoundAt then return end
	nextSoundAt = os.clock() + 0.35
	local anchor = Instance.new("Part")
	anchor.Name, anchor.Size, anchor.CFrame = "CityFeedbackSound", Vector3.new(0.1, 0.1, 0.1), root.CFrame
	anchor.Transparency, anchor.Anchored = 1, true
	anchor.CanCollide, anchor.CanTouch, anchor.CanQuery, anchor.CastShadow = false, false, false, false
	anchor.Parent = effects
	local sound = Instance.new("Sound")
	sound.SoundId, sound.Volume, sound.PlaybackSpeed = PING_SOUND, 0.14, pitch or 1.2
	sound.RollOffMinDistance, sound.RollOffMaxDistance = 8, 30
	sound.Parent = anchor
	if track(anchor, 1.5) then pcall(function() sound:Play() end) end
end
local function emit(start, ending)
	local part = visualPart("VisualDroplet", Vector3.new(0.6, 0.6, 0.6), start.CFrame, start.Color)
	if not part then return end
	track(part, 0.65, TweenService:Create(part, TweenInfo.new(0.65, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		CFrame = ending.CFrame, Size = Vector3.new(0.22, 0.22, 0.22), Transparency = 0.55,
	}))
end
local function inspect(object)
	if object.Name == "DropletStart" and object:IsA("BasePart") then
		local parent = object.Parent
		local ending = parent and parent:FindFirstChild("DropletEnd")
		if ending and ending:IsA("BasePart") then pairsByStart[object] = ending end
	elseif object.Name == "DropletEnd" and object:IsA("BasePart") and object.Parent then
		local start = object.Parent:FindFirstChild("DropletStart")
		if start then inspect(start) end
	end
end

local function clearHighlights()
	for pad, highlight in pairs(highlights) do highlight:Destroy(); highlights[pad] = nil end
end
local function refreshPurchases()
	if not alive then return end
	if quality() == "Off" or not config or player:GetAttribute("DataReady") ~= true then clearHighlights(); return end
	local ownPlot
	if plots then
		for _, plot in ipairs(plots:GetChildren()) do
			if plot:GetAttribute("OwnerUserId") == player.UserId then ownPlot = plot; break end
		end
	end
	local wanted = {}
	local function available(name)
		local pad = ownPlot and ownPlot:FindFirstChild(name)
		if pad then wanted[pad] = true end
	end
	if ownPlot and ownPlot:GetAttribute("OwnerReady") == true then
		local coins = player:GetAttribute("Coins") or 0
		local floor, tier = player:GetAttribute("Floor") or 0, player:GetAttribute("DropperTier") or 0
		local nextFloor, nextTier = config.Floors[floor + 1], config.DropperCosts[tier + 1]
		if nextFloor and coins >= nextFloor.Cost then available("UpgradePad") end
		if floor > 0 and nextTier and coins >= nextTier then available("DropperUpgradePad") end
		if (player:GetAttribute("Bank") or 0) > 0 then available("Collector") end
	end
	for pad, highlight in pairs(highlights) do
		if not wanted[pad] or not pad.Parent or not near(pad.Position) then highlight:Destroy(); highlights[pad] = nil end
	end
	for pad in pairs(wanted) do
		if pad and pad:IsA("BasePart") and pad:IsDescendantOf(Workspace) and near(pad.Position) and not highlights[pad] then
			local highlight = Instance.new("Highlight")
			highlight.Name, highlight.Adornee = "AvailablePurchase", pad
			highlight.DepthMode = Enum.HighlightDepthMode.Occluded
			highlight.FillColor, highlight.OutlineColor = TEAL, GOLD
			highlight.FillTransparency, highlight.OutlineTransparency = 0.88, 0.2
			highlight.Parent = effects
			highlights[pad] = highlight
		end
	end
end
local function construction(plot, floor)
	local base = plot:FindFirstChild("Base")
	if not base or not base:IsA("BasePart") or not near(base.Position) or quality() == "Off" then return end
	local structure = plot:FindFirstChild("Structure")
	if structure then
		local glow = Instance.new("Highlight")
		glow.Name, glow.Adornee = "ConstructionGlow", plot
		glow.DepthMode = Enum.HighlightDepthMode.Occluded
		glow.FillColor, glow.OutlineColor = TEAL, GOLD
		glow.FillTransparency, glow.OutlineTransparency = 0.85, 0.2
		glow.Parent = effects
		track(glow, 0.75, TweenService:Create(glow, TweenInfo.new(0.75), {FillTransparency = 1, OutlineTransparency = 1}))
	end
	-- Этажи имеют верхнюю поверхность .8 + 12*n; пульс расположен над плитой.
	local position = base.Position + Vector3.new(0, 0.72 + (floor - 1) * 12, 0)
	ring(position, 22, TEAL, 0.8, "ConstructionRing")
	particles(position + Vector3.new(0, 1, 0), GOLD, 16)
end
local function bindPlots(folder)
	disconnect(plotConnections)
	table.clear(pairsByStart)
	clearHighlights()
	plots = folder
	if not folder then return end
	local watched = {}
	local function watchPlot(plot)
		if not plot:IsA("Model") or watched[plot] then return end
		watched[plot] = true
		local previous = plot:GetAttribute("Floor") or 0
		connect(plot:GetAttributeChangedSignal("Floor"), function()
			local current = plot:GetAttribute("Floor") or 0
			if current > previous and plot:GetAttribute("OwnerReady") == true then construction(plot, current) end
			previous = current
			refreshPurchases()
		end, plotConnections)
		connect(plot:GetAttributeChangedSignal("OwnerReady"), refreshPurchases, plotConnections)
		connect(plot:GetAttributeChangedSignal("OwnerUserId"), refreshPurchases, plotConnections)
	end
	for _, plot in ipairs(folder:GetChildren()) do watchPlot(plot) end
	for _, object in ipairs(folder:GetDescendants()) do inspect(object) end
	connect(folder.ChildAdded, watchPlot, plotConnections)
	connect(folder.DescendantAdded, inspect, plotConnections)
	connect(folder.DescendantRemoving, function(object)
		pairsByStart[object] = nil
		if object.Name == "DropletEnd" then
			for start, ending in pairs(pairsByStart) do if ending == object then pairsByStart[start] = nil end end
		end
	end, plotConnections)
	refreshPurchases()
end

local function crateArrival(prompt)
	if not prompt:IsA("ProximityPrompt") or prompt.Name ~= "LootPrompt" then return end
	local body = prompt.Parent
	if not body or not body:IsA("BasePart") then return end
	local landed = prompt.Enabled
	local ground = Vector3.new(body.Position.X, 0.25, body.Position.Z)
	if not landed and quality() ~= "Off" and near(ground, 170) then
		ring(ground, 7, GOLD, 1.2, "CrateArrival")
		particles(body.Position, TEAL, 8)
		local anchor = visualPart("CrateLandingMarker", Vector3.new(0.1, 0.1, 0.1), CFrame.new(ground), GOLD)
		if anchor then
			anchor.Transparency = 1
			local bottom, top = Instance.new("Attachment"), Instance.new("Attachment")
			bottom.Parent, top.Parent = anchor, anchor
			top.Position = Vector3.new(0, 12, 0)
			local beam = Instance.new("Beam")
			beam.Attachment0, beam.Attachment1 = bottom, top
			beam.Width0, beam.Width1, beam.FaceCamera, beam.LightEmission = 0.8, 0.15, true, 0.7
			beam.Color, beam.Transparency = ColorSequence.new(GOLD), NumberSequence.new(0.6)
			beam.Parent = anchor
			track(anchor, config and config.Airdrops.FallSeconds + 1 or 8)
		end
	end
	connect(prompt:GetPropertyChangedSignal("Enabled"), function()
		if not alive or landed or prompt.Enabled ~= true then return end
		landed = true
		if quality() ~= "Off" and body.Parent and near(body.Position, 150) then
			local point = Vector3.new(body.Position.X, 0.3, body.Position.Z)
			ring(point, 10, GOLD, 0.7, "CrateLanding")
			particles(point + Vector3.new(0, 1, 0), GOLD, 16)
		end
	end, crateConnections)
end
local function bindCrates(folder)
	disconnect(crateConnections)
	crateFolder = folder
	if not folder then return end
	local watched = {}
	local function inspectCrate(object)
		if object.Name == "LootPrompt" and not watched[object] then watched[object] = true; crateArrival(object) end
	end
	for _, object in ipairs(folder:GetDescendants()) do inspectCrate(object) end
	connect(folder.DescendantAdded, inspectCrate, crateConnections)
	-- Отсоединённые prompts не сохраняются между следующими грузами.
	connect(folder.ChildRemoved, function() task.defer(function() if alive and crateFolder == folder then bindCrates(folder) end end) end, crateConnections)
end
local function portals()
	local campus = Workspace:FindFirstChild("HeroCampus")
	if not campus then return end
	for _, name in ipairs({"ArenaPortal", "ReturnStand", "RebirthStand"}) do
		local pad = campus:FindFirstChild(name)
		if pad and pad:IsA("BasePart") and near(pad.Position, 90) then
			ring(pad.Position + Vector3.new(0, 0.32, 0), 4.5, pad.Color, 1.2, "PortalPulse")
		end
	end
end
local function clearTransient()
	for object in pairs(active) do removeEffect(object) end
	clearHighlights()
end
local function cleanup()
	if not alive then return end
	alive = false
	disconnect(connections)
	disconnect(plotConnections)
	disconnect(crateConnections)
	clearTransient()
	table.clear(pairsByStart)
	effects:Destroy()
end
connect(stopEvent.Event, cleanup)
connect(script.Destroying, cleanup)
connect(effects.Destroying, cleanup)
connect(player.CharacterRemoving, clearTransient)
connect(player:GetAttributeChangedSignal("EffectsQuality"), function() clearTransient(); refreshPurchases() end)
connect(player:GetAttributeChangedSignal("SoundEnabled"), function()
	if player:GetAttribute("SoundEnabled") == false then
		for object in pairs(active) do if object.Name == "CityFeedbackSound" then removeEffect(object) end end
	end
end)
for _, name in ipairs({"Coins", "Floor", "DropperTier", "PlotId", "Bank", "DataReady"}) do
	connect(player:GetAttributeChangedSignal(name), refreshPurchases)
end

task.spawn(function()
	local shared = ReplicatedStorage:WaitForChild("Shared", 30)
	local module = shared and shared:WaitForChild("TycoonConfig", 30)
	if alive and module and module:IsA("ModuleScript") then config = require(module); refreshPurchases() end
	local remotes = ReplicatedStorage:WaitForChild("TycoonRemotes", 30)
	if not alive or not remotes then return end
	local notice = remotes:WaitForChild("Notice", 30)
	local loot = remotes:WaitForChild("LootResult", 30)
	if not alive then return end
	if notice and notice:IsA("RemoteEvent") then
		connect(notice.OnClientEvent, function(payload)
			if type(payload) ~= "table" then return end
			if payload.kind == "success" or payload.kind == "reward" then feedbackSound(1.15)
			elseif payload.kind == "error" then feedbackSound(0.8) end
		end)
	end
	if loot and loot:IsA("RemoteEvent") then
		connect(loot.OnClientEvent, function(payload)
			if not config or type(payload) ~= "table" then return end
			local weapon = config.GetWeapon(payload.weaponId)
			local root = rootPart()
			if not weapon or not root then return end
			local color = Color3.fromRGB(weapon.Color[1], weapon.Color[2], weapon.Color[3])
			if quality() ~= "Off" then
				ring(root.Position - Vector3.new(0, 2.5, 0), 4, color, 0.7, "LootReward")
				particles(root.Position, color, if weapon.LootWeight <= 9 then 18 else 8)
			end
			feedbackSound(if weapon.LootWeight <= 9 then 1.45 else 1.2)
		end)
	end
end)

task.spawn(function()
	while alive do
		local currentPlots, currentCrates = Workspace:FindFirstChild("TycoonPlots"), Workspace:FindFirstChild("Airdrops")
		if currentPlots ~= plots then bindPlots(currentPlots) end
		if currentCrates ~= crateFolder then bindCrates(currentCrates) end
		if quality() ~= "Off" then
			for start, ending in pairs(pairsByStart) do
				if not start:IsDescendantOf(Workspace) or not ending:IsDescendantOf(Workspace) then pairsByStart[start] = nil
				elseif near(start.Position) then emit(start, ending) end
			end
			if os.clock() >= nextPortalAt then nextPortalAt = os.clock() + 3; portals() end
			refreshPurchases()
		end
		task.wait(if quality() == "Low" then 1.4 elseif quality() == "Off" then 2 else 0.8)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="45">
        <Properties>
          <string name="Name">HeroControls</string>
          <string name="Source"><![CDATA[-- Только управление: сервер проверяет оружие, расстояние и перезарядку навыка.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local ACTION_NAME = "TycoonHeroSkill"
local AIM_DISTANCE = 250
local LOCAL_COOLDOWN = 0.15
local RUNTIME_NAME = "HeroControlsRuntime"

-- При повторном запуске сначала отключаем старые кнопки и обработчики.
local oldRuntime = script.Parent:FindFirstChild(RUNTIME_NAME)
if oldRuntime then
	local oldStop = oldRuntime:FindFirstChild("Stop")
	if oldStop and oldStop:IsA("BindableEvent") then
		oldStop:Fire()
	end
	oldRuntime:Destroy()
end

local runtime = Instance.new("Folder")
runtime.Name = RUNTIME_NAME
runtime.Parent = script.Parent
local stopEvent = Instance.new("BindableEvent")
stopEvent.Name = "Stop"
stopEvent.Parent = runtime

local alive = true
local skillRemote = nil
local character = nil
local equippedTool = nil
local actionBound = false
local lastRequest = -math.huge
local connections = {}
local characterConnections = {}
local tools = {}
local cameraConnection = nil
local cooldownElapsed = 0

local function disconnectAll(list)
	for _, connection in ipairs(list) do
		connection:Disconnect()
	end
	table.clear(list)
end

local function isFiniteVector(value)
	if typeof(value) ~= "Vector3" then
		return false
	end
	for _, number in ipairs({ value.X, value.Y, value.Z }) do
		if number ~= number or math.abs(number) > 1000000 then
			return false
		end
	end
	return true
end

local function isHeroTool(tool)
	if not tool or not tool:IsA("Tool") then return false end
	local marker = tool:GetAttribute("HeroWeapon")
	-- Сервер помечает оружие строкой heroId или loot:weaponId.
	-- Это фильтр управления; владение и точный Tool проверяет сервер.
	return type(marker) == "string" and #marker > 0 and #marker <= 64
end

local function aimPosition(forceCenter)
	local camera = Workspace.CurrentCamera
	if not camera then
		return nil
	end
	local inputType = UserInputService:GetLastInputType()
	local useCenter = forceCenter
		or inputType == Enum.UserInputType.Touch
		or string.find(inputType.Name, "^Gamepad") ~= nil
		or not UserInputService.MouseEnabled
	local ray
	if useCenter then
		local center = camera.ViewportSize / 2
		ray = camera:ViewportPointToRay(center.X, center.Y)
	else
		-- ScreenPointToRay учитывает верхнюю панель Roblox.
		local mousePosition = UserInputService:GetMouseLocation()
		ray = camera:ScreenPointToRay(mousePosition.X, mousePosition.Y)
	end
	if not isFiniteVector(ray.Origin) or not isFiniteVector(ray.Direction) then
		return nil
	end
	local excluded = {}
	if character then
		table.insert(excluded, character)
	end
	for _, name in ipairs({ "ClientHeroEffects", "ClientTycoonEffects" }) do
		local folder = Workspace:FindFirstChild(name)
		if folder then
			table.insert(excluded, folder)
		end
	end
	local parameters = RaycastParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Exclude
	parameters.FilterDescendantsInstances = excluded
	parameters.IgnoreWater = true
	parameters.RespectCanCollide = false -- Учитываем CanQuery, а не CanCollide.
	local direction = ray.Direction * AIM_DISTANCE
	local result = Workspace:Raycast(ray.Origin, direction, parameters)
	local position = result and result.Position or ray.Origin + direction
	return isFiniteVector(position) and position or nil
end

local function modalOpen()
	local gui = player:FindFirstChildOfClass("PlayerGui")
	local modal = gui and gui:GetAttribute("QuarterModalOpen")
	return (type(modal) == "string" and modal ~= "") or UserInputService:GetFocusedTextBox() ~= nil
end

local function remainingCooldown()
	local readyAt = player:GetAttribute("AttackReadyAt")
	if type(readyAt) ~= "number" or readyAt ~= readyAt or math.abs(readyAt) == math.huge then return 0 end
	return math.max(0, readyAt - Workspace:GetServerTimeNow())
end

local function updateActionTitle()
	if not actionBound then return end
	local remaining = remainingCooldown()
	ContextActionService:SetTitle(ACTION_NAME, if remaining > 0 then string.format("%.1f с", remaining)
		elseif player:GetAttribute("ArenaCombatOptIn") ~= true then "Арена" else "Атака")
end

local function requestSkill(forceCenter)
	if not alive or not skillRemote or not skillRemote.Parent then
		return
	end
	if not isHeroTool(equippedTool) or equippedTool.Parent ~= character then
		return
	end
	if modalOpen() or player:GetAttribute("DataReady") ~= true
		or player:GetAttribute("ArenaCombatOptIn") ~= true or player:GetAttribute("ObbyActive") == true
		or remainingCooldown() > 0 then return end
	-- Это удобство для управления. Настоящая защита работает на сервере.
	local now = os.clock()
	if now - lastRequest < LOCAL_COOLDOWN then
		return
	end
	local position = aimPosition(forceCenter)
	if not position then
		return
	end
	lastRequest = now
	skillRemote:FireServer(position) -- Только Vector3, без цели или размера награды.
end

local function positionAction()
	if not actionBound then return end
	local camera = Workspace.CurrentCamera
	local landscape = camera and camera.ViewportSize.X > camera.ViewportSize.Y
	-- Portrait: right of the admin button and above jump. Landscape:
	-- keep below the inventory button and left of jump.
	ContextActionService:SetPosition(ACTION_NAME, if landscape then UDim2.new(1, -140, 1, -110) else UDim2.new(1, -130, 1, -200))
end

local function refreshAction()
	equippedTool = nil
	for tool in pairs(tools) do
		if tool.Parent == character and isHeroTool(tool) then
			equippedTool = tool
			break
		end
	end
	local shouldBind = alive and equippedTool ~= nil and skillRemote ~= nil
	if shouldBind == actionBound then
		return
	end
	actionBound = shouldBind
	if not actionBound then
		ContextActionService:UnbindAction(ACTION_NAME)
		return
	end
	ContextActionService:BindAction(ACTION_NAME, function(_, inputState, inputObject)
		if modalOpen() then return Enum.ContextActionResult.Pass end
		if inputState == Enum.UserInputState.Begin then
			local center = inputObject and (
				inputObject.UserInputType == Enum.UserInputType.Touch
				or string.find(inputObject.UserInputType.Name, "^Gamepad") ~= nil
			)
			requestSkill(center)
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.Q, Enum.KeyCode.ButtonX, Enum.KeyCode.ButtonR2)
	updateActionTitle()
	positionAction()
end

local function removeTool(tool)
	local toolConnections = tools[tool]
	if not toolConnections then
		return
	end
	disconnectAll(toolConnections)
	tools[tool] = nil
	refreshAction()
end

local function addTool(tool)
	if not alive or not tool:IsA("Tool") or tools[tool] then
		return
	end
	-- Один набор обработчиков на Tool; добавление других детей его не дублирует.
	local toolConnections = {}
	tools[tool] = toolConnections
	table.insert(toolConnections, tool.Activated:Connect(function()
		if tool == equippedTool then
			requestSkill(false)
		end
	end))
	table.insert(toolConnections, tool:GetAttributeChangedSignal("HeroWeapon"):Connect(refreshAction))
	refreshAction()
end

local function clearCharacter()
	disconnectAll(characterConnections)
	for _, toolConnections in pairs(tools) do
		disconnectAll(toolConnections)
	end
	table.clear(tools)
	character = nil
	refreshAction()
end

local function bindCharacter(newCharacter)
	if not alive or character == newCharacter then
		return
	end
	clearCharacter()
	character = newCharacter
	table.insert(characterConnections, newCharacter.ChildAdded:Connect(addTool))
	table.insert(characterConnections, newCharacter.ChildRemoved:Connect(removeTool))
	for _, child in ipairs(newCharacter:GetChildren()) do
		addTool(child)
	end
end

local function cleanup()
	if not alive then
		return
	end
	alive = false
	disconnectAll(connections)
	clearCharacter()
	skillRemote = nil
	if cameraConnection then cameraConnection:Disconnect() end
	runtime:Destroy()
end

table.insert(connections, stopEvent.Event:Connect(cleanup))
table.insert(connections, script.Destroying:Connect(cleanup))
table.insert(connections, runtime.Destroying:Connect(cleanup))
table.insert(connections, player:GetAttributeChangedSignal("AttackReadyAt"):Connect(updateActionTitle))
table.insert(connections, player:GetAttributeChangedSignal("ArenaCombatOptIn"):Connect(updateActionTitle))
table.insert(connections, RunService.Heartbeat:Connect(function(seconds)
	if not actionBound then return end
	cooldownElapsed += seconds
	if cooldownElapsed < 0.1 then return end
	cooldownElapsed = 0
	updateActionTitle()
end))
local function bindCamera()
	if cameraConnection then cameraConnection:Disconnect() end
	local camera = Workspace.CurrentCamera
	if camera then cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(positionAction) end
	positionAction()
end
table.insert(connections, Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera))
bindCamera()
table.insert(connections, player.CharacterAdded:Connect(bindCharacter))
table.insert(connections, player.CharacterRemoving:Connect(function(oldCharacter)
	if character == oldCharacter then
		clearCharacter()
	end
end))
if player.Character then
	bindCharacter(player.Character)
end

task.spawn(function()
	local remotes = ReplicatedStorage:WaitForChild("TycoonRemotes", 30)
	if not alive or not remotes then
		return
	end
	local remote = remotes:WaitForChild("SkillRequest", 30)
	if not alive or not remote or not remote:IsA("RemoteEvent") then
		return
	end
	skillRemote = remote
	refreshAction()
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="46">
        <Properties>
          <string name="Name">HeroEffects</string>
          <string name="Source"><![CDATA[-- Только обратная связь: сервер определяет попадания, урон и награды.
-- Все эффекты локальные, с ограничением числа объектов и временем жизни.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local DEFAULT_COLOR = Color3.fromRGB(104, 224, 255)
local GOLD = Color3.fromRGB(255, 209, 101)
local RED = Color3.fromRGB(248, 100, 93)
local VIEW_DISTANCE = 210
local MAX_SEGMENT_LENGTH = 500
-- Текстура и звуки поставляются с Roblox, без загружаемых сторонних assets.
local SPARK_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"
local SWISH_SOUND = "rbxasset://sounds/action_jump.mp3"

local oldFolder = Workspace:FindFirstChild("ClientHeroEffects")
if oldFolder then
	local oldStop = oldFolder:FindFirstChild("Stop")
	if oldStop and oldStop:IsA("BindableEvent") then oldStop:Fire() end
	oldFolder:Destroy()
end
local effects = Instance.new("Folder")
effects.Name = "ClientHeroEffects"
effects.Parent = Workspace
local stopEvent = Instance.new("BindableEvent")
stopEvent.Name = "Stop"
stopEvent.Parent = effects

local alive = true
local active, joints, targetGlows, connections = {}, {}, {}, {}
local activeCount = 0
local feedbackGui = nil
local nextSoundAt, nextHurtAt = 0, 0

local function quality()
	local value = player:GetAttribute("EffectsQuality")
	return if value == "Off" or value == "Low" then value else "High"
end

local function limit()
	return if quality() == "Off" then 8 elseif quality() == "Low" then 20 else 60
end

local function finite(value)
	return type(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function validVector(value)
	return typeof(value) == "Vector3" and finite(value.X) and finite(value.Y) and finite(value.Z)
		and math.abs(value.X) <= 1000000 and math.abs(value.Y) <= 1000000 and math.abs(value.Z) <= 1000000
end

local function effectColor(value)
	local r, g, b
	if typeof(value) == "Color3" then r, g, b = value.R, value.G, value.B
	elseif type(value) == "table" then
		r, g, b = value.r or value.R or value[1], value.g or value.G or value[2], value.b or value.B or value[3]
	end
	if not finite(r) or not finite(g) or not finite(b) then return DEFAULT_COLOR end
	if type(value) == "table" and math.max(r, g, b) > 1 then r, g, b = r / 255, g / 255, b / 255 end
	return Color3.new(math.clamp(r, 0, 1), math.clamp(g, 0, 1), math.clamp(b, 0, 1))
end

local function focus()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local camera = Workspace.CurrentCamera
	return root and root:IsA("BasePart") and root.Position or camera and camera.CFrame.Position
end

local function nearby(from, to)
	local point = focus()
	local distance = if quality() == "Low" then 120 else VIEW_DISTANCE
	return point and ((point - from).Magnitude <= distance or (point - to).Magnitude <= distance)
end

local function removeEffect(object)
	local entry = active[object]
	if not entry then return end
	active[object] = nil
	if entry.target and targetGlows[entry.target] == object then targetGlows[entry.target] = nil end
	activeCount -= 1
	if entry.connection then entry.connection:Disconnect() end
	if entry.tween then entry.tween:Cancel() end
	object:Destroy()
end

local function track(object, duration, tween)
	if not alive or activeCount >= limit() then object:Destroy(); return nil end
	activeCount += 1
	local entry = {tween = tween}
	active[object] = entry
	if tween then
		entry.connection = tween.Completed:Connect(function() removeEffect(object) end)
		tween:Play()
	end
	-- Резервная уборка также работает для отменённого tween и удалённой цели.
	task.delay(duration + 0.15, function() removeEffect(object) end)
	return object
end

local function part(name, size, cframe, color, shape, transparency, essential)
	if not alive or (quality() == "Off" and not essential) or activeCount >= limit() then return nil end
	local object = Instance.new("Part")
	object.Name = name
	object.Size, object.CFrame, object.Color = size, cframe, color
	object.Shape, object.Material = shape or Enum.PartType.Ball, Enum.Material.Neon
	object.Anchored, object.CanCollide, object.CanTouch, object.CanQuery = true, false, false, false
	object.CastShadow, object.Transparency = false, transparency or 0.15
	object.Parent = effects
	return object
end

local function animate(name, size, cframe, color, shape, duration, goals, transparency, essential)
	local object = part(name, size, cframe, color, shape, transparency, essential)
	if not object then return nil end
	local tween = TweenService:Create(object, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goals)
	return track(object, duration, tween)
end

local function pulse(position, radius, color, duration, name)
	return animate(name or "ImpactRing", Vector3.new(0.1, 2, 2),
		CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2), color, Enum.PartType.Cylinder, duration, {
			Size = Vector3.new(0.08, radius * 2, radius * 2), Transparency = 1,
		}, 0.65)
end

local function sparks(position, color, count, speed)
	if quality() ~= "High" then return end
	local anchor = part("ImpactParticles", Vector3.new(0.1, 0.1, 0.1), CFrame.new(position), color, nil, 1)
	if not anchor then return end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Sparks"
	emitter.Texture = SPARK_TEXTURE
	emitter.Rate = 0
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 0.8
	emitter.Lifetime = NumberRange.new(0.2, 0.45)
	emitter.Speed = NumberRange.new(speed or 4, (speed or 4) * 1.8)
	emitter.Drag = 4
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.28), NumberSequenceKeypoint.new(1, 0)})
	emitter.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1)})
	emitter.Parent = anchor
	if track(anchor, 0.65) then emitter:Emit(math.clamp(count or 8, 1, 20)) end
end

local function beam(from, target, color, width, duration, curved)
	if (target - from).Magnitude < 0.05 then return end
	local anchor = part("SkillBeamAnchor", Vector3.new(0.1, 0.1, 0.1), CFrame.new(from), color, nil, 1)
	if not anchor then return end
	local first, last = Instance.new("Attachment"), Instance.new("Attachment")
	first.Name, last.Name = "Origin", "Target"
	first.Parent, last.Parent = anchor, anchor
	last.Position = target - from
	local ray = Instance.new("Beam")
	ray.Name = "SkillBeam"
	ray.Attachment0, ray.Attachment1 = first, last
	ray.Color = ColorSequence.new(color)
	ray.Width0, ray.Width1 = width, width * 0.35
	ray.LightEmission, ray.FaceCamera = 0.9, true
	ray.Segments = if curved then 8 else 1
	ray.CurveSize0, ray.CurveSize1 = if curved then 1.4 else 0, if curved then -1.4 else 0
	ray.Transparency = NumberSequence.new(0.12)
	ray.Parent = anchor
	track(anchor, duration)
end

local function sound(kind, position, volume)
	if not alive or player:GetAttribute("SoundEnabled") == false or os.clock() < nextSoundAt then return end
	nextSoundAt = os.clock() + 0.12
	local anchor = Instance.new("Part")
	anchor.Name = "FeedbackSound"
	anchor.Size, anchor.CFrame = Vector3.new(0.1, 0.1, 0.1), CFrame.new(position)
	anchor.Transparency, anchor.Anchored = 1, true
	anchor.CanCollide, anchor.CanTouch, anchor.CanQuery, anchor.CastShadow = false, false, false, false
	anchor.Parent = effects
	local audio = Instance.new("Sound")
	audio.Name = "LocalFeedback"
	audio.SoundId = SWISH_SOUND
	audio.Volume = volume or 0.12
	audio.PlaybackSpeed = if kind == "hurt" then 1.05 else 1.6
	audio.RollOffMinDistance, audio.RollOffMaxDistance = 8, 65
	audio.Parent = anchor
	if not track(anchor, 1.5) then return end
	-- При недоступном встроенном звуке визуальная обратная связь остаётся рабочей.
	pcall(function() audio:Play() end)
end

local function numberLabel(position, amount, critical)
	if not finite(amount) or amount <= 0 then return end
	local anchor = part("DamageNumber", Vector3.new(0.1, 0.1, 0.1), CFrame.new(position + Vector3.new(0, 2.8, 0)), DEFAULT_COLOR, nil, 1)
	if not anchor then return end
	local gui = Instance.new("BillboardGui")
	gui.Name = "Damage"
	gui.Size, gui.AlwaysOnTop, gui.MaxDistance = UDim2.fromOffset(120, 48), true, 120
	gui.Parent = anchor
	local text = Instance.new("TextLabel")
	text.Size, text.BackgroundTransparency = UDim2.fromScale(1, 1), 1
	text.Font, text.TextSize = Enum.Font.GothamBold, if critical then 28 else 22
	text.Text = "−" .. tostring(math.clamp(math.floor(amount), 1, 99999))
	text.TextColor3 = if critical then GOLD else Color3.fromRGB(244, 250, 255)
	text.TextStrokeColor3, text.TextStrokeTransparency = Color3.fromRGB(28, 34, 48), 0.25
	text.Parent = gui
	local tween = TweenService:Create(anchor, TweenInfo.new(0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		CFrame = anchor.CFrame + Vector3.new(0, 2, 0),
	})
	track(anchor, 0.75, tween)
end

local function highlight(target, color)
	if typeof(target) ~= "Instance" or not target:IsA("Model") or not target:IsDescendantOf(Workspace)
		or activeCount >= limit() then return end
	if targetGlows[target] then removeEffect(targetGlows[target]) end
	local glow = Instance.new("Highlight")
	glow.Name = "HitHighlight"
	glow.Adornee = target
	glow.DepthMode = Enum.HighlightDepthMode.Occluded
	glow.FillColor, glow.OutlineColor = color, color
	glow.FillTransparency, glow.OutlineTransparency = 0.6, 0.15
	glow.Parent = effects
	if track(glow, 0.2, TweenService:Create(glow, TweenInfo.new(0.2), {FillTransparency = 1, OutlineTransparency = 1})) then
		active[glow].target = target
		targetGlows[target] = glow
	end
end

local function resetJoint(joint)
	local entry = joints[joint]
	if not entry then return end
	joints[joint] = nil
	if entry.tween then entry.tween:Cancel() end
	if joint.Parent then joint.C0 = entry.rest end
end

local function attackPose(actorUserId, kind)
	-- Короткая процедурная поза, без опубликованных чужих animation IDs.
	if actorUserId ~= player.UserId then return end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return end
	local joint
	for _, item in ipairs(character:GetDescendants()) do
		if item:IsA("Motor6D") and (item.Name == "RightShoulder" or item.Name == "Right Shoulder") then joint = item; break end
	end
	if not joint then return end
	resetJoint(joint)
	local entry = {rest = joint.C0}
	joints[joint] = entry
	local angle = if kind == "slam" then -1.15 else -0.55
	entry.tween = TweenService:Create(joint, TweenInfo.new(0.07), {C0 = entry.rest * CFrame.Angles(angle, 0, -0.12)})
	entry.tween:Play()
	task.delay(0.09, function()
		if joints[joint] ~= entry then return end
		if not alive or not joint.Parent or player.Character ~= character then resetJoint(joint); return end
		entry.tween:Cancel()
		entry.tween = TweenService:Create(joint, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {C0 = entry.rest})
		entry.tween:Play()
	end)
	task.delay(0.3, function() if joints[joint] == entry then resetJoint(joint) end end)
end

local function hurt(amount)
	if os.clock() < nextHurtAt or not finite(amount) or amount <= 0 then return end
	nextHurtAt = os.clock() + 0.16
	local guiParent = player:FindFirstChild("PlayerGui")
	if not guiParent then return end
	if not feedbackGui then
		feedbackGui = Instance.new("ScreenGui")
		feedbackGui.Name = "CombatFeedbackHUD"
		feedbackGui.ResetOnSpawn, feedbackGui.IgnoreGuiInset, feedbackGui.DisplayOrder = false, true, 4
		feedbackGui.Parent = guiParent
	end
	local flash = Instance.new("Frame")
	flash.Name = "DamageFlash"
	flash.Size, flash.BackgroundColor3, flash.BackgroundTransparency = UDim2.fromScale(1, 1), RED, 0.92
	flash.BorderSizePixel, flash.Active = 0, false
	flash.Parent = feedbackGui
	track(flash, 0.38, TweenService:Create(flash, TweenInfo.new(0.38), {BackgroundTransparency = 1}))
end

local ATTACKS = {web = true, repulsor = true, lightning = true, slam = true, beam = true, projectile = true, blast = true}
local function render(payload)
	if not alive or type(payload) ~= "table" or type(payload.kind) ~= "string" then return end
	local from, target = payload.from, payload.to
	if not validVector(from) or not validVector(target) or (target - from).Magnitude > MAX_SEGMENT_LENGTH
		or not nearby(from, target) then return end
	local kind, color = payload.kind, effectColor(payload.color)
	if kind == "hurt" and payload.victimUserId == player.UserId then
		if not finite(payload.amount) or payload.amount <= 0 then return end
		sound("hurt", target, 0.1)
		if quality() ~= "Off" then hurt(payload.amount) end
		return
	end
	-- Предупреждение об опасной атаке — часть управления боем, видно даже без VFX.
	if quality() == "Off" and kind ~= "boss_warning" then
		return
	end
	if kind == "hit" then
		if payload.actorUserId == player.UserId then numberLabel(target, payload.amount, payload.boss == true) end
		highlight(payload.target, color)
		sparks(target, color, 6, 3)
		return
	elseif kind == "victory" then
		local radius = if payload.boss == true then 14 else 5
		pulse(Vector3.new(target.X, 0.35, target.Z), radius, GOLD, 0.7, "VictoryRing")
		sparks(target + Vector3.new(0, 1.5, 0), GOLD, if payload.boss == true then 20 else 8, 9)
		-- Звук победы воспроизводит обработчик серверного Notice, без двойного ping.
		return
	elseif kind == "boss_warning" then
		local radius = if finite(payload.radius) then math.clamp(payload.radius, 1, 32) else 8
		local duration = if finite(payload.duration) then math.clamp(payload.duration, 0.15, 3) else 0.7
		from, target = Vector3.new(from.X, 0.35, from.Z), Vector3.new(target.X, 0.35, target.Z)
		if payload.style == "rush" and (target - from).Magnitude > 0.05 then
			animate("BossRushWarning", Vector3.new(radius * 2, 0.08, (target - from).Magnitude + radius * 2),
				CFrame.lookAt((from + target) / 2, target), RED, Enum.PartType.Block, duration, {Transparency = 0.68}, 0.9, true)
		else
			animate("BossAreaWarning", Vector3.new(0.07, radius * 2, radius * 2),
				CFrame.new(target) * CFrame.Angles(0, 0, math.pi / 2), RED, Enum.PartType.Cylinder, duration,
				{Transparency = 0.65}, 0.88, true)
		end
		return
	elseif kind == "boss_impact" then
		local radius = if finite(payload.radius) then math.clamp(payload.radius, 1, 32) else 8
		pulse(Vector3.new(target.X, 0.35, target.Z), radius, RED, 0.5, "BossImpact")
		sparks(target, RED, 16, 7)
		return
	end
	if not ATTACKS[kind] then return end
	attackPose(payload.actorUserId, kind)
	if payload.actorUserId == player.UserId then sound("attack", from, 0.07) end
	if kind == "slam" then
		local radius = if finite(payload.radius) then math.clamp(payload.radius, 1, 24) else 12
		pulse(Vector3.new(target.X, 0.35, target.Z), radius, color, 0.45, "HeroSlamPulse")
		sparks(target, color, 12, 7)
	elseif kind == "lightning" then
		local delta = target - from
		local segments = if quality() == "Low" then 2 else 5
		local previous = from
		for index = 1, segments do
			local nextPoint = from + delta * (index / segments)
			if index < segments then nextPoint += Vector3.new(if index % 2 == 0 then 0.8 else -0.8, 0.5, 0) end
			beam(previous, nextPoint, color, 0.32, 0.2)
			previous = nextPoint
		end
		sparks(target, color, 8, 5)
	elseif kind == "web" then
		beam(from, target, Color3.fromRGB(235, 246, 252), 0.14, 0.3, true)
		pulse(target, 2.1, color, 0.25, "WebContact")
	elseif kind == "projectile" then
		animate("HeroProjectile", Vector3.new(0.8, 0.8, 0.8), CFrame.new(from), color, nil, 0.18,
			{CFrame = CFrame.new(target), Size = Vector3.new(0.35, 0.35, 0.35), Transparency = 0.8})
		beam(from, target, color, 0.13, 0.12)
	else
		beam(from, target, color, if kind == "repulsor" then 0.5 else 0.25, 0.17)
		animate("HeroImpact", Vector3.new(0.45, 0.45, 0.45), CFrame.new(target), color, nil, 0.25,
			{Size = Vector3.new(2.2, 2.2, 2.2), Transparency = 1})
		sparks(target, color, 8, 4)
	end
end

local function clearTransient()
	for object in pairs(active) do removeEffect(object) end
	for joint in pairs(joints) do resetJoint(joint) end
end

local function cleanup()
	if not alive then return end
	alive = false
	for _, connection in ipairs(connections) do connection:Disconnect() end
	table.clear(connections)
	clearTransient()
	if feedbackGui then feedbackGui:Destroy(); feedbackGui = nil end
	effects:Destroy()
end

table.insert(connections, stopEvent.Event:Connect(cleanup))
table.insert(connections, script.Destroying:Connect(cleanup))
table.insert(connections, effects.Destroying:Connect(cleanup))
table.insert(connections, player.CharacterRemoving:Connect(clearTransient))
table.insert(connections, player:GetAttributeChangedSignal("EffectsQuality"):Connect(clearTransient))
table.insert(connections, player:GetAttributeChangedSignal("SoundEnabled"):Connect(function()
	if player:GetAttribute("SoundEnabled") == false then
		for object in pairs(active) do if object.Name == "FeedbackSound" then removeEffect(object) end end
	end
end))

task.spawn(function()
	local remotes = ReplicatedStorage:WaitForChild("TycoonRemotes", 30)
	if not alive or not remotes then return end
	local remote = remotes:WaitForChild("Effect", 30)
	if not alive or not remote or not remote:IsA("RemoteEvent") then return end
	table.insert(connections, remote.OnClientEvent:Connect(render))
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="47">
        <Properties>
          <string name="Name">ObbyHUD</string>
          <string name="Source"><![CDATA[-- Only the server advances course checkpoints; the client displays its state.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(shared:WaitForChild("TycoonConfig"))
local Theme = require(shared:WaitForChild("UITheme"))
local request = ReplicatedStorage:WaitForChild("TycoonRemotes"):WaitForChild("ObbyRequest")
local old = playerGui:FindFirstChild("RooftopObbyHUD")
if old then
 local stop = old:FindFirstChild("Stop")
 if stop then stop:Fire() end
 old:Destroy()
end
local scope = Theme.Scope()
local gui = Theme.Make("ScreenGui", {Name = "RooftopObbyHUD", ResetOnSpawn = false, IgnoreGuiInset = false, DisplayOrder = 18, ZIndexBehavior = Enum.ZIndexBehavior.Sibling}, playerGui)
local stop = Theme.Make("BindableEvent", {Name = "Stop"}, gui)
local panel = Theme.Make("Frame", {Name = "CourseStatus", AnchorPoint = Vector2.new(.5, 0), Position = UDim2.new(.5, 0, 0, 10), Size = UDim2.new(1, -28, 0, 172), BackgroundColor3 = Theme.Colors.panel, BorderSizePixel = 0, Visible = false}, gui)
Theme.Surface(panel, 18, Theme.Colors.gold)
Theme.Make("UISizeConstraint", {MaxSize = Vector2.new(420, 172)}, panel)
local entryScale = Theme.Make("UIScale", {Scale = 1}, panel)
Theme.Icon(panel, "star", Theme.Colors.gold, UDim2.fromOffset(19, 19), UDim2.fromOffset(14, 12))
Theme.Label(panel, "Title", "КРЫШИ КВАРТАЛА", UDim2.new(1, -68, 0, 25), UDim2.fromOffset(43, 9), 16, Theme.Colors.gold)
local progress = Theme.Label(panel, "Progress", "", UDim2.new(1, -28, 0, 24), UDim2.fromOffset(14, 37), 13)
local track = Theme.Make("Frame", {Name = "CourseTrack", Position = UDim2.fromOffset(14, 66), Size = UDim2.new(1, -28, 0, 5), BackgroundColor3 = Theme.Colors.card, BorderSizePixel = 0}, panel)
Theme.Round(track, 3)
local fill = Theme.Make("Frame", {Name = "Fill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Colors.gold, BorderSizePixel = 0}, track)
Theme.Round(fill, 3)
local best = Theme.Label(panel, "Best", "", UDim2.new(1, -28, 0, 32), UDim2.fromOffset(14, 77), 11, Theme.Colors.muted)
local lastRequest = -math.huge
for index, definition in ipairs({{"Checkpoint", "К точке"}, {"Exit", "В город"}}) do
 local button = Theme.Button(scope, panel, definition[1], definition[2], UDim2.new(.5, -21, 0, 44), UDim2.new((index - 1) * .5, 14 - (index - 1) * 7, 0, 116), if index == 1 then Theme.Colors.gold else nil)
 scope:Connect(button.Activated, function()
  if player:GetAttribute("ObbyActive") ~= true or os.clock() - lastRequest < 1 then return end
  lastRequest = os.clock()
  request:FireServer(definition[1])
 end)
end

local active = false
local function update()
 if not scope.alive then return end
 local nextActive = player:GetAttribute("ObbyActive") == true
 if nextActive ~= active then
  active = nextActive
  panel.Visible = active
  if active then
   Theme.CloseAll()
   entryScale.Scale = .95
   scope:Tween(entryScale, .18, {Scale = 1})
  end
 end
 if not active then return end
 local stage = player:GetAttribute("ObbyStage") or 1
 local checkpoint = player:GetAttribute("ObbyCheckpoint") or 1
 local started = player:GetAttribute("ObbyStartedAt") or Workspace:GetServerTimeNow()
 local elapsed = math.max(0, Workspace:GetServerTimeNow() - started)
 progress.Text = "Этап " .. stage .. " / " .. #Config.Obby.Platforms .. "   ·   " .. string.format("%.1f", elapsed) .. " сек."
 fill.Size = UDim2.fromScale(math.clamp((stage - 1) / math.max(1, #Config.Obby.Platforms - 1), 0, 1), 1)
 local record = player:GetAttribute("ObbyBestMilliseconds") or 0
 best.Text = "Контрольная точка " .. checkpoint .. " · падения не сбрасывают маршрут\n" .. (if record > 0 then "Рекорд " .. string.format("%.1f", record / 1000) .. " с · побед " .. (player:GetAttribute("ObbyWins") or 0) else "Награда: +" .. Config.Obby.RewardCoins .. " монет и +" .. Config.Obby.RewardXP .. " XP")
end
for _, name in ipairs({"ObbyActive", "ObbyStage", "ObbyCheckpoint", "ObbyStartedAt", "ObbyWins", "ObbyBestMilliseconds"}) do scope:Connect(player:GetAttributeChangedSignal(name), update) end
local function cleanup()
 if not scope.alive then return end
 scope:Destroy()
 gui:Destroy()
end
scope:Connect(stop.Event, cleanup)
scope:Connect(script.Destroying, cleanup)
update()
task.spawn(function()
 while scope.alive do
  task.wait(.2)
  if active then update() end
 end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="48">
        <Properties>
          <string name="Name">TutorialHUD</string>
          <string name="Source"><![CDATA[-- Подсказка ведёт к реальному объекту; выполнение и награды определяет сервер.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(shared:WaitForChild("TycoonConfig"))
local Theme = require(shared:WaitForChild("UITheme"))
local previous = playerGui:FindFirstChild("QuarterTutorialHUD")
if previous then
	local stop = previous:FindFirstChild("Stop")
	if stop then stop:Fire() end
	previous:Destroy()
end
local scope = Theme.Scope()
local gui = Theme.Make("ScreenGui", {Name = "QuarterTutorialHUD", ResetOnSpawn = false, IgnoreGuiInset = false, DisplayOrder = 5, ZIndexBehavior = Enum.ZIndexBehavior.Sibling}, playerGui)
local stop = Theme.Make("BindableEvent", {Name = "Stop"}, gui)
local bounds = Theme.Make("Frame", {Name = "Bounds", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0}, gui)
local banner = Theme.Make("Frame", {Name = "NextGoal", AnchorPoint = Vector2.new(.5, 0), Position = UDim2.new(.5, 0, 0, 108), Size = UDim2.fromOffset(420, 56), BackgroundColor3 = Theme.Colors.panel, BackgroundTransparency = .08, BorderSizePixel = 0, ZIndex = 1, Visible = false}, bounds)
Theme.Surface(banner, 12, Theme.Colors.teal)
local title = Theme.Label(banner, "Title", "", UDim2.new(1, -88, 0, 20), UDim2.fromOffset(12, 4), 13, Theme.Colors.teal)
local description = Theme.Label(banner, "Description", "", UDim2.new(1, -24, 0, 27), UDim2.fromOffset(12, 24), 11, Theme.Colors.text)
local distance = Theme.Label(banner, "Distance", "", UDim2.fromOffset(66, 20), UDim2.new(1, -76, 0, 4), 11, Theme.Colors.gold)
distance.TextXAlignment = Enum.TextXAlignment.Right
local glow = Theme.Make("Highlight", {Name = "QuarterTutorialTarget", Enabled = false, FillColor = Theme.Colors.teal, OutlineColor = Theme.Colors.gold, FillTransparency = .88, OutlineTransparency = .25, DepthMode = Enum.HighlightDepthMode.Occluded}, Workspace)
local shortDescriptions = {"Займи свободный дом · E / экранная кнопка.", "Построй первый этаж на синей площадке.", "Забери монеты из зелёной копилки.", "Улучши генератор на фиолетовой площадке.", "Наступи на стенд первого героя.", "Войди на арену и попади по бандиту."}

local function targetFor(step, root)
	local plots = Workspace:FindFirstChild("TycoonPlots")
	local ownPlot
	if plots then
		local nearest, best
		for _, plot in ipairs(plots:GetChildren()) do
			if plot:GetAttribute("OwnerUserId") == player.UserId then ownPlot = plot end
			if step == 1 and plot:GetAttribute("OwnerUserId") == 0 then
				local pad = plot:FindFirstChild("ClaimPad")
				local value = pad and (root.Position - pad.Position).Magnitude
				if value and (not best or value < best) then nearest, best = pad, value end
			end
		end
		if step == 1 then return nearest end
	end
	if step >= 2 and step <= 4 then
		local names = {[2] = "UpgradePad", [3] = "Collector", [4] = "DropperUpgradePad"}
		return ownPlot and ownPlot:FindFirstChild(names[step])
	end
	local campus = Workspace:FindFirstChild("HeroCampus")
	if step == 5 then
		local gallery = campus and campus:FindFirstChild("Gallery")
		if gallery then
			for _, model in ipairs(gallery:GetChildren()) do
				if model:GetAttribute("HeroId") == Config.Heroes[1].Id then return model:FindFirstChild("Pedestal") end
			end
		end
	elseif step == 6 then
		if player:GetAttribute("ArenaCombatOptIn") ~= true then return campus and campus:FindFirstChild("ArenaPortal") end
		local enemies = Workspace:FindFirstChild("TrainingEnemies")
		local nearest, best
		if enemies then
			for _, model in ipairs(enemies:GetChildren()) do
				if model:GetAttribute("Alive") == true and model.PrimaryPart then
					local value = (root.Position - model.PrimaryPart.Position).Magnitude
					if not best or value < best then nearest, best = model.PrimaryPart, value end
				end
			end
		end
		return nearest
	end
	return nil
end

local function refresh()
	if not scope.alive then return end
	local modal = playerGui:GetAttribute("QuarterModalOpen")
	local step = player:GetAttribute("TutorialStep") or 1
	local definition = Config.TutorialSteps[step]
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local compact = bounds.AbsoluteSize.Y < 440
	local hidden = not definition or (type(modal) == "string" and modal ~= "") or player:GetAttribute("ObbyActive") == true
		or (compact and playerGui:GetAttribute("QuarterToastOpen") == true)
	banner.Visible = not hidden
	local width = math.min(420, math.max(240, bounds.AbsoluteSize.X - 28))
	banner.Size = UDim2.fromOffset(width, if compact then 46 else 56)
	banner.Position = UDim2.new(.5, 0, 0, if compact then 98 else 108)
	description.Size = UDim2.new(1, -24, 0, if compact then 17 else 27)
	if hidden then glow.Enabled = false; return end
	if player:GetAttribute("DataReady") ~= true then
		title.Text = if player:GetAttribute("PersistenceStatus") == "error" then "Прогресс не удалось загрузить" else "Загружаем твой квартал…"
		description.Text = if player:GetAttribute("PersistenceStatus") == "error" then "Переподключись: сохранение остаётся защищённым." else "Покупки откроются после загрузки."
		distance.Text = ""; glow.Enabled = false; return
	end
	title.Text = step .. "/" .. #Config.TutorialSteps .. " · " .. definition.Title
	description.Text = if compact then shortDescriptions[step] else definition.Description
	local target = root and targetFor(step, root)
	if not root then description.Text = "Ждём появления персонажа…"
	elseif step == 1 and not target then description.Text = "Все дома заняты. Подожди свободного участка." end
	if target and target:IsA("BasePart") then
		local value = (root.Position - target.Position).Magnitude
		distance.Text = if value <= 10 then "Рядом" else "→ " .. math.floor(value)
		glow.Adornee = target
		glow.Enabled = player:GetAttribute("EffectsQuality") ~= "Off"
	else distance.Text = ""; glow.Enabled = false end
end

local elapsed = 0
scope:Connect(RunService.Heartbeat, function(delta)
	elapsed += delta
	if elapsed >= .35 then elapsed = 0; refresh() end
end)
for _, name in ipairs({"TutorialStep", "DataReady", "PlotId", "ArenaCombatOptIn", "ObbyActive", "PersistenceStatus", "EffectsQuality"}) do scope:Connect(player:GetAttributeChangedSignal(name), refresh) end
scope:Connect(playerGui:GetAttributeChangedSignal("QuarterModalOpen"), refresh)
scope:Connect(playerGui:GetAttributeChangedSignal("QuarterToastOpen"), refresh)
scope:Connect(bounds:GetPropertyChangedSignal("AbsoluteSize"), refresh)
local function cleanup()
	if not scope.alive then return end
	scope:Destroy()
	glow:Destroy()
	gui:Destroy()
end
scope:Connect(stop.Event, cleanup)
scope:Connect(script.Destroying, cleanup)
refresh()
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="49">
        <Properties>
          <string name="Name">TycoonUI</string>
          <string name="Source"><![CDATA[-- HUD and shop guide. Purchases and rewards always belong to the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("TycoonConfig"))
local Theme = require(Shared:WaitForChild("UITheme"))
local scope = Theme.Scope()
local remotes = ReplicatedStorage:WaitForChild("TycoonRemotes")
local notice = remotes:WaitForChild("Notice")
local actionRequest = remotes:WaitForChild("ActionRequest")
local monetizationRequest = remotes:WaitForChild("MonetizationRequest")

local gui = playerGui:FindFirstChild("TycoonHUD")
if not gui then
	gui = Instance.new("ScreenGui")
	gui.Name = "TycoonHUD"
	gui.Parent = playerGui
end
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.DisplayOrder = 30

-- A rerun asks the previous HUD to remove its listeners before rebuilding.
local oldRuntime = gui:FindFirstChild("TycoonUIRuntime")
if oldRuntime then
	local oldStop = oldRuntime:FindFirstChild("Stop")
	if oldStop and oldStop:IsA("BindableEvent") then
		oldStop:Fire()
	end
	oldRuntime:Destroy()
end

local runtime = Instance.new("Frame")
runtime.Name = "TycoonUIRuntime"
runtime.Size = UDim2.fromScale(1, 1)
runtime.BackgroundTransparency = 1
runtime.BorderSizePixel = 0
runtime.Parent = gui
local stopEvent = Instance.new("BindableEvent")
stopEvent.Name = "Stop"
stopEvent.Parent = runtime

local connections = {}
local statsConnections = {}
local alive = true
local function connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(connections, connection)
	return connection
end

local palette = Theme.Colors
local function make(className, properties, parent)
 local object = Theme.Make(className, properties, parent)
 if className == "TextButton" then Theme.DecorateButton(scope, object) end
 return object
end
local function corner(object, radius) Theme.Round(object, radius) end
local function label(parent, name, text, size, position, fontSize, color)
 return Theme.Label(parent, name, text, size, position, fontSize, color)
end

-- Compact top wallet and bottom dock leave the city and touch controls visible.
local hud = make("Frame", {Name = "Dashboard", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0}, runtime)
local wallet = make("Frame", {Name = "Wallet", AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(350, 80), BackgroundColor3 = palette.panel, BackgroundTransparency = 0.05, BorderSizePixel = 0}, hud)
Theme.Surface(wallet, 18)
local hudScale = make("UIScale", {Scale = 1}, wallet)
Theme.Icon(wallet, "coin", palette.gold, UDim2.fromOffset(25, 25), UDim2.fromOffset(14, 12))
local coinsText = label(wallet, "Coins", "Загрузка…", UDim2.fromOffset(198, 34), UDim2.fromOffset(48, 6), 22, palette.gold)
coinsText.TextScaled = true
make("UITextSizeConstraint", {MinTextSize = 14, MaxTextSize = 22}, coinsText)
local levelText = label(wallet, "Level", "УР. …", UDim2.fromOffset(86, 32), UDim2.fromOffset(252, 7), 15)
local xpText = label(wallet, "XP", "0 / 100 XP", UDim2.fromOffset(208, 18), UDim2.fromOffset(16, 43), 11, palette.muted)
local savingBadge = label(wallet, "Saving", "Загрузка", UDim2.fromOffset(109, 18), UDim2.fromOffset(225, 43), 10, palette.muted)
savingBadge.TextXAlignment = Enum.TextXAlignment.Right
local xpTrack = make("Frame", {Name = "XPTrack", Position = UDim2.fromOffset(16, 67), Size = UDim2.fromOffset(318, 5), BackgroundColor3 = palette.card, BorderSizePixel = 0}, wallet)
corner(xpTrack, 3)
local xpFill = make("Frame", {Name = "XPFill", Size = UDim2.fromScale(0, 1), BackgroundColor3 = palette.teal, BorderSizePixel = 0}, xpTrack)
corner(xpFill, 3)
local vitality = make("Frame", {Name = "Vitality", AnchorPoint = Vector2.new(.5, 1), Position = UDim2.new(.5, 0, 1, -146), Size = UDim2.fromOffset(274, 44), BackgroundColor3 = palette.panel, BackgroundTransparency = .14, BorderSizePixel = 0}, hud)
Theme.Surface(vitality, 13)
Theme.Icon(vitality, "health", palette.red, UDim2.fromOffset(15, 15), UDim2.fromOffset(12, 9))
local healthText = label(vitality, "Health", "100 HP", UDim2.fromOffset(93, 20), UDim2.fromOffset(33, 6), 11, palette.teal)
local skillText = label(vitality, "Ability", "Выбери костюм", UDim2.fromOffset(142, 20), UDim2.fromOffset(123, 6), 11, palette.muted)
skillText.TextXAlignment = Enum.TextXAlignment.Right
local healthTrack = make("Frame", {Name = "HealthTrack", Position = UDim2.fromOffset(12, 31), Size = UDim2.new(1, -24, 0, 4), BackgroundColor3 = palette.card, BorderSizePixel = 0}, vitality)
corner(healthTrack, 3)
local healthFill = make("Frame", {Name = "Fill", Size = UDim2.fromScale(1, 1), BackgroundColor3 = palette.teal, BorderSizePixel = 0}, healthTrack)
corner(healthFill, 3)
local shopButton = Theme.Button(scope, hud, "ShopButton", "База", UDim2.fromOffset(88, 44), UDim2.new(.5, -96, 1, -88))
shopButton.AnchorPoint = Vector2.new(.5, 1)
shopButton.TextXAlignment = Enum.TextXAlignment.Right
make("UIPadding", {PaddingRight = UDim.new(0, 12)}, shopButton)
Theme.Icon(shopButton, "house", palette.teal, UDim2.fromOffset(20, 20), UDim2.fromOffset(8, 12))
local settingsButton = Theme.Button(scope, hud, "SettingsButton", "Меню", UDim2.fromOffset(88, 44), UDim2.new(.5, 96, 1, -88))
settingsButton.AnchorPoint = Vector2.new(.5, 1)
