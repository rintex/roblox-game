      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">AdminService</string>
          <string name="Source"><![CDATA[-- Only the experience owner / explicit allowlist may use this remote.
local Players=game:GetService('Players')
local RunService=game:GetService('RunService')
local Service={};Service.__index=Service
function Service.new(config,profiles,tycoon,notice,request)
 return setmetatable({config=config,profiles=profiles,tycoon=tycoon,notice=notice,request=request,states={},connections={},destroyed=false},Service)
end
function Service:IsAuthorized(player)
 if RunService:IsStudio() and game.GameId==0 then return true end
 for _,id in ipairs(self.config.AdminUserIds or {}) do if id>0 and id==player.UserId then return true end end
 if game.CreatorId<=0 then return false end
 if game.CreatorType==Enum.CreatorType.User then return player.UserId==game.CreatorId end
 if game.CreatorType==Enum.CreatorType.Group then
  local ok,rank=pcall(function() return player:GetRankInGroup(game.CreatorId) end)
  return ok and rank==255
 end
 return false
end
function Service:_add(player)
 if self.destroyed or player.Parent~=Players or self.states[player] then return end
 local state={authorized=false,last=-math.huge};self.states[player]=state
 local authorized=self:IsAuthorized(player)
 -- Group ownership lookup yields; teardown must invalidate its continuation.
 if self.destroyed or player.Parent~=Players or self.states[player]~=state then return end
 state.authorized=authorized
 player:SetAttribute('IsGameAdmin',authorized)
end
function Service:_request(player,command)
 local state=self.states[player]
 if self.destroyed or not state or not state.authorized or player.Parent~=Players or type(command)~='string' then return end
 if self.profiles:IsClosing() or player:GetAttribute('DataReady')~=true then return end
 local profile=self.profiles:Get(player);if not profile then return end
 local now=os.clock();if now-state.last<1 then return end;state.last=now
 local character=player.Character
 local humanoid=character and character:FindFirstChildOfClass('Humanoid')
 if command=='GrantCoins' then
  profile.Coins=math.min(self.config.MaxCoins,profile.Coins+25000);self.tycoon:SyncPlayer(player)
 elseif command=='Heal' then
  if humanoid and humanoid.Health>0 then humanoid.Health=humanoid.MaxHealth end
 elseif command=='TeleportHome' then
  if player:GetAttribute('ObbyActive')==true then
   self.notice:FireClient(player,{kind='info',text='Сначала заверши обби или нажми «Выйти из обби».'});return
  end
  player:SetAttribute('ArenaCombatOptIn',false)
  local root=character and character:FindFirstChild('HumanoidRootPart')
  local target=Vector3.new(0,5,14)
  local state=self.tycoon:GetState(player)
  if state and state.plot then local base=state.plot:FindFirstChild('Base');if base then target=base.Position+Vector3.new(0,5,-20) end end
  if root and humanoid and humanoid.Health>0 then root.CFrame=CFrame.new(target) end
 elseif command=='PreviewVIP' or command=='PreviewNeon' then
  if not RunService:IsStudio() then return end
  local attribute=if command=='PreviewVIP' then 'HasVIP' else 'HasNeon'
  player:SetAttribute(attribute,player:GetAttribute(attribute)~=true)
 else return end
 self.notice:FireClient(player,{kind='info',text='Команда владельца выполнена.'})
end
function Service:Start()
 assert(not self.started and not self.destroyed,'AdminService is already running or destroyed');self.started=true
 table.insert(self.connections,self.request.OnServerEvent:Connect(function(player,command) self:_request(player,command) end))
 table.insert(self.connections,Players.PlayerAdded:Connect(function(player) task.spawn(function() self:_add(player) end) end))
 table.insert(self.connections,Players.PlayerRemoving:Connect(function(player) self.states[player]=nil end))
 for _,player in ipairs(Players:GetPlayers()) do task.spawn(function() self:_add(player) end) end
end
function Service:Destroy()
 if self.destroyed then return end;self.destroyed=true
 for _,c in ipairs(self.connections) do c:Disconnect() end;table.clear(self.connections);table.clear(self.states)
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">CombatRules</string>
          <string name="Source"><![CDATA[-- Чистые проверки боя: их выполняет сервер и автоматические тесты.
local Rules = {}

function Rules.IsFinite(value, limit)
	return type(value) == "number" and value == value and math.abs(value) ~= math.huge
		and (limit == nil or math.abs(value) <= limit)
end

function Rules.IsVector(value)
	return typeof(value) == "Vector3" and Rules.IsFinite(value.X, 100000)
		and Rules.IsFinite(value.Y, 100000) and Rules.IsFinite(value.Z, 100000)
end

function Rules.CastDirection(origin, aim, range)
	if not Rules.IsVector(origin) or not Rules.IsVector(aim) or not Rules.IsFinite(range, 1000) or range <= 0 then
		return nil
	end
	local delta = aim - origin
	if not Rules.IsFinite(delta.Magnitude, 10000) or delta.Magnitude < 0.05 then return nil end
	-- Клиент задаёт только направление; длину луча устанавливает сервер.
	return delta.Unit * range
end

function Rules.CooldownReady(now, last, cooldown)
	return Rules.IsFinite(now) and type(last) == "number" and Rules.IsFinite(cooldown, 60)
		and cooldown >= 0 and now - last >= cooldown
end

function Rules.InArena(position)
	return Rules.IsVector(position) and math.abs(position.X) <= 48
		and position.Z >= -158 and position.Z <= -82 and position.Y >= -2 and position.Y <= 30
end

-- Геометрия телеграфированного рывка: X/Z фиксированы при замахе.
-- Игрок может уйти в сторону; клиент не передаёт список попавших целей.
function Rules.SegmentDistance(position, from, to)
	if not Rules.IsVector(position) or not Rules.IsVector(from) or not Rules.IsVector(to) then return math.huge end
	local dx, dz = to.X - from.X, to.Z - from.Z
	local lengthSquared = dx * dx + dz * dz
	local alpha = if lengthSquared > 0.0001 then math.clamp(((position.X - from.X) * dx + (position.Z - from.Z) * dz) / lengthSquared, 0, 1) else 0
	local x, z = from.X + dx * alpha, from.Z + dz * alpha
	return math.sqrt((position.X - x) ^ 2 + (position.Z - z) ^ 2)
end

function Rules.BossPhase(health, maximum)
	if not Rules.IsFinite(health) or not Rules.IsFinite(maximum) or maximum <= 0 then return 1 end
	if health / maximum <= 0.30 then return 3 end
	if health / maximum <= 0.65 then return 2 end
	return 1
end

function Rules.PvPAllowed(attacker, target)
	return attacker ~= nil and target ~= nil and attacker.id ~= target.id
		and attacker.ready == true and target.ready == true
		and attacker.optedIn == true and target.optedIn == true
		and attacker.alive == true and target.alive == true
		and attacker.protected ~= true and target.protected ~= true
		and Rules.InArena(attacker.position) and Rules.InArena(target.position)
end

function Rules.OwnsWeapon(config, profile, id)
	if type(id) ~= "string" or #id > 48 or type(profile.Inventory) ~= "table" then return false end
	local count = profile.Inventory[id]
	return config.GetWeapon(id) ~= nil and Rules.IsFinite(count, config.MaxWeaponCopies or 99) and count >= 1 and count % 1 == 0
end

function Rules.ApplyDamage(target, amount)
	if target.dead or not Rules.IsFinite(target.health) or target.health <= 0
		or not Rules.IsFinite(amount, 10000) or amount <= 0 then return 0, false end
	local applied = math.min(target.health, amount)
	target.health -= applied
	local killed = target.health <= 0
	if killed then target.dead = true end
	return applied, killed
end

function Rules.Reward(config, profile, coins, xp)
	local earnedCoins = math.max(0, math.min(coins, config.MaxCoins - profile.Coins))
	local earnedXP = math.max(0, math.min(xp, config.MaxXP - profile.XP))
	profile.Coins += earnedCoins
	profile.XP += earnedXP
	profile.EnemiesDefeated = math.min(config.MaxEnemiesDefeated or 1000000000, (profile.EnemiesDefeated or 0) + 1)
	return earnedCoins, earnedXP
end

return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">CostumePadService</string>
          <string name="Source"><![CDATA[-- Наступание на стенд меняет костюм. Нового RemoteEvent для этого не требуется.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Service = {}
Service.__index = Service

function Service.new(config, heroes, campus)
	return setmetatable({config = config, heroes = heroes, campus = campus, connections = {}, lastTouch = {}, destroyed = false}, Service)
end

function Service:_equip(player, pad, id)
	if self.destroyed or not pad:IsDescendantOf(Workspace) or not pad:IsDescendantOf(self.campus)
		or player.Parent ~= Players or player:GetAttribute("ObbyActive") == true then return end
	local profile = self.heroes:_profile(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not profile or not humanoid or not (humanoid.Health > 0) or not root or not root:IsA("BasePart") then return end
	local delta = root.Position - pad.Position
	-- Touch можно подделать через физику: отдельно проверяем положение тела на площадке.
	if delta.X ~= delta.X or delta.Y ~= delta.Y or delta.Z ~= delta.Z
		or math.abs(delta.X) > pad.Size.X / 2 + 0.5 or math.abs(delta.Z) > pad.Size.Z / 2 + 0.5
		or delta.Y < pad.Size.Y / 2 or delta.Y > pad.Size.Y / 2 + 5.5 then return end
	if profile.EquippedHero == id and (profile.EquippedWeapon or "") == "" then return end
	local now = os.clock()
	if now - (self.lastTouch[player] or -math.huge) < 1.2 then return end
	self.lastTouch[player] = now
	local ok, message = self.heroes:Equip(player, id)
	self.heroes:_notify(player, message, ok and "success" or "info")
end

function Service:Start()
	assert(not self.started and not self.destroyed, "CostumePadService уже запущен или завершён")
	self.started = true
	local gallery = self.campus:WaitForChild("Gallery")
	for _, model in ipairs(gallery:GetChildren()) do
		local id = model:GetAttribute("HeroId")
		local pad = model:FindFirstChild("Pedestal")
		assert(self.config.GetHero(id) and pad and pad:IsA("BasePart"), "Некорректный стенд костюма")
		pad.CanTouch = true
		table.insert(self.connections, pad.Touched:Connect(function(hit)
			local node = hit
			while node and node ~= Workspace do
				if node:IsA("Model") then
					local player = Players:GetPlayerFromCharacter(node)
					if player then self:_equip(player, pad, id); return end
				end
				node = node.Parent
			end
		end))
	end
	table.insert(self.connections, Players.PlayerRemoving:Connect(function(player) self.lastTouch[player] = nil end))
end

function Service:Destroy()
	if self.destroyed then return end
	self.destroyed = true
	for _, connection in ipairs(self.connections) do connection:Disconnect() end
	table.clear(self.connections)
	table.clear(self.lastTouch)
end

return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">EnemyAI</string>
          <string name="Source"><![CDATA[-- Серверная AI для открытой арены: преследование, разделение NPC и атаки с окнами уклонения.
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Rules = require(script.Parent:WaitForChild("CombatRules"))
local AI = {}
AI.__index = AI

function AI.new(combat)
	return setmetatable({combat = combat, elapsed = 0, time = 0}, AI)
end

function AI:_state(record, text)
	if record.model:GetAttribute("State") ~= text then record.model:SetAttribute("State", text) end
	if record.stateLabel and record.stateLabel.Text ~= text then record.stateLabel.Text = text end
end

function AI:_target(player)
	local data, humanoid, root = self.combat:_combatant(player)
	if data.ready and data.alive and data.optedIn and not data.protected and Rules.InArena(data.position)
		and player:GetAttribute("ObbyActive") ~= true then return humanoid, root end
	return nil
end

function AI:_visible(record, player, root, from)
	local origin = from or record.center.Position
	local delta = root.Position - origin
	if delta.Magnitude < 0.1 then return true end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {record.model}
	params.IgnoreWater = true
	local hit = Workspace:Raycast(origin, delta, params)
	return hit == nil or hit.Instance:IsDescendantOf(player.Character)
end

function AI:_move(record, destination, seconds)
	local current = record.center.Position
	local delta = Vector3.new(destination.X - current.X, 0, destination.Z - current.Z)
	if delta.Magnitude < 0.05 then self:_animate(record, false); return end
	local direction = delta.Unit
	-- Небольшое разделение не даёт бандитам собраться в одну пересекающуюся модель.
	local separation = Vector3.new(0, 0, 0)
	for _, other in pairs(self.combat.targets) do
		if other ~= record and not other.dead then
			local apart = Vector3.new(current.X - other.center.Position.X, 0, current.Z - other.center.Position.Z)
			if apart.Magnitude > 0.05 and apart.Magnitude < 5 then separation += apart.Unit * (1 - apart.Magnitude / 5) end
		end
	end
	local steering = direction + separation * 0.8
	if steering.Magnitude > 0.05 then direction = steering.Unit end
	local phase = if record.boss then Rules.BossPhase(record.health, record.maxHealth) else 1
	local speed = record.ai.Speed * (1 + (phase - 1) * 0.1)
	if self.time < (record.slowUntil or 0) then speed *= record.slowFactor or 0.55 end
	local nextPosition = current + direction * math.min(delta.Magnitude, speed * math.min(seconds, 1))
	nextPosition = Vector3.new(math.clamp(nextPosition.X, -44, 44), record.home.Y, math.clamp(nextPosition.Z, -153, -87))
	local travel = nextPosition - current
	if travel.Magnitude > 0.05 then
		local parameters = RaycastParams.new()
		parameters.FilterType = Enum.RaycastFilterType.Exclude
		parameters.FilterDescendantsInstances = {self.combat.targetFolder}
		parameters.IgnoreWater = true
		parameters.RespectCanCollide = true
		local obstacle = Workspace:Raycast(current, travel, parameters)
		if obstacle and obstacle.Instance.CanCollide == true then self:_animate(record, false); return end
	end
	-- Anchored-части никогда не передаются под сетевое управление клиента.
	record.model:PivotTo(CFrame.lookAt(nextPosition, nextPosition + direction) * CFrame.Angles(0, math.pi, 0))
	self:_animate(record, true)
end

function AI:_animate(record, walking)
	local pose = if walking then "walk" elseif record.pending then "windup" else "idle"
	if pose ~= "walk" and record.pose == pose and record.poseFrame == record.center.CFrame then return end
	record.pose, record.poseFrame = pose, record.center.CFrame
	local swing = if walking then math.sin(self.time * 9) * 0.35 else 0
	for _, limb in ipairs(record.limbs) do
		local angle = swing * limb.side * (if limb.arm then -1 else 1)
		if record.pending and limb.arm then angle = -1.1 end
		local rest = limb.rest.Position
		local pivot = Vector3.new(rest.X, if limb.arm then record.center.Size.Y * 0.4 else -record.center.Size.Y * 0.4, rest.Z)
		limb.part.CFrame = record.center.CFrame * CFrame.new(pivot) * CFrame.Angles(angle, 0, 0) * CFrame.new(rest - pivot)
	end
end

function AI:_warning(record, visible, pending)
	local warning = record.warning
	if warning then
		local transparency = if visible then 0.35 else 1
		if warning.Transparency ~= transparency then warning.Transparency = transparency end
		warning.CanQuery = false
		if visible and pending then
			local floorFrom = Vector3.new(pending.from.X, 0.3, pending.from.Z)
			if pending.kind == "rush" then
				local floorTo = Vector3.new(pending.to.X, 0.3, pending.to.Z)
				warning.Shape = Enum.PartType.Block
				warning.Size = Vector3.new(pending.radius * 2, 0.05, (floorTo - floorFrom).Magnitude + pending.radius * 2)
				warning.CFrame = CFrame.lookAt((floorFrom + floorTo) * 0.5, floorTo)
			else
				warning.Shape = Enum.PartType.Cylinder
				warning.Size = Vector3.new(0.05, pending.radius * 2, pending.radius * 2)
				warning.CFrame = CFrame.new(floorFrom) * CFrame.Angles(0, 0, math.pi / 2)
			end
		end
	end
	record.model:SetAttribute("Attacking", visible)
end

function AI:Reset(record)
	record.pending = nil
	record.nextAttack = self.time + 1
	record.slowUntil = 0
	record.staggerUntil = 0
	record.attackCycle = 0
	self:_state(record, "Патруль")
	self:_warning(record, false)
	record.model:PivotTo(CFrame.new(record.home))
	self:_animate(record, false)
end

function AI:_damage(record, player, humanoid, root, amount)
	local applied = math.min(humanoid.Health, amount)
	if applied <= 0 then return end
	humanoid:TakeDamage(applied)
	self.combat:_hurt(player, applied, record.center.Position)
end

function AI:_finish(record, pending)
	self:_warning(record, false)
	if pending.kind == "melee" then
		local humanoid, root = self:_target(pending.player)
		if humanoid and (root.Position - pending.from).Magnitude <= pending.radius
			and self:_visible(record, pending.player, root, pending.from) then
			self:_damage(record, pending.player, humanoid, root, record.ai.Damage)
		end
		return
	end
	self.combat:_effect("boss_impact", pending.from, pending.to, {Color = {255, 100, 74}}, "bandit", {
		radius = pending.radius, duration = 0.4, style = pending.kind,
	})
	for _, player in ipairs(self.combat.players:GetPlayers()) do
		local humanoid, root = self:_target(player)
		if humanoid then
			local inside = if pending.kind == "rush" then Rules.SegmentDistance(root.Position, pending.from, pending.to) <= pending.radius
				else Rules.SegmentDistance(root.Position, pending.from, pending.from) <= pending.radius
			if inside and math.abs(root.Position.Y - pending.from.Y) <= 6
				and self:_visible(record, player, root, pending.from) then
				self:_damage(record, player, humanoid, root, math.floor(record.ai.Damage * (if pending.kind == "rush" then 0.9 else 1)))
			end
		end
	end
	if pending.kind == "rush" then
		local direction = pending.to - pending.from
		if direction.Magnitude > 0.05 then record.model:PivotTo(CFrame.lookAt(pending.to, pending.to + direction) * CFrame.Angles(0, math.pi, 0)) end
	end
end

function AI:_begin(record, player, root, phase)
	record.attackCycle = (record.attackCycle or 0) + 1
	local kind = "melee"
	if record.boss and phase >= 2 then
		if phase == 3 and record.attackCycle % 3 == 0 then kind = "rush"
		elseif record.attackCycle % 2 == 0 then kind = "shockwave" end
	end
	local windup = if kind == "shockwave" then 1.2 elseif kind == "rush" then 1.15 else record.ai.Windup
	local radius = if kind == "shockwave" then 10 elseif kind == "rush" then 3.5 else record.ai.AttackRange
	local from = record.center.Position
	local facing = Vector3.new(root.Position.X - from.X, 0, root.Position.Z - from.Z)
	if facing.Magnitude > 0.05 then record.model:PivotTo(CFrame.lookAt(from, from + facing) * CFrame.Angles(0, math.pi, 0)) end
	local destination = from
	if kind == "rush" then
		local delta = Vector3.new(root.Position.X - from.X, 0, root.Position.Z - from.Z)
		if delta.Magnitude > 0.1 then
			local travel = from + delta.Unit * math.min(delta.Magnitude + 4, 26)
			destination = Vector3.new(math.clamp(travel.X, -44, 44), record.home.Y, math.clamp(travel.Z, -153, -87))
			local parameters = RaycastParams.new()
			parameters.FilterType = Enum.RaycastFilterType.Exclude
			local excluded = {self.combat.targetFolder}
			for _, candidate in ipairs(self.combat.players:GetPlayers()) do if candidate.Character then table.insert(excluded, candidate.Character) end end
			parameters.FilterDescendantsInstances = excluded
			parameters.IgnoreWater = true
			parameters.RespectCanCollide = true
			local path = destination - from
			local obstacle = Workspace:Raycast(from, path, parameters)
			if obstacle and obstacle.Instance.CanCollide == true then
				local allowed = math.max(0, (obstacle.Position - from).Magnitude - 2)
				destination = from + path.Unit * math.min(path.Magnitude, allowed)
			end
		end
		if (destination - from).Magnitude < 1 then kind, radius, windup = "shockwave", 10, 1.2; destination = from end
	end
	record.pending = {player = player, at = self.time + windup, kind = kind, radius = radius, from = from, to = destination}
	record.nextAttack = self.time + windup + record.ai.Cooldown
	self:_state(record, if kind == "rush" then "РЫВОК — уйди в сторону!" elseif kind == "shockwave" then "ВОЛНА — выйди из круга!" else "Замах — отойди!")
	self:_warning(record, true, record.pending)
	self:_animate(record, false)
	if kind ~= "melee" then
		self.combat:_effect("boss_warning", from, destination, {Color = {255, 108, 80}}, "bandit", {
			radius = radius, duration = windup, style = kind,
		})
	end
end

function AI:_step(record, seconds)
	if record.dead or not record.model.Parent then
		record.pending = nil
		self:_warning(record, false)
		return
	end
	if record.pending then
		self:_animate(record, false)
		if self.time < record.pending.at then return end
		local pending = record.pending
		record.pending = nil
		self:_finish(record, pending)
		return
	end
	if self.time < (record.staggerUntil or 0) then self:_animate(record, false); return end
	local nearest, nearestRoot, nearestDistance
	for _, player in ipairs(self.combat.players:GetPlayers()) do
		local humanoid, root = self:_target(player)
		if humanoid then
			local distance = (root.Position - record.center.Position).Magnitude
			if distance <= record.ai.AggroRange and (not nearestDistance or distance < nearestDistance) then
				nearest, nearestRoot, nearestDistance = player, root, distance
			end
		end
	end
	if not nearest then
		self:_state(record, "Патруль")
		self:_move(record, record.home, seconds)
		return
	end
	local phase = if record.boss then Rules.BossPhase(record.health, record.maxHealth) else 1
	if nearestDistance <= record.ai.AttackRange then
		self:_animate(record, false)
		if self.time >= (record.nextAttack or 0) and self:_visible(record, nearest, nearestRoot) then self:_begin(record, nearest, nearestRoot, phase) end
	else
		self:_state(record, "Преследует")
		self:_move(record, nearestRoot.Position, seconds)
	end
end

function AI:Step(seconds)
	if self.combat.destroyed or self.combat.profiles:IsClosing() then return end
	self.time += seconds
	for _, record in pairs(self.combat.targets) do self:_step(record, seconds) end
end

function AI:Start()
	assert(not self.connection, "EnemyAI уже запущен")
	self.connection = RunService.Heartbeat:Connect(function(seconds)
		self.elapsed += seconds
		if self.elapsed < 0.1 then return end
		local delta = math.min(self.elapsed, 0.25)
		self.elapsed = 0
		self:Step(delta)
	end)
end

function AI:Destroy()
	if self.connection then self.connection:Disconnect(); self.connection = nil end
end

return AI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">HeroCombatService</string>
          <string name="Source"><![CDATA[-- Сервер выдаёт костюмы/оружие и проверяет каждый выстрел. Клиент передаёт лишь точку прицеливания.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Rules = require(script.Parent:WaitForChild("CombatRules"))
local Style = require(script.Parent:WaitForChild("VisualStyle"))
local EnemyAI = require(script.Parent:WaitForChild("EnemyAI"))

local HeroCombatService = {}
HeroCombatService.__index = HeroCombatService

local BODY_COLORS = { "HeadColor3", "TorsoColor3", "LeftArmColor3", "RightArmColor3", "LeftLegColor3", "RightLegColor3" }

local function colorFor(definition)
	local rgb = definition.Color or { 80, 205, 255 }
	return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

local function part(parent, name, size, frame, color, material)
	local value = Instance.new("Part")
	value.Name = name
	value.Size = size
	value.CFrame = frame
	value.Color = color
	value.Material = material or Enum.Material.Metal
	value.TopSurface = Enum.SurfaceType.Smooth
	value.BottomSurface = Enum.SurfaceType.Smooth
	value.Anchored = true
	value.Parent = parent
	return value
end

local function attach(parent, anchor, name, size, offset, color, material, shape)
	local value = part(parent, name, size, anchor.CFrame * offset, color, material)
	value.Anchored = false
	value.CanCollide = false
	value.CanTouch = false
	value.CanQuery = false
	value.Massless = true
	if shape then value.Shape = shape end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = anchor
	weld.Part1 = value
	weld.Parent = value
	return value
end

local function liveCharacter(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not humanoid or not Rules.IsFinite(humanoid.Health) or humanoid.Health <= 0
		or not root or not root:IsA("BasePart") then return nil end
	return character, humanoid, root
end

function HeroCombatService.new(config, profiles, tycoon, notice, skillRemote, effectRemote)
	return setmetatable({
		config = config, profiles = profiles, tycoon = tycoon, notice = notice,
		skillRemote = skillRemote, effectRemote = effectRemote, players = Players,
		connections = {}, playerConnections = {}, issuedTools = {}, appearances = {},
		nextAttackAt = {}, lastRequest = {}, lastEquip = {}, targets = {}, targetParts = {},
		started = false, destroyed = false,
	}, HeroCombatService)
end

function HeroCombatService:_profile(player)
	if self.destroyed or self.profiles:IsClosing() or player.Parent ~= self.players
		or player:GetAttribute("DataReady") ~= true then return nil end
	local profile = self.profiles:Get(player)
	local state = self.tycoon:GetState(player)
	if not profile or not state or state.leaving or state.profile ~= profile then return nil end
	return profile
end

function HeroCombatService:_notify(player, text, kind)
	if player.Parent == self.players then self.notice:FireClient(player, { text = text, kind = kind or "info" }) end
end

function HeroCombatService:_definition(profile)
	local weaponId = profile.EquippedWeapon or ""
	if weaponId ~= "" and Rules.OwnsWeapon(self.config, profile, weaponId) then
		local key = "loot:" .. weaponId
		return self.config.WeaponStats(self.config.GetWeapon(weaponId), self.config.GetUpgradeLevel(profile, key)), key
	end
	local hero = self.config.GetHero(profile.EquippedHero or "")
	if hero and self.config.CanUseHero(profile, hero) then
		return self.config.WeaponStats(hero, self.config.GetUpgradeLevel(profile, "hero:" .. hero.Id)), hero.Id
	end
	return nil
end

function HeroCombatService:_clearAppearance(player)
	local old = self.appearances[player]
	if not old then return end
	if old.folder.Parent then old.folder:Destroy() end
	if old.colors.Parent then
		if old.created then old.colors:Destroy()
		else for name, value in pairs(old.original) do old.colors[name] = value end end
	end
	for _, change in ipairs(old.modified or {}) do
		if change.object.Parent then change.object[change.property] = change.value end
	end
	self.appearances[player] = nil
end

function HeroCombatService:_removeTool(player)
	local old = self.issuedTools[player]
	if old then old:Destroy() end
	self.issuedTools[player] = nil
end

function HeroCombatService:_costume(player, character, hero)
 self:_clearAppearance(player)
 if not hero then return end
 local torso=character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
 local head=character:FindFirstChild("Head")
 if not torso or not torso:IsA("BasePart") or not head or not head:IsA("BasePart") then return end
 local kind=hero.Style
 local accent=colorFor(hero)
 local gold=Color3.fromRGB(223,177,74)
 local dark=Color3.fromRGB(25,31,43)
 local colors=character:FindFirstChildOfClass("BodyColors")
 local created=colors==nil
 if not colors then colors=Instance.new("BodyColors");colors.Parent=character end
 local original={}
 for _,name in ipairs(BODY_COLORS) do original[name]=colors[name];colors[name]=accent end
 if kind=="spider" then colors.LeftLegColor3=Color3.fromRGB(29,64,132);colors.RightLegColor3=colors.LeftLegColor3
 elseif kind=="hulk" then colors.LeftLegColor3=Color3.fromRGB(95,55,141);colors.RightLegColor3=colors.LeftLegColor3
 elseif kind=="thor" then colors.HeadColor3=Color3.fromRGB(218,174,137) end
 local folder=Instance.new("Folder");folder.Name="HeroArmor";folder.Parent=character
 local appearance={folder=folder,colors=colors,original=original,created=created,modified={}}
 self.appearances[player]=appearance
 local function hide(object,property,value)
  table.insert(appearance.modified,{object=object,property=property,value=object[property]})
  object[property]=value
 end
 -- Keep the player's avatar recoverable when the costume changes or is removed.
 for _,object in ipairs(character:GetChildren()) do
  if object:IsA("Shirt") then hide(object,"ShirtTemplate","")
  elseif object:IsA("Pants") then hide(object,"PantsTemplate","")
  elseif object:IsA("ShirtGraphic") then hide(object,"Graphic","")
  elseif object:IsA("Accessory") then
   local handle=object:FindFirstChild("Handle");if handle and handle:IsA("BasePart") then hide(handle,"Transparency",1) end
  end
 end
 for _,object in ipairs(head:GetChildren()) do if object:IsA("Decal") then hide(object,"Transparency",1) end end
 local material=if kind=="iron" or kind=="iron_gold" or kind=="thor" then Enum.Material.Metal else Enum.Material.Fabric
 local chest=attach(folder,torso,"ChestArmor",Vector3.new(torso.Size.X*1.02,torso.Size.Y*1.02,0.16),CFrame.new(0,0,-torso.Size.Z/2-0.10),accent,material)
 Style.Chest(chest,kind)
 local helmetColor=if kind=="iron" or kind=="iron_gold" then gold elseif kind=="thor" then colors.HeadColor3 else accent
 local mask=attach(folder,head,"CostumeHead",head.Size*1.03,CFrame.new(),helmetColor,material)
 Style.Face(mask,kind)
 if kind=="iron" or kind=="iron_gold" then
  attach(folder,torso,"EnergyCore",Vector3.new(0.35,0.35,0.08),CFrame.new(0,torso.Size.Y*0.1,-torso.Size.Z/2-0.23),Color3.fromRGB(192,251,255),Enum.Material.Neon,Enum.PartType.Ball)
  for _,side in ipairs({-1,1}) do
   attach(folder,torso,"ShoulderArmor"..side,Vector3.new(0.65,0.45,0.8),CFrame.new(side*(torso.Size.X/2+0.2),torso.Size.Y*0.3,0),gold,Enum.Material.Metal)
   attach(folder,torso,"Thruster"..side,Vector3.new(0.3,0.8,0.3),CFrame.new(side*0.6,0,torso.Size.Z/2+0.18),accent,Enum.Material.Metal)
  end
 elseif kind=="hulk" then
  for _,side in ipairs({-1,1}) do
   attach(folder,torso,"MuscleShoulder"..side,Vector3.new(0.95,0.8,1),CFrame.new(side*(torso.Size.X/2+0.27),torso.Size.Y*0.28,0),accent,Enum.Material.SmoothPlastic,Enum.PartType.Ball)
  end
 elseif kind=="thor" then
  attach(folder,torso,"RedCape",Vector3.new(torso.Size.X*1.2,torso.Size.Y*1.8,0.15),CFrame.new(0,-torso.Size.Y*0.2,torso.Size.Z/2+0.18),Color3.fromRGB(170,35,38),Enum.Material.Fabric)
 end
end

function HeroCombatService:_giveTool(player, definition, id)
	self:_removeTool(player)
	if not definition then return end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then return end
	local tool = Instance.new("Tool")
	tool.Name = definition.Weapon or definition.Name
	tool.RequiresHandle = true
	tool.CanBeDropped = false
	tool.ToolTip = "Арена: нажмите или коснитесь для атаки"
	tool:SetAttribute("HeroWeapon", id)
	tool:SetAttribute("WeaponKind", definition.Kind)
	tool:SetAttribute("AttackCooldown", definition.Cooldown)
	local accent = colorFor(definition)
	local handle = part(tool, "Handle", Vector3.new(0.35, 1.0, 0.35), CFrame.new(), Color3.fromRGB(28, 36, 54))
	handle.Anchored = false
	handle.CanCollide = false
	handle.CanTouch = false
	handle.CanQuery = false
	handle.Massless = true
	if definition.Id == "titan" then
		handle.Transparency = 1
		attach(tool, handle, "HulkFist", Vector3.new(0.8, 0.8, 0.8), CFrame.new(0, 0.5, 0), accent, Enum.Material.SmoothPlastic)
	elseif definition.Kind == "slam" or definition.Style == "thor" then
		attach(tool, handle, "GravityHead", Vector3.new(1.6, 0.7, 0.7), CFrame.new(0, 0.8, 0), accent)
		attach(tool, handle, "GravityCore", Vector3.new(0.4, 0.8, 0.78), CFrame.new(0, 0.8, 0), accent, Enum.Material.Neon)
	else
		attach(tool, handle, "Emitter", Vector3.new(0.6, 0.55, 1.2), CFrame.new(0, 0.45, -0.3), Color3.fromRGB(38, 48, 68))
		attach(tool, handle, "Barrel", Vector3.new(0.3, 0.3, 0.6), CFrame.new(0, 0.45, -1.05), accent, Enum.Material.Neon)
	end
	self.issuedTools[player] = tool
	tool.Parent = backpack
	local character, humanoid = liveCharacter(player)
	if character and humanoid then humanoid:EquipTool(tool) end
end

function HeroCombatService:ApplyPerks(player, humanoid, profile)
	if player:GetAttribute("ObbyActive") == true then humanoid.WalkSpeed = self.config.Obby.WalkSpeed; return end
	local speed = (profile.Floor >= 3 or (profile.Rebirths or 0) > 0) and self.config.ThirdFloorWalkSpeed or self.config.DefaultWalkSpeed
	local hero = self.config.GetHero(profile.EquippedHero or "")
	if hero and self.config.CanUseHero(profile, hero) then speed = math.max(speed, hero.WalkSpeed or speed) end
	humanoid.WalkSpeed = speed
end

function HeroCombatService:Refresh(player)
	local profile = self:_profile(player)
	if not profile then self:_removeTool(player); self:_clearAppearance(player); return end
	local hero = self.config.GetHero(profile.EquippedHero or "")
	if not hero or not self.config.CanUseHero(profile, hero) then hero = nil end
	local character, humanoid = liveCharacter(player)
	if character then self:_costume(player, character, hero); self:ApplyPerks(player, humanoid, profile) end
	local definition, id = self:_definition(profile)
	self:_giveTool(player, definition, id)
end

HeroCombatService.RefreshPlayer = HeroCombatService.Refresh

function HeroCombatService:_equipReady(player)
	local profile = self:_profile(player)
	if not profile then return nil, "Дождитесь загрузки прогресса." end
	local now = os.clock()
	if not Rules.CooldownReady(now, self.lastEquip[player] or -math.huge, 0.3) then return nil, "Подождите перед сменой снаряжения." end
	self.lastEquip[player] = now
	return profile
end

function HeroCombatService:Equip(player, id)
	if type(id) ~= "string" or #id > 48 then return false, "Неизвестный герой." end
	local profile, reason = self:_equipReady(player)
	if not profile then return false, reason end
	local hero = id ~= "" and self.config.GetHero(id) or nil
	if id ~= "" and (not hero or not self.config.CanUseHero(profile, hero)) then return false, "Этот герой ещё не открыт. Стройте этажи и делайте перерождения." end
	profile.EquippedHero = id
	profile.EquippedWeapon = ""
	self.tycoon:SyncPlayer(player)
	self:Refresh(player)
	return true, hero and ("Герой «" .. hero.Name .. "» выбран. Оружие готово!") or "Костюм снят."
end

function HeroCombatService:EquipWeapon(player, id)
	if type(id) ~= "string" or #id > 48 then return false, "Неизвестное оружие." end
	local profile, reason = self:_equipReady(player)
	if not profile then return false, reason end
	if id ~= "" and not Rules.OwnsWeapon(self.config, profile, id) then return false, "Сначала получите это оружие из бесплатного контейнера." end
	profile.EquippedWeapon = id
	self.tycoon:SyncPlayer(player)
	self:Refresh(player)
	local definition = self.config.GetWeapon(id)
	return true, definition and ("Оружие «" .. definition.Name .. "» экипировано!") or "Выбрано оружие героя."
end

function HeroCombatService:UpgradeWeapon(player, key)
	if type(key) ~= "string" or #key > 48 then return false, "Неизвестное оружие." end
	local profile, reason = self:_equipReady(player)
	if not profile then return false, reason end
	local definition
	local heroId = string.match(key, "^hero:(.+)$")
	local weaponId = string.match(key, "^loot:(.+)$")
	if heroId then
		local hero = self.config.GetHero(heroId)
		if hero and self.config.CanUseHero(profile, hero) then definition = hero end
	elseif weaponId and Rules.OwnsWeapon(self.config, profile, weaponId) then
		definition = self.config.GetWeapon(weaponId)
	end
	if not definition then return false, "Сначала откройте этого героя или получите оружие." end
	local level = self.config.GetUpgradeLevel(profile, key)
	local cost = self.config.WeaponUpgradeCosts[level + 1]
	if not cost then return false, "Оружие уже улучшено до максимума." end
	if profile.Coins < cost then return false, "Для улучшения нужно " .. cost .. " монет." end
	-- Цена, уровень и характеристики серверные. Нет yield между проверкой и списанием.
	profile.Coins -= cost
	profile.WeaponUpgrades = profile.WeaponUpgrades or {}
	profile.WeaponUpgrades[key] = level + 1
	self.tycoon:SyncPlayer(player)
	local _, equipped = self:_definition(profile)
	if equipped == key or equipped == heroId then self:Refresh(player) end
	local stats = self.config.WeaponStats(definition, level + 1)
	return true, (definition.Weapon or definition.Name) .. " улучшено: +" .. (level + 1) .. ", урон " .. stats.Damage .. "!"
end

function HeroCombatService:_targetLabel(record)
	record.model:SetAttribute("Health", record.health)
	record.model:SetAttribute("Alive", not record.dead)
	local phase = if record.boss then Rules.BossPhase(record.health, record.maxHealth) else 1
	record.model:SetAttribute("Phase", phase)
	record.label.Text = record.name .. (if record.boss then " · " .. phase .. "/3" else "") .. "\n" .. math.ceil(record.health) .. " / " .. record.maxHealth
	if record.bar then record.bar.Size = UDim2.fromScale(math.clamp(record.health / record.maxHealth, 0, 1), 1) end
	if record.renderedDead == record.dead then return end
	record.renderedDead = record.dead
	for _, object in ipairs(record.model:GetChildren()) do
		if object:IsA("BasePart") then
			object.Transparency = record.dead and 0.8 or 0
			object.CanQuery = not record.dead
			object.CanCollide = false
			object.CanTouch = false
			if object == record.warning then object.Transparency = 1; object.CanQuery = false end
			for _, surface in ipairs(object:GetChildren()) do
				if surface:IsA("SurfaceGui") then surface.Enabled = not record.dead end
			end
		end
	end
end

function HeroCombatService:_buildTargets()
	-- Управляем только папкой, созданной этим модулем.
	local folder = Workspace:FindFirstChild("TrainingEnemies")
	if folder then
		assert(folder:IsA("Folder") and folder:GetAttribute("HeroCombatManaged") == true, "TrainingEnemies уже используется другим объектом")
		folder:Destroy()
	end
	folder = Instance.new("Folder")
	folder.Name = "TrainingEnemies"
	folder:SetAttribute("HeroCombatManaged", true)
	folder.Parent = Workspace
	self.targetFolder = folder
	local positions = {
		Vector3.new(-30, 0, -100), Vector3.new(30, 0, -100),
		Vector3.new(-30, 0, -120), Vector3.new(30, 0, -120),
		Vector3.new(-30, 0, -140), Vector3.new(30, 0, -140), Vector3.new(0, 0, -140),
	}
	for index, position in ipairs(positions) do
		local boss = index == #positions
		local model = Instance.new("Model")
		model.Name = boss and "ArenaSentinel" or "TrainingBot" .. index
		model.Parent = folder
  local accent=if boss then Color3.fromRGB(122,71,153) else Color3.fromRGB(56+index*13,66,86)
  local skin=Color3.fromRGB(218,174,137)
  local scale=if boss then 1.35 else 1
  local chest=part(model,"Core",Vector3.new(2.5,2.7,1.3)*scale,CFrame.new(position+Vector3.new(0,3.65*scale,0)),accent,Enum.Material.Fabric)
  local head=part(model,"Head",Vector3.new(1.8,1.8,1.6)*scale,CFrame.new(position+Vector3.new(0,5.8*scale,0)),skin,Enum.Material.SmoothPlastic)
  Style.Face(head,"villain")
  head:FindFirstChild("CostumeFace").Face=Enum.NormalId.Back
  part(model,"Hair",Vector3.new(1.9,0.45,1.7)*scale,CFrame.new(position+Vector3.new(0,6.6*scale,0)),Color3.fromRGB(30,25,27))
  part(model,"JacketZip",Vector3.new(0.12,2.4,0.12)*scale,CFrame.new(position+Vector3.new(0,3.7*scale,0.72*scale)),Color3.fromRGB(186,193,200),Enum.Material.Metal)
  part(model,"Belt",Vector3.new(2.55,0.25,1.35)*scale,CFrame.new(position+Vector3.new(0,2.5*scale,0)),Color3.fromRGB(34,25,28))
  for _,side in ipairs({-1,1}) do
   part(model,"Arm"..side,Vector3.new(0.8,2.4,1)*scale,CFrame.new(position+Vector3.new(side*1.7*scale,3.6*scale,0)),accent,Enum.Material.Fabric)
   part(model,"Hand"..side,Vector3.new(0.8,0.6,1)*scale,CFrame.new(position+Vector3.new(side*1.7*scale,2.15*scale,0)),skin,Enum.Material.SmoothPlastic)
   part(model,"Leg"..side,Vector3.new(0.95,2.1,1.05)*scale,CFrame.new(position+Vector3.new(side*0.65*scale,1.05*scale,0)),Color3.fromRGB(31,40,63),Enum.Material.Fabric)
   part(model,"Shoe"..side,Vector3.new(1,0.35,1.3)*scale,CFrame.new(position+Vector3.new(side*0.65*scale,0.18*scale,0.12*scale)),Color3.fromRGB(24,23,27))
  end

		model.PrimaryPart = chest
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "HealthDisplay"
		billboard.Size = UDim2.fromOffset(210, 84)
		billboard.StudsOffset = Vector3.new(0, 4.3 * scale, 0)
		billboard.AlwaysOnTop = true
		billboard.MaxDistance = 130
		billboard.Parent = chest
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 0, 54)
		label.BackgroundTransparency = 0.25
		label.BackgroundColor3 = Color3.fromRGB(18, 27, 43)
		label.TextColor3 = Color3.fromRGB(245, 245, 253)
		label.TextStrokeTransparency = 0.6
		label.Font = Enum.Font.GothamBold
		label.TextSize = 16
		label.Parent = billboard
		local track = Instance.new("Frame")
		track.Name = "HealthTrack"
		track.Position = UDim2.new(0, 0, 0, 56)
		track.Size = UDim2.new(1, 0, 0, 6)
		track.BorderSizePixel = 0
		track.BackgroundColor3 = Color3.fromRGB(41, 47, 62)
		track.Parent = billboard
		local fill = Instance.new("Frame")
		fill.Name = "HealthFill"
		fill.BorderSizePixel = 0
		fill.BackgroundColor3 = if boss then Color3.fromRGB(232, 126, 87) else Color3.fromRGB(111, 211, 168)
		fill.Parent = track
		local stateLabel = Instance.new("TextLabel")
		stateLabel.Name = "AttackState"
		stateLabel.Position = UDim2.fromOffset(0, 64)
		stateLabel.Size = UDim2.new(1, 0, 0, 20)
		stateLabel.BackgroundTransparency = 0.2
		stateLabel.BackgroundColor3 = Color3.fromRGB(18, 27, 43)
		stateLabel.TextColor3 = Color3.fromRGB(255, 215, 158)
		stateLabel.Text = "Патруль"
		stateLabel.Font = Enum.Font.GothamBold
		stateLabel.TextSize = 12
		stateLabel.Parent = billboard
		local record = {
			model = model, center = chest, label = label, bar = fill, stateLabel = stateLabel, name = boss and "ГЛАВАРЬ БАНДЫ" or "Бандит квартала",
			boss = boss,
			health = boss and 400 or 80, maxHealth = boss and 400 or 80,
			coins = boss and 500 or 60, xp = boss and 200 or 40, respawn = boss and 30 or 8, dead = false,
		}
		record.home = chest.Position
		record.ai = boss and self.config.Enemies.Boss or self.config.Enemies.Bandit
		record.limbs = {}
		for _, side in ipairs({-1, 1}) do
			for _, prefix in ipairs({"Arm", "Hand", "Leg", "Shoe"}) do
				local limb = model:FindFirstChild(prefix .. side)
				table.insert(record.limbs, {part = limb, rest = chest.CFrame:ToObjectSpace(limb.CFrame), side = side, arm = prefix == "Arm" or prefix == "Hand"})
			end
		end
		local warning = part(model, "AttackWarning", Vector3.new(record.ai.AttackRange * 2, 0.04, record.ai.AttackRange * 2), CFrame.new(position + Vector3.new(0, 0.3, 0)), Color3.fromRGB(255, 80, 65), Enum.Material.Neon)
		warning.Transparency = 1
		warning.CanCollide = false
		warning.CanQuery = false
		record.warning = warning
		self.targets[model] = record
		for _, object in ipairs(model:GetChildren()) do if object:IsA("BasePart") and object ~= warning then self.targetParts[object] = record end end
		self:_targetLabel(record)
	end
end

function HeroCombatService:_effect(kind, from, to, definition, id, extra)
	local payload = { kind = kind, from = from, to = to, color = colorFor(definition), hero = id }
	for key, value in pairs(extra or {}) do payload[key] = value end
	self.effectRemote:FireAllClients(payload)
end

function HeroCombatService:_damageTarget(player, profile, record, damage, origin, range)
	if not record or self.targets[record.model] ~= record or not record.model.Parent
		or not record.model:IsDescendantOf(self.targetFolder) or record.dead
		or (record.center.Position - origin).Magnitude > range + 4 then return false end
	-- Урон, флаг смерти и награда идут без yield: один дрон не выдаст награду дважды.
	local amount, killed = Rules.ApplyDamage(record, damage)
	if amount <= 0 then return false end
	local practiceChanged = profile.CombatPractice ~= true
	profile.CombatPractice = true
	self:_effect("hit", record.center.Position, record.center.Position, {Color = {255, 233, 152}}, "", {
		amount = amount, actorUserId = player.UserId, target = record.model, targetKind = "npc",
	})
	self:_targetLabel(record)
	if killed then
		if record.boss then profile.BossDefeated = math.min(1000000000, (profile.BossDefeated or 0) + 1) end
		local coins, xp = Rules.Reward(self.config, profile, record.coins, record.xp)
		self.tycoon:SyncPlayer(player)
		self:_effect("victory", record.center.Position, record.center.Position, {Color = {255, 210, 113}}, "", {
			actorUserId = player.UserId, target = record.model, boss = record.boss == true,
		})
		self:_notify(player, record.name .. ": +" .. coins .. " монет, +" .. xp .. " XP!", "success")
		task.delay(record.respawn, function()
			if self.destroyed or self.targets[record.model] ~= record or not record.model.Parent then return end
			record.health = record.maxHealth
			record.dead = false
			self:_targetLabel(record)
			if self.enemyAI then self.enemyAI:Reset(record) end
		end)
	elseif practiceChanged then
		self.tycoon:SyncPlayer(player)
	end
	return true
end

function HeroCombatService:_combatant(player)
	local profile = self:_profile(player)
	local character, humanoid, root = liveCharacter(player)
	return { id = player.UserId, ready = profile ~= nil, optedIn = player:GetAttribute("ArenaCombatOptIn") == true and player:GetAttribute("ObbyActive") ~= true,
		alive = humanoid ~= nil, protected = character and character:FindFirstChildOfClass("ForceField") ~= nil,
		position = root and root.Position }, humanoid, root
end

function HeroCombatService:_damagePlayer(attacker, target, amount, origin, range)
	local attackerData = self:_combatant(attacker)
	local targetData, humanoid, root = self:_combatant(target)
	if not Rules.PvPAllowed(attackerData, targetData) or not root
		or (root.Position - origin).Magnitude > range + 3 then return false end
	-- Никаких наград за убийство игроков: нельзя фармить валюту вторым аккаунтом.
	local applied = math.min(humanoid.Health, amount)
	humanoid:TakeDamage(applied)
	self:_effect("hit", root.Position, root.Position, {Color = {255, 145, 113}}, "", {
		amount = applied, actorUserId = attacker.UserId, victimUserId = target.UserId, targetKind = "player",
	})
	self:_hurt(target, applied, origin)
	return true
end

function HeroCombatService:_hurt(player, amount, from)
	local _, _, root = liveCharacter(player)
	-- Последний удар может уже убить Humanoid; позицию берём из персонажа без требования Health > 0.
	root = root or (player.Character and player.Character:FindFirstChild("HumanoidRootPart"))
	if not root or not root:IsA("BasePart") or player.Parent ~= self.players then return end
	self.effectRemote:FireClient(player, {kind = "hurt", from = from, to = root.Position,
		color = Color3.fromRGB(255, 96, 83), amount = amount, victimUserId = player.UserId})
end

function HeroCombatService:_styleHit(record, definition)
	if not record or record.dead then return end
	local style = definition.Style
	local time = self.enemyAI and self.enemyAI.time or 0
	if style == "spider" or style == "symbiote" or definition.Id == "thread_launcher" then
		record.slowUntil = time + (if style == "symbiote" then 1.5 else 1.25)
		record.slowFactor = if style == "symbiote" then 0.45 else 0.55
	elseif style == "iron" or style == "iron_gold" or style == "thor" then
		record.staggerUntil = time + (if style == "thor" then 0.25 elseif style == "iron_gold" then 0.18 else 0.12)
	end
end

function HeroCombatService:_hitPlayer(partHit)
	local node = partHit
	while node and node ~= Workspace do
		if node:IsA("Model") then
			local player = self.players:GetPlayerFromCharacter(node)
			if player then return player end
		end
		node = node.Parent
	end
	return nil
end

function HeroCombatService:_attack(player, aim)
	local now = os.clock()
	-- Недорогой ограничитель отклоняет спам до Raycast и обхода игроков.
	if not Rules.CooldownReady(now, self.lastRequest[player] or -math.huge, 0.08) then return end
	self.lastRequest[player] = now
	local profile = self:_profile(player)
	if not profile then return end
	local definition, id = self:_definition(profile)
	local character, _, root = liveCharacter(player)
	local issued = self.issuedTools[player]
	if not definition or not character or not issued or issued.Parent ~= character
		or issued:GetAttribute("HeroWeapon") ~= id or player:GetAttribute("ObbyActive") == true
		or player:GetAttribute("ArenaCombatOptIn") ~= true or not Rules.InArena(root.Position) then return end
	local origin = root.Position + Vector3.new(0, 1.5, 0)
	local direction = Rules.CastDirection(origin, aim, definition.Range)
	if not direction or now < (self.nextAttackAt[player] or -math.huge) then return end
	-- Смена оружия не сбрасывает общий cooldown игрока.
	self.nextAttackAt[player] = now + definition.Cooldown
	player:SetAttribute("AttackReadyAt", Workspace:GetServerTimeNow() + definition.Cooldown)
	local parameters = RaycastParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Exclude
	parameters.FilterDescendantsInstances = { character }
	parameters.IgnoreWater = true
	if definition.Kind == "slam" then
		self:_effect("slam", root.Position, root.Position, definition, id, {actorUserId = player.UserId, radius = definition.Range})
		for _, record in pairs(self.targets) do
			local offset = record.center.Position - origin
			if not record.dead and offset.Magnitude <= definition.Range then
				local hit = Workspace:Raycast(origin, offset, parameters)
				if hit and self.targetParts[hit.Instance] == record then
					self:_damageTarget(player, profile, record, definition.Damage, origin, definition.Range)
				end
			end
		end
		for _, target in ipairs(self.players:GetPlayers()) do
			if target ~= player then
				local _, _, targetRoot = liveCharacter(target)
				if targetRoot then
					local offset = targetRoot.Position - origin
					if offset.Magnitude <= definition.Range then
						local hit = Workspace:Raycast(origin, offset, parameters)
						if hit and hit.Instance:IsDescendantOf(target.Character) then self:_damagePlayer(player, target, definition.Damage, origin, definition.Range) end
					end
				end
			end
		end
	else
		local hit = Workspace:Raycast(origin, direction, parameters)
		local endpoint = hit and hit.Position or origin + direction
		local style = definition.Style
		local kind = if style == "spider" or style == "symbiote" or definition.Id == "thread_launcher" then "web"
			elseif style == "iron" or style == "iron_gold" then "repulsor"
			elseif style == "thor" then "lightning" else "beam"
		self:_effect(kind, origin, endpoint, definition, id, {actorUserId = player.UserId})
		if hit then
			local record = self.targetParts[hit.Instance]
			if record then
				if self:_damageTarget(player, profile, record, definition.Damage, origin, definition.Range) then self:_styleHit(record, definition) end
			else
				local target = self:_hitPlayer(hit.Instance)
				if target then self:_damagePlayer(player, target, definition.Damage, origin, definition.Range) end
			end
		end
	end
end

function HeroCombatService:_watchPlayer(player)
	if self.playerConnections[player] then return end
	local connections = {}
	self.playerConnections[player] = connections
	local function characterReady(character)
		player:SetAttribute("ArenaCombatOptIn", false)
		self:_removeTool(player)
		self:_clearAppearance(player)
		task.spawn(function()
			local humanoid = character:WaitForChild("Humanoid", 10)
			local root = character:WaitForChild("HumanoidRootPart", 10)
			local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 10)
			if humanoid and root and backpack and self.playerConnections[player] == connections and player.Character == character then self:Refresh(player) end
		end)
	end
	table.insert(connections, player.CharacterAdded:Connect(characterReady))
	table.insert(connections, player.CharacterAppearanceLoaded:Connect(function(character)
		if player.Character == character then self:Refresh(player) end
	end))
	table.insert(connections, player:GetAttributeChangedSignal("DataReady"):Connect(function() self:Refresh(player) end))
	if player.Character then characterReady(player.Character) end
end

function HeroCombatService:_removePlayer(player)
	local connections = self.playerConnections[player]
	if connections then for _, connection in ipairs(connections) do connection:Disconnect() end end
	self.playerConnections[player] = nil
	self:_removeTool(player)
	self:_clearAppearance(player)
	self.nextAttackAt[player] = nil
	self.lastRequest[player] = nil
	self.lastEquip[player] = nil
end

function HeroCombatService:Start()
	assert(not self.started, "HeroCombatService уже запущен")
	self.started = true
	self:_buildTargets()
	self.enemyAI = EnemyAI.new(self)
	self.enemyAI:Start()
	if self.tycoon.SetPerkHandler then
		self.tycoon:SetPerkHandler(function(player, humanoid, profile) self:ApplyPerks(player, humanoid, profile) end)
	end
	table.insert(self.connections, self.skillRemote.OnServerEvent:Connect(function(player, aim) self:_attack(player, aim) end))
	table.insert(self.connections, self.players.PlayerAdded:Connect(function(player) self:_watchPlayer(player) end))
	table.insert(self.connections, self.players.PlayerRemoving:Connect(function(player) self:_removePlayer(player) end))
	for _, player in ipairs(self.players:GetPlayers()) do self:_watchPlayer(player) end
end

function HeroCombatService:Destroy()
	self.destroyed = true
	if self.enemyAI then self.enemyAI:Destroy() end
	for _, connection in ipairs(self.connections) do connection:Disconnect() end
	for player in pairs(self.playerConnections) do self:_removePlayer(player) end
	if self.targetFolder and self.targetFolder.Parent then self.targetFolder:Destroy() end
	table.clear(self.connections)
	table.clear(self.targets)
	table.clear(self.targetParts)
end

return HeroCombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">HeroWorld</string>
          <string name="Source"><![CDATA[-- Только оформление мира: награды, герои и бой проверяются другими серверными модулями.
local HeroWorld = {}
local Style = require(script.Parent:WaitForChild("VisualStyle"))

local DARK = Style.Palette.Ink
local CREAM = Style.Palette.Paper
local GOLD = Style.Palette.Gold
local CYAN = Style.Palette.Mint
local VIOLET = Color3.fromRGB(176, 125, 242)

local function child(parent, className, name)
	local existing = parent:FindFirstChild(name)
	if existing then
		assert(existing:IsA(className), name .. " has the wrong object type")
		return existing
	end
	local object = Instance.new(className)
	object.Name = name
	object.Parent = parent
	return object
end

local function part(parent, name, size, position, color, material, collide)
	local object = child(parent, "Part", name)
	object.Anchored = true
	object.Size = size
	object.CFrame = CFrame.new(position)
	object.Color = color
	object.Material = material or Enum.Material.SmoothPlastic
	Style.Material(object)
	object.Shape = Enum.PartType.Block
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	object.CanCollide = collide ~= false
	object.CanTouch = false
	object.CanQuery = object.CanCollide
	return object
end

local function label(parent, name, text, offset, width, height)
	local gui = child(parent, "BillboardGui", name)
	gui.Size = UDim2.new(0, width or 190, 0, height or 48)
	gui.StudsOffset = offset
	gui.AlwaysOnTop = false
	gui.MaxDistance = 95
	local textLabel = child(gui, "TextLabel", "TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundColor3 = DARK
	textLabel.BackgroundTransparency = 0.08
	textLabel.BorderSizePixel = 0
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextColor3 = CREAM
	textLabel.TextScaled = true
	textLabel.TextWrapped = true
	textLabel.Text = text
	child(textLabel, "UICorner", "Round").CornerRadius = UDim.new(0, 8)
	return textLabel
end

local function stand(campus, name, position, color, promptName, action, title)
	local base = part(campus, name, Vector3.new(7, 0.5, 5), position, color, Enum.Material.Neon)
	local prompt = child(base, "ProximityPrompt", promptName)
	prompt.ActionText = action
	prompt.ObjectText = title
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.HoldDuration = 0.25
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	-- The runtime service decides availability after construction.
	prompt.Enabled = true
	label(base, "StandLabel", title, Vector3.new(0, 5.5, 0), 190, 52)
	return base
end

local function gate(parent, name, x, z, color)
	local model = child(parent, "Model", name)
	for _, side in ipairs({ -1, 1 }) do
		local suffix = if side < 0 then "Left" else "Right"
		part(model, suffix .. "Pillar", Vector3.new(1, 9, 1.5), Vector3.new(x + side * 5, 4.5, z), DARK, Enum.Material.Metal)
		part(model, suffix .. "Glow", Vector3.new(0.2, 7, 1.6), Vector3.new(x + side * 4.45, 4.5, z), color, Enum.Material.Neon, false)
	end
	part(model, "Top", Vector3.new(11, 1, 1.5), Vector3.new(x, 9.5, z), color, Enum.Material.Neon)
	part(model, "GateFoundation", Vector3.new(12, 0.18, 4), Vector3.new(x, 0.1, z), DARK, Enum.Material.Slate)
	-- A translucent membrane gives the portal a visible surface without blocking it.
	local veil = part(model, "PortalVeil", Vector3.new(8.7, 7.3, 0.15), Vector3.new(x, 4.3, z), color, Enum.Material.Glass, false)
	veil.Transparency = 0.88
	for band = 1, 3 do
		part(model, "PortalBand" .. band, Vector3.new(7.8 - band, 0.035, 0.12), Vector3.new(x, 1 + band * 2, z - 0.1), color, Enum.Material.Neon, false).Transparency = 0.42
	end
	return model
end

local function buildStands(campus, decor)
	stand(campus, "DailyStand", Vector3.new(-20, 0.55, 18), GOLD, "ClaimDailyPrompt", "Получить подарок", "ЕЖЕДНЕВНЫЙ ПОДАРОК")
	stand(campus, "QuestStand", Vector3.new(20, 0.55, 18), CYAN, "QuestPrompt", "Посмотреть задания", "ЗАДАНИЯ ГЕРОЯ")
	stand(campus, "ArenaPortal", Vector3.new(0, 0.55, -43), Style.Palette.Danger, "EnterArenaPrompt", "Войти на арену", "ОПАСНАЯ ЗОНА / БАНДИТЫ И PvP")
	stand(campus, "ReturnStand", Vector3.new(35, 0.55, -88), CYAN, "ReturnPrompt", "Вернуться домой", "ВЕРНУТЬСЯ В БЕЗОПАСНУЮ ЗОНУ")
	stand(campus, "RebirthStand", Vector3.new(-26, 0.55, 0), VIOLET, "RebirthPrompt", "Перерождение", "ПЕРЕРОЖДЕНИЕ")
	gate(decor, "ArenaGate", 0, -47, Style.Palette.Danger)
	gate(decor, "ReturnGate", 35, -91, CYAN)
	gate(decor, "RebirthGate", -26, -3, VIOLET)
	part(decor, "DailyGift", Vector3.new(3.5, 2.8, 3), Vector3.new(-20, 2.2, 21.1), GOLD)
	part(decor, "GiftRibbon", Vector3.new(0.6, 2.85, 3.1), Vector3.new(-20, 2.2, 21.1), CREAM, Enum.Material.SmoothPlastic, false)
	part(decor, "GiftLid", Vector3.new(3.8, 0.35, 3.3), Vector3.new(-20, 3.8, 21.1), CREAM)
	part(decor, "QuestBoard", Vector3.new(5, 4, 0.5), Vector3.new(20, 3.2, 21.1), DARK)
	for index = 1, 3 do
		part(decor, "QuestLine" .. index, Vector3.new(3.6, 0.18, 0.12), Vector3.new(20, 4.3 - index * 0.8, 20.79), CYAN, Enum.Material.Neon, false)
	end
end

local function buildHero(gallery, definition, index)
	local column = (index - 1) % 3
	local z = if index <= 3 then -12 else 24
	local origin = Vector3.new(42 + column * 13, 0, z)
	local model = child(gallery, "Model", "Hero" .. index)
	model:SetAttribute("HeroId", definition.Id)
	local rgb = definition.Color
	local color = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
	local base = part(model, "Pedestal", Vector3.new(8, 0.6, 8), origin + Vector3.new(0, 0.3, 0), DARK, Enum.Material.Concrete)
	base.CanTouch = true
	part(model, "PedestalGlow", Vector3.new(7.5, 0.08, 7.5), origin + Vector3.new(0, 0.64, 0), color, Enum.Material.Neon, false)
	model:FindFirstChild("PedestalGlow").Transparency = 0.62
	for _, side in ipairs({ -1, 1 }) do
		part(model, "PedestalRimX" .. side, Vector3.new(0.14, 0.05, 7.3), origin + Vector3.new(side * 3.55, 0.72, 0), color, Enum.Material.Neon, false)
		part(model, "PedestalRimZ" .. side, Vector3.new(7.3, 0.05, 0.14), origin + Vector3.new(0, 0.72, side * 3.55), color, Enum.Material.Neon, false)
	end
	for _, side in ipairs({ -1, 1 }) do
		local suffix = if side < 0 then "Left" else "Right"
		part(model, suffix .. "Leg", Vector3.new(0.8, 2.2, 1), origin + Vector3.new(side * 0.55, 1.8, 0), DARK, Enum.Material.SmoothPlastic, false)
		part(model, suffix .. "Arm", Vector3.new(0.7, 2.7, 1), origin + Vector3.new(side * 1.4, 4.25, 0), color, Enum.Material.SmoothPlastic, false)
	end
	part(model, "Torso", Vector3.new(if index == 4 then 2.5 else 2, 2.7, 1.2), origin + Vector3.new(0, 4.25, 0), color, Enum.Material.SmoothPlastic, false)
	local head = part(model, "Head", Vector3.new(1.6, 1.6, 1.6), origin + Vector3.new(0, 6.45, 0), color, Enum.Material.SmoothPlastic, false)
	if definition.Style == "thor" then head.Color = Color3.fromRGB(218, 174, 137) end
	Style.Face(head, definition.Style)
	Style.Chest(model:FindFirstChild("Torso"), definition.Style)
	-- Both rows face the walkway between the displays.
	if index <= 3 then
		head:FindFirstChild("CostumeFace").Face = Enum.NormalId.Back
		model:FindFirstChild("Torso"):FindFirstChild("CostumeChest").Face = Enum.NormalId.Back
	end
	if definition.Style == "spider" then
		for _, name in ipairs({ "LeftLeg", "RightLeg" }) do model:FindFirstChild(name).Color = Color3.fromRGB(29, 64, 132) end
	elseif definition.Style == "hulk" then
		for _, name in ipairs({ "LeftLeg", "RightLeg" }) do
			model:FindFirstChild(name).Color = Color3.fromRGB(95, 55, 141)
			model:FindFirstChild(name).Material = Enum.Material.Fabric
		end
	end
	if index == 4 then
		for _, side in ipairs({ -1, 1 }) do
			part(model, "Muscle" .. (if side < 0 then "Left" else "Right"), Vector3.new(1.1, 0.8, 1.4), origin + Vector3.new(side * 1.4, 5.35, 0), color, Enum.Material.SmoothPlastic, false)
		end
	elseif index == 5 then
		part(model, "ThorCape", Vector3.new(3.3, 3.9, 0.2), origin + Vector3.new(0, 3.6, 0.85), Color3.fromRGB(170, 35, 38), Enum.Material.Fabric, false)
	end
	label(base, "HeroLabel", definition.Name .. "\nНаступи, чтобы надеть · " .. (if definition.MinRebirths > 0 then "Перерождений: " .. definition.MinRebirths else "Этаж: " .. definition.MinFloor), Vector3.new(0, 9, 0), 180, 60)
end

local function buildArena(campus)
	local arena = child(campus, "Folder", "Arena")
	part(arena, "Floor", Vector3.new(100, 0.24, 76), Vector3.new(0, 0.12, -120), Color3.fromRGB(93, 111, 131), Enum.Material.Concrete)
	-- Open center gates give characters a sixteen-stud entrance and exit.
	for _, z in ipairs({ -82, -158 }) do
		local endName = if z == -82 then "North" else "South"
		for _, side in ipairs({ -1, 1 }) do
			local suffix = if side < 0 then "Left" else "Right"
			part(arena, endName .. suffix .. "Wall", Vector3.new(42, 3.5, 1), Vector3.new(side * 29, 1.75, z), DARK, Enum.Material.Metal)
			part(arena, endName .. suffix .. "Trim", Vector3.new(42, 0.15, 1.1), Vector3.new(side * 29, 3.6, z), CYAN, Enum.Material.Neon, false)
		end
	end
	for _, side in ipairs({ -1, 1 }) do
		local suffix = if side < 0 then "Left" else "Right"
		part(arena, suffix .. "Wall", Vector3.new(1, 3.5, 76), Vector3.new(side * 49.5, 1.75, -120), DARK, Enum.Material.Metal)
		part(arena, suffix .. "Trim", Vector3.new(1.1, 0.15, 76), Vector3.new(side * 49.5, 3.6, -120), CYAN, Enum.Material.Neon, false)
	end
	-- Lines decorate the floor without adding barriers inside the battle area.
	part(arena, "CenterLine", Vector3.new(88, 0.02, 0.15), Vector3.new(0, 0.25, -120), CREAM, Enum.Material.SmoothPlastic, false)
	-- Surface-only markings preserve the clear movement/line-of-sight paths for AI.
	for _, side in ipairs({ -1, 1 }) do
		part(arena, "BattleLine" .. side, Vector3.new(0.12, 0.025, 61), Vector3.new(side * 37, 0.26, -120), CREAM, Enum.Material.SmoothPlastic, false)
		part(arena, "BossZoneEdge" .. side, Vector3.new(19, 0.025, 0.18), Vector3.new(0, 0.26, -148 + side * 5), Style.Palette.Danger, Enum.Material.Neon, false)
		part(arena, "BossZoneSide" .. side, Vector3.new(0.18, 0.025, 10), Vector3.new(side * 9.5, 0.26, -148), Style.Palette.Danger, Enum.Material.Neon, false)
	end
	local warning = part(arena, "BossSign", Vector3.new(14, 2.4, 0.25), Vector3.new(0, 6.8, -159), DARK, Enum.Material.Metal, false)
	Style.Sign(warning, "ГЛАВАРЬ БАНДЫ", "СЛЕДИ ЗА ЗОНОЙ УДАРА", Style.Palette.Danger, Enum.NormalId.Back)
	for index, position in ipairs({ Vector3.new(-46, 4.5, -86), Vector3.new(46, 4.5, -86), Vector3.new(-46, 4.5, -154), Vector3.new(46, 4.5, -154) }) do
		part(arena, "LampPost" .. index, Vector3.new(0.6, 9, 0.6), position, DARK, Enum.Material.Metal)
		part(arena, "Lamp" .. index, Vector3.new(2, 0.6, 2), position + Vector3.new(0, 4.7, 0), CYAN, Enum.Material.Neon, false)
	end
	label(arena:FindFirstChild("Floor"), "ArenaLabel", "АРЕНА PvP\nБандиты атакуют · PvP включено", Vector3.new(0, 13, 0), 290, 60)
end

local function buildCityDecor(campus, config)
 local decor=child(campus,"Folder","Neighborhood")
 local sign=part(decor,"WelcomeSign",Vector3.new(18,4,0.5),Vector3.new(0,7,-23),DARK,Enum.Material.Metal,false)
 local oldLabel=sign:FindFirstChild("WelcomeLabel");if oldLabel then oldLabel:Destroy() end
 Style.Sign(sign,config.GameTitle,"СТРОЙ · ПРЫГАЙ · СРАЖАЙСЯ",CYAN,Enum.NormalId.Back)
 for _,side in ipairs({-1,1}) do
  part(decor,"SignPost"..side,Vector3.new(0.5,8,0.5),Vector3.new(side*7,4,-23),DARK,Enum.Material.Metal)
 end
 part(decor,"FountainBase",Vector3.new(14,0.65,11),Vector3.new(-18,0.6,-18),CREAM,Enum.Material.Cobblestone)
 local water=part(decor,"FountainWater",Vector3.new(12,0.15,9),Vector3.new(-18,1,-18),Color3.fromRGB(75,177,218),Enum.Material.Glass,false)
 water.Transparency=0.3;water.CanQuery=false
 for _,side in ipairs({-1,1}) do
  part(decor,"FountainRimX"..side,Vector3.new(0.8,1,11),Vector3.new(-18+side*6.8,0.9,-18),CREAM,Enum.Material.Concrete)
  part(decor,"FountainRimZ"..side,Vector3.new(13,1,0.8),Vector3.new(-18,0.9,-18+side*5.2),CREAM,Enum.Material.Concrete)
 end
 part(decor,"FountainPillar",Vector3.new(1.2,3,1.2),Vector3.new(-18,2.4,-18),CREAM,Enum.Material.Slate)
 local jet=part(decor,"WaterJet",Vector3.new(0.6,3.8,0.6),Vector3.new(-18,4.7,-18),CYAN,Enum.Material.Glass,false)
 jet.Transparency=0.45;jet.CanQuery=false
 for index,position in ipairs({Vector3.new(-31,0,24),Vector3.new(31,0,24),Vector3.new(-31,0,-9),Vector3.new(29,0,-23)}) do
  part(decor,"FlowerBed"..index,Vector3.new(4.5,1.2,4.5),position+Vector3.new(0,0.6,0),Color3.fromRGB(147,102,71),Enum.Material.Brick)
  for flower=1,3 do
   local bloom=part(decor,"Flower"..index.."_"..flower,Vector3.new(1.3,1.3,1.3),position+Vector3.new((flower-2)*1.1,1.7,0),if flower==2 then GOLD else Color3.fromRGB(212,116,159),Enum.Material.SmoothPlastic,false)
   bloom.Shape=Enum.PartType.Ball;bloom.CanQuery=false
  end
 end
 for index,position in ipairs({Vector3.new(17,0,-17),Vector3.new(-31,0,9)}) do
  part(decor,"BenchSeat"..index,Vector3.new(7,0.4,2),position+Vector3.new(0,1.4,0),Color3.fromRGB(146,102,71),Enum.Material.WoodPlanks)
  part(decor,"BenchBack"..index,Vector3.new(7,1.4,0.3),position+Vector3.new(0,2.3,0.9),Color3.fromRGB(146,102,71),Enum.Material.WoodPlanks)
  for _,side in ipairs({-1,1}) do part(decor,"BenchLeg"..index..side,Vector3.new(0.4,1.3,1.5),position+Vector3.new(side*2.8,0.7,0),DARK,Enum.Material.Metal) end
 end
 -- Frame the costume gallery as one readable destination, rather than loose blocks.
 part(decor,"GalleryWalk",Vector3.new(47,0.18,51),Vector3.new(55,0.09,6),CREAM,Enum.Material.Concrete,false)
 part(decor,"GalleryFrontBorder",Vector3.new(47,0.04,0.3),Vector3.new(55,0.2,-19.3),CYAN,Enum.Material.Neon,false)
 part(decor,"GalleryBackBorder",Vector3.new(47,0.04,0.3),Vector3.new(55,0.2,31.3),CYAN,Enum.Material.Neon,false)
 local gallerySign=part(decor,"GallerySign",Vector3.new(18,3,0.25),Vector3.new(55,8,-22),DARK,Enum.Material.Metal,false)
 Style.Sign(gallerySign,"ГАРДЕРОБ ГЕРОЕВ","НАСТУПИ НА ДОСТУПНЫЙ КОСТЮМ",CYAN,Enum.NormalId.Back)
 -- Decorative shopfronts sit outside activities and have no fake shop prompts.
 local storefronts={
  {X=-66,Z=37,Title="МАСТЕРСКАЯ",Detail="ДОМА · ГЕНЕРАТОРЫ",Color=CYAN},
  {X=67,Z=47,Title="АРСЕНАЛ",Detail="ОРУЖИЕ В ТВОЁМ МЕНЮ",Color=GOLD},
 }
 for index,store in ipairs(storefronts) do
  part(decor,"ShopShell"..index,Vector3.new(22,12,13),Vector3.new(store.X,6,store.Z),Color3.fromRGB(183,199,199),Enum.Material.Brick)
  part(decor,"ShopRoof"..index,Vector3.new(24,0.6,15),Vector3.new(store.X,12.4,store.Z),DARK,Enum.Material.Slate)
  part(decor,"ShopAwning"..index,Vector3.new(22,0.4,3.5),Vector3.new(store.X,7,store.Z-7.5),store.Color,Enum.Material.Fabric,false)
  for _,side in ipairs({-1,1}) do
   local glass=part(decor,"ShopWindow"..index..side,Vector3.new(7,4.5,0.2),Vector3.new(store.X+side*6,3.5,store.Z-6.65),Style.Palette.Window,Enum.Material.Glass,false)
   glass.Transparency=0.3
   part(decor,"ShopWindowFrame"..index..side,Vector3.new(7.4,0.22,0.3),Vector3.new(store.X+side*6,1.1,store.Z-6.8),CREAM,Enum.Material.Metal,false)
  end
  part(decor,"ShopDoor"..index,Vector3.new(3,6,0.2),Vector3.new(store.X,3,store.Z-6.65),DARK,Enum.Material.Metal,false)
  local title=part(decor,"ShopSign"..index,Vector3.new(17,2.9,0.3),Vector3.new(store.X,10,store.Z-6.75),DARK,Enum.Material.Metal,false)
  Style.Sign(title,store.Title,store.Detail,store.Color)
 end
end

function HeroWorld.Build(workspace, config)
	assert(type(config.Heroes) == "table" and #config.Heroes == 6, "HeroWorld expects six configured heroes")
	local campus = child(workspace, "Folder", "HeroCampus")
	local decor = child(campus, "Folder", "Decor")
	buildStands(campus, decor)
	local gallery = child(campus, "Folder", "Gallery")
	for index, definition in ipairs(config.Heroes) do
		buildHero(gallery, definition, index)
	end
	buildArena(campus)
	buildCityDecor(campus, config)
	campus:SetAttribute("WorldReady", true)
	return campus
end

return HeroWorld
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">HouseWorld</string>
          <string name="Source"><![CDATA[-- Physical tycoon plots. This module only draws the world; the server owns money
-- and all purchase decisions. Rebuilding Structure never deletes a prompt.
local World = {}
local Style = require(script.Parent:WaitForChild("VisualStyle"))

local DEFAULT_POSITIONS = {
	Vector3.new(-148, 0, -156), Vector3.new(148, 0, -156),
	Vector3.new(-148, 0, 0), Vector3.new(148, 0, 0),
	Vector3.new(-148, 0, 156), Vector3.new(148, 0, 156),
}

local HOUSE_COLORS = {
	Color3.fromRGB(174, 216, 213),
	Color3.fromRGB(190, 205, 233),
	Color3.fromRGB(229, 193, 178),
	Color3.fromRGB(212, 206, 233),
}

local CREAM = Style.Palette.Paper
local WOOD = Style.Palette.Wood
local DARK = Style.Palette.Ink
local GOLD = Style.Palette.Gold
local CYAN = Style.Palette.Window

local function child(parent, className, name)
	local existing = parent:FindFirstChild(name)
	if existing then
		assert(existing:IsA(className), name .. " has the wrong object type")
		return existing
	end
	local object = Instance.new(className)
	object.Name = name
	object.Parent = parent
	return object
end

local function geometry(parent, size, position)
	local plot = parent
	while plot and plot:GetAttribute("GeometryScale") == nil do plot = plot.Parent end
	if not plot then return size, position end
	local scale = plot:GetAttribute("GeometryScale")
	local origin = Vector3.new(plot:GetAttribute("OriginX"), 0, plot:GetAttribute("OriginZ"))
	local offset = position - origin
	return Vector3.new(size.X * scale, size.Y, size.Z * scale), origin + Vector3.new(offset.X * scale, offset.Y, offset.Z * scale)
end

local function part(parent, name, size, position, color, material, canCollide)
	size, position = geometry(parent, size, position)
	local object = child(parent, "Part", name)
	object.Anchored = true
	object.Size = size
	object.CFrame = CFrame.new(position)
	object.Color = color
	object.Material = material or Enum.Material.SmoothPlastic
	Style.Material(object)
	object.Shape = Enum.PartType.Block
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	object.CanCollide = canCollide ~= false
	object.CanTouch = false
	object.CanQuery = true
	return object
end

local function prompt(parent, name, actionText, objectText, enabled)
	local object = child(parent, "ProximityPrompt", name)
	object.ActionText = actionText
	object.ObjectText = objectText
	object.MaxActivationDistance = 10
	object.RequiresLineOfSight = false
	object.HoldDuration = 0.25
	object.KeyboardKeyCode = Enum.KeyCode.E
	object.Enabled = enabled
	return object
end

local function label(parent, name, text, offset, width, height)
	local gui = child(parent, "BillboardGui", name)
	gui.Size = UDim2.new(0, width or 210, 0, height or 50)
	gui.StudsOffset = offset or Vector3.new(0, 3, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 90
	local textLabel = child(gui, "TextLabel", "TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundColor3 = DARK
	textLabel.BackgroundTransparency = 0.1
	textLabel.BorderSizePixel = 0
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextColor3 = CREAM
	textLabel.TextScaled = true
	textLabel.TextWrapped = true
	textLabel.Text = text
	return textLabel
end

local function pad(plot, origin, name, x, color, promptName, actionText, objectText, enabled)
	local object = part(plot, name, Vector3.new(6, 0.35, 4), origin + Vector3.new(x, 0.55, -17), color, Enum.Material.Neon)
	prompt(object, promptName, actionText, objectText, enabled)
	label(object, "PadLabel", objectText, Vector3.new(0, 2.3, 0), 140, 38)
	return object
end

-- A door is an opening in the wall, so the entrance is always walkable.
local function frontWall(structure, origin, floor, y, wallColor)
	local z = -10
	for _, side in ipairs({ -1, 1 }) do
		local suffix = (if side < 0 then "Left" else "Right") .. floor
		-- Real window openings let daylight reach the room, with a clear door gap.
		part(structure, "Front" .. suffix, Vector3.new(2.2, 10.5, 0.7), origin + Vector3.new(side * 12.9, y + 5.25, z), wallColor, Enum.Material.Brick)
		part(structure, "FrontInner" .. suffix, Vector3.new(2.2, 10.5, 0.7), origin + Vector3.new(side * 5.1, y + 5.25, z), wallColor, Enum.Material.Brick)
		part(structure, "FrontWindowBase" .. suffix, Vector3.new(5.6, 2.5, 0.7), origin + Vector3.new(side * 9, y + 1.25, z), wallColor, Enum.Material.Brick)
		part(structure, "FrontWindowTop" .. suffix, Vector3.new(5.6, 2, 0.7), origin + Vector3.new(side * 9, y + 9.5, z), wallColor, Enum.Material.Brick)
		local pane = part(structure, "StreetWindow" .. suffix, Vector3.new(5.6, 6, 0.22), origin + Vector3.new(side * 9, y + 5.5, z), CYAN, Enum.Material.Glass)
		pane.Transparency = 0.42
		part(structure, "StreetWindowSill" .. suffix, Vector3.new(6, 0.22, 1), origin + Vector3.new(side * 9, y + 2.5, z - 0.22), CREAM, Enum.Material.Concrete, false)
		part(structure, "StreetWindowHeader" .. suffix, Vector3.new(6, 0.22, 0.9), origin + Vector3.new(side * 9, y + 8.5, z - 0.12), CREAM, Enum.Material.Concrete, false)
		part(structure, "StreetWindowMullion" .. suffix, Vector3.new(0.13, 5.8, 0.32), origin + Vector3.new(side * 9, y + 5.5, z - 0.16), CREAM, Enum.Material.Metal, false)
	end
	part(structure, "FrontLintel" .. floor, Vector3.new(8, 3, 0.7), origin + Vector3.new(0, y + 9, z), CREAM)
	if floor > 1 then
		-- A closed upper window; only the ground floor is the main entrance.
		local pane = part(structure, "FrontWindow" .. floor, Vector3.new(7.5, 6.8, 0.25), origin + Vector3.new(0, y + 3.9, z), CYAN, Enum.Material.Glass)
		pane.Transparency = 0.5
	end
end

local function buildInterior(structure, origin, floor, top, wallColor)
	-- Furnish the left wall; the central doorway and both stair exits stay clear.
	local accent = if floor == 3 then GOLD else Style.Palette.Mint
	part(structure, "WorkDesk" .. floor, Vector3.new(3.2, 0.35, 5), origin + Vector3.new(-11.8, top + 2.25, -3), WOOD, Enum.Material.WoodPlanks)
	for _, z in ipairs({ -4.8, -1.2 }) do
		part(structure, "DeskLeg" .. floor .. "_" .. z, Vector3.new(0.35, 2, 0.35), origin + Vector3.new(-11.8, top + 1.05, z), DARK, Enum.Material.Metal)
	end
	part(structure, "WorkScreen" .. floor, Vector3.new(1.4, 1.3, 0.2), origin + Vector3.new(-11.6, top + 3.05, -4.4), accent, Enum.Material.Neon, false)
	local plaque = part(structure, "InteriorPlaque" .. floor, Vector3.new(5, 1.9, 0.15), origin + Vector3.new(0, top + 6.2, 13.5), DARK, Enum.Material.Metal, false)
	Style.Sign(plaque, if floor == 3 then "ШТАБ ГЕРОЯ" elseif floor == 2 then "МАСТЕРСКАЯ" else "ПЕРВАЯ БАЗА", "ЭТАЖ " .. floor .. " / 3", accent)
	part(structure, "CeilingPanel" .. floor, Vector3.new(4, 0.08, 4), origin + Vector3.new(0, top + 10.8, 0), CREAM, Enum.Material.Neon, false)
	if floor < 3 then
		part(structure, "InteriorRug" .. floor, Vector3.new(9, 0.04, 8), origin + Vector3.new(5, top + 0.03, 0), wallColor, Enum.Material.Fabric, false)
	end
	for _, side in ipairs({ -1, 1 }) do
		local width = if floor == 3 then 7.7 else 8.7
		local x = if floor == 3 then 6 else 5
		local depth = if floor == 3 then 2.25 else 3.75
		part(structure, "RugBorder" .. floor .. side, Vector3.new(width, 0.02, 0.18), origin + Vector3.new(x, top + 0.058, side * depth), CREAM, Enum.Material.Fabric, false)
	end
end

local function rearWall(structure, origin, floor, y, wallColor)
	part(structure, "RearLeft" .. floor, Vector3.new(7, 10.5, 0.7), origin + Vector3.new(-10.5, y + 5.25, 14), wallColor)
	part(structure, "RearMiddle" .. floor, Vector3.new(8, 10.5, 0.7), origin + Vector3.new(0, y + 5.25, 14), wallColor)
	if floor == 2 then
		part(structure, "RearDoorLintel2", Vector3.new(7, 3, 0.7), origin + Vector3.new(10.5, y + 9, 14), CREAM)
	else
		part(structure, "RearRight" .. floor, Vector3.new(7, 10.5, 0.7), origin + Vector3.new(10.5, y + 5.25, 14), wallColor)
	end
	for _, x in ipairs({ -5.5, 5.5 }) do
		local suffix = if x < 0 then "Left" else "Right"
		part(structure, "RearWindowSill" .. suffix .. floor, Vector3.new(3, 2.5, 0.7), origin + Vector3.new(x, y + 1.25, 14), CREAM)
		part(structure, "RearWindowTop" .. suffix .. floor, Vector3.new(3, 2, 0.7), origin + Vector3.new(x, y + 9.5, 14), CREAM)
		local pane = part(structure, "RearWindow" .. suffix .. floor, Vector3.new(3, 6, 0.25), origin + Vector3.new(x, y + 5.5, 14), CYAN, Enum.Material.Glass)
		pane.Transparency = 0.5
	end
end

local function rightWall(structure, origin, floor, y, wallColor)
	-- Floor 2 enters through the rear wall; floor 3 uses this side doorway.
	local doorCenter = -7
	if floor < 3 then
		part(structure, "RightWall" .. floor, Vector3.new(0.7, 10.5, 24), origin + Vector3.new(14, y + 5.25, 2), wallColor)
		return
	end
	local beforeLength = doorCenter - 3 - (-10)
	local afterLength = 14 - (doorCenter + 3)
	if beforeLength > 0 then
		part(structure, "RightFront" .. floor, Vector3.new(0.7, 10.5, beforeLength), origin + Vector3.new(14, y + 5.25, -10 + beforeLength / 2), wallColor, Enum.Material.Brick)
	end
	if afterLength > 0 then
		part(structure, "RightRear" .. floor, Vector3.new(0.7, 10.5, afterLength), origin + Vector3.new(14, y + 5.25, doorCenter + 3 + afterLength / 2), wallColor, Enum.Material.Brick)
	end
	part(structure, "SideDoorLintel" .. floor, Vector3.new(0.7, 3, 6), origin + Vector3.new(14, y + 9, doorCenter), CREAM)
end

local function buildDropper(structure, origin, floor, floorTop)
	local model = child(structure, "Model", "Dropper" .. floor)
	local position = origin + Vector3.new(-7, floorTop, 7)
	local color = if floor == 3 then GOLD elseif floor == 2 then CYAN else Color3.fromRGB(122, 179, 239)
	part(model, "MachineBase", Vector3.new(8, 0.6, 8), position + Vector3.new(0, 0.3, 0), DARK, Enum.Material.Metal)
	part(model, "MachineBack", Vector3.new(7, 5, 1), position + Vector3.new(0, 3, 3), color, Enum.Material.Metal)
	part(model, "MachineTop", Vector3.new(7, 1, 5), position + Vector3.new(0, 5.8, 1), color, Enum.Material.Metal)
	part(model, "Nozzle", Vector3.new(1.5, 0.7, 1.5), position + Vector3.new(0, 4.95, -0.7), GOLD, Enum.Material.Neon, false)
	part(model, "Conveyor", Vector3.new(5, 0.4, 6), position + Vector3.new(0, 0.8, -0.5), WOOD, Enum.Material.WoodPlanks)
	for index = 1, 5 do
		part(model, "BeltStripe" .. index, Vector3.new(5, 0.04, 0.18), position + Vector3.new(0, 1.03, -3.3 + index), CREAM, Enum.Material.SmoothPlastic, false)
	end
	local start = part(model, "DropletStart", Vector3.new(0.2, 0.2, 0.2), position + Vector3.new(0, 4.55, -0.7), color, Enum.Material.SmoothPlastic, false)
	local finish = part(model, "DropletEnd", Vector3.new(0.2, 0.2, 0.2), position + Vector3.new(0, 1.25, -0.7), color, Enum.Material.SmoothPlastic, false)
	start.Transparency = 1
	finish.Transparency = 1
	start.CanQuery = false
	finish.CanQuery = false
	label(model:FindFirstChild("MachineBack"), "MachineLabel", if floor == 3 then "ЗОЛОТОЙ ГЕНЕРАТОР" else "ГЕНЕРАТОР " .. floor, Vector3.new(0, 2.4, 0), 150, 40)
end

local function buildStairs(structure, origin, targetFloor)
	local startingTop = 0.8 + (targetFloor - 2) * 12
	local laneX = if targetFloor == 2 then 16.25 else 20
	-- Separate lanes keep the second flight above neither the player's head
	-- nor the first flight. Thin treads leave the space below them open.
	if targetFloor == 2 then
		part(structure, "StairStart", Vector3.new(3.5, 0.4, 3), origin + Vector3.new(laneX, 0.6, -10.5), WOOD, Enum.Material.WoodPlanks)
	end
	-- 24 half-stud risers are climbable by the standard Roblox character.
	for step = 1, 24 do
		local height = step * 0.5
		local z = if targetFloor == 2 then -9.5 + step else 15.5 - step
		part(structure, "Stair" .. targetFloor .. "Step" .. step, Vector3.new(3.5, 0.4, 1), origin + Vector3.new(laneX, startingTop + height - 0.2, z), WOOD, Enum.Material.WoodPlanks)
	end
	-- A landing starts beyond the final step instead of over the approaching
	-- character. The rear porch connects the second floor's broad rear door.
	local landingZ = if targetFloor == 2 then 16 else -9.5
	local landingDepth = if targetFloor == 2 then 3 else 4
	part(structure, "StairLanding" .. targetFloor, Vector3.new(8.25, 0.4, landingDepth), origin + Vector3.new(17.625, startingTop + 11.8, landingZ), WOOD, Enum.Material.WoodPlanks)
	if targetFloor == 2 then
		part(structure, "RearPorch2", Vector3.new(7, 0.4, 3.5), origin + Vector3.new(10.5, startingTop + 11.8, 15.5), WOOD, Enum.Material.WoodPlanks)
	end
	-- The rail is outside the walking width, never across the doorway.
	part(structure, "LandingRail" .. targetFloor, Vector3.new(0.3, 2.5, landingDepth), origin + Vector3.new(21.85, startingTop + 13.25, landingZ), CREAM)
	part(structure, "LandingRailPost" .. targetFloor, Vector3.new(0.3, 3, 0.3), origin + Vector3.new(21.85, startingTop + 13.5, landingZ), DARK)
end

local function buildThirdFloorExtras(structure, origin, floorTop)
	-- The third floor opens onto a broad balcony above the front walkway.
	local oldWindow = structure:FindFirstChild("FrontWindow3")
	if oldWindow then
		oldWindow:Destroy()
	end
	part(structure, "Balcony", Vector3.new(28, 0.4, 5), origin + Vector3.new(0, floorTop - 0.2, -12.5), WOOD, Enum.Material.WoodPlanks)
	part(structure, "BalconyFrontRail", Vector3.new(28, 2.5, 0.4), origin + Vector3.new(0, floorTop + 1.25, -14.8), GOLD, Enum.Material.Metal)
	part(structure, "BalconyLeftRail", Vector3.new(0.4, 2.5, 5), origin + Vector3.new(-13.8, floorTop + 1.25, -12.5), CREAM)
	part(structure, "BalconyRightRail", Vector3.new(0.4, 2.5, 5), origin + Vector3.new(13.8, floorTop + 1.25, -12.5), CREAM)
	part(structure, "BonusChest", Vector3.new(4.5, 2.6, 3), origin + Vector3.new(6, floorTop + 1.3, 6), GOLD, Enum.Material.Metal)
	part(structure, "BonusChestLid", Vector3.new(4.8, 0.5, 3.3), origin + Vector3.new(6, floorTop + 2.85, 6), CREAM, Enum.Material.Metal)
	part(structure, "BonusChestLock", Vector3.new(0.8, 1, 0.3), origin + Vector3.new(6, floorTop + 1.9, 4.35), GOLD, Enum.Material.Neon, false)
	part(structure, "GoldCarpet", Vector3.new(8, 0.04, 5), origin + Vector3.new(6, floorTop + 0.03, 0), GOLD, Enum.Material.SmoothPlastic, false)
	label(structure:FindFirstChild("BonusChest"), "ChestLabel", "БОНУСЫ 3 ЭТАЖА", Vector3.new(0, 3, 0), 170, 40)
	local display = child(structure, "Model", "HeroDisplay")
	local position = origin + Vector3.new(6, floorTop, 10)
	part(display, "DisplayBase", Vector3.new(4, 0.3, 4), position + Vector3.new(0, 0.15, 0), DARK, Enum.Material.Metal)
	part(display, "LeftLeg", Vector3.new(0.65, 1.5, 0.8), position + Vector3.new(-0.55, 1.05, 0), GOLD, Enum.Material.Metal)
	part(display, "RightLeg", Vector3.new(0.65, 1.5, 0.8), position + Vector3.new(0.55, 1.05, 0), GOLD, Enum.Material.Metal)
	local torso = part(display, "ArmorTorso", Vector3.new(2.2, 2.4, 1.2), position + Vector3.new(0, 3, 0), GOLD, Enum.Material.Metal)
	part(display, "LeftArm", Vector3.new(0.6, 2.2, 0.9), position + Vector3.new(-1.55, 3, 0), GOLD, Enum.Material.Metal)
	part(display, "RightArm", Vector3.new(0.6, 2.2, 0.9), position + Vector3.new(1.55, 3, 0), GOLD, Enum.Material.Metal)
	part(display, "Helmet", Vector3.new(1.5, 1.5, 1.3), position + Vector3.new(0, 4.95, 0), DARK, Enum.Material.Metal)
	part(display, "Visor", Vector3.new(1.1, 0.45, 0.15), position + Vector3.new(0, 5.1, -0.72), CYAN, Enum.Material.Neon, false)
	label(torso, "HeroDisplayLabel", "ЗАЛ ГЕРОЯ", Vector3.new(0, 3.8, 0), 150, 38)
end

function World.UpdatePlot(plot, floorNumber, ownerName)
	local base = plot:FindFirstChild("Base")
	assert(base and base:IsA("BasePart"), "Tycoon plot needs its Base")
	local origin = base.Position - Vector3.new(0, 0.15, 0)
	local floors = math.clamp(math.floor(floorNumber or 0), 0, 3)
	local previous = plot:FindFirstChild("Structure")
	if previous then
		assert(previous:IsA("Folder"), "Plot Structure must be a Folder")
		previous:Destroy()
	end
	local structure = child(plot, "Folder", "Structure")
	local plotId = plot:GetAttribute("PlotId") or 1
	local wallColor = HOUSE_COLORS[((plotId - 1) % #HOUSE_COLORS) + 1]
	part(structure, "Foundation", Vector3.new(29, 0.3, 25), origin + Vector3.new(0, 0.45, 2), CREAM, Enum.Material.Concrete)
	for floor = 1, floors do
		local top = 0.8 + (floor - 1) * 12
		part(structure, "Floor" .. floor, Vector3.new(28, 0.4, 24), origin + Vector3.new(0, top - 0.2, 2), WOOD, Enum.Material.WoodPlanks)
		frontWall(structure, origin, floor, top, wallColor)
		rearWall(structure, origin, floor, top, wallColor)
		rightWall(structure, origin, floor, top, wallColor)
		part(structure, "LeftWall" .. floor, Vector3.new(0.7, 10.5, 24), origin + Vector3.new(-14, top + 5.25, 2), wallColor)
		part(structure, "FrontCornice" .. floor, Vector3.new(29, 0.5, 0.9), origin + Vector3.new(0, top + 10.75, -10), CREAM)
		part(structure, "RearCornice" .. floor, Vector3.new(29, 0.5, 0.9), origin + Vector3.new(0, top + 10.75, 14), CREAM)
		part(structure, "LeftCornice" .. floor, Vector3.new(0.9, 0.5, 24), origin + Vector3.new(-14, top + 10.75, 2), CREAM)
		buildDropper(structure, origin, floor, top)
		-- Stone frames, brickwork and timber floors use built-in Roblox textures.
		for _, side in ipairs({-1, 1}) do
			part(structure, "CornerTrim" .. floor .. "_" .. side, Vector3.new(0.6, 10.5, 0.8), origin + Vector3.new(side * 13.65, top + 5.25, -10.45), CREAM, Enum.Material.Concrete, false)
			part(structure, "WindowSill" .. floor .. "_" .. side, Vector3.new(4, 0.25, 1.3), origin + Vector3.new(side * 5.5, top + 2.4, 14.3), CREAM, Enum.Material.Concrete, false)
		end
		buildInterior(structure, origin, floor, top, wallColor)
		if floor >= 2 then
			buildStairs(structure, origin, floor)
		end
	end
	if floors > 0 then
		local roofTop = 0.8 + (floors - 1) * 12 + 11.5
		part(structure, "Roof", Vector3.new(30, 0.5, 26), origin + Vector3.new(0, roofTop, 2), DARK, Enum.Material.Slate)
		part(structure, "RoofAccent", Vector3.new(28, 0.15, 24), origin + Vector3.new(0, roofTop + 0.325, 2), if floors == 3 then GOLD else wallColor)
		for _, side in ipairs({ -1, 1 }) do
			part(structure, "RoofParapetX" .. side, Vector3.new(0.5, 0.9, 25), origin + Vector3.new(side * 14.5, roofTop + 0.6, 2), CREAM, Enum.Material.Concrete)
			part(structure, "RoofParapetZ" .. side, Vector3.new(29, 0.9, 0.5), origin + Vector3.new(0, roofTop + 0.6, 2 + side * 12.5), CREAM, Enum.Material.Concrete)
		end
		part(structure, "RoofVent", Vector3.new(2.4, 1.1, 2.4), origin + Vector3.new(-9, roofTop + 0.95, 9), DARK, Enum.Material.Metal)
		part(structure, "RoofVentCap", Vector3.new(2.9, 0.25, 2.9), origin + Vector3.new(-9, roofTop + 1.6, 9), CREAM, Enum.Material.Metal)
		part(structure, "RoofSkylight", Vector3.new(6, 0.18, 4), origin + Vector3.new(4, roofTop + 0.52, 4), CYAN, Enum.Material.Glass, false).Transparency = 0.35
	end
	if floors == 3 then
		buildThirdFloorExtras(structure, origin, 24.8)
	end
	-- Keep this Part and its prompt stable: the server connects to it once.
	-- It becomes an invisible interaction point on the third-floor chest.
	local bonusPad = plot:FindFirstChild("BonusPad")
	if bonusPad then
		bonusPad.Size = Vector3.new(1, 1, 0.35)
		local _, bonusPosition = geometry(plot, Vector3.new(1, 1, 0.35), origin + Vector3.new(6, if floors == 3 then 26.7 else 0.55, if floors == 3 then 4 else -17))
		bonusPad.CFrame = CFrame.new(bonusPosition)
		bonusPad.Transparency = 1
		bonusPad.CanCollide = false
		bonusPad.CanQuery = false
		local bonusLabel = bonusPad:FindFirstChild("PadLabel")
		if bonusLabel then
			bonusLabel.Enabled = false
		end
	end
	local sign = plot:FindFirstChild("PlotSign")
	local gui = sign and sign:FindFirstChild("PlotLabel")
	local textLabel = gui and gui:FindFirstChild("TextLabel")
	if textLabel then
		local name = if type(ownerName) == "string" and ownerName ~= "" then ownerName else "Свободный участок"
		textLabel.Text = name .. "\nЭтажи: " .. floors .. " / 3"
	end
	return structure
end

function World.BuildPlots(workspace, config)
	local folder = child(workspace, "Folder", "TycoonPlots")
	local positions = DEFAULT_POSITIONS
	if config and config.PlotLayout then
		positions = {}
		for _, position in ipairs(config.PlotLayout) do
			table.insert(positions, Vector3.new(position.X, 0, position.Z))
		end
	end
	local plots = {}
	-- Обновление старого места с 12 участками тоже оставляет максимум шесть домов.
	for _, existing in ipairs(folder:GetChildren()) do
		local id = existing:GetAttribute("PlotId")
		if existing:IsA("Model") and type(id) == "number" and id > #positions and string.match(existing.Name, "^Plot%d+$") then existing:Destroy() end
	end
	for index, origin in ipairs(positions) do
		local plot = child(folder, "Model", "Plot" .. index)
		plot:SetAttribute("GeometryScale", config and config.HouseScale or 1.5)
		plot:SetAttribute("OriginX", origin.X)
		plot:SetAttribute("OriginZ", origin.Z)
		plot:SetAttribute("PlotId", index)
		plot:SetAttribute("OwnerUserId", 0)
		plot:SetAttribute("OwnerName", "")
		plot:SetAttribute("Floor", 0)
		plot:SetAttribute("Bank", 0)
		plot:SetAttribute("DropperTier", 0)
		plot:SetAttribute("OwnerReady", false)
		local base = part(plot, "Base", Vector3.new(44, 0.3, 44), origin + Vector3.new(0, 0.15, 0), Color3.fromRGB(166, 191, 144), Enum.Material.Grass)
		plot.PrimaryPart = base
		part(plot, "FrontWalk", Vector3.new(30, 0.1, 10), origin + Vector3.new(0, 0.35, -16), CREAM, Enum.Material.Concrete)
		for _, side in ipairs({ -1, 1 }) do
			part(plot, "LotEdge" .. side, Vector3.new(0.3, 0.2, 43), origin + Vector3.new(side * 21.5, 0.4, 0), CREAM, Enum.Material.Concrete, false)
		end
		local number = part(plot, "HouseNumber", Vector3.new(3.3, 1.3, 0.2), origin + Vector3.new(12.5, 2.1, -19.5), DARK, Enum.Material.Metal, false)
		Style.Sign(number, "ДОМ " .. index, "ТВОЙ КВАРТАЛ", Style.Palette.Mint)
		for _, side in ipairs({-1, 1}) do
			-- Keep the right planter in the front yard, away from both stair lanes.
			local gardenZ = if side > 0 then -17 else -8
			local depth = if side > 0 then 6 else 11
			part(plot, "GardenBed" .. side, Vector3.new(5, 0.6, depth), origin + Vector3.new(side * 18.5, 0.55, gardenZ), DARK, Enum.Material.Slate)
			for shrub = 1, 3 do
				local z = if side > 0 then gardenZ + (shrub - 2) * 1.8 else -14 + shrub * 3
				local bush = part(plot, "GardenShrub" .. side .. "_" .. shrub, Vector3.new(3.2, 2.1, 3.2), origin + Vector3.new(side * 18.5, 1.6, z), Color3.fromRGB(65, 130, 84), Enum.Material.Grass, false)
				bush.Shape = Enum.PartType.Ball
			end
		end
		local claim = part(plot, "ClaimPad", Vector3.new(7, 0.3, 2.5), origin + Vector3.new(0, 0.6, -20), Color3.fromRGB(88, 231, 156), Enum.Material.Neon)
		prompt(claim, "ClaimPrompt", "Занять", "Свободный дом", true)
		pad(plot, origin, "Collector", -10.5, Color3.fromRGB(99, 222, 159), "CollectPrompt", "Забрать", "КОПИЛКА", false)
		pad(plot, origin, "UpgradePad", -3.5, Color3.fromRGB(108, 185, 248), "FloorPrompt", "Построить", "ЭТАЖ", false)
		pad(plot, origin, "DropperUpgradePad", 3.5, Color3.fromRGB(175, 137, 242), "DropperPrompt", "Улучшить", "ГЕНЕРАТОР", false)
		pad(plot, origin, "BonusPad", 10.5, GOLD, "BonusPrompt", "Получить", "БОНУС III", false)
		pad(plot, origin, "HeroPad", 10.5, Color3.fromRGB(246, 129, 88), "HeroPrompt", "Выбрать героя", "ГЕРОЙ", false)
		local sign = part(plot, "PlotSign", Vector3.new(1, 4.5, 1), origin + Vector3.new(-18, 2.55, -18), WOOD, Enum.Material.Wood)
		label(sign, "PlotLabel", "Свободный участок\nЭтажи: 0 / 3", Vector3.new(0, 3.2, 0), 225, 65)
		World.UpdatePlot(plot, 0, "")
		table.insert(plots, plot)
	end
	return plots
end

return World
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">LootDropService</string>
          <string name="Source"><![CDATA[-- Бесплатный общий груз. Выбор оружия и выдача награды происходят только на сервере.
local LootDropService = {}
LootDropService.__index = LootDropService

local Helpers = {}
LootDropService.Helpers = Helpers

local function finite(value)
	return type(value) == "number" and value == value and math.abs(value) ~= math.huge
end

-- unitRoll задаётся серверным Random:NextNumber(). Аргумент удобен для проверки шансов.
function Helpers.WeightedRoll(weapons, unitRoll)
	if type(weapons) ~= "table" or not finite(unitRoll) then return nil end
	local total = 0
	local lastWeapon
	for _, weapon in ipairs(weapons) do
		local weight = weapon.LootWeight
		if finite(weight) and weight > 0 then
			total += weight
			lastWeapon = weapon
		end
	end
	if total <= 0 or not finite(total) then return nil end
	local target = math.clamp(unitRoll, 0, 1) * total
	local accumulated = 0
	for _, weapon in ipairs(weapons) do
		local weight = weapon.LootWeight
		if finite(weight) and weight > 0 then
			accumulated += weight
			if target < accumulated then return weapon end
		end
	end
	return lastWeapon
end

-- Эта функция не обращается к RemoteEvent и не содержит ожиданий.
-- В инвентаре остаётся максимум 99 копий, переполнение заменяется монетами.
function Helpers.Grant(config, profile, weapon)
	if type(profile) ~= "table" or type(weapon) ~= "table" then return nil end
	local known = false
	for _, definition in ipairs(config.Weapons or {}) do
		if definition == weapon then known = true; break end
	end
	if not known or type(weapon.Id) ~= "string" then return nil end
	if type(profile.Inventory) ~= "table" then profile.Inventory = {} end
	local maximum = if finite(config.MaxWeaponCopies) then math.clamp(math.floor(config.MaxWeaponCopies), 1, 99) else 99
	local previous = profile.Inventory[weapon.Id]
	previous = if finite(previous) then math.clamp(math.floor(previous), 0, maximum) else 0
	local count = math.min(maximum, previous + 1)
	local compensation = 0
	if previous >= maximum then
		local coins = if finite(profile.Coins) then math.clamp(math.floor(profile.Coins), 0, config.MaxCoins) else 0
		local reward = config.Airdrops and config.Airdrops.DuplicateCoins or 100
		reward = if finite(reward) then math.max(0, math.floor(reward)) else 100
		compensation = math.min(reward, config.MaxCoins - coins)
		profile.Coins = coins + compensation
	end
	profile.Inventory[weapon.Id] = count
	return {
		weaponId = weapon.Id, name = weapon.Name, rarity = weapon.Rarity,
		count = count, duplicate = previous > 0, compensationCoins = compensation,
	}
end

function LootDropService.new(config, profiles, tycoon, notice, lootResult)
	return setmetatable({
		config = config, profiles = profiles, tycoon = tycoon,
		notice = notice, lootResult = lootResult,
		players = game:GetService("Players"), workspace = game:GetService("Workspace"),
		runService = game:GetService("RunService"), tweenService = game:GetService("TweenService"),
		random = Random.new(), connections = {}, lastAttemptAt = {},
		started = false, destroyed = false, active = nil, folder = nil,
	}, LootDropService)
end

local function part(parent, name, size, cframe, color, material)
	local object = Instance.new("Part")
	object.Name = name
	object.Size = size
	object.CFrame = cframe
	object.Color = color
	object.Material = material or Enum.Material.SmoothPlastic
	object.Anchored = true
	object.CanCollide = false
	object.CanTouch = false
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	object.Parent = parent
	return object
end

local function attachedPart(parent, body, name, size, offset, color, material)
	local object = part(parent, name, size, body.CFrame * CFrame.new(offset), color, material)
	object.Massless = true
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = body
	weld.Part1 = object
	weld.Parent = object
	-- Одна закреплённая деталь ведёт весь груз; физика клиента его не перемещает.
	object.Anchored = false
	return object
end

function LootDropService:_removeDrop(drop)
	if drop.removed then return end
	drop.removed = true
	drop.claimed = true
	drop.prompt.Enabled = false
	if self.active == drop then self.active = nil end
	for _, connection in ipairs(drop.connections) do connection:Disconnect() end
	table.clear(drop.connections)
	-- Сначала отключаем Completed, затем отменяем падение.
	if drop.tween then drop.tween:Cancel() end
	drop.model:Destroy()
end

function LootDropService:_currentProfile(player)
	if self.destroyed or self.profiles:IsClosing() or player.Parent ~= self.players
		or player:GetAttribute("DataReady") ~= true then return nil end
	local profile = self.profiles:Get(player)
	local state = self.tycoon:GetState(player)
	if not profile or not state or state.leaving or state.profile ~= profile then return nil end
	return profile
end

function LootDropService:_claim(player, drop)
	local now = os.clock()
	if self.destroyed or self.active ~= drop or drop.claimed or not drop.landed
		or now >= drop.expiresAt or not drop.prompt.Enabled then return end
	if not self.folder or self.folder.Parent ~= self.workspace or drop.model.Parent ~= self.folder or not drop.body:IsDescendantOf(drop.model)
		or drop.prompt.Parent ~= drop.body then return end
	if player.Parent ~= self.players then return end
	if now - (self.lastAttemptAt[player] or -math.huge) < (self.config.ActionCooldown or 0.35) then return end
	self.lastAttemptAt[player] = now
	local profile = self:_currentProfile(player)
	if not profile then return end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not (humanoid.Health > 0) or not root or not root:IsA("BasePart") then return end
	-- Triggered можно подделать: расстояние перепроверяет сам сервер.
	local distance = (root.Position - drop.body.Position).Magnitude
	if not finite(distance) or distance > 12 then return end
	local weapon = Helpers.WeightedRoll(self.config.Weapons, self.random:NextNumber())
	if not weapon then self:_removeDrop(drop); return end
	-- Проверки, пометка и выдача проходят без yield. Только один игрок получит груз.
	drop.claimed = true
	drop.prompt.Enabled = false
	local outcome = Helpers.Grant(self.config, profile, weapon)
	self:_removeDrop(drop)
	if not outcome then return end
	local synced = pcall(function() self.tycoon:SyncPlayer(player) end)
	if not synced then warn("LootDrop: не удалось обновить интерфейс инвентаря") end
	-- SyncPlayer может в будущем стать асинхронным: старой сессии результат не отправляем.
	if self:_currentProfile(player) ~= profile then return end
	self.lootResult:FireClient(player, outcome)
	local text = "Бесплатный груз: " .. outcome.name .. " (" .. outcome.rarity .. ")!"
	if outcome.compensationCoins > 0 then
		text = "Лимит копий: компенсация +" .. outcome.compensationCoins .. " монет!"
	elseif outcome.duplicate then
		text ..= " Копий в инвентаре: " .. outcome.count .. "."
	end
	self.notice:FireClient(player, { text = text, kind = "success" })
end

function LootDropService:_spawnDrop(now)
	local settings = self.config.Airdrops
	local location = settings.Locations[self.random:NextInteger(1, #settings.Locations)]
	local model = Instance.new("Model")
	model.Name = "FreeSupplyCrate"
	local start = CFrame.new(location.X, 88, location.Z)
	local body = part(model, "Crate", Vector3.new(6, 5, 6), start, Color3.fromRGB(48, 69, 100), Enum.Material.Metal)
	model.PrimaryPart = body
	attachedPart(model, body, "Lid", Vector3.new(6.4, 0.5, 6.4), Vector3.new(0, 2.6, 0), Color3.fromRGB(255, 210, 75), Enum.Material.Metal)
	attachedPart(model, body, "GoldBandX", Vector3.new(6.05, 1, 6.05), Vector3.new(0, 0, 0), Color3.fromRGB(255, 210, 75), Enum.Material.Metal)
	local parachute = Instance.new("Folder")
	parachute.Name = "Parachute"
	parachute.Parent = model
	local canopy = attachedPart(parachute, body, "Canopy", Vector3.new(13, 2.5, 13), Vector3.new(0, 14, 0), Color3.fromRGB(79, 218, 208))
	canopy.Shape = Enum.PartType.Ball
	for index, offset in ipairs({ Vector3.new(-2.6, 8, -2.6), Vector3.new(2.6, 8, -2.6), Vector3.new(-2.6, 8, 2.6), Vector3.new(2.6, 8, 2.6) }) do
		attachedPart(parachute, body, "Rope" .. index, Vector3.new(0.12, 10, 0.12), offset, Color3.fromRGB(232, 238, 244))
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "CrateLabel"
	gui.Size = UDim2.fromOffset(240, 54)
	gui.StudsOffset = Vector3.new(0, 5, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 140
	gui.Parent = body
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Color3.fromRGB(25, 37, 60)
	label.BackgroundTransparency = 0.15
	label.BorderSizePixel = 0
	label.TextColor3 = Color3.fromRGB(255, 220, 103)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextWrapped = true
	label.Text = "БЕСПЛАТНЫЙ ГРУЗ\nПриземляется..."
	label.Parent = gui
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 210, 75)
	light.Brightness = 1.5
	light.Range = 15
	light.Parent = body
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "LootPrompt"
	prompt.ActionText = "Забрать оружие"
	prompt.ObjectText = "Бесплатный груз"
	prompt.MaxActivationDistance = 10
	prompt.HoldDuration = 0.35
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false
	prompt.Parent = body
	model.Parent = self.folder
	local drop = {
		model = model, body = body, prompt = prompt, label = label,
		landed = false, claimed = false, removed = false, connections = {},
		landDeadline = now + settings.FallSeconds + 5, expiresAt = math.huge,
	}
	self.active = drop
	self.nextDropAt = now + self.random:NextNumber(settings.MinInterval, settings.MaxInterval)
	table.insert(drop.connections, prompt.Triggered:Connect(function(player) self:_claim(player, drop) end))
	drop.tween = self.tweenService:Create(body, TweenInfo.new(settings.FallSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		CFrame = CFrame.new(location.X, 2.7, location.Z),
	})
	table.insert(drop.connections, drop.tween.Completed:Connect(function(playbackState)
		if playbackState ~= Enum.PlaybackState.Completed or self.destroyed or self.active ~= drop or drop.removed then return end
		if self.profiles:IsClosing() or model.Parent ~= self.folder or not body:IsDescendantOf(model) then
			self:_removeDrop(drop)
			return
		end
		parachute:Destroy()
		body.CanCollide = true
		drop.landed = true
		drop.expiresAt = os.clock() + settings.Lifetime
		label.Text = "БЕСПЛАТНОЕ ОРУЖИЕ\nПодойди и нажми E"
		prompt.Enabled = true
	end))
	drop.tween:Play()
	self.notice:FireAllClients({ text = "С неба падает бесплатный груз! Забери оружие после приземления.", kind = "info" })
end

function LootDropService:_step(now)
	if self.destroyed then return end
	if self.profiles:IsClosing() or not self.folder or self.folder.Parent ~= self.workspace then
		self:Destroy()
		return
	end
	local drop = self.active
	if drop then
		if drop.model.Parent ~= self.folder or not drop.body:IsDescendantOf(drop.model)
			or drop.prompt.Parent ~= drop.body
			or (not drop.landed and now >= drop.landDeadline)
			or (drop.landed and now >= drop.expiresAt) then
			self:_removeDrop(drop)
		end
	end
	if not self.active and now >= self.nextDropAt then self:_spawnDrop(now) end
end

function LootDropService:Start()
	assert(not self.started and not self.destroyed, "LootDropService уже запущен или завершён")
	local settings = self.config.Airdrops
	assert(settings and type(settings.Locations) == "table" and #settings.Locations > 0, "Не заданы точки бесплатного груза")
	assert(Helpers.WeightedRoll(self.config.Weapons, 0), "Не заданы шансы оружия")
	assert(not self.workspace:FindFirstChild("Airdrops"), "Airdrops уже существует: второй сервис создаст дубликаты")
	self.folder = Instance.new("Folder")
	self.folder.Name = "Airdrops"
	self.folder.Parent = self.workspace
	self.started = true
	self.nextDropAt = os.clock() + settings.FirstDelay
	table.insert(self.connections, self.runService.Heartbeat:Connect(function() self:_step(os.clock()) end))
	table.insert(self.connections, self.players.PlayerRemoving:Connect(function(player) self.lastAttemptAt[player] = nil end))
	game:BindToClose(function() self:Destroy() end)
end

function LootDropService:Destroy()
	if self.destroyed then return end
	self.destroyed = true
	self.started = false
	for _, connection in ipairs(self.connections) do connection:Disconnect() end
	table.clear(self.connections)
	if self.active then self:_removeDrop(self.active) end
	if self.folder then self.folder:Destroy(); self.folder = nil end
	table.clear(self.lastAttemptAt)
end

return LootDropService
]]></string>
        </Properties>
