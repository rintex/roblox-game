      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">AdminService</string>
          <string name="Source"><![CDATA[-- Only the experience owner / explicit allowlist may use this remote.
local Players=game:GetService('Players')
local RunService=game:GetService('RunService')
local Service={};Service.__index=Service
function Service.new(config,profiles,tycoon,notice,request)
 return setmetatable({config=config,profiles=profiles,tycoon=tycoon,notice=notice,request=request,states={},connections={}},Service)
end
function Service:IsAuthorized(player)
 if RunService:IsStudio() and game.GameId==0 then return true end
 for _,id in ipairs(self.config.AdminUserIds or {}) do if id>0 and id==player.UserId then return true end end
 if game.CreatorId<=0 then return false end
 if game.CreatorType==Enum.CreatorType.User then return player.UserId==game.CreatorId end
 if game.CreatorType==Enum.CreatorType.Group then
  local ok,rank=pcall(function() return player:GetRankInGroup(game.CreatorId) end)
  return ok and rank==255
 end
 return false
end
function Service:_add(player)
 local authorized=self:IsAuthorized(player)
 if player.Parent~=Players then return end
 self.states[player]={authorized=authorized,last=-math.huge}
 player:SetAttribute('IsGameAdmin',authorized)
end
function Service:_request(player,command)
 local state=self.states[player]
 if not state or not state.authorized or player.Parent~=Players or type(command)~='string' then return end
 if self.profiles:IsClosing() or player:GetAttribute('DataReady')~=true then return end
 local profile=self.profiles:Get(player);if not profile then return end
 local now=os.clock();if now-state.last<1 then return end;state.last=now
 local character=player.Character
 local humanoid=character and character:FindFirstChildOfClass('Humanoid')
 if command=='GrantCoins' then
  profile.Coins=math.min(self.config.MaxCoins,profile.Coins+25000);self.tycoon:SyncPlayer(player)
 elseif command=='Heal' then
  if humanoid and humanoid.Health>0 then humanoid.Health=humanoid.MaxHealth end
 elseif command=='TeleportHome' then
  player:SetAttribute('ArenaCombatOptIn',false)
  local root=character and character:FindFirstChild('HumanoidRootPart')
  local target=Vector3.new(0,5,14)
  local state=self.tycoon:GetState(player)
  if state and state.plot then local base=state.plot:FindFirstChild('Base');if base then target=base.Position+Vector3.new(0,5,-20) end end
  if root and humanoid and humanoid.Health>0 then root.CFrame=CFrame.new(target) end
 elseif command=='PreviewVIP' or command=='PreviewNeon' then
  if not RunService:IsStudio() then return end
  local attribute=if command=='PreviewVIP' then 'HasVIP' else 'HasNeon'
  player:SetAttribute(attribute,player:GetAttribute(attribute)~=true)
 else return end
 self.notice:FireClient(player,{kind='info',text='Команда владельца выполнена.'})
end
function Service:Start()
 table.insert(self.connections,self.request.OnServerEvent:Connect(function(player,command) self:_request(player,command) end))
 table.insert(self.connections,Players.PlayerAdded:Connect(function(player) task.spawn(function() self:_add(player) end) end))
 table.insert(self.connections,Players.PlayerRemoving:Connect(function(player) self.states[player]=nil end))
 for _,player in ipairs(Players:GetPlayers()) do task.spawn(function() self:_add(player) end) end
end
function Service:Destroy()
 for _,c in ipairs(self.connections) do c:Disconnect() end;table.clear(self.states)
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">CombatRules</string>
          <string name="Source"><![CDATA[-- Чистые проверки боя: их выполняет сервер и автоматические тесты.
local Rules = {}

function Rules.IsFinite(value, limit)
	return type(value) == "number" and value == value and math.abs(value) ~= math.huge
		and (limit == nil or math.abs(value) <= limit)
end

function Rules.IsVector(value)
	return typeof(value) == "Vector3" and Rules.IsFinite(value.X, 100000)
		and Rules.IsFinite(value.Y, 100000) and Rules.IsFinite(value.Z, 100000)
end

function Rules.CastDirection(origin, aim, range)
	if not Rules.IsVector(origin) or not Rules.IsVector(aim) or not Rules.IsFinite(range, 1000) or range <= 0 then
		return nil
	end
	local delta = aim - origin
	if not Rules.IsFinite(delta.Magnitude, 10000) or delta.Magnitude < 0.05 then return nil end
	-- Клиент задаёт только направление; длину луча устанавливает сервер.
	return delta.Unit * range
end

function Rules.CooldownReady(now, last, cooldown)
	return Rules.IsFinite(now) and type(last) == "number" and Rules.IsFinite(cooldown, 60)
		and cooldown >= 0 and now - last >= cooldown
end

function Rules.InArena(position)
	return Rules.IsVector(position) and math.abs(position.X) <= 48
		and position.Z >= -158 and position.Z <= -82 and position.Y >= -2 and position.Y <= 30
end

function Rules.PvPAllowed(attacker, target)
	return attacker ~= nil and target ~= nil and attacker.id ~= target.id
		and attacker.ready == true and target.ready == true
		and attacker.optedIn == true and target.optedIn == true
		and attacker.alive == true and target.alive == true
		and attacker.protected ~= true and target.protected ~= true
		and Rules.InArena(attacker.position) and Rules.InArena(target.position)
end

function Rules.OwnsWeapon(config, profile, id)
	if type(id) ~= "string" or #id > 48 or type(profile.Inventory) ~= "table" then return false end
	local count = profile.Inventory[id]
	return config.GetWeapon(id) ~= nil and Rules.IsFinite(count, config.MaxWeaponCopies or 99) and count >= 1 and count % 1 == 0
end

function Rules.ApplyDamage(target, amount)
	if target.dead or not Rules.IsFinite(target.health) or target.health <= 0
		or not Rules.IsFinite(amount, 10000) or amount <= 0 then return 0, false end
	local applied = math.min(target.health, amount)
	target.health -= applied
	local killed = target.health <= 0
	if killed then target.dead = true end
	return applied, killed
end

function Rules.Reward(config, profile, coins, xp)
	local earnedCoins = math.max(0, math.min(coins, config.MaxCoins - profile.Coins))
	local earnedXP = math.max(0, math.min(xp, config.MaxXP - profile.XP))
	profile.Coins += earnedCoins
	profile.XP += earnedXP
	profile.EnemiesDefeated = math.min(config.MaxEnemiesDefeated or 1000000000, (profile.EnemiesDefeated or 0) + 1)
	return earnedCoins, earnedXP
end

return Rules
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">HeroCombatService</string>
          <string name="Source"><![CDATA[-- Сервер выдаёт костюмы/оружие и проверяет каждый выстрел. Клиент передаёт лишь точку прицеливания.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Rules = require(script.Parent:WaitForChild("CombatRules"))

local HeroCombatService = {}
HeroCombatService.__index = HeroCombatService

local BODY_COLORS = { "HeadColor3", "TorsoColor3", "LeftArmColor3", "RightArmColor3", "LeftLegColor3", "RightLegColor3" }

local function colorFor(definition)
	local rgb = definition.Color or { 80, 205, 255 }
	return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

local function part(parent, name, size, frame, color, material)
	local value = Instance.new("Part")
	value.Name = name
	value.Size = size
	value.CFrame = frame
	value.Color = color
	value.Material = material or Enum.Material.Metal
	value.TopSurface = Enum.SurfaceType.Smooth
	value.BottomSurface = Enum.SurfaceType.Smooth
	value.Anchored = true
	value.Parent = parent
	return value
end

local function attach(parent, anchor, name, size, offset, color, material, shape)
	local value = part(parent, name, size, anchor.CFrame * offset, color, material)
	value.Anchored = false
	value.CanCollide = false
	value.CanTouch = false
	value.CanQuery = false
	value.Massless = true
	if shape then value.Shape = shape end
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = anchor
	weld.Part1 = value
	weld.Parent = value
	return value
end

local function liveCharacter(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then return nil end
	return character, humanoid, root
end

function HeroCombatService.new(config, profiles, tycoon, notice, skillRemote, effectRemote)
	return setmetatable({
		config = config, profiles = profiles, tycoon = tycoon, notice = notice,
		skillRemote = skillRemote, effectRemote = effectRemote, players = Players,
		connections = {}, playerConnections = {}, issuedTools = {}, appearances = {},
		nextAttackAt = {}, lastRequest = {}, lastEquip = {}, targets = {}, targetParts = {},
		started = false, destroyed = false,
	}, HeroCombatService)
end

function HeroCombatService:_profile(player)
	if self.destroyed or self.profiles:IsClosing() or player.Parent ~= self.players
		or player:GetAttribute("DataReady") ~= true then return nil end
	local profile = self.profiles:Get(player)
	local state = self.tycoon:GetState(player)
	if not profile or not state or state.leaving or state.profile ~= profile then return nil end
	return profile
end

function HeroCombatService:_notify(player, text, kind)
	if player.Parent == self.players then self.notice:FireClient(player, { text = text, kind = kind or "info" }) end
end

function HeroCombatService:_definition(profile)
	local weaponId = profile.EquippedWeapon or ""
	if weaponId ~= "" and Rules.OwnsWeapon(self.config, profile, weaponId) then
		return self.config.GetWeapon(weaponId), "loot:" .. weaponId
	end
	local hero = self.config.GetHero(profile.EquippedHero or "")
	if hero and self.config.CanUseHero(profile, hero) then return hero, hero.Id end
	return nil
end

function HeroCombatService:_clearAppearance(player)
	local old = self.appearances[player]
	if not old then return end
	if old.folder.Parent then old.folder:Destroy() end
	if old.colors.Parent then
		if old.created then old.colors:Destroy()
		else for name, value in pairs(old.original) do old.colors[name] = value end end
	end
	self.appearances[player] = nil
end

function HeroCombatService:_removeTool(player)
	local old = self.issuedTools[player]
	if old then old:Destroy() end
	self.issuedTools[player] = nil
end

function HeroCombatService:_costume(player, character, hero)
	self:_clearAppearance(player)
	if not hero then return end
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	local head = character:FindFirstChild("Head")
	if not torso or not torso:IsA("BasePart") or not head or not head:IsA("BasePart") then return end
	local accent = colorFor(hero)
	local dark = Color3.fromRGB(25, 32, 48)
	local colors = character:FindFirstChildOfClass("BodyColors")
	local created = colors == nil
	if not colors then colors = Instance.new("BodyColors"); colors.Parent = character end
	local original = {}
	for _, name in ipairs(BODY_COLORS) do original[name] = colors[name]; colors[name] = dark end
	colors.HeadColor3 = accent:Lerp(dark, 0.6)
	local folder = Instance.new("Folder")
	folder.Name = "HeroArmor"
	folder.Parent = character
	self.appearances[player] = { folder = folder, colors = colors, original = original, created = created }
	local chestWidth = math.clamp(torso.Size.X * 0.85, 1, 2.2)
	local chestHeight = math.clamp(torso.Size.Y * 0.85, 0.7, 1.8)
	local front = -torso.Size.Z / 2 - 0.12
	attach(folder, torso, "ChestArmor", Vector3.new(chestWidth, chestHeight, 0.22), CFrame.new(0, 0, front), dark)
	attach(folder, torso, "EnergyCore", Vector3.new(0.46, 0.46, 0.16), CFrame.new(0, 0.06, front - 0.19) * CFrame.Angles(0, 0, math.pi / 4), accent, Enum.Material.Neon)
	attach(folder, torso, "ChestTrimLeft", Vector3.new(0.12, chestHeight * 0.8, 0.13), CFrame.new(-chestWidth * 0.38, 0, front - 0.16), accent, Enum.Material.Neon)
	attach(folder, torso, "ChestTrimRight", Vector3.new(0.12, chestHeight * 0.8, 0.13), CFrame.new(chestWidth * 0.38, 0, front - 0.16), accent, Enum.Material.Neon)
	for _, side in ipairs({ -1, 1 }) do
		attach(folder, torso, side == -1 and "LeftPauldron" or "RightPauldron", Vector3.new(0.55, 0.35, 0.75), CFrame.new(side * (torso.Size.X / 2 + 0.16), torso.Size.Y * 0.32, 0), accent, Enum.Material.Metal)
	end
	local visorZ = -head.Size.Z / 2 - 0.09
	attach(folder, head, "VisorFrame", Vector3.new(head.Size.X * 0.85, 0.32, 0.14), CFrame.new(0, 0.06, visorZ), dark)
	attach(folder, head, "EnergyVisor", Vector3.new(head.Size.X * 0.70, 0.12, 0.09), CFrame.new(0, 0.06, visorZ - 0.10), accent, Enum.Material.Neon)
	if hero.Id == "titan" then
		attach(folder, torso, "GravityPack", Vector3.new(1.25, 1.25, 0.5), CFrame.new(0, 0, torso.Size.Z / 2 + 0.3), accent)
	elseif hero.Id == "helios" then
		for _, side in ipairs({ -1, 1 }) do
			attach(folder, torso, "SolarFin" .. side, Vector3.new(0.2, 1.5, 1.0), CFrame.new(side * 0.7, 0.35, torso.Size.Z / 2 + 0.55) * CFrame.Angles(0, 0, side * -0.45), accent, Enum.Material.Neon)
		end
	elseif hero.Id == "frost" then
		attach(folder, torso, "CryoCell", Vector3.new(0.65, 0.65, 0.4), CFrame.new(0, 0.2, torso.Size.Z / 2 + 0.3) * CFrame.Angles(0, 0, math.pi / 4), Color3.fromRGB(180, 240, 255), Enum.Material.Glass)
	elseif hero.Id == "volt" then
		attach(folder, torso, "ArcSpine", Vector3.new(0.3, 1.3, 0.3), CFrame.new(0, 0.1, torso.Size.Z / 2 + 0.3), accent, Enum.Material.Neon)
	elseif hero.Id == "nightweaver" then
		attach(folder, torso, "StealthPack", Vector3.new(1.15, 1.05, 0.3), CFrame.new(0, 0, torso.Size.Z / 2 + 0.2), dark)
	end
end

function HeroCombatService:_giveTool(player, definition, id)
	self:_removeTool(player)
	if not definition then return end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then return end
	local tool = Instance.new("Tool")
	tool.Name = definition.Weapon or definition.Name
	tool.RequiresHandle = true
	tool.CanBeDropped = false
	tool.ToolTip = "Арена: нажмите или коснитесь для атаки"
	tool:SetAttribute("HeroWeapon", id)
	tool:SetAttribute("WeaponKind", definition.Kind)
	local accent = colorFor(definition)
	local handle = part(tool, "Handle", Vector3.new(0.35, 1.0, 0.35), CFrame.new(), Color3.fromRGB(28, 36, 54))
	handle.Anchored = false
	handle.CanCollide = false
	handle.CanTouch = false
	handle.CanQuery = false
	handle.Massless = true
	if definition.Kind == "slam" then
		attach(tool, handle, "GravityHead", Vector3.new(1.6, 0.7, 0.7), CFrame.new(0, 0.8, 0), accent)
		attach(tool, handle, "GravityCore", Vector3.new(0.4, 0.8, 0.78), CFrame.new(0, 0.8, 0), accent, Enum.Material.Neon)
	else
		attach(tool, handle, "Emitter", Vector3.new(0.6, 0.55, 1.2), CFrame.new(0, 0.45, -0.3), Color3.fromRGB(38, 48, 68))
		attach(tool, handle, "Barrel", Vector3.new(0.3, 0.3, 0.6), CFrame.new(0, 0.45, -1.05), accent, Enum.Material.Neon)
	end
	self.issuedTools[player] = tool
	tool.Parent = backpack
	local character, humanoid = liveCharacter(player)
	if character and humanoid then humanoid:EquipTool(tool) end
end

function HeroCombatService:ApplyPerks(player, humanoid, profile)
	local speed = (profile.Floor >= 3 or (profile.Rebirths or 0) > 0) and self.config.ThirdFloorWalkSpeed or self.config.DefaultWalkSpeed
	local hero = self.config.GetHero(profile.EquippedHero or "")
	if hero and self.config.CanUseHero(profile, hero) then speed = math.max(speed, hero.WalkSpeed or speed) end
	humanoid.WalkSpeed = speed
end

function HeroCombatService:Refresh(player)
	local profile = self:_profile(player)
	if not profile then self:_removeTool(player); self:_clearAppearance(player); return end
	local hero = self.config.GetHero(profile.EquippedHero or "")
	if not hero or not self.config.CanUseHero(profile, hero) then hero = nil end
	local character, humanoid = liveCharacter(player)
	if character then self:_costume(player, character, hero); self:ApplyPerks(player, humanoid, profile) end
	local definition, id = self:_definition(profile)
	self:_giveTool(player, definition, id)
end

HeroCombatService.RefreshPlayer = HeroCombatService.Refresh

function HeroCombatService:_equipReady(player)
	local profile = self:_profile(player)
	if not profile then return nil, "Дождитесь загрузки прогресса." end
	local now = os.clock()
	if not Rules.CooldownReady(now, self.lastEquip[player] or -math.huge, 0.3) then return nil, "Подождите перед сменой снаряжения." end
	self.lastEquip[player] = now
	return profile
end

function HeroCombatService:Equip(player, id)
	if type(id) ~= "string" or #id > 48 then return false, "Неизвестный герой." end
	local profile, reason = self:_equipReady(player)
	if not profile then return false, reason end
	local hero = id ~= "" and self.config.GetHero(id) or nil
	if id ~= "" and (not hero or not self.config.CanUseHero(profile, hero)) then return false, "Этот герой ещё не открыт. Стройте этажи и делайте перерождения." end
	profile.EquippedHero = id
	profile.EquippedWeapon = ""
	self.tycoon:SyncPlayer(player)
	self:Refresh(player)
	return true, hero and ("Герой «" .. hero.Name .. "» выбран. Оружие готово!") or "Костюм снят."
end

function HeroCombatService:EquipWeapon(player, id)
	if type(id) ~= "string" or #id > 48 then return false, "Неизвестное оружие." end
	local profile, reason = self:_equipReady(player)
	if not profile then return false, reason end
	if id ~= "" and not Rules.OwnsWeapon(self.config, profile, id) then return false, "Сначала получите это оружие из бесплатного контейнера." end
	profile.EquippedWeapon = id
	self.tycoon:SyncPlayer(player)
	self:Refresh(player)
	local definition = self.config.GetWeapon(id)
	return true, definition and ("Оружие «" .. definition.Name .. "» экипировано!") or "Выбрано оружие героя."
end

function HeroCombatService:_targetLabel(record)
	record.model:SetAttribute("Health", record.health)
	record.model:SetAttribute("Alive", not record.dead)
	record.label.Text = record.name .. "\n" .. math.ceil(record.health) .. " / " .. record.maxHealth
	for _, object in ipairs(record.model:GetChildren()) do
		if object:IsA("BasePart") then
			object.Transparency = record.dead and 0.8 or 0
			object.CanQuery = not record.dead
			object.CanCollide = not record.dead
		end
	end
end

function HeroCombatService:_buildTargets()
	-- Управляем только папкой, созданной этим модулем.
	local folder = Workspace:FindFirstChild("TrainingEnemies")
	if folder then
		assert(folder:IsA("Folder") and folder:GetAttribute("HeroCombatManaged") == true, "TrainingEnemies уже используется другим объектом")
		folder:Destroy()
	end
	folder = Instance.new("Folder")
	folder.Name = "TrainingEnemies"
	folder:SetAttribute("HeroCombatManaged", true)
	folder.Parent = Workspace
	self.targetFolder = folder
	local positions = {
		Vector3.new(-30, 0, -100), Vector3.new(30, 0, -100),
		Vector3.new(-30, 0, -120), Vector3.new(30, 0, -120),
		Vector3.new(-30, 0, -140), Vector3.new(30, 0, -140), Vector3.new(0, 0, -140),
	}
	for index, position in ipairs(positions) do
		local boss = index == #positions
		local model = Instance.new("Model")
		model.Name = boss and "ArenaSentinel" or "TrainingBot" .. index
		model.Parent = folder
		local accent = boss and Color3.fromRGB(255, 130, 80) or Color3.fromRGB(80, 195, 235)
		local scale = boss and 1.45 or 1
		local chest = part(model, "Core", Vector3.new(3, 3, 2) * scale, CFrame.new(position + Vector3.new(0, 3.7 * scale, 0)), Color3.fromRGB(54, 64, 83))
		part(model, "Head", Vector3.new(2, 1.6, 1.7) * scale, CFrame.new(position + Vector3.new(0, 6 * scale, 0)), accent)
		part(model, "EnergyCell", Vector3.new(1.1, 1.1, 0.15) * scale, CFrame.new(position + Vector3.new(0, 3.9 * scale, -1.1 * scale)) * CFrame.Angles(0, 0, math.pi / 4), accent, Enum.Material.Neon)
		for _, side in ipairs({ -1, 1 }) do
			part(model, "Arm" .. side, Vector3.new(0.8, 2.8, 1) * scale, CFrame.new(position + Vector3.new(side * 2 * scale, 3.6 * scale, 0)), accent)
			part(model, "Leg" .. side, Vector3.new(0.9, 2.2, 1) * scale, CFrame.new(position + Vector3.new(side * 0.8 * scale, 1.1 * scale, 0)), Color3.fromRGB(54, 64, 83))
		end
		model.PrimaryPart = chest
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "HealthDisplay"
		billboard.Size = UDim2.fromOffset(190, 54)
		billboard.StudsOffset = Vector3.new(0, 4.3 * scale, 0)
		billboard.AlwaysOnTop = true
		billboard.MaxDistance = 130
		billboard.Parent = chest
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 0.25
		label.BackgroundColor3 = Color3.fromRGB(18, 27, 43)
		label.TextColor3 = accent
		label.TextStrokeTransparency = 0.6
		label.Font = Enum.Font.GothamBold
		label.TextSize = 16
		label.Parent = billboard
		local record = {
			model = model, center = chest, label = label, name = boss and "СТРАЖ АРЕНЫ" or "Тренировочный дрон",
			health = boss and 400 or 80, maxHealth = boss and 400 or 80,
			coins = boss and 500 or 60, xp = boss and 200 or 40, respawn = boss and 30 or 8, dead = false,
		}
		self.targets[model] = record
		for _, object in ipairs(model:GetChildren()) do if object:IsA("BasePart") then self.targetParts[object] = record end end
		self:_targetLabel(record)
	end
end

function HeroCombatService:_effect(kind, from, to, definition, id)
	self.effectRemote:FireAllClients({ kind = kind, from = from, to = to, color = colorFor(definition), hero = id })
end

function HeroCombatService:_damageTarget(player, profile, record, damage, origin, range)
	if not record or self.targets[record.model] ~= record or not record.model.Parent
		or not record.model:IsDescendantOf(self.targetFolder) or record.dead
		or (record.center.Position - origin).Magnitude > range + 4 then return false end
	-- Урон, флаг смерти и награда идут без yield: один дрон не выдаст награду дважды.
	local amount, killed = Rules.ApplyDamage(record, damage)
	if amount <= 0 then return false end
	self:_targetLabel(record)
	if killed then
		local coins, xp = Rules.Reward(self.config, profile, record.coins, record.xp)
		self.tycoon:SyncPlayer(player)
		self:_notify(player, record.name .. ": +" .. coins .. " монет, +" .. xp .. " XP!", "success")
		task.delay(record.respawn, function()
			if self.destroyed or self.targets[record.model] ~= record or not record.model.Parent then return end
			record.health = record.maxHealth
			record.dead = false
			self:_targetLabel(record)
		end)
	end
	return true
end

function HeroCombatService:_combatant(player)
	local profile = self:_profile(player)
	local character, humanoid, root = liveCharacter(player)
	return { id = player.UserId, ready = profile ~= nil, optedIn = player:GetAttribute("ArenaCombatOptIn") == true,
		alive = humanoid ~= nil, protected = character and character:FindFirstChildOfClass("ForceField") ~= nil,
		position = root and root.Position }, humanoid, root
end

function HeroCombatService:_damagePlayer(attacker, target, amount, origin, range)
	local attackerData = self:_combatant(attacker)
	local targetData, humanoid, root = self:_combatant(target)
	if not Rules.PvPAllowed(attackerData, targetData) or not root
		or (root.Position - origin).Magnitude > range + 3 then return false end
	-- Никаких наград за убийство игроков: нельзя фармить валюту вторым аккаунтом.
	humanoid:TakeDamage(amount)
	return true
end

function HeroCombatService:_hitPlayer(partHit)
	local node = partHit
	while node and node ~= Workspace do
		if node:IsA("Model") then
			local player = self.players:GetPlayerFromCharacter(node)
			if player then return player end
		end
		node = node.Parent
	end
	return nil
end

function HeroCombatService:_attack(player, aim)
	local now = os.clock()
	-- Недорогой ограничитель отклоняет спам до Raycast и обхода игроков.
	if not Rules.CooldownReady(now, self.lastRequest[player] or -math.huge, 0.08) then return end
	self.lastRequest[player] = now
	local profile = self:_profile(player)
	if not profile then return end
	local definition, id = self:_definition(profile)
	local character, _, root = liveCharacter(player)
	local issued = self.issuedTools[player]
	if not definition or not character or not issued or issued.Parent ~= character
		or issued:GetAttribute("HeroWeapon") ~= id or not Rules.InArena(root.Position) then return end
	local origin = root.Position + Vector3.new(0, 1.5, 0)
	local direction = Rules.CastDirection(origin, aim, definition.Range)
	if not direction or now < (self.nextAttackAt[player] or -math.huge) then return end
	-- Смена оружия не сбрасывает общий cooldown игрока.
	self.nextAttackAt[player] = now + definition.Cooldown
	local parameters = RaycastParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Exclude
	parameters.FilterDescendantsInstances = { character }
	parameters.IgnoreWater = true
	if definition.Kind == "slam" then
		self:_effect("slam", root.Position, root.Position, definition, id)
		for _, record in pairs(self.targets) do
			local offset = record.center.Position - origin
			if not record.dead and offset.Magnitude <= definition.Range then
				local hit = Workspace:Raycast(origin, offset, parameters)
				if hit and self.targetParts[hit.Instance] == record then
					self:_damageTarget(player, profile, record, definition.Damage, origin, definition.Range)
				end
			end
		end
		for _, target in ipairs(self.players:GetPlayers()) do
			if target ~= player then
				local _, _, targetRoot = liveCharacter(target)
				if targetRoot then
					local offset = targetRoot.Position - origin
					if offset.Magnitude <= definition.Range then
						local hit = Workspace:Raycast(origin, offset, parameters)
						if hit and hit.Instance:IsDescendantOf(target.Character) then self:_damagePlayer(player, target, definition.Damage, origin, definition.Range) end
					end
				end
			end
		end
	else
		local hit = Workspace:Raycast(origin, direction, parameters)
		local endpoint = hit and hit.Position or origin + direction
		self:_effect("beam", origin, endpoint, definition, id)
		if hit then
			local record = self.targetParts[hit.Instance]
			if record then
				self:_damageTarget(player, profile, record, definition.Damage, origin, definition.Range)
			else
				local target = self:_hitPlayer(hit.Instance)
				if target then self:_damagePlayer(player, target, definition.Damage, origin, definition.Range) end
			end
		end
	end
end

function HeroCombatService:_watchPlayer(player)
	if self.playerConnections[player] then return end
	local connections = {}
	self.playerConnections[player] = connections
	local function characterReady(character)
		player:SetAttribute("ArenaCombatOptIn", false)
		self:_removeTool(player)
		self:_clearAppearance(player)
		task.spawn(function()
			local humanoid = character:WaitForChild("Humanoid", 10)
			local root = character:WaitForChild("HumanoidRootPart", 10)
			local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack", 10)
			if humanoid and root and backpack and self.playerConnections[player] == connections and player.Character == character then self:Refresh(player) end
		end)
	end
	table.insert(connections, player.CharacterAdded:Connect(characterReady))
	table.insert(connections, player.CharacterAppearanceLoaded:Connect(function(character)
		if player.Character == character then self:Refresh(player) end
	end))
	table.insert(connections, player:GetAttributeChangedSignal("DataReady"):Connect(function() self:Refresh(player) end))
	if player.Character then characterReady(player.Character) end
end

function HeroCombatService:_removePlayer(player)
	local connections = self.playerConnections[player]
	if connections then for _, connection in ipairs(connections) do connection:Disconnect() end end
	self.playerConnections[player] = nil
	self:_removeTool(player)
	self:_clearAppearance(player)
	self.nextAttackAt[player] = nil
	self.lastRequest[player] = nil
	self.lastEquip[player] = nil
end

function HeroCombatService:Start()
	assert(not self.started, "HeroCombatService уже запущен")
	self.started = true
	self:_buildTargets()
	if self.tycoon.SetPerkHandler then
		self.tycoon:SetPerkHandler(function(player, humanoid, profile) self:ApplyPerks(player, humanoid, profile) end)
	end
	table.insert(self.connections, self.skillRemote.OnServerEvent:Connect(function(player, aim) self:_attack(player, aim) end))
	table.insert(self.connections, self.players.PlayerAdded:Connect(function(player) self:_watchPlayer(player) end))
	table.insert(self.connections, self.players.PlayerRemoving:Connect(function(player) self:_removePlayer(player) end))
	for _, player in ipairs(self.players:GetPlayers()) do self:_watchPlayer(player) end
end

function HeroCombatService:Destroy()
	self.destroyed = true
	for _, connection in ipairs(self.connections) do connection:Disconnect() end
	for player in pairs(self.playerConnections) do self:_removePlayer(player) end
	if self.targetFolder and self.targetFolder.Parent then self.targetFolder:Destroy() end
	table.clear(self.connections)
	table.clear(self.targets)
	table.clear(self.targetParts)
end

return HeroCombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">HeroWorld</string>
          <string name="Source"><![CDATA[-- Только оформление мира: награды, герои и бой проверяются другими серверными модулями.
local HeroWorld = {}

local DARK = Color3.fromRGB(34, 48, 70)
local CREAM = Color3.fromRGB(243, 239, 220)
local GOLD = Color3.fromRGB(255, 201, 76)
local CYAN = Color3.fromRGB(83, 224, 234)
local VIOLET = Color3.fromRGB(176, 125, 242)

local function child(parent, className, name)
	local existing = parent:FindFirstChild(name)
	if existing then
		assert(existing:IsA(className), name .. " has the wrong object type")
		return existing
	end
	local object = Instance.new(className)
	object.Name = name
	object.Parent = parent
	return object
end

local function part(parent, name, size, position, color, material, collide)
	local object = child(parent, "Part", name)
	object.Anchored = true
	object.Size = size
	object.CFrame = CFrame.new(position)
	object.Color = color
	object.Material = material or Enum.Material.SmoothPlastic
	object.Shape = Enum.PartType.Block
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	object.CanCollide = collide ~= false
	object.CanTouch = false
	object.CanQuery = true
	return object
end

local function label(parent, name, text, offset, width, height)
	local gui = child(parent, "BillboardGui", name)
	gui.Size = UDim2.new(0, width or 190, 0, height or 48)
	gui.StudsOffset = offset
	gui.AlwaysOnTop = false
	gui.MaxDistance = 95
	local textLabel = child(gui, "TextLabel", "TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundColor3 = DARK
	textLabel.BackgroundTransparency = 0.08
	textLabel.BorderSizePixel = 0
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextColor3 = CREAM
	textLabel.TextScaled = true
	textLabel.TextWrapped = true
	textLabel.Text = text
	return textLabel
end

local function stand(campus, name, position, color, promptName, action, title)
	local base = part(campus, name, Vector3.new(7, 0.5, 5), position, color, Enum.Material.Neon)
	local prompt = child(base, "ProximityPrompt", promptName)
	prompt.ActionText = action
	prompt.ObjectText = title
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.HoldDuration = 0.25
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	-- The runtime service decides availability after construction.
	prompt.Enabled = true
	label(base, "StandLabel", title, Vector3.new(0, 5.5, 0), 190, 52)
	return base
end

local function gate(parent, name, x, z, color)
	local model = child(parent, "Model", name)
	for _, side in ipairs({ -1, 1 }) do
		local suffix = if side < 0 then "Left" else "Right"
		part(model, suffix .. "Pillar", Vector3.new(1, 9, 1.5), Vector3.new(x + side * 5, 4.5, z), DARK, Enum.Material.Metal)
		part(model, suffix .. "Glow", Vector3.new(0.2, 7, 1.6), Vector3.new(x + side * 4.45, 4.5, z), color, Enum.Material.Neon, false)
	end
	part(model, "Top", Vector3.new(11, 1, 1.5), Vector3.new(x, 9.5, z), color, Enum.Material.Neon)
	return model
end

local function buildStands(campus, decor)
	stand(campus, "DailyStand", Vector3.new(-20, 0.55, 18), GOLD, "ClaimDailyPrompt", "Получить подарок", "ЕЖЕДНЕВНЫЙ ПОДАРОК")
	stand(campus, "QuestStand", Vector3.new(20, 0.55, 18), CYAN, "QuestPrompt", "Посмотреть задания", "ЗАДАНИЯ ГЕРОЯ")
	stand(campus, "ArenaPortal", Vector3.new(0, 0.55, -43), Color3.fromRGB(240, 105, 104), "EnterArenaPrompt", "Войти в PvP", "PvP / БОЙ С ИГРОКАМИ И РОБОТАМИ")
	stand(campus, "ReturnStand", Vector3.new(35, 0.55, -88), CYAN, "ReturnPrompt", "Вернуться домой", "ВЕРНУТЬСЯ В БЕЗОПАСНУЮ ЗОНУ")
	stand(campus, "RebirthStand", Vector3.new(-26, 0.55, 0), VIOLET, "RebirthPrompt", "Перерождение", "ПЕРЕРОЖДЕНИЕ")
	gate(decor, "ArenaGate", 0, -47, Color3.fromRGB(240, 105, 104))
	gate(decor, "ReturnGate", 35, -91, CYAN)
	gate(decor, "RebirthGate", -26, -3, VIOLET)
	part(decor, "DailyGift", Vector3.new(3.5, 2.8, 3), Vector3.new(-20, 2.2, 21.1), GOLD)
	part(decor, "GiftRibbon", Vector3.new(0.6, 2.85, 3.1), Vector3.new(-20, 2.2, 21.1), CREAM, Enum.Material.SmoothPlastic, false)
	part(decor, "GiftLid", Vector3.new(3.8, 0.35, 3.3), Vector3.new(-20, 3.8, 21.1), CREAM)
	part(decor, "QuestBoard", Vector3.new(5, 4, 0.5), Vector3.new(20, 3.2, 21.1), DARK)
	for index = 1, 3 do
		part(decor, "QuestLine" .. index, Vector3.new(3.6, 0.18, 0.12), Vector3.new(20, 4.3 - index * 0.8, 20.79), CYAN, Enum.Material.Neon, false)
	end
end

local function buildHero(gallery, definition, index)
	local column = (index - 1) % 3
	local z = if index <= 3 then -12 else 24
	local origin = Vector3.new(42 + column * 13, 0, z)
	local model = child(gallery, "Model", "Hero" .. index)
	model:SetAttribute("HeroId", definition.Id)
	local rgb = definition.Color
	local color = Color3.fromRGB(rgb[1], rgb[2], rgb[3])
	local base = part(model, "Pedestal", Vector3.new(8, 0.6, 8), origin + Vector3.new(0, 0.3, 0), DARK, Enum.Material.Concrete)
	part(model, "PedestalGlow", Vector3.new(7.5, 0.08, 7.5), origin + Vector3.new(0, 0.64, 0), color, Enum.Material.Neon, false)
	for _, side in ipairs({ -1, 1 }) do
		local suffix = if side < 0 then "Left" else "Right"
		part(model, suffix .. "Leg", Vector3.new(0.8, 2.2, 1), origin + Vector3.new(side * 0.55, 1.8, 0), DARK, Enum.Material.SmoothPlastic, false)
		part(model, suffix .. "Arm", Vector3.new(0.7, 2.7, 1), origin + Vector3.new(side * 1.4, 4.25, 0), color, Enum.Material.SmoothPlastic, false)
	end
	part(model, "Torso", Vector3.new(if index == 4 then 2.5 else 2, 2.7, 1.2), origin + Vector3.new(0, 4.25, 0), color, Enum.Material.SmoothPlastic, false)
	local head = part(model, "Head", Vector3.new(1.6, 1.6, 1.6), origin + Vector3.new(0, 6.45, 0), color, Enum.Material.SmoothPlastic, false)
	head.Shape = Enum.PartType.Ball
	part(model, "Visor", Vector3.new(1.2, 0.28, 0.15), origin + Vector3.new(0, 6.55, -0.8), CREAM, Enum.Material.Neon, false)
	part(model, "Emblem", Vector3.new(0.6, 0.7, 0.15), origin + Vector3.new(0, 4.65, -0.67), CREAM, Enum.Material.Neon, false)
	if index == 2 then
		part(model, "Cape", Vector3.new(3.3, 3.9, 0.2), origin + Vector3.new(0, 3.6, 0.85), Color3.fromRGB(62, 40, 89), Enum.Material.SmoothPlastic, false)
	elseif index == 4 then
		for _, side in ipairs({ -1, 1 }) do
			part(model, "Armor" .. (if side < 0 then "Left" else "Right"), Vector3.new(1.1, 0.8, 1.4), origin + Vector3.new(side * 1.4, 5.35, 0), GOLD, Enum.Material.Metal, false)
		end
	elseif index == 5 then
		for spike = 1, 3 do
			part(model, "IceCrown" .. spike, Vector3.new(0.2, 0.6, 0.25), origin + Vector3.new((spike - 2) * 0.45, 7.35, 0), CYAN, Enum.Material.Neon, false)
		end
	elseif index == 6 then
		part(model, "SunCrest", Vector3.new(0.5, 0.7, 0.4), origin + Vector3.new(0, 7.45, 0), GOLD, Enum.Material.Neon, false)
	end
	label(base, "HeroLabel", definition.Name .. "\nВыбор: кнопка «Герои»", Vector3.new(0, 9, 0), 155, 52)
end

local function buildArena(campus)
	local arena = child(campus, "Folder", "Arena")
	part(arena, "Floor", Vector3.new(100, 0.24, 76), Vector3.new(0, 0.12, -120), Color3.fromRGB(93, 111, 131), Enum.Material.Concrete)
	-- Open center gates give characters a sixteen-stud entrance and exit.
	for _, z in ipairs({ -82, -158 }) do
		local endName = if z == -82 then "North" else "South"
		for _, side in ipairs({ -1, 1 }) do
			local suffix = if side < 0 then "Left" else "Right"
			part(arena, endName .. suffix .. "Wall", Vector3.new(42, 3.5, 1), Vector3.new(side * 29, 1.75, z), DARK, Enum.Material.Metal)
			part(arena, endName .. suffix .. "Trim", Vector3.new(42, 0.15, 1.1), Vector3.new(side * 29, 3.6, z), CYAN, Enum.Material.Neon, false)
		end
	end
	for _, side in ipairs({ -1, 1 }) do
		local suffix = if side < 0 then "Left" else "Right"
		part(arena, suffix .. "Wall", Vector3.new(1, 3.5, 76), Vector3.new(side * 49.5, 1.75, -120), DARK, Enum.Material.Metal)
		part(arena, suffix .. "Trim", Vector3.new(1.1, 0.15, 76), Vector3.new(side * 49.5, 3.6, -120), CYAN, Enum.Material.Neon, false)
	end
	-- Lines decorate the floor without adding barriers inside the battle area.
	part(arena, "CenterLine", Vector3.new(88, 0.02, 0.15), Vector3.new(0, 0.25, -120), CREAM, Enum.Material.SmoothPlastic, false)
	for index, position in ipairs({ Vector3.new(-46, 4.5, -86), Vector3.new(46, 4.5, -86), Vector3.new(-46, 4.5, -154), Vector3.new(46, 4.5, -154) }) do
		part(arena, "LampPost" .. index, Vector3.new(0.6, 9, 0.6), position, DARK, Enum.Material.Metal)
		part(arena, "Lamp" .. index, Vector3.new(2, 0.6, 2), position + Vector3.new(0, 4.7, 0), CYAN, Enum.Material.Neon, false)
	end
	label(arena:FindFirstChild("Floor"), "ArenaLabel", "АРЕНА PvP\nБой с игроками и роботами", Vector3.new(0, 13, 0), 290, 60)
end

local function buildTraining(campus)
	local park = child(campus, "Folder", "TrainingPark")
	part(park, "Floor", Vector3.new(64, 0.2, 68), Vector3.new(0, 0.1, 120), Color3.fromRGB(110, 157, 135), Enum.Material.Grass)
	for lane, x in ipairs({ -22, 0, 22 }) do
		part(park, "Lane" .. lane, Vector3.new(9, 0.04, 62), Vector3.new(x, 0.22, 120), CREAM, Enum.Material.SmoothPlastic, false)
	end
	for index = 1, 5 do
		local height = index * 0.5
		part(park, "JumpBlock" .. index, Vector3.new(7, height, 6), Vector3.new(-22, 0.25 + height / 2, 92 + index * 10), CYAN)
		part(park, "Hurdle" .. index, Vector3.new(7, 1.5, 0.7), Vector3.new(0, 1, 92 + index * 10), GOLD)
		part(park, "Slalom" .. index, Vector3.new(1.2, 4, 1.2), Vector3.new(22 + (if index % 2 == 0 then -3 else 3), 2.2, 92 + index * 10), VIOLET)
	end
	local start = part(park, "Start", Vector3.new(54, 0.1, 3), Vector3.new(0, 0.3, 88), DARK)
	label(start, "TrainingLabel", "ТРЕНИРОВОЧНЫЙ ПАРК\nПрыжки • препятствия • слалом", Vector3.new(0, 6, 0), 270, 55)
	part(park, "Finish", Vector3.new(54, 0.1, 3), Vector3.new(0, 0.3, 151), GOLD, Enum.Material.Neon)
end

function HeroWorld.Build(workspace, config)
	assert(type(config.Heroes) == "table" and #config.Heroes == 6, "HeroWorld expects six configured heroes")
	local campus = child(workspace, "Folder", "HeroCampus")
	local decor = child(campus, "Folder", "Decor")
	buildStands(campus, decor)
	local gallery = child(campus, "Folder", "Gallery")
	for index, definition in ipairs(config.Heroes) do
		buildHero(gallery, definition, index)
	end
	buildArena(campus)
	buildTraining(campus)
	campus:SetAttribute("WorldReady", true)
	return campus
end

return HeroWorld
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">HouseWorld</string>
          <string name="Source"><![CDATA[-- Physical tycoon plots. This module only draws the world; the server owns money
-- and all purchase decisions. Rebuilding Structure never deletes a prompt.
local World = {}

local DEFAULT_POSITIONS = {
	Vector3.new(-148, 0, -170), Vector3.new(148, 0, -170),
	Vector3.new(-148, 0, -102), Vector3.new(148, 0, -102),
	Vector3.new(-148, 0, -34), Vector3.new(148, 0, -34),
	Vector3.new(-148, 0, 34), Vector3.new(148, 0, 34),
	Vector3.new(-148, 0, 102), Vector3.new(148, 0, 102),
	Vector3.new(-148, 0, 170), Vector3.new(148, 0, 170),
}

local HOUSE_COLORS = {
	Color3.fromRGB(174, 216, 213),
	Color3.fromRGB(190, 205, 233),
	Color3.fromRGB(229, 193, 178),
	Color3.fromRGB(212, 206, 233),
}

local CREAM = Color3.fromRGB(247, 238, 216)
local WOOD = Color3.fromRGB(151, 115, 83)
local DARK = Color3.fromRGB(56, 77, 94)
local GOLD = Color3.fromRGB(255, 199, 66)
local CYAN = Color3.fromRGB(77, 221, 218)

local function child(parent, className, name)
	local existing = parent:FindFirstChild(name)
	if existing then
		assert(existing:IsA(className), name .. " has the wrong object type")
		return existing
	end
	local object = Instance.new(className)
	object.Name = name
	object.Parent = parent
	return object
end

local function part(parent, name, size, position, color, material, canCollide)
	local object = child(parent, "Part", name)
	object.Anchored = true
	object.Size = size
	object.CFrame = CFrame.new(position)
	object.Color = color
	object.Material = material or Enum.Material.SmoothPlastic
	object.Shape = Enum.PartType.Block
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	object.CanCollide = canCollide ~= false
	object.CanTouch = false
	object.CanQuery = true
	return object
end

local function prompt(parent, name, actionText, objectText, enabled)
	local object = child(parent, "ProximityPrompt", name)
	object.ActionText = actionText
	object.ObjectText = objectText
	object.MaxActivationDistance = 10
	object.RequiresLineOfSight = false
	object.HoldDuration = 0.25
	object.KeyboardKeyCode = Enum.KeyCode.E
	object.Enabled = enabled
	return object
end

local function label(parent, name, text, offset, width, height)
	local gui = child(parent, "BillboardGui", name)
	gui.Size = UDim2.new(0, width or 210, 0, height or 50)
	gui.StudsOffset = offset or Vector3.new(0, 3, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 90
	local textLabel = child(gui, "TextLabel", "TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundColor3 = DARK
	textLabel.BackgroundTransparency = 0.1
	textLabel.BorderSizePixel = 0
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextColor3 = CREAM
	textLabel.TextScaled = true
	textLabel.TextWrapped = true
	textLabel.Text = text
	return textLabel
end

local function pad(plot, origin, name, x, color, promptName, actionText, objectText, enabled)
	local object = part(plot, name, Vector3.new(6, 0.35, 4), origin + Vector3.new(x, 0.55, -17), color, Enum.Material.Neon)
	prompt(object, promptName, actionText, objectText, enabled)
	label(object, "PadLabel", objectText, Vector3.new(0, 2.3, 0), 140, 38)
	return object
end

-- A door is an opening in the wall, so the entrance is always walkable.
local function frontWall(structure, origin, floor, y, wallColor)
	local z = -10
	part(structure, "FrontLeft" .. floor, Vector3.new(10, 10.5, 0.7), origin + Vector3.new(-9, y + 5.25, z), wallColor)
	part(structure, "FrontRight" .. floor, Vector3.new(10, 10.5, 0.7), origin + Vector3.new(9, y + 5.25, z), wallColor)
	part(structure, "FrontLintel" .. floor, Vector3.new(8, 3, 0.7), origin + Vector3.new(0, y + 9, z), CREAM)
	if floor > 1 then
		-- A closed upper window; only the ground floor is the main entrance.
		local pane = part(structure, "FrontWindow" .. floor, Vector3.new(7.5, 6.8, 0.25), origin + Vector3.new(0, y + 3.9, z), CYAN, Enum.Material.Glass)
		pane.Transparency = 0.5
	end
end

local function rearWall(structure, origin, floor, y, wallColor)
	part(structure, "RearLeft" .. floor, Vector3.new(7, 10.5, 0.7), origin + Vector3.new(-10.5, y + 5.25, 14), wallColor)
	part(structure, "RearMiddle" .. floor, Vector3.new(8, 10.5, 0.7), origin + Vector3.new(0, y + 5.25, 14), wallColor)
	if floor == 2 then
		part(structure, "RearDoorLintel2", Vector3.new(7, 3, 0.7), origin + Vector3.new(10.5, y + 9, 14), CREAM)
	else
		part(structure, "RearRight" .. floor, Vector3.new(7, 10.5, 0.7), origin + Vector3.new(10.5, y + 5.25, 14), wallColor)
	end
	for _, x in ipairs({ -5.5, 5.5 }) do
		local suffix = if x < 0 then "Left" else "Right"
		part(structure, "RearWindowSill" .. suffix .. floor, Vector3.new(3, 2.5, 0.7), origin + Vector3.new(x, y + 1.25, 14), CREAM)
		part(structure, "RearWindowTop" .. suffix .. floor, Vector3.new(3, 2, 0.7), origin + Vector3.new(x, y + 9.5, 14), CREAM)
		local pane = part(structure, "RearWindow" .. suffix .. floor, Vector3.new(3, 6, 0.25), origin + Vector3.new(x, y + 5.5, 14), CYAN, Enum.Material.Glass)
		pane.Transparency = 0.5
	end
end

local function rightWall(structure, origin, floor, y, wallColor)
	-- Floor 2 enters through the rear wall; floor 3 uses this side doorway.
	local doorCenter = -7
	if floor < 3 then
		part(structure, "RightWall" .. floor, Vector3.new(0.7, 10.5, 24), origin + Vector3.new(14, y + 5.25, 2), wallColor)
		return
	end
	local beforeLength = doorCenter - 3 - (-10)
	local afterLength = 14 - (doorCenter + 3)
	if beforeLength > 0 then
		part(structure, "RightFront" .. floor, Vector3.new(0.7, 10.5, beforeLength), origin + Vector3.new(14, y + 5.25, -10 + beforeLength / 2), wallColor)
	end
	if afterLength > 0 then
		part(structure, "RightRear" .. floor, Vector3.new(0.7, 10.5, afterLength), origin + Vector3.new(14, y + 5.25, doorCenter + 3 + afterLength / 2), wallColor)
	end
	part(structure, "SideDoorLintel" .. floor, Vector3.new(0.7, 3, 6), origin + Vector3.new(14, y + 9, doorCenter), CREAM)
end

local function buildDropper(structure, origin, floor, floorTop)
	local model = child(structure, "Model", "Dropper" .. floor)
	local position = origin + Vector3.new(-7, floorTop, 7)
	local color = if floor == 3 then GOLD elseif floor == 2 then CYAN else Color3.fromRGB(122, 179, 239)
	part(model, "MachineBase", Vector3.new(8, 0.6, 8), position + Vector3.new(0, 0.3, 0), DARK, Enum.Material.Metal)
	part(model, "MachineBack", Vector3.new(7, 5, 1), position + Vector3.new(0, 3, 3), color, Enum.Material.Metal)
	part(model, "MachineTop", Vector3.new(7, 1, 5), position + Vector3.new(0, 5.8, 1), color, Enum.Material.Metal)
	part(model, "Nozzle", Vector3.new(1.5, 0.7, 1.5), position + Vector3.new(0, 4.95, -0.7), GOLD, Enum.Material.Neon, false)
	part(model, "Conveyor", Vector3.new(5, 0.4, 6), position + Vector3.new(0, 0.8, -0.5), WOOD, Enum.Material.WoodPlanks)
	for index = 1, 5 do
		part(model, "BeltStripe" .. index, Vector3.new(5, 0.04, 0.18), position + Vector3.new(0, 1.03, -3.3 + index), CREAM, Enum.Material.SmoothPlastic, false)
	end
	local start = part(model, "DropletStart", Vector3.new(0.2, 0.2, 0.2), position + Vector3.new(0, 4.55, -0.7), color, Enum.Material.SmoothPlastic, false)
	local finish = part(model, "DropletEnd", Vector3.new(0.2, 0.2, 0.2), position + Vector3.new(0, 1.25, -0.7), color, Enum.Material.SmoothPlastic, false)
	start.Transparency = 1
	finish.Transparency = 1
	start.CanQuery = false
	finish.CanQuery = false
	label(model:FindFirstChild("MachineBack"), "MachineLabel", if floor == 3 then "ЗОЛОТОЙ ГЕНЕРАТОР" else "ГЕНЕРАТОР " .. floor, Vector3.new(0, 2.4, 0), 150, 40)
end

local function buildStairs(structure, origin, targetFloor)
	local startingTop = 0.8 + (targetFloor - 2) * 12
	local laneX = if targetFloor == 2 then 16.25 else 20
	-- Separate lanes keep the second flight above neither the player's head
	-- nor the first flight. Thin treads leave the space below them open.
	if targetFloor == 2 then
		part(structure, "StairStart", Vector3.new(3.5, 0.4, 3), origin + Vector3.new(laneX, 0.6, -10.5), WOOD, Enum.Material.WoodPlanks)
	end
	-- 24 half-stud risers are climbable by the standard Roblox character.
	for step = 1, 24 do
		local height = step * 0.5
		local z = if targetFloor == 2 then -9.5 + step else 15.5 - step
		part(structure, "Stair" .. targetFloor .. "Step" .. step, Vector3.new(3.5, 0.4, 1), origin + Vector3.new(laneX, startingTop + height - 0.2, z), WOOD, Enum.Material.WoodPlanks)
	end
	-- A landing starts beyond the final step instead of over the approaching
	-- character. The rear porch connects the second floor's broad rear door.
	local landingZ = if targetFloor == 2 then 16 else -9.5
	local landingDepth = if targetFloor == 2 then 3 else 4
	part(structure, "StairLanding" .. targetFloor, Vector3.new(8.25, 0.4, landingDepth), origin + Vector3.new(17.625, startingTop + 11.8, landingZ), WOOD, Enum.Material.WoodPlanks)
	if targetFloor == 2 then
		part(structure, "RearPorch2", Vector3.new(7, 0.4, 3.5), origin + Vector3.new(10.5, startingTop + 11.8, 15.5), WOOD, Enum.Material.WoodPlanks)
	end
	-- The rail is outside the walking width, never across the doorway.
	part(structure, "LandingRail" .. targetFloor, Vector3.new(0.3, 2.5, landingDepth), origin + Vector3.new(21.85, startingTop + 13.25, landingZ), CREAM)
	part(structure, "LandingRailPost" .. targetFloor, Vector3.new(0.3, 3, 0.3), origin + Vector3.new(21.85, startingTop + 13.5, landingZ), DARK)
end

local function buildThirdFloorExtras(structure, origin, floorTop)
	-- The third floor opens onto a broad balcony above the front walkway.
	local oldWindow = structure:FindFirstChild("FrontWindow3")
	if oldWindow then
		oldWindow:Destroy()
	end
	part(structure, "Balcony", Vector3.new(28, 0.4, 5), origin + Vector3.new(0, floorTop - 0.2, -12.5), WOOD, Enum.Material.WoodPlanks)
	part(structure, "BalconyFrontRail", Vector3.new(28, 2.5, 0.4), origin + Vector3.new(0, floorTop + 1.25, -14.8), GOLD, Enum.Material.Metal)
	part(structure, "BalconyLeftRail", Vector3.new(0.4, 2.5, 5), origin + Vector3.new(-13.8, floorTop + 1.25, -12.5), CREAM)
	part(structure, "BalconyRightRail", Vector3.new(0.4, 2.5, 5), origin + Vector3.new(13.8, floorTop + 1.25, -12.5), CREAM)
	part(structure, "BonusChest", Vector3.new(4.5, 2.6, 3), origin + Vector3.new(6, floorTop + 1.3, 6), GOLD, Enum.Material.Metal)
	part(structure, "BonusChestLid", Vector3.new(4.8, 0.5, 3.3), origin + Vector3.new(6, floorTop + 2.85, 6), CREAM, Enum.Material.Metal)
	part(structure, "BonusChestLock", Vector3.new(0.8, 1, 0.3), origin + Vector3.new(6, floorTop + 1.9, 4.35), GOLD, Enum.Material.Neon, false)
	part(structure, "GoldCarpet", Vector3.new(8, 0.04, 5), origin + Vector3.new(6, floorTop + 0.03, 0), GOLD, Enum.Material.SmoothPlastic, false)
	label(structure:FindFirstChild("BonusChest"), "ChestLabel", "БОНУСЫ 3 ЭТАЖА", Vector3.new(0, 3, 0), 170, 40)
	local display = child(structure, "Model", "HeroDisplay")
	local position = origin + Vector3.new(6, floorTop, 10)
	part(display, "DisplayBase", Vector3.new(4, 0.3, 4), position + Vector3.new(0, 0.15, 0), DARK, Enum.Material.Metal)
	part(display, "LeftLeg", Vector3.new(0.65, 1.5, 0.8), position + Vector3.new(-0.55, 1.05, 0), GOLD, Enum.Material.Metal)
	part(display, "RightLeg", Vector3.new(0.65, 1.5, 0.8), position + Vector3.new(0.55, 1.05, 0), GOLD, Enum.Material.Metal)
	local torso = part(display, "ArmorTorso", Vector3.new(2.2, 2.4, 1.2), position + Vector3.new(0, 3, 0), GOLD, Enum.Material.Metal)
	part(display, "LeftArm", Vector3.new(0.6, 2.2, 0.9), position + Vector3.new(-1.55, 3, 0), GOLD, Enum.Material.Metal)
	part(display, "RightArm", Vector3.new(0.6, 2.2, 0.9), position + Vector3.new(1.55, 3, 0), GOLD, Enum.Material.Metal)
	part(display, "Helmet", Vector3.new(1.5, 1.5, 1.3), position + Vector3.new(0, 4.95, 0), DARK, Enum.Material.Metal)
	part(display, "Visor", Vector3.new(1.1, 0.45, 0.15), position + Vector3.new(0, 5.1, -0.72), CYAN, Enum.Material.Neon, false)
	label(torso, "HeroDisplayLabel", "ЗАЛ ГЕРОЯ", Vector3.new(0, 3.8, 0), 150, 38)
end

function World.UpdatePlot(plot, floorNumber, ownerName)
	local base = plot:FindFirstChild("Base")
	assert(base and base:IsA("BasePart"), "Tycoon plot needs its Base")
	local origin = base.Position - Vector3.new(0, 0.15, 0)
	local floors = math.clamp(math.floor(floorNumber or 0), 0, 3)
	local previous = plot:FindFirstChild("Structure")
	if previous then
		assert(previous:IsA("Folder"), "Plot Structure must be a Folder")
		previous:Destroy()
	end
	local structure = child(plot, "Folder", "Structure")
	local plotId = plot:GetAttribute("PlotId") or 1
	local wallColor = HOUSE_COLORS[((plotId - 1) % #HOUSE_COLORS) + 1]
	part(structure, "Foundation", Vector3.new(29, 0.3, 25), origin + Vector3.new(0, 0.45, 2), CREAM, Enum.Material.Concrete)
	for floor = 1, floors do
		local top = 0.8 + (floor - 1) * 12
		part(structure, "Floor" .. floor, Vector3.new(28, 0.4, 24), origin + Vector3.new(0, top - 0.2, 2), WOOD, Enum.Material.WoodPlanks)
		frontWall(structure, origin, floor, top, wallColor)
		rearWall(structure, origin, floor, top, wallColor)
		rightWall(structure, origin, floor, top, wallColor)
		part(structure, "LeftWall" .. floor, Vector3.new(0.7, 10.5, 24), origin + Vector3.new(-14, top + 5.25, 2), wallColor)
		part(structure, "FrontCornice" .. floor, Vector3.new(29, 0.5, 0.9), origin + Vector3.new(0, top + 10.75, -10), CREAM)
		part(structure, "RearCornice" .. floor, Vector3.new(29, 0.5, 0.9), origin + Vector3.new(0, top + 10.75, 14), CREAM)
		buildDropper(structure, origin, floor, top)
		if floor >= 2 then
			buildStairs(structure, origin, floor)
		end
	end
	if floors > 0 then
		local roofTop = 0.8 + (floors - 1) * 12 + 11.5
		part(structure, "Roof", Vector3.new(30, 0.5, 26), origin + Vector3.new(0, roofTop, 2), DARK, Enum.Material.Slate)
		part(structure, "RoofAccent", Vector3.new(28, 0.15, 24), origin + Vector3.new(0, roofTop + 0.325, 2), if floors == 3 then GOLD else wallColor)
	end
	if floors == 3 then
		buildThirdFloorExtras(structure, origin, 24.8)
	end
	-- Keep this Part and its prompt stable: the server connects to it once.
	-- It becomes an invisible interaction point on the third-floor chest.
	local bonusPad = plot:FindFirstChild("BonusPad")
	if bonusPad then
		bonusPad.Size = Vector3.new(1, 1, 0.35)
		bonusPad.CFrame = CFrame.new(origin + Vector3.new(6, if floors == 3 then 26.7 else 0.55, if floors == 3 then 4 else -17))
		bonusPad.Transparency = 1
		bonusPad.CanCollide = false
		bonusPad.CanQuery = false
		local bonusLabel = bonusPad:FindFirstChild("PadLabel")
		if bonusLabel then
			bonusLabel.Enabled = false
		end
	end
	local sign = plot:FindFirstChild("PlotSign")
	local gui = sign and sign:FindFirstChild("PlotLabel")
	local textLabel = gui and gui:FindFirstChild("TextLabel")
	if textLabel then
		local name = if type(ownerName) == "string" and ownerName ~= "" then ownerName else "Свободный участок"
		textLabel.Text = name .. "\nЭтажи: " .. floors .. " / 3"
	end
	return structure
end

function World.BuildPlots(workspace, config)
	local folder = child(workspace, "Folder", "TycoonPlots")
	local positions = DEFAULT_POSITIONS
	if config and config.PlotLayout then
		positions = {}
		for _, position in ipairs(config.PlotLayout) do
			table.insert(positions, Vector3.new(position.X, 0, position.Z))
		end
	end
	local plots = {}
	for index, origin in ipairs(positions) do
		local plot = child(folder, "Model", "Plot" .. index)
		plot:SetAttribute("PlotId", index)
		plot:SetAttribute("OwnerUserId", 0)
		plot:SetAttribute("OwnerName", "")
		plot:SetAttribute("Floor", 0)
		plot:SetAttribute("Bank", 0)
		plot:SetAttribute("DropperTier", 0)
		plot:SetAttribute("OwnerReady", false)
		local base = part(plot, "Base", Vector3.new(44, 0.3, 44), origin + Vector3.new(0, 0.15, 0), Color3.fromRGB(166, 191, 144), Enum.Material.Grass)
		plot.PrimaryPart = base
		part(plot, "FrontWalk", Vector3.new(30, 0.1, 10), origin + Vector3.new(0, 0.35, -16), CREAM, Enum.Material.Concrete)
		local claim = part(plot, "ClaimPad", Vector3.new(7, 0.3, 2.5), origin + Vector3.new(0, 0.6, -20), Color3.fromRGB(88, 231, 156), Enum.Material.Neon)
		prompt(claim, "ClaimPrompt", "Занять", "Свободный дом", true)
		pad(plot, origin, "Collector", -10.5, Color3.fromRGB(99, 222, 159), "CollectPrompt", "Забрать", "КОПИЛКА", false)
		pad(plot, origin, "UpgradePad", -3.5, Color3.fromRGB(108, 185, 248), "FloorPrompt", "Построить", "ЭТАЖ", false)
		pad(plot, origin, "DropperUpgradePad", 3.5, Color3.fromRGB(175, 137, 242), "DropperPrompt", "Улучшить", "ГЕНЕРАТОР", false)
		pad(plot, origin, "BonusPad", 10.5, GOLD, "BonusPrompt", "Получить", "БОНУС III", false)
		pad(plot, origin, "HeroPad", 10.5, Color3.fromRGB(246, 129, 88), "HeroPrompt", "Выбрать героя", "ГЕРОЙ", false)
		local sign = part(plot, "PlotSign", Vector3.new(1, 4.5, 1), origin + Vector3.new(-18, 2.55, -18), WOOD, Enum.Material.Wood)
		label(sign, "PlotLabel", "Свободный участок\nЭтажи: 0 / 3", Vector3.new(0, 3.2, 0), 225, 65)
		World.UpdatePlot(plot, 0, "")
		table.insert(plots, plot)
	end
	return plots
end

return World
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">LootDropService</string>
          <string name="Source"><![CDATA[-- Бесплатный общий груз. Выбор оружия и выдача награды происходят только на сервере.
local LootDropService = {}
LootDropService.__index = LootDropService

local Helpers = {}
LootDropService.Helpers = Helpers

local function finite(value)
	return type(value) == "number" and value == value and math.abs(value) ~= math.huge
end

-- unitRoll задаётся серверным Random:NextNumber(). Аргумент удобен для проверки шансов.
function Helpers.WeightedRoll(weapons, unitRoll)
	if type(weapons) ~= "table" or not finite(unitRoll) then return nil end
	local total = 0
	local lastWeapon
	for _, weapon in ipairs(weapons) do
		local weight = weapon.LootWeight
		if finite(weight) and weight > 0 then
			total += weight
			lastWeapon = weapon
		end
	end
	if total <= 0 or not finite(total) then return nil end
	local target = math.clamp(unitRoll, 0, 1) * total
	local accumulated = 0
	for _, weapon in ipairs(weapons) do
		local weight = weapon.LootWeight
		if finite(weight) and weight > 0 then
			accumulated += weight
			if target < accumulated then return weapon end
		end
	end
	return lastWeapon
end

-- Эта функция не обращается к RemoteEvent и не содержит ожиданий.
-- В инвентаре остаётся максимум 99 копий, переполнение заменяется монетами.
function Helpers.Grant(config, profile, weapon)
	if type(profile) ~= "table" or type(weapon) ~= "table" then return nil end
	local known = false
	for _, definition in ipairs(config.Weapons or {}) do
		if definition == weapon then known = true; break end
	end
	if not known or type(weapon.Id) ~= "string" then return nil end
	if type(profile.Inventory) ~= "table" then profile.Inventory = {} end
	local maximum = if finite(config.MaxWeaponCopies) then math.clamp(math.floor(config.MaxWeaponCopies), 1, 99) else 99
	local previous = profile.Inventory[weapon.Id]
	previous = if finite(previous) then math.clamp(math.floor(previous), 0, maximum) else 0
	local count = math.min(maximum, previous + 1)
	local compensation = 0
	if previous >= maximum then
		local coins = if finite(profile.Coins) then math.clamp(math.floor(profile.Coins), 0, config.MaxCoins) else 0
		local reward = config.Airdrops and config.Airdrops.DuplicateCoins or 100
		reward = if finite(reward) then math.max(0, math.floor(reward)) else 100
		compensation = math.min(reward, config.MaxCoins - coins)
		profile.Coins = coins + compensation
	end
	profile.Inventory[weapon.Id] = count
	return {
		weaponId = weapon.Id, name = weapon.Name, rarity = weapon.Rarity,
		count = count, duplicate = previous > 0, compensationCoins = compensation,
	}
end

function LootDropService.new(config, profiles, tycoon, notice, lootResult)
	return setmetatable({
		config = config, profiles = profiles, tycoon = tycoon,
		notice = notice, lootResult = lootResult,
		players = game:GetService("Players"), workspace = game:GetService("Workspace"),
		runService = game:GetService("RunService"), tweenService = game:GetService("TweenService"),
		random = Random.new(), connections = {}, lastAttemptAt = {},
		started = false, destroyed = false, active = nil, folder = nil,
	}, LootDropService)
end

local function part(parent, name, size, cframe, color, material)
	local object = Instance.new("Part")
	object.Name = name
	object.Size = size
	object.CFrame = cframe
	object.Color = color
	object.Material = material or Enum.Material.SmoothPlastic
	object.Anchored = true
	object.CanCollide = false
	object.CanTouch = false
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	object.Parent = parent
	return object
end

local function attachedPart(parent, body, name, size, offset, color, material)
	local object = part(parent, name, size, body.CFrame * CFrame.new(offset), color, material)
	object.Massless = true
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = body
	weld.Part1 = object
	weld.Parent = object
	-- Одна закреплённая деталь ведёт весь груз; физика клиента его не перемещает.
	object.Anchored = false
	return object
end

function LootDropService:_removeDrop(drop)
	if drop.removed then return end
	drop.removed = true
	drop.claimed = true
	drop.prompt.Enabled = false
	if self.active == drop then self.active = nil end
	for _, connection in ipairs(drop.connections) do connection:Disconnect() end
	table.clear(drop.connections)
	-- Сначала отключаем Completed, затем отменяем падение.
	if drop.tween then drop.tween:Cancel() end
	drop.model:Destroy()
end

function LootDropService:_currentProfile(player)
	if self.destroyed or self.profiles:IsClosing() or player.Parent ~= self.players
		or player:GetAttribute("DataReady") ~= true then return nil end
	local profile = self.profiles:Get(player)
	local state = self.tycoon:GetState(player)
	if not profile or not state or state.leaving or state.profile ~= profile then return nil end
	return profile
end

function LootDropService:_claim(player, drop)
	local now = os.clock()
	if self.destroyed or self.active ~= drop or drop.claimed or not drop.landed
		or now >= drop.expiresAt or not drop.prompt.Enabled then return end
	if not self.folder or self.folder.Parent ~= self.workspace or drop.model.Parent ~= self.folder or not drop.body:IsDescendantOf(drop.model)
		or drop.prompt.Parent ~= drop.body then return end
	if player.Parent ~= self.players then return end
	if now - (self.lastAttemptAt[player] or -math.huge) < (self.config.ActionCooldown or 0.35) then return end
	self.lastAttemptAt[player] = now
	local profile = self:_currentProfile(player)
	if not profile then return end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not (humanoid.Health > 0) or not root or not root:IsA("BasePart") then return end
	-- Triggered можно подделать: расстояние перепроверяет сам сервер.
	local distance = (root.Position - drop.body.Position).Magnitude
	if not finite(distance) or distance > 12 then return end
	local weapon = Helpers.WeightedRoll(self.config.Weapons, self.random:NextNumber())
	if not weapon then self:_removeDrop(drop); return end
	-- Проверки, пометка и выдача проходят без yield. Только один игрок получит груз.
	drop.claimed = true
	drop.prompt.Enabled = false
	local outcome = Helpers.Grant(self.config, profile, weapon)
	self:_removeDrop(drop)
	if not outcome then return end
	local synced = pcall(function() self.tycoon:SyncPlayer(player) end)
	if not synced then warn("LootDrop: не удалось обновить интерфейс инвентаря") end
	-- SyncPlayer может в будущем стать асинхронным: старой сессии результат не отправляем.
	if self:_currentProfile(player) ~= profile then return end
	self.lootResult:FireClient(player, outcome)
	local text = "Бесплатный груз: " .. outcome.name .. " (" .. outcome.rarity .. ")!"
	if outcome.compensationCoins > 0 then
		text = "Лимит копий: компенсация +" .. outcome.compensationCoins .. " монет!"
	elseif outcome.duplicate then
		text ..= " Копий в инвентаре: " .. outcome.count .. "."
	end
	self.notice:FireClient(player, { text = text, kind = "success" })
end

function LootDropService:_spawnDrop(now)
	local settings = self.config.Airdrops
	local location = settings.Locations[self.random:NextInteger(1, #settings.Locations)]
	local model = Instance.new("Model")
	model.Name = "FreeSupplyCrate"
	local start = CFrame.new(location.X, 88, location.Z)
	local body = part(model, "Crate", Vector3.new(6, 5, 6), start, Color3.fromRGB(48, 69, 100), Enum.Material.Metal)
	model.PrimaryPart = body
	attachedPart(model, body, "Lid", Vector3.new(6.4, 0.5, 6.4), Vector3.new(0, 2.6, 0), Color3.fromRGB(255, 210, 75), Enum.Material.Metal)
	attachedPart(model, body, "GoldBandX", Vector3.new(6.05, 1, 6.05), Vector3.new(0, 0, 0), Color3.fromRGB(255, 210, 75), Enum.Material.Metal)
	local parachute = Instance.new("Folder")
	parachute.Name = "Parachute"
	parachute.Parent = model
	local canopy = attachedPart(parachute, body, "Canopy", Vector3.new(13, 2.5, 13), Vector3.new(0, 14, 0), Color3.fromRGB(79, 218, 208))
	canopy.Shape = Enum.PartType.Ball
	for index, offset in ipairs({ Vector3.new(-2.6, 8, -2.6), Vector3.new(2.6, 8, -2.6), Vector3.new(-2.6, 8, 2.6), Vector3.new(2.6, 8, 2.6) }) do
		attachedPart(parachute, body, "Rope" .. index, Vector3.new(0.12, 10, 0.12), offset, Color3.fromRGB(232, 238, 244))
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "CrateLabel"
	gui.Size = UDim2.fromOffset(240, 54)
	gui.StudsOffset = Vector3.new(0, 5, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 140
	gui.Parent = body
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundColor3 = Color3.fromRGB(25, 37, 60)
	label.BackgroundTransparency = 0.15
	label.BorderSizePixel = 0
	label.TextColor3 = Color3.fromRGB(255, 220, 103)
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextWrapped = true
	label.Text = "БЕСПЛАТНЫЙ ГРУЗ\nПриземляется..."
	label.Parent = gui
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 210, 75)
	light.Brightness = 1.5
	light.Range = 15
	light.Parent = body
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "LootPrompt"
	prompt.ActionText = "Забрать оружие"
	prompt.ObjectText = "Бесплатный груз"
	prompt.MaxActivationDistance = 10
	prompt.HoldDuration = 0.35
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false
	prompt.Parent = body
	model.Parent = self.folder
	local drop = {
		model = model, body = body, prompt = prompt, label = label,
		landed = false, claimed = false, removed = false, connections = {},
		landDeadline = now + settings.FallSeconds + 5, expiresAt = math.huge,
	}
	self.active = drop
	self.nextDropAt = now + self.random:NextNumber(settings.MinInterval, settings.MaxInterval)
	table.insert(drop.connections, prompt.Triggered:Connect(function(player) self:_claim(player, drop) end))
	drop.tween = self.tweenService:Create(body, TweenInfo.new(settings.FallSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		CFrame = CFrame.new(location.X, 2.7, location.Z),
	})
	table.insert(drop.connections, drop.tween.Completed:Connect(function(playbackState)
		if playbackState ~= Enum.PlaybackState.Completed or self.destroyed or self.active ~= drop or drop.removed then return end
		if self.profiles:IsClosing() or model.Parent ~= self.folder or not body:IsDescendantOf(model) then
			self:_removeDrop(drop)
			return
		end
		parachute:Destroy()
		body.CanCollide = true
		drop.landed = true
		drop.expiresAt = os.clock() + settings.Lifetime
		label.Text = "БЕСПЛАТНОЕ ОРУЖИЕ\nПодойди и нажми E"
		prompt.Enabled = true
	end))
	drop.tween:Play()
	self.notice:FireAllClients({ text = "С неба падает бесплатный груз! Забери оружие после приземления.", kind = "info" })
end

function LootDropService:_step(now)
	if self.destroyed then return end
	if self.profiles:IsClosing() or not self.folder or self.folder.Parent ~= self.workspace then
		self:Destroy()
		return
	end
	local drop = self.active
	if drop then
		if drop.model.Parent ~= self.folder or not drop.body:IsDescendantOf(drop.model)
			or drop.prompt.Parent ~= drop.body
			or (not drop.landed and now >= drop.landDeadline)
			or (drop.landed and now >= drop.expiresAt) then
			self:_removeDrop(drop)
		end
	end
	if not self.active and now >= self.nextDropAt then self:_spawnDrop(now) end
end

function LootDropService:Start()
	assert(not self.started and not self.destroyed, "LootDropService уже запущен или завершён")
	local settings = self.config.Airdrops
	assert(settings and type(settings.Locations) == "table" and #settings.Locations > 0, "Не заданы точки бесплатного груза")
	assert(Helpers.WeightedRoll(self.config.Weapons, 0), "Не заданы шансы оружия")
	assert(not self.workspace:FindFirstChild("Airdrops"), "Airdrops уже существует: второй сервис создаст дубликаты")
	self.folder = Instance.new("Folder")
	self.folder.Name = "Airdrops"
	self.folder.Parent = self.workspace
	self.started = true
	self.nextDropAt = os.clock() + settings.FirstDelay
	table.insert(self.connections, self.runService.Heartbeat:Connect(function() self:_step(os.clock()) end))
	table.insert(self.connections, self.players.PlayerRemoving:Connect(function(player) self.lastAttemptAt[player] = nil end))
	game:BindToClose(function() self:Destroy() end)
end

function LootDropService:Destroy()
	if self.destroyed then return end
	self.destroyed = true
	self.started = false
	for _, connection in ipairs(self.connections) do connection:Disconnect() end
	table.clear(self.connections)
	if self.active then self:_removeDrop(self.active) end
	if self.folder then self.folder:Destroy(); self.folder = nil end
	table.clear(self.lastAttemptAt)
end

return LootDropService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[-- Game Pass ownership is checked by Roblox; clients never grant entitlements.
local Players=game:GetService('Players')
local MarketplaceService=game:GetService('MarketplaceService')
local Service={};Service.__index=Service
function Service.new(config,profiles,notice,request)
 return setmetatable({config=config,profiles=profiles,notice=notice,request=request,connections={},states={}},Service)
end
local function create(parent,class,name)
 local object=parent:FindFirstChild(name)
 if object then if object:IsA(class) then return object else return nil end end
 object=Instance.new(class);object.Name=name;object.Parent=parent;return object
end
function Service:_cosmetics(player)
 local character=player.Character
 if character then
  local head=character:FindFirstChild('Head')
  if head then
   local title=head:FindFirstChild('HeroClubTitle')
   if player:GetAttribute('HasVIP')==true then
    title=create(head,'BillboardGui','HeroClubTitle')
    if title then
     title.Size=UDim2.fromOffset(180,32);title.StudsOffset=Vector3.new(0,2.5,0);title.MaxDistance=75
     local label=create(title,'TextLabel','Title')
     if label then
      label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=1;label.Text='КЛУБ ГЕРОЕВ'
      label.TextColor3=Color3.fromRGB(255,218,89);label.Font=Enum.Font.GothamBold;label.TextScaled=true
     end
    end
   elseif title then title:Destroy() end
  end
 end
 local containers={}
 if character then table.insert(containers,character) end
 local backpack=player:FindFirstChildOfClass('Backpack');if backpack then table.insert(containers,backpack) end
 for _,container in ipairs(containers) do
  for _,tool in ipairs(container:GetChildren()) do
   if tool:IsA('Tool') and tool:GetAttribute('HeroWeapon') then
    local handle=tool:FindFirstChild('Handle')
    if handle and handle:IsA('BasePart') then
     if player:GetAttribute('HasNeon')==true then
      local a=create(handle,'Attachment','HeroNeonA');local b=create(handle,'Attachment','HeroNeonB')
      local trail=create(handle,'Trail','HeroNeonTrail')
      if a and b and trail then
       a.Position=Vector3.new(0,0.5,0);b.Position=Vector3.new(0,-0.5,0)
       trail.Attachment0=a;trail.Attachment1=b;trail.Lifetime=0.25
       trail.Color=ColorSequence.new(Color3.fromRGB(91,233,239));trail.Transparency=NumberSequence.new(0.25)
      end
     else
      for _,name in ipairs({'HeroNeonTrail','HeroNeonA','HeroNeonB'}) do
       local object=handle:FindFirstChild(name);if object then object:Destroy() end
      end
     end
    end
   end
  end
 end
end
function Service:_ready(player)
 return player.Parent==Players and player:GetAttribute('DataReady')==true
  and self.profiles:Get(player)~=nil and not self.profiles:IsClosing()
end
function Service:_verify(player,key)
 local pass=self.config.GamePasses[key]
 if not pass or type(pass.Id)~='number' or pass.Id<=0 then return false end
 local ok,owned=pcall(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId,pass.Id) end)
 if ok and owned==true and self:_ready(player) then
  player:SetAttribute(key=='VIP' and 'HasVIP' or 'HasNeon',true)
  self:_cosmetics(player);return true
 end
 return false
end
function Service:_request(player,key)
 local state=self.states[player]
 if type(key)~='string' or not state or not self:_ready(player) then return end
 local pass=self.config.GamePasses[key]
 if not pass or (key~='VIP' and key~='Neon') then return end
 local now=os.clock();if now-state.last<3 then return end;state.last=now
 if type(pass.Id)~='number' or pass.Id<=0 then return end
 if self:_verify(player,key) then
  self.notice:FireClient(player,{kind='info',text='Этот пропуск уже у вас.'});return
 end
 local ok,info=pcall(function() return MarketplaceService:GetProductInfo(pass.Id,Enum.InfoType.GamePass) end)
 if not ok or type(info)~='table' or info.IsForSale~=true or not self:_ready(player) then
  if player.Parent==Players then self.notice:FireClient(player,{kind='error',text='Покупка сейчас недоступна. Попробуйте позже.'}) end
  return
 end
 local prompted=pcall(function() MarketplaceService:PromptGamePassPurchase(player,pass.Id) end)
 if not prompted then self.notice:FireClient(player,{kind='error',text='Не удалось открыть покупку Roblox.'}) end
end
function Service:_add(player)
 if self.states[player] then return end
 local state={last=-math.huge,connections={}};self.states[player]=state
 player:SetAttribute('HasVIP',false);player:SetAttribute('HasNeon',false)
 local function connect(signal,fn) table.insert(state.connections,signal:Connect(fn)) end
 local function load()
  if self:_ready(player) then for key in pairs(self.config.GamePasses) do self:_verify(player,key) end end
 end
 connect(player:GetAttributeChangedSignal('DataReady'),function() task.spawn(load) end)
 connect(player:GetAttributeChangedSignal('HasVIP'),function() self:_cosmetics(player) end)
 connect(player:GetAttributeChangedSignal('HasNeon'),function() self:_cosmetics(player) end)
 local function watch(container)
  connect(container.ChildAdded,function() task.defer(function() self:_cosmetics(player) end) end)
  self:_cosmetics(player)
 end
 connect(player.CharacterAdded,function(character)
  watch(character);task.spawn(function() character:WaitForChild('Head',5);if player.Character==character then self:_cosmetics(player) end end)
 end)
 if player.Character then watch(player.Character) end
 task.spawn(function()
  local backpack=player:WaitForChild('Backpack',10)
  if backpack and self.states[player]==state then watch(backpack) end
 end)
 task.spawn(load)
end
function Service:Start()
 table.insert(self.connections,self.request.OnServerEvent:Connect(function(player,key) self:_request(player,key) end))
 table.insert(self.connections,MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player,id,purchased)
  if purchased~=true or not self:_ready(player) then return end
  for key,pass in pairs(self.config.GamePasses) do
   if pass.Id>0 and pass.Id==id and self:_verify(player,key) then
    self.notice:FireClient(player,{kind='success',text='Покупка подтверждена Roblox: '..pass.Name});return
   end
  end
 end))
 table.insert(self.connections,Players.PlayerAdded:Connect(function(player) self:_add(player) end))
 table.insert(self.connections,Players.PlayerRemoving:Connect(function(player)
  local state=self.states[player];if state then for _,c in ipairs(state.connections) do c:Disconnect() end end
  self.states[player]=nil
 end))
 for _,player in ipairs(Players:GetPlayers()) do self:_add(player) end
end
function Service:Destroy()
 for _,c in ipairs(self.connections) do c:Disconnect() end
 for _,state in pairs(self.states) do for _,c in ipairs(state.connections) do c:Disconnect() end end
 table.clear(self.states)
end
return Service
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">ProfileSchema</string>
          <string name="Source"><![CDATA[-- Проверка сохранённого профиля. Уровень вычисляется из XP, а не хранится отдельно.
local Schema = {}

local function boundedInteger(value, default, maximum)
	if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then
		return default
	end
	return math.clamp(math.floor(value), 0, maximum)
end

function Schema.New(config)
	return { Coins = config.StartingCoins, XP = 0, Floor = 0, DropperTier = 0, Bank = 0, BonusReadyAt = 0,
		Rebirths = 0, EquippedHero = "", CollectedTotal = 0, EnemiesDefeated = 0, DailyReadyAt = 0, QuestClaims = {},
		Inventory = {}, EquippedWeapon = "" }
end

function Schema.Normalize(data, config, now)
	if type(data) ~= "table" then
		return Schema.New(config)
	end
	local floor = boundedInteger(data.Floor, 0, #config.Floors)
	local rebirths = boundedInteger(data.Rebirths, 0, config.MaxRebirths or 20)
	local hero = config.GetHero and config.GetHero(data.EquippedHero)
	local equipped = if hero and config.CanUseHero({ Floor = floor, Rebirths = rebirths }, hero) then hero.Id else ""
	local claims = {}
	for _, quest in ipairs(config.Quests or {}) do
		if type(data.QuestClaims) == "table" and data.QuestClaims[quest.Id] == true then claims[quest.Id] = true end
	end
	local inventory = {}
	for _, weapon in ipairs(config.Weapons or {}) do
		local count = if type(data.Inventory) == "table" then boundedInteger(data.Inventory[weapon.Id], 0, config.MaxWeaponCopies or 99) else 0
		if count > 0 then inventory[weapon.Id] = count end
	end
	local equippedWeapon = if type(data.EquippedWeapon) == "string" and inventory[data.EquippedWeapon] then data.EquippedWeapon else ""
	return {
		Coins = boundedInteger(data.Coins, config.StartingCoins, config.MaxCoins),
		XP = boundedInteger(data.XP, 0, config.MaxXP),
		Floor = floor,
		DropperTier = if floor == 0 then 0 else boundedInteger(data.DropperTier, 0, #config.DropperCosts),
		Bank = if floor == 0 then 0 else boundedInteger(data.Bank, 0, config.MaxBank),
		BonusReadyAt = boundedInteger(data.BonusReadyAt, 0, now + 86400),
		Rebirths = rebirths, EquippedHero = equipped,
		CollectedTotal = boundedInteger(data.CollectedTotal, 0, config.MaxCoins),
		EnemiesDefeated = boundedInteger(data.EnemiesDefeated, 0, config.MaxCoins),
		DailyReadyAt = boundedInteger(data.DailyReadyAt, 0, now + (config.DailyCooldown or 86400)),
		QuestClaims = claims,
		Inventory = inventory, EquippedWeapon = equippedWeapon,
	}
end

function Schema.Copy(profile)
	local claims = {}
	for id, claimed in pairs(profile.QuestClaims or {}) do if claimed == true then claims[id] = true end end
	local inventory = {}
	for id, count in pairs(profile.Inventory or {}) do inventory[id] = count end
	return {
		Coins = profile.Coins, XP = profile.XP, Floor = profile.Floor,
		DropperTier = profile.DropperTier, Bank = profile.Bank, BonusReadyAt = profile.BonusReadyAt,
		Rebirths = profile.Rebirths or 0, EquippedHero = profile.EquippedHero or "",
		CollectedTotal = profile.CollectedTotal or 0, EnemiesDefeated = profile.EnemiesDefeated or 0,
		DailyReadyAt = profile.DailyReadyAt or 0, QuestClaims = claims,
		Inventory = inventory, EquippedWeapon = profile.EquippedWeapon or "",
	}
end

return Schema
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">ProfileService</string>
          <string name="Source"><![CDATA[-- DataStore + блокировка сессии: два сервера не перезаписывают один профиль.
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Schema = require(script.Parent:WaitForChild("ProfileSchema"))

local ProfileService = {}
ProfileService.__index = ProfileService

function ProfileService.new(config)
	local self = setmetatable({
		config = config,
		records = {},
		closing = false,
		sessionId = game.JobId .. ":" .. HttpService:GenerateGUID(false),
		store = nil,
	}, ProfileService)
	if game.GameId ~= 0 then
		local ok, store = pcall(function()
			return DataStoreService:GetDataStore(config.Persistence.StoreName)
		end)
		if ok then self.store = store end
	end
		task.spawn(function()
			while not self.closing do
				task.wait(config.Persistence.SaveInterval)
				if self.closing then break end
				for player, record in pairs(self.records) do
					if record.ready and not record.saving and not record.releasing then
						task.spawn(function()
							if record.cancelled then self:Release(player) else self:Save(player) end
						end)
					end
				end
			end
		end)
	game:BindToClose(function()
		self.closing = true
		local pending = 0
		for player in pairs(self.records) do
			pending += 1
			task.spawn(function()
				self:Release(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 27
		while pending > 0 and os.clock() < deadline do task.wait(0.1) end
	end)
	return self
end

function ProfileService:IsClosing()
	return self.closing
end

function ProfileService:_update(key, callback)
	local lastError
	for attempt = 1, self.config.Persistence.MaxRetries do
		local ok, result = pcall(function() return self.store:UpdateAsync(key, callback) end)
		if ok then return true, result end
		lastError = result
		if attempt < self.config.Persistence.MaxRetries then task.wait(0.8 * attempt) end
	end
	return false, lastError
end

function ProfileService:_sessionProfile(player, record)
	if record.cancelled then
		record.loading = false
		self.records[player] = nil
		return nil, "Игрок вышел во время загрузки"
	end
	record.profile = Schema.New(self.config)
	record.ready = true
	record.mode = "session"
	record.loading = false
	player:SetAttribute("PersistenceMode", "session")
	player:SetAttribute("PersistenceStatus", "session")
	return record.profile
end

function ProfileService:Load(player)
	if self.closing then return nil, "Сервер завершает работу" end
	if self.records[player] then return nil, "Профиль уже загружается" end
	local record = {
		key = "Player_" .. player.UserId,
		token = self.sessionId .. ":" .. player.UserId .. ":" .. HttpService:GenerateGUID(false),
		ready = false, loading = true, cancelled = false, saving = false, player = player,
	}
	self.records[player] = record
	player:SetAttribute("PersistenceStatus", "loading")
	if not self.store then
		if RunService:IsStudio() then return self:_sessionProfile(player, record) end
		self.records[player] = nil
		record.loading = false
		return nil, "Хранилище прогресса недоступно"
	end
	local reason
	local ok, stored = self:_update(record.key, function(old)
		reason = nil
		if record.cancelled then reason = "Игрок вышел"; return nil end
		if old ~= nil and (type(old) ~= "table" or old.Version ~= 1 or type(old.Data) ~= "table") then
			reason = "Неизвестный формат сохранения"; return nil
		end
		local now = os.time()
		local lock = old and old.Session
		if type(lock) == "table" and lock.Id ~= record.token
			and type(lock.ExpiresAt) == "number" and lock.ExpiresAt > now then
			reason = "Профиль ещё открыт на другом сервере. Попробуйте войти позже."; return nil
		end
		return {
			Version = 1, Data = Schema.Normalize(old and old.Data, self.config, now),
			Session = { Id = record.token, ExpiresAt = now + self.config.Persistence.LockSeconds },
			UpdatedAt = now,
		}
	end)
	if record.cancelled then
		-- Не сохраняем стартовые значения, если игрок вышел во время UpdateAsync.
		if ok and stored and stored.Session and stored.Session.Id == record.token then
			self:_update(record.key, function(old)
				if old and old.Session and old.Session.Id == record.token then
					old.Session = nil
					return old
				end
				return nil
			end)
		end
		self.records[player] = nil
		record.loading = false
		return nil, "Игрок вышел во время загрузки"
	end
	if not ok then
		if RunService:IsStudio() then return self:_sessionProfile(player, record) end
		self.records[player] = nil
		record.loading = false
		return nil, "Не удалось загрузить прогресс. Попробуйте войти позже."
	end
	if not stored or not stored.Session or stored.Session.Id ~= record.token then
		self.records[player] = nil
		record.loading = false
		return nil, reason or "Не удалось получить блокировку профиля"
	end
	record.profile = Schema.Normalize(stored.Data, self.config, os.time())
	record.ready = true
	record.mode = "saved"
	record.loading = false
	player:SetAttribute("PersistenceMode", "saved")
	player:SetAttribute("PersistenceStatus", "saved")
	return record.profile
end

function ProfileService:Get(player)
	local record = self.records[player]
	return if record and record.ready and not record.cancelled then record.profile else nil
end

function ProfileService:_persist(record, release)
	if record.mode == "session" then return true end
	local deadline = os.clock() + 12
	while record.saving and os.clock() < deadline do task.wait(0.1) end
	if record.saving then return false, "Предыдущее сохранение ещё выполняется" end
	if not record.ready or (record.cancelled and not release) then return false, "Профиль закрыт" end
	record.saving = true
	record.player:SetAttribute("PersistenceStatus", "saving")
	local snapshot = Schema.Copy(record.profile)
	local lostLock = false
	local ok, stored = self:_update(record.key, function(old)
		lostLock = false
		if not old or type(old) ~= "table" or old.Version ~= 1
			or type(old.Session) ~= "table" or old.Session.Id ~= record.token then
			lostLock = true; return nil
		end
		local now = os.time()
		return {
			Version = 1, Data = snapshot, UpdatedAt = now,
			Session = if release then nil else { Id = record.token, ExpiresAt = now + self.config.Persistence.LockSeconds },
		}
	end)
	record.saving = false
	if not ok or not stored then
		record.player:SetAttribute("PersistenceStatus", "error")
		if lostLock then
			record.ready = false
			record.player:SetAttribute("DataReady", false)
			record.player:Kick("Профиль открыт в другой сессии. Войдите в игру снова.")
		end
		warn("Не удалось сохранить профиль пользователя " .. record.player.UserId)
		return false, "Сохранение не подтверждено"
	end
	record.player:SetAttribute("PersistenceStatus", "saved")
	return true
end

function ProfileService:Save(player)
	local record = self.records[player]
	if not record or record.cancelled then return false, "Профиль не загружен" end
	return self:_persist(record, false)
end

function ProfileService:Release(player)
	local record = self.records[player]
	if not record then return true end
	record.cancelled = true
	player:SetAttribute("DataReady", false)
	-- Выход и BindToClose могут одновременно ждать одну загрузку/запись.
	local deadline = os.clock() + 25
	while (record.loading or record.releasing) and os.clock() < deadline do task.wait(0.1) end
	if record.loading or record.releasing then return false, "Загрузка или сохранение ещё выполняются" end
	if self.records[player] ~= record then return true end
	if not record.ready then self.records[player] = nil; return true end
	record.releasing = true
	local ok, message = self:_persist(record, true)
	record.releasing = false
	-- При сетевой ошибке сохраняем снимок в памяти для следующей попытки.
	if ok or not record.ready then self.records[player] = nil end
	return ok, message
end

return ProfileService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">ProgressionService</string>
          <string name="Source"><![CDATA[-- Ежедневная награда, задания, перерождения и безопасные действия общего меню.
local ProgressionService = {}
ProgressionService.__index = ProgressionService
local Economy = {}
ProgressionService.Economy = Economy

local function outcome(ok, text, kind)
	return { ok = ok, text = text, kind = kind or (ok and "success" or "error") }
end

function Economy.GetQuestProgress(config, profile, id)
	local definition
	for _, quest in ipairs(config.Quests) do
		if quest.Id == id then definition = quest; break end
	end
	if not definition then return 0, nil end
	if id == "collector" then return profile.CollectedTotal or 0, definition end
	if id == "builder" then
		return (profile.Rebirths or 0) > 0 and definition.Target or profile.Floor, definition
	end
	if id == "fighter" then return profile.EnemiesDefeated or 0, definition end
	return 0, definition
end

function Economy.ClaimQuest(config, profile, id)
	local progress, quest = Economy.GetQuestProgress(config, profile, id)
	if not quest then return outcome(false, "Такого задания нет.") end
	profile.QuestClaims = profile.QuestClaims or {}
	if profile.QuestClaims[id] == true then
		return outcome(false, "Награда за это задание уже получена.", "info")
	end
	if progress < quest.Target then
		return outcome(false, "Задание пока не выполнено: " .. math.min(progress, quest.Target) .. "/" .. quest.Target .. ".", "info")
	end
	if profile.Coins > config.MaxCoins - quest.RewardCoins then
		return outcome(false, "Потратьте монеты, чтобы в кошельке хватило места для награды.")
	end
	profile.Coins += quest.RewardCoins
	profile.XP = math.min(config.MaxXP, profile.XP + quest.RewardXP)
	profile.QuestClaims[id] = true
	return outcome(true, "Задание выполнено: +" .. quest.RewardCoins .. " монет и +" .. quest.RewardXP .. " XP!")
end

function Economy.ClaimDaily(config, profile, now)
	if now < (profile.DailyReadyAt or 0) then
		local minutes = math.max(1, math.ceil((profile.DailyReadyAt - now) / 60))
		return outcome(false, "Следующая ежедневная награда через " .. minutes .. " мин.", "info")
	end
	if profile.Coins > config.MaxCoins - config.DailyReward then
		return outcome(false, "Потратьте монеты, чтобы в кошельке хватило места для награды.")
	end
	profile.Coins += config.DailyReward
	profile.DailyReadyAt = now + config.DailyCooldown
	return outcome(true, "Ежедневная награда: +" .. config.DailyReward .. " монет!")
end

function Economy.Rebirth(config, profile)
	local count = profile.Rebirths or 0
	if count >= config.MaxRebirths then
		return outcome(false, "Достигнуто максимальное число перерождений.", "info")
	end
	if profile.Floor < #config.Floors or profile.DropperTier < #config.DropperCosts then
		return outcome(false, "Для перерождения нужны три этажа и все улучшения генератора.")
	end
	local cost = config.RebirthCost(count)
	if profile.Coins < cost then
		return outcome(false, "Для перерождения нужно " .. cost .. " монет.")
	end
	-- Это один шаг без yield: клиент не выбирает число перерождений или цену.
	profile.Rebirths = count + 1
	profile.Coins = config.StartingCoins
	profile.Floor = 0
	profile.DropperTier = 0
	profile.Bank = 0
	profile.BonusReadyAt = 0
	return outcome(true, "Перерождение " .. profile.Rebirths .. "! Дом сброшен, доход навсегда увеличен.")
end

function ProgressionService.new(config, profiles, tycoon, notice, request, worldFolder, heroCombat)
	return setmetatable({
		config = config, profiles = profiles, tycoon = tycoon, notice = notice,
		request = request, worldFolder = worldFolder, heroCombat = heroCombat,
		players = game:GetService("Players"), connections = {}, lastActions = {}, started = false,
	}, ProgressionService)
end

function ProgressionService:_notify(player, response)
	if player.Parent == self.players then self.notice:FireClient(player, response) end
end

function ProgressionService:_context(player, prompt, needsPlot)
	if self.profiles:IsClosing() or player.Parent ~= self.players or player:GetAttribute("DataReady") ~= true then return nil end
	local state = self.tycoon:GetState(player)
	local profile = self.profiles:Get(player)
	if not state or not profile or state.profile ~= profile then return nil end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then return nil end
	if prompt then
		local pad = prompt.Parent
		if not prompt.Enabled or not pad or not pad:IsA("BasePart") or not pad:IsDescendantOf(workspace) then return nil end
		local distance = (root.Position - pad.Position).Magnitude
		if distance ~= distance or distance > prompt.MaxActivationDistance + 2 then return nil end
	end
	local now = os.clock()
	if now - (self.lastActions[player] or -math.huge) < 0.4 then return nil end
	self.lastActions[player] = now
	if needsPlot and (not state.plot or state.plot:GetAttribute("OwnerUserId") ~= player.UserId) then
		self:_notify(player, { kind = "error", text = "Сначала займите собственный участок." })
		return nil
	end
	return { state = state, profile = profile, root = root }
end

function ProgressionService:_perform(player, context, command, id)
	local response
	if command == "ClaimQuest" then
		response = Economy.ClaimQuest(self.config, context.profile, id)
	elseif command == "ClaimDaily" then
		response = Economy.ClaimDaily(self.config, context.profile, os.time())
	elseif command == "Rebirth" then
		response = Economy.Rebirth(self.config, context.profile)
		if response.ok then
			self.tycoon:RebuildPlayer(player)
			if self.heroCombat then
				if self.heroCombat.Refresh then self.heroCombat:Refresh(player)
				elseif self.heroCombat.RefreshPlayer then self.heroCombat:RefreshPlayer(player) end
			end
		end
	elseif command == "EquipHero" then
		if not self.heroCombat then return end
		local ok, message = self.heroCombat:Equip(player, id)
		response = outcome(ok == true, message or (ok and "Герой выбран!" or "Этот герой пока недоступен."))
	elseif command == "EquipWeapon" then
		if not self.heroCombat or not self.heroCombat.EquipWeapon then return end
		local ok, message = self.heroCombat:EquipWeapon(player, id)
		response = outcome(ok == true, message or (ok and "Оружие выбрано!" or "Такого оружия нет в инвентаре."))
	else
		return
	end
	if response.ok then self.tycoon:SyncPlayer(player) end
	self:_notify(player, response)
end

function ProgressionService:_request(player, command, id)
	-- Данные клиента лишь выбирают известное действие; цены и награды серверные.
	local commands = { EquipHero = true, EquipWeapon = true, ClaimQuest = true, ClaimDaily = true, Rebirth = true }
	if type(command) ~= "string" or not commands[command] then return end
	if (command == "EquipHero" or command == "EquipWeapon" or command == "ClaimQuest") and (type(id) ~= "string" or #id > 40) then return end
	local context = self:_context(player, nil, command == "Rebirth")
	if context then self:_perform(player, context, command, id) end
end

function ProgressionService:_claimAll(player, prompt)
	local context = self:_context(player, prompt, false)
	if not context then return end
	local completed = 0
	local eligible = 0
	for _, quest in ipairs(self.config.Quests) do
		local progress = Economy.GetQuestProgress(self.config, context.profile, quest.Id)
		if progress >= quest.Target and not (context.profile.QuestClaims or {})[quest.Id] then
			eligible += 1
			local response = Economy.ClaimQuest(self.config, context.profile, quest.Id)
			self:_notify(player, response)
			if response.ok then completed += 1 end
		end
	end
	if completed > 0 then self.tycoon:SyncPlayer(player)
	elseif eligible == 0 then self:_notify(player, { kind = "info", text = "Нет готовых наград. Собирайте монеты, стройте дом и побеждайте на арене!" }) end
end

function ProgressionService:_bindPrompt(container, partName, promptName, callback)
	local part = container:FindFirstChild(partName)
	assert(part and part:IsA("BasePart"), "Для прогрессии отсутствует " .. partName)
	local prompt = part:FindFirstChild(promptName)
	assert(prompt and prompt:IsA("ProximityPrompt"), "Для прогрессии отсутствует " .. promptName)
	table.insert(self.connections, prompt.Triggered:Connect(function(player) callback(player, prompt) end))
end

function ProgressionService:Start()
	assert(not self.started, "ProgressionService уже запущен")
	self.started = true
	table.insert(self.connections, self.request.OnServerEvent:Connect(function(player, command, id) self:_request(player, command, id) end))
	table.insert(self.connections, self.players.PlayerRemoving:Connect(function(player) self.lastActions[player] = nil end))
	self:_bindPrompt(self.worldFolder, "DailyStand", "ClaimDailyPrompt", function(player, prompt)
		local context = self:_context(player, prompt, false)
		if context then self:_perform(player, context, "ClaimDaily") end
	end)
	self:_bindPrompt(self.worldFolder, "QuestStand", "QuestPrompt", function(player, prompt) self:_claimAll(player, prompt) end)
	self:_bindPrompt(self.worldFolder, "RebirthStand", "RebirthPrompt", function(player, prompt)
		local context = self:_context(player, prompt, true)
		if context then self:_perform(player, context, "Rebirth") end
	end)
	self:_bindPrompt(self.worldFolder, "ArenaPortal", "EnterArenaPrompt", function(player, prompt)
		local context = self:_context(player, prompt, false)
		if context then
			player:SetAttribute("ArenaCombatOptIn", true)
			context.root.CFrame = CFrame.new(0, 5, -98)
			context.root.AssemblyLinearVelocity = Vector3.zero
			context.root.AssemblyAngularVelocity = Vector3.zero
			self:_notify(player, { kind = "info", text = "Арена: выберите героя и атакуйте тренировочных врагов!" })
		end
	end)
	self:_bindPrompt(self.worldFolder, "ReturnStand", "ReturnPrompt", function(player, prompt)
		local context = self:_context(player, prompt, false)
		if context then
			player:SetAttribute("ArenaCombatOptIn", false)
			context.root.CFrame = CFrame.new(0, 5, 14)
			context.root.AssemblyLinearVelocity = Vector3.zero
			context.root.AssemblyAngularVelocity = Vector3.zero
		end
	end)
	for _, plot in ipairs(self.tycoon.plots) do
		self:_bindPrompt(plot, "HeroPad", "HeroPrompt", function(player, prompt)
			local context = self:_context(player, prompt, true)
			if context and context.state.plot == plot then
				self:_notify(player, { kind = "heroes", text = "Выберите героя и отправляйтесь на арену!" })
			end
		end)
	end
end

function ProgressionService:Destroy()
	for _, connection in ipairs(self.connections) do connection:Disconnect() end
	table.clear(self.connections)
	table.clear(self.lastActions)
	self.started = false
end

return ProgressionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">TycoonService</string>
          <string name="Source"><![CDATA[-- Авторитетная экономика и владение участками. Клиент не задаёт цены и награды.
local TycoonService = {}
TycoonService.__index = TycoonService

-- Чистые функции экономики также используются в автоматических проверках.
local Economy = {}
TycoonService.Economy = Economy

local function result(ok, text, kind)
	return { ok = ok, text = text, kind = kind or (ok and "success" or "error") }
end

function Economy.Income(config, profile)
	return config.IncomeFor(profile.Floor, profile.DropperTier, profile.Rebirths or 0)
end

function Economy.Accrue(config, profile, ticks)
	local added = math.min(config.MaxBank - profile.Bank, Economy.Income(config, profile) * (ticks or 1))
	if added <= 0 then
		return 0
	end
	profile.Bank += added
	return added
end

function Economy.Collect(config, profile)
	local amount = math.min(profile.Bank, config.MaxCoins - profile.Coins)
	if amount <= 0 then
		if profile.Bank > 0 then
			return result(false, "Кошелёк заполнен. Потратьте монеты на улучшения.")
		end
		return result(false, "Копилка пока пуста. Сначала постройте этаж и немного подождите.", "info")
	end
	profile.Bank -= amount
	profile.Coins += amount
	profile.XP = math.min(config.MaxXP, profile.XP + amount)
	profile.CollectedTotal = math.min(config.MaxCoins, (profile.CollectedTotal or 0) + amount)
	return result(true, "+" .. amount .. " монет и +" .. amount .. " XP из копилки!")
end

function Economy.BuyFloor(config, profile)
	local nextFloor = profile.Floor + 1
	local floor = config.Floors[nextFloor]
	if not floor then
		return result(false, "Все три этажа уже построены!", "info")
	end
	if profile.Coins < floor.Cost then
		return result(false, "Для этажа " .. nextFloor .. " нужно " .. floor.Cost .. " монет.")
	end
	profile.Coins -= floor.Cost
	profile.Floor = nextFloor
	profile.XP = math.min(config.MaxXP, profile.XP + floor.XP)
	local suffix = nextFloor == 3 and " Доступны бонусный сундук и ускорение персонажа!" or " Генератор приносит больше монет."
	return result(true, "Этаж " .. nextFloor .. " построен!" .. suffix)
end

function Economy.BuyDropper(config, profile)
	if profile.Floor < 1 then
		return result(false, "Сначала постройте первый этаж.")
	end
	local nextTier = profile.DropperTier + 1
	local cost = config.DropperCosts[nextTier]
	if not cost then
		return result(false, "Генератор уже улучшен до максимума!", "info")
	end
	if profile.Coins < cost then
		return result(false, "Для улучшения генератора нужно " .. cost .. " монет.")
	end
	profile.Coins -= cost
	profile.DropperTier = nextTier
	return result(true, "Генератор улучшен! Доход: " .. Economy.Income(config, profile) .. " монет/сек.")
end

function Economy.ClaimBonus(config, profile, now)
	if profile.Floor < 3 then
		return result(false, "Бонусный сундук откроется на третьем этаже.")
	end
	if now < profile.BonusReadyAt then
		return result(false, "Следующий бонус через " .. math.ceil(profile.BonusReadyAt - now) .. " сек.", "info")
	end
	local amount = math.min(config.BonusCoins, config.MaxCoins - profile.Coins)
	if amount <= 0 then
		return result(false, "Кошелёк заполнен. Сначала потратьте монеты.")
	end
	profile.Coins += amount
	profile.XP = math.min(config.MaxXP, profile.XP + config.BonusXP)
	profile.BonusReadyAt = now + config.BonusCooldown
	return result(true, "Бонус третьего этажа: +" .. amount .. " монет и +" .. config.BonusXP .. " XP!")
end

function TycoonService.new(config, profiles, world, plots, notice)
	return setmetatable({
		config = config,
		profiles = profiles,
		world = world,
		plots = plots,
		notice = notice,
		players = game:GetService("Players"),
		httpService = game:GetService("HttpService"),
		runService = game:GetService("RunService"),
		states = {},
		owners = {},
		connections = {},
		started = false,
		elapsed = 0,
	}, TycoonService)
end

function TycoonService:_notify(player, text, kind)
	if player.Parent == self.players then
		self.notice:FireClient(player, { text = text, kind = kind or "info" })
	end
end

local function findPrompt(plot, partName, promptName)
	local part = plot:FindFirstChild(partName)
	assert(part and part:IsA("BasePart"), "На участке отсутствует " .. partName)
	local prompt = part:FindFirstChild(promptName)
	assert(prompt and prompt:IsA("ProximityPrompt"), "На участке отсутствует " .. promptName)
	return prompt
end

function TycoonService:_refreshPlot(plot)
	local state = self.owners[plot]
	local ready = state ~= nil and state.profile ~= nil and state.player:GetAttribute("DataReady") == true
	local profile = ready and state.profile or nil
	local prompts = self.promptSets[plot]
	prompts.claim.Enabled = state == nil
	prompts.floor.Enabled = ready and profile.Floor < #self.config.Floors
	prompts.dropper.Enabled = ready and profile.Floor > 0 and profile.DropperTier < #self.config.DropperCosts
	prompts.collect.Enabled = ready and profile.Floor > 0
	prompts.bonus.Enabled = ready and profile.Floor >= 3
	local heroPad = plot:FindFirstChild("HeroPad")
	local heroPrompt = heroPad and heroPad:FindFirstChild("HeroPrompt")
	if heroPrompt then
		heroPrompt.Enabled = ready and (profile.Floor >= 1 or (profile.Rebirths or 0) > 0)
	end
	plot:SetAttribute("OwnerReady", ready)
	plot:SetAttribute("Bank", profile and profile.Bank or 0)
	plot:SetAttribute("DropperTier", profile and profile.DropperTier or 0)
	plot:SetAttribute("Income", profile and Economy.Income(self.config, profile) or 0)
	if profile then
		local nextFloor = self.config.Floors[profile.Floor + 1]
		prompts.floor.ActionText = "Построить этаж " .. (profile.Floor + 1)
		prompts.floor.ObjectText = nextFloor and (nextFloor.Cost .. " монет") or "Дом достроен"
		local cost = self.config.DropperCosts[profile.DropperTier + 1]
		prompts.dropper.ActionText = "Улучшить генератор"
		prompts.dropper.ObjectText = cost and (cost .. " монет") or "Максимум"
		prompts.collect.ActionText = "Забрать монеты"
		prompts.collect.ObjectText = "Копилка: " .. profile.Bank
		prompts.bonus.ActionText = "Открыть бонус"
		prompts.bonus.ObjectText = "+" .. self.config.BonusCoins .. " монет"
	end
end

function TycoonService:_sync(state)
	local profile = state.profile
	local player = state.player
	if not profile or player.Parent ~= self.players then
		return
	end
	state.coins.Value = profile.Coins
	state.level.Value = self.config.GetLevel(profile.XP)
	player:SetAttribute("Floor", profile.Floor)
	player:SetAttribute("DropperTier", profile.DropperTier)
	player:SetAttribute("Bank", profile.Bank)
	player:SetAttribute("Income", Economy.Income(self.config, profile))
	player:SetAttribute("XP", profile.XP)
	player:SetAttribute("BonusReadyAt", profile.BonusReadyAt)
	player:SetAttribute("Rebirths", profile.Rebirths or 0)
	player:SetAttribute("EquippedHero", profile.EquippedHero or "")
	player:SetAttribute("EquippedWeapon", profile.EquippedWeapon or "")
	player:SetAttribute("WeaponInventory", self.httpService:JSONEncode(profile.Inventory or {}))
	player:SetAttribute("CollectedTotal", profile.CollectedTotal or 0)
	player:SetAttribute("EnemiesDefeated", profile.EnemiesDefeated or 0)
	player:SetAttribute("DailyReadyAt", profile.DailyReadyAt or 0)
	local claims = profile.QuestClaims or {}
	player:SetAttribute("QuestCollectorDone", claims.collector == true)
	player:SetAttribute("QuestBuilderDone", claims.builder == true)
	player:SetAttribute("QuestFighterDone", claims.fighter == true)
	if state.plot then
		self:_refreshPlot(state.plot)
	end
end

function TycoonService:_rebuild(state)
	self.world.UpdatePlot(state.plot, state.profile.Floor, state.player.DisplayName)
	state.plot:SetAttribute("OwnerUserId", state.player.UserId)
	state.plot:SetAttribute("OwnerName", state.player.DisplayName)
	state.plot:SetAttribute("Floor", state.profile.Floor)
	self:_refreshPlot(state.plot)
end

function TycoonService:_applyPerks(state, character)
	-- WaitForChild имеет таймаут: удалённый персонаж не оставит вечную задачу.
	task.spawn(function()
		local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
		if not humanoid or not humanoid:IsA("Humanoid") then
			return
		end
		if self.states[state.player] ~= state or state.player.Character ~= character then
			return
		end
		if self.perkHandler and state.profile and state.player:GetAttribute("DataReady") == true then
			self.perkHandler(state.player, humanoid, state.profile)
			return
		end
		local unlocked = state.profile and (state.profile.Floor >= 3 or (state.profile.Rebirths or 0) > 0)
			and state.player:GetAttribute("DataReady") == true
		humanoid.WalkSpeed = unlocked and self.config.ThirdFloorWalkSpeed or self.config.DefaultWalkSpeed
	end)
end

-- Узкий серверный API для прогрессии и боя. Балансы остаются в общем профиле.
function TycoonService:GetState(player)
	return self.states[player]
end

function TycoonService:SyncPlayer(player)
	local state = self.states[player]
	if not state or not state.profile or not state.coins or not state.level then
		return false
	end
	self:_sync(state)
	return true
end

function TycoonService:RebuildPlayer(player)
	local state = self.states[player]
	if not state or not state.profile then
		return false
	end
	if state.plot then
		self:_rebuild(state)
	end
	self:_sync(state)
	if player.Character then
		self:_applyPerks(state, player.Character)
	end
	return true
end

function TycoonService:SetPerkHandler(callback)
	assert(type(callback) == "function", "PerkHandler должен быть функцией")
	self.perkHandler = callback
	for _, state in pairs(self.states) do
		if state.profile and state.player.Character then
			self:_applyPerks(state, state.player.Character)
		end
	end
end

local function getValue(parent, name, className)
	local value = parent:FindFirstChild(name)
	if value then
		assert(value:IsA(className), name .. " должен быть " .. className)
		return value
	end
	value = Instance.new(className)
	value.Name = name
	value.Parent = parent
	return value
end

function TycoonService:_addPlayer(player)
	if self.states[player] then
		return
	end
	local state = { player = player, profile = nil, plot = nil, lastActionAt = -math.huge, leaving = false }
	self.states[player] = state
	player:SetAttribute("DataReady", false)
	player:SetAttribute("PlotId", "")
	state.characterConnection = player.CharacterAdded:Connect(function(character)
		self:_applyPerks(state, character)
	end)
	if player.Character then
		self:_applyPerks(state, player.Character)
	end
	local profile, loadError = self.profiles:Load(player)
	if player.Parent ~= self.players or state.leaving or self.states[player] ~= state or self.profiles:IsClosing() then
		self.profiles:Release(player)
		return
	end
	if not profile then
		player:SetAttribute("PersistenceStatus", "error")
		warn("Tycoon: профиль игрока " .. player.UserId .. " недоступен: " .. tostring(loadError))
		self:_notify(player, "Прогресс не удалось загрузить. Переподключитесь; покупки временно отключены.", "error")
		return
	end
	state.profile = profile
	local leaderstats = getValue(player, "leaderstats", "Folder")
	state.coins = getValue(leaderstats, "Coins", "IntValue")
	state.level = getValue(leaderstats, "Level", "IntValue")
	self:_sync(state)
	player:SetAttribute("DataReady", true)
	if player.Character then
		self:_applyPerks(state, player.Character)
	end
	local sessionOnly = player:GetAttribute("PersistenceMode") == "session"
	local text = sessionOnly and "Тестовый режим: прогресс действует до выхода. Займите свободный участок!"
		or "Прогресс загружен. Займите свободный участок!"
	self:_notify(player, text, "info")
end

function TycoonService:_removePlayer(player)
	local state = self.states[player]
	if not state then
		self.profiles:Release(player)
		return
	end
	state.leaving = true
	player:SetAttribute("DataReady", false)
	if state.characterConnection then
		state.characterConnection:Disconnect()
	end
	if state.plot then
		local plot = state.plot
		self.owners[plot] = nil
		state.plot = nil
		plot:SetAttribute("OwnerUserId", 0)
		plot:SetAttribute("OwnerName", "")
		plot:SetAttribute("Floor", 0)
		self.world.UpdatePlot(plot, 0, "")
		self:_refreshPlot(plot)
	end
	self.states[player] = nil
	self.profiles:Release(player)
end

function TycoonService:_validate(player, plot, prompt, needsOwner)
	local state = self.states[player]
	if self.profiles:IsClosing() then
		return nil
	end
	if not state or not state.profile or state.leaving or player.Parent ~= self.players then
		return nil
	end
	if player:GetAttribute("DataReady") ~= true or self.profiles:Get(player) ~= state.profile then
		return nil
	end
	if not plot.Parent or not prompt.Enabled or not prompt:IsDescendantOf(plot) then
		return nil
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or not root:IsA("BasePart") then
		return nil
	end
	local pad = prompt.Parent
	if not pad or not pad:IsA("BasePart") then
		return nil
	end
	-- Triggered может быть вызван эксплойтом: сервер сам измеряет расстояние.
	local distance = (root.Position - pad.Position).Magnitude
	if distance ~= distance or distance > prompt.MaxActivationDistance + 2 then
		return nil
	end
	-- Сундук нужно открывать с третьего этажа, а не с площадки под ним.
	if prompt.Name == "BonusPrompt" and math.abs(root.Position.Y - pad.Position.Y) > 7 then
		return nil
	end
	local now = os.clock()
	if now - state.lastActionAt < self.config.ActionCooldown then
		return nil
	end
	state.lastActionAt = now
	if needsOwner and (state.plot ~= plot or self.owners[plot] ~= state or plot:GetAttribute("OwnerUserId") ~= player.UserId) then
		self:_notify(player, "Это чужой дом. Займите свой свободный участок.", "error")
		return nil
	end
	return state
end

function TycoonService:_claim(player, plot, prompt)
	local state = self:_validate(player, plot, prompt, false)
	if not state then
		return
	end
	if state.plot then
		self:_notify(player, "У вас уже есть участок. Улучшайте свой дом!", "info")
		return
	end
	if self.owners[plot] or plot:GetAttribute("OwnerUserId") ~= 0 then
		return
	end
	-- Захват и обновление не содержат yield: два игрока не займут один участок.
	self.owners[plot] = state
	state.plot = plot
	player:SetAttribute("PlotId", plot:GetAttribute("PlotId") or plot.Name)
	self:_rebuild(state)
	self:_sync(state)
	local text = state.profile.Floor == 0 and ("Участок ваш! Постройте первый этаж за " .. self.config.Floors[1].Cost .. " монет на синей площадке.")
		or "Участок ваш! Сохранённый дом восстановлен."
	self:_notify(player, text, "success")
end

function TycoonService:_action(player, plot, prompt, action)
	local state = self:_validate(player, plot, prompt, true)
	if not state then
		return
	end
	local outcome
	if action == "floor" then
		outcome = Economy.BuyFloor(self.config, state.profile)
	elseif action == "dropper" then
		outcome = Economy.BuyDropper(self.config, state.profile)
	elseif action == "collect" then
		outcome = Economy.Collect(self.config, state.profile)
	elseif action == "bonus" then
		outcome = Economy.ClaimBonus(self.config, state.profile, os.time())
	else
		return
	end
	if outcome.ok then
		if action == "floor" then
			self:_rebuild(state)
			if player.Character then
				self:_applyPerks(state, player.Character)
			end
		end
		self:_sync(state)
	end
	self:_notify(player, outcome.text, outcome.kind)
end

function TycoonService:Start()
	assert(not self.started, "TycoonService уже запущен")
	self.started = true
	self.promptSets = {}
	for _, plot in ipairs(self.plots) do
		local prompts = {
			claim = findPrompt(plot, "ClaimPad", "ClaimPrompt"),
			floor = findPrompt(plot, "UpgradePad", "FloorPrompt"),
			dropper = findPrompt(plot, "DropperUpgradePad", "DropperPrompt"),
			collect = findPrompt(plot, "Collector", "CollectPrompt"),
			bonus = findPrompt(plot, "BonusPad", "BonusPrompt"),
		}
		self.promptSets[plot] = prompts
		table.insert(self.connections, prompts.claim.Triggered:Connect(function(player)
			self:_claim(player, plot, prompts.claim)
		end))
		for _, action in ipairs({ "floor", "dropper", "collect", "bonus" }) do
			local actionName = action
			local actionPrompt = prompts[actionName]
			table.insert(self.connections, actionPrompt.Triggered:Connect(function(player)
				self:_action(player, plot, actionPrompt, actionName)
			end))
		end
		self:_refreshPlot(plot)
	end
	table.insert(self.connections, self.players.PlayerAdded:Connect(function(player)
		self:_addPlayer(player)
	end))
	table.insert(self.connections, self.players.PlayerRemoving:Connect(function(player)
		self:_removePlayer(player)
	end))
	table.insert(self.connections, self.runService.Heartbeat:Connect(function(delta)
		if self.profiles:IsClosing() then
			return
		end
		self.elapsed += delta
		local ticks = math.floor(self.elapsed / self.config.IncomeInterval)
		if ticks < 1 then
			return
		end
		self.elapsed -= ticks * self.config.IncomeInterval
		for _, state in pairs(self.states) do
			if state.profile and state.plot then
				if state.player:GetAttribute("DataReady") == true then
					Economy.Accrue(self.config, state.profile, ticks)
					self:_sync(state)
				else
					self:_refreshPlot(state.plot)
				end
			end
		end
	end))
	for _, player in ipairs(self.players:GetPlayers()) do
		task.spawn(function()
			self:_addPlayer(player)
		end)
	end
end

function TycoonService:Destroy()
	for _, connection in ipairs(self.connections) do
		connection:Disconnect()
	end
	table.clear(self.connections)
	for _, state in pairs(self.states) do
		if state.characterConnection then
			state.characterConnection:Disconnect()
		end
	end
	self.started = false
end

return TycoonService
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="28">
      <Properties>
        <string name="Name">Stage1Map</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- A spacious campus shared by the twelve house plots, gallery and arena.
-- All geometry is anchored and uses simple Parts; no asset downloads needed.
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")

local map = Workspace:FindFirstChild("SimulatorMap")
if map then
	assert(map:IsA("Folder"), "SimulatorMap должен быть Folder")
else
	map = Instance.new("Folder")
	map.Name = "SimulatorMap"
	map.Parent = Workspace
end

local function makePart(name, size, position, color, material, canCollide)
	local object = map:FindFirstChild(name)
	if object then
		assert(object.ClassName == "Part", name .. " должен быть Part")
	else
		object = Instance.new("Part")
		object.Name = name
		object.Parent = map
	end
	object.Anchored = true
	object.CanCollide = canCollide ~= false
	object.Size = size
	object.CFrame = CFrame.new(position)
	object.Color = color
	object.Material = material
	object.Shape = Enum.PartType.Block
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	return object
end

local grass = Color3.fromRGB(88, 144, 112)
local paving = Color3.fromRGB(219, 230, 237)
local cyan = Color3.fromRGB(85, 218, 224)
local navy = Color3.fromRGB(46, 65, 89)
local wood = Color3.fromRGB(123, 88, 62)

makePart("Ground", Vector3.new(480, 2, 480), Vector3.new(0, -1, 0), grass, Enum.Material.Grass)
makePart("Plaza", Vector3.new(72, 0.3, 72), Vector3.new(0, 0.15, 0), paving, Enum.Material.Concrete)

-- Roads stop at the plaza and continue through the public campus activities.
makePart("NorthPath", Vector3.new(12, 0.2, 178), Vector3.new(0, 0.1, -125), paving, Enum.Material.Concrete)
makePart("SouthPath", Vector3.new(12, 0.2, 178), Vector3.new(0, 0.1, 125), paving, Enum.Material.Concrete)
makePart("WestPath", Vector3.new(178, 0.2, 12), Vector3.new(-125, 0.1, 0), paving, Enum.Material.Concrete)
makePart("EastPath", Vector3.new(178, 0.2, 12), Vector3.new(125, 0.1, 0), paving, Enum.Material.Concrete)

for _, side in ipairs({ -1, 1 }) do
	local suffix = if side < 0 then "West" else "East"
	makePart("PlazaTrim" .. suffix, Vector3.new(0.45, 0.05, 72), Vector3.new(side * 35.5, 0.325, 0), cyan, Enum.Material.Neon, false)
	makePart("PlazaTrim" .. (if side < 0 then "North" else "South"), Vector3.new(72, 0.05, 0.45), Vector3.new(0, 0.325, side * 35.5), cyan, Enum.Material.Neon, false)
end

local rows = { -170, -102, -34, 34, 102, 170 }
for rowIndex, rowZ in ipairs(rows) do
	for _, side in ipairs({ -1, 1 }) do
		local suffix = (if side < 0 then "West" else "East") .. rowIndex
		makePart("HouseRoad" .. suffix, Vector3.new(148, 0.2, 6), Vector3.new(side * 74, 0.1, rowZ - 25), paving, Enum.Material.Concrete)
		makePart("HouseEntry" .. suffix, Vector3.new(8, 0.2, 6), Vector3.new(side * 148, 0.1, rowZ - 22), paving, Enum.Material.Concrete)
		makePart("RoadLamp" .. suffix, Vector3.new(0.65, 8, 0.65), Vector3.new(side * 110, 4, rowZ - 31), navy, Enum.Material.Metal)
		local glow = makePart("RoadLampGlow" .. suffix, Vector3.new(1.6, 1.6, 1.6), Vector3.new(side * 110, 8.2, rowZ - 31), cyan, Enum.Material.Neon, false)
		glow.Shape = Enum.PartType.Ball
	end
end

-- Low walls mark the edge without obstructing any plot or public walkway.
local border = Color3.fromRGB(109, 132, 139)
makePart("NorthBorder", Vector3.new(480, 5, 2), Vector3.new(0, 2.5, -239), border, Enum.Material.Slate)
makePart("SouthBorder", Vector3.new(480, 5, 2), Vector3.new(0, 2.5, 239), border, Enum.Material.Slate)
makePart("WestBorder", Vector3.new(2, 5, 476), Vector3.new(-239, 2.5, 0), border, Enum.Material.Slate)
makePart("EastBorder", Vector3.new(2, 5, 476), Vector3.new(239, 2.5, 0), border, Enum.Material.Slate)

local treePositions = {}
for _, side in ipairs({ -1, 1 }) do
	for _, z in ipairs({ -210, -140, -70, 0, 70, 140, 210 }) do
		table.insert(treePositions, Vector3.new(side * 215, 0, z))
	end
	for _, x in ipairs({ -150, -80, 80, 150 }) do
		table.insert(treePositions, Vector3.new(x, 0, side * 218))
	end
end
for index, position in ipairs(treePositions) do
	makePart("TreeTrunk" .. index, Vector3.new(2.5, 10, 2.5), position + Vector3.new(0, 5, 0), wood, Enum.Material.Wood)
	local leaves = makePart("TreeLeaves" .. index, Vector3.new(15, 15, 15), position + Vector3.new(0, 13, 0), Color3.fromRGB(56, 119 + index % 5 * 8, 91), Enum.Material.SmoothPlastic, false)
	leaves.Shape = Enum.PartType.Ball
end

for index, position in ipairs({
	Vector3.new(-214, 2, -105), Vector3.new(214, 2, -105),
	Vector3.new(-214, 2, 105), Vector3.new(214, 2, 105),
	Vector3.new(-110, 2, -220), Vector3.new(110, 2, -220),
	Vector3.new(-110, 2, 220), Vector3.new(110, 2, 220),
}) do
	local rock = makePart("Rock" .. index, Vector3.new(9, 4, 7), position, Color3.fromRGB(127, 145, 158), Enum.Material.Slate)
	rock.Shape = Enum.PartType.Ball
end

for index, position in ipairs({
	Vector3.new(-32, 0, -32), Vector3.new(32, 0, -32),
	Vector3.new(-32, 0, 32), Vector3.new(32, 0, 32),
}) do
	makePart("PlazaLamp" .. index, Vector3.new(0.8, 10, 0.8), position + Vector3.new(0, 5.3, 0), navy, Enum.Material.Metal)
	makePart("PlazaLampCap" .. index, Vector3.new(2.5, 0.5, 2.5), position + Vector3.new(0, 10.5, 0), cyan, Enum.Material.Neon, false)
end

-- Reuse an existing singleton spawn. Duplicate spawns require a deliberate
-- Studio decision, rather than silently moving or deleting someone else's.
local spawns = {}
for _, object in ipairs(Workspace:GetDescendants()) do
	if object:IsA("SpawnLocation") then
		table.insert(spawns, object)
	end
end
assert(#spawns <= 1, "Найдено несколько SpawnLocation. Оставьте одну стартовую точку.")
local spawn = spawns[1] or Instance.new("SpawnLocation")
spawn.Name = "StartSpawn"
spawn.Size = Vector3.new(7, 0.8, 7)
spawn.CFrame = CFrame.new(0, 0.7, 6)
spawn.Anchored = true
spawn.CanCollide = true
spawn.Neutral = true
spawn.Enabled = true
spawn.AllowTeamChangeOnTouch = false
spawn.Duration = 0
spawn.Color = Color3.fromRGB(104, 223, 194)
spawn.Material = Enum.Material.Neon
spawn.TopSurface = Enum.SurfaceType.Smooth
spawn.BottomSurface = Enum.SurfaceType.Smooth
spawn.Parent = map

Lighting.ClockTime = 14
Lighting.Brightness = 2
Lighting.GlobalShadows = true
Lighting.Ambient = Color3.fromRGB(110, 120, 139)
Lighting.OutdoorAmbient = Color3.fromRGB(151, 164, 177)

-- Soft daylight and restrained neon bloom keep the city bright and readable.
local function lightingEffect(name, className)
	local effect = Lighting:FindFirstChild(name)
	if effect then
		assert(effect:IsA(className), name .. " имеет неверный тип")
	else
		effect = Instance.new(className)
		effect.Name = name
		effect.Parent = Lighting
	end
	return effect
end
local atmosphere = lightingEffect("HeroCityAtmosphere", "Atmosphere")
atmosphere.Density = 0.2
atmosphere.Offset = 0.05
atmosphere.Color = Color3.fromRGB(188, 214, 238)
atmosphere.Decay = Color3.fromRGB(107, 123, 151)
atmosphere.Glare = 0.1
atmosphere.Haze = 0.6
local bloom = lightingEffect("HeroCityBloom", "BloomEffect")
bloom.Intensity = 0.25
bloom.Size = 24
bloom.Threshold = 2
local color = lightingEffect("HeroCityColor", "ColorCorrectionEffect")
color.Brightness = 0.01
color.Contrast = 0.03
color.Saturation = 0.1
color.TintColor = Color3.fromRGB(255, 250, 242)

map:SetAttribute("MapReady", true)
print("Кампус готов: большая карта, площадь, дороги к 12 домам и StartSpawn.")
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="29">
      <Properties>
        <string name="Name">TycoonServer</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Small bootstrap: server-owned construction, persistence, progression and heroes.
local ReplicatedStorage=game:GetService('ReplicatedStorage')
local Workspace=game:GetService('Workspace')
local config=require(ReplicatedStorage:WaitForChild('Shared'):WaitForChild('TycoonConfig'))
local modules=script.Parent:WaitForChild('Modules')
local function module(name) return require(modules:WaitForChild(name)) end
local ProfileService=module('ProfileService')
local HouseWorld=module('HouseWorld')
local HeroWorld=module('HeroWorld')
local TycoonService=module('TycoonService')
local ProgressionService=module('ProgressionService')
local HeroCombatService=module('HeroCombatService')
local LootDropService=module('LootDropService')
local MonetizationService=module('MonetizationService')
local AdminService=module('AdminService')
local remotes=ReplicatedStorage:WaitForChild('TycoonRemotes')
local map=Workspace:WaitForChild('SimulatorMap')
while map.Parent and map:GetAttribute('MapReady')~=true do map:GetAttributeChangedSignal('MapReady'):Wait() end
local plots=HouseWorld.BuildPlots(Workspace,config)
local campus=HeroWorld.Build(Workspace,config)
local profiles=ProfileService.new(config)
local tycoon=TycoonService.new(config,profiles,HouseWorld,plots,remotes.Notice)
local heroes=HeroCombatService.new(config,profiles,tycoon,remotes.Notice,remotes.SkillRequest,remotes.Effect)
heroes:Start()
tycoon:Start()
LootDropService.new(config,profiles,tycoon,remotes.Notice,remotes.LootResult):Start()
ProgressionService.new(config,profiles,tycoon,remotes.Notice,remotes.ActionRequest,campus,heroes):Start()
MonetizationService.new(config,profiles,remotes.Notice,remotes.MonetizationRequest):Start()
AdminService.new(config,profiles,tycoon,remotes.Notice,remotes.AdminRequest):Start()
print('Hero City Tycoon готов: 12 участков, оригинальные герои, арена, задания и развитие.')
]]></string>
      </Properties>
    </Item>
  </Item>
