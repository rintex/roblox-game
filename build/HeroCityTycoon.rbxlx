      <string name="Name">StarterGui</string>
    </Properties>
    <Item class="ScreenGui" referent="31">
      <Properties>
        <string name="Name">TycoonHUD</string>
        <token name="ScreenInsets">2</token>
        <bool name="ResetOnSpawn">false</bool>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="32">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="33">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="34">
        <Properties>
          <string name="Name">AdminPanel</string>
          <string name="Source"><![CDATA[-- The panel only requests actions. Admin rights and rewards are checked on the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local request = ReplicatedStorage:WaitForChild("TycoonRemotes"):WaitForChild("AdminRequest")
local old = playerGui:FindFirstChild("TycoonAdminHUD")
if old then
	local stop = old:FindFirstChild("Stop")
	if stop and stop:IsA("BindableEvent") then stop:Fire() end
	old:Destroy()
end

local gui = Instance.new("ScreenGui")
gui.Name = "TycoonAdminHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.DisplayOrder = 15
gui.Enabled = player:GetAttribute("IsGameAdmin") == true
gui.Parent = playerGui
local stop = Instance.new("BindableEvent")
stop.Name = "Stop"
stop.Parent = gui

local alive = true
local connections = {}
local function connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(connections, connection)
	return connection
end

local panelColor = Color3.fromRGB(25, 32, 45)
local cardColor = Color3.fromRGB(40, 51, 70)
local textColor = Color3.fromRGB(238, 245, 255)
local accent = Color3.fromRGB(255, 212, 115)
local muted = Color3.fromRGB(172, 190, 211)
local function make(className, properties, parent)
	local object = Instance.new(className)
	for name, value in pairs(properties) do object[name] = value end
	object.Parent = parent
	return object
end
local function corner(object, radius)
	make("UICorner", { CornerRadius = UDim.new(0, radius) }, object)
end
local function text(parent, name, value, size, position, fontSize, color)
	return make("TextLabel", {
		Name = name, BackgroundTransparency = 1, Text = value, Size = size, Position = position,
		TextColor3 = color or textColor, TextSize = fontSize, Font = Enum.Font.GothamMedium,
		TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
	}, parent)
end

local toggle = make("TextButton", {
	Name = "AdminButton", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -92),
	Size = UDim2.fromOffset(110, 42), BackgroundColor3 = panelColor, BorderSizePixel = 0,
	Text = "Админ", TextColor3 = accent, TextSize = 15, Font = Enum.Font.GothamBold,
}, gui)
corner(toggle, 12)
local backdrop = make("TextButton", {
	Name = "Backdrop", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(6, 11, 22),
	BackgroundTransparency = 0.25, Text = "", AutoButtonColor = false, Visible = false, ZIndex = 2,
}, gui)
local panel = make("Frame", {
	Name = "OwnerPanel", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(440, 520), BackgroundColor3 = panelColor, BorderSizePixel = 0,
	Visible = false, ZIndex = 3,
}, gui)
corner(panel, 18)
text(panel, "Title", "Панель владельца", UDim2.new(1, -84, 0, 34), UDim2.fromOffset(18, 10), 21, accent)
text(panel, "Subtitle", "Действия применяются только к твоему персонажу.", UDim2.new(1, -36, 0, 38), UDim2.fromOffset(18, 46), 12, muted)
local close = make("TextButton", {
	Name = "Close", Position = UDim2.new(1, -56, 0, 8), Size = UDim2.fromOffset(44, 44),
	BackgroundColor3 = cardColor, BorderSizePixel = 0, Text = "×", TextSize = 26,
	Font = Enum.Font.GothamBold, TextColor3 = textColor,
}, panel)
corner(close, 10)

local list = make("ScrollingFrame", {
	Name = "Actions", Position = UDim2.fromOffset(18, 98), Size = UDim2.new(1, -36, 1, -138),
	BackgroundTransparency = 1, BorderSizePixel = 0, CanvasSize = UDim2.new(),
	AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4,
	ScrollBarImageColor3 = accent, ScrollingDirection = Enum.ScrollingDirection.Y,
}, panel)
make("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, list)
local status = text(panel, "Status", "Действия доступны только владельцу игры.", UDim2.new(1, -36, 0, 28), UDim2.new(0, 18, 1, -34), 11, muted)

local lastSent = 0
local actions = {
	{ "GrantCoins", "+25 000 монет себе" },
	{ "Heal", "Восстановить здоровье" },
	{ "TeleportHome", "Вернуться на свой участок" },
}
if RunService:IsStudio() then
	table.insert(actions, { "PreviewVIP", "Studio: пример VIP-титула" })
	table.insert(actions, { "PreviewNeon", "Studio: пример неонового оружия" })
end
for index, action in ipairs(actions) do
	local button = make("TextButton", {
		Name = action[1], Size = UDim2.new(1, -8, 0, 46), LayoutOrder = index,
		BackgroundColor3 = cardColor, BorderSizePixel = 0, Text = action[2],
		TextColor3 = textColor, TextSize = 14, Font = Enum.Font.GothamBold,
	}, list)
	corner(button, 10)
	connect(button.Activated, function()
		if not alive or player:GetAttribute("IsGameAdmin") ~= true then return end
		if player:GetAttribute("DataReady") ~= true then
			status.Text = "Дождись загрузки прогресса."
			return
		end
		if os.clock() - lastSent < 0.5 then return end
		lastSent = os.clock()
		request:FireServer(action[1])
		status.Text = "Запрос отправлен. Результат появится в уведомлении."
	end)
end

local setup = make("Frame", {
	Name = "GamePassSetup", LayoutOrder = 10, Size = UDim2.new(1, -8, 0, 170),
	BackgroundColor3 = cardColor, BorderSizePixel = 0,
}, list)
corner(setup, 12)
text(setup, "Heading", "Как подключить пропуска", UDim2.new(1, -24, 0, 28), UDim2.fromOffset(12, 8), 15, accent)
text(setup, "Instructions", "Пропуска создаются в Creator Hub после публикации игры.\ncreate.roblox.com\n\nСоздай свои пропуска VIP и Neon, затем укажи их ID в ReplicatedStorage → Shared → TycoonConfig → GamePasses. Без настоящих ID покупки скрыты.", UDim2.new(1, -24, 1, -44), UDim2.fromOffset(12, 38), 12, textColor)

local function setOpen(open)
	local allowed = player:GetAttribute("IsGameAdmin") == true
	panel.Visible = open and allowed
	backdrop.Visible = open and allowed
end
connect(toggle.Activated, function() setOpen(not panel.Visible) end)
connect(close.Activated, function() setOpen(false) end)
connect(backdrop.Activated, function() setOpen(false) end)
connect(player:GetAttributeChangedSignal("IsGameAdmin"), function()
	gui.Enabled = player:GetAttribute("IsGameAdmin") == true
	if not gui.Enabled then setOpen(false) end
end)

local cameraConnection
local function resize()
	local camera = Workspace.CurrentCamera
	if camera then
		local size = camera.ViewportSize
		panel.Size = UDim2.fromOffset(math.min(440, math.max(250, size.X - 28)), math.min(520, math.max(220, size.Y - 90)))
	end
end
local function bindCamera()
	if cameraConnection then cameraConnection:Disconnect() end
	local camera = Workspace.CurrentCamera
	if camera then cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(resize) end
	resize()
end
connect(Workspace:GetPropertyChangedSignal("CurrentCamera"), bindCamera)
bindCamera()
local function cleanup()
	if not alive then return end
	alive = false
	for _, connection in ipairs(connections) do connection:Disconnect() end
	if cameraConnection then cameraConnection:Disconnect() end
	gui:Destroy()
end
connect(stop.Event, cleanup)
connect(script.Destroying, cleanup)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="35">
        <Properties>
          <string name="Name">DropperEffects</string>
          <string name="Source"><![CDATA[-- Local visual droplets only. Server income does not depend on these parts.
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local EFFECT_LIMIT = 36
local MAX_DISTANCE = 110
local DROPLET_INTERVAL = 0.8

local oldFolder = Workspace:FindFirstChild("ClientTycoonEffects")
if oldFolder then
	local oldStop = oldFolder:FindFirstChild("Stop")
	if oldStop and oldStop:IsA("BindableEvent") then
		oldStop:Fire()
	end
	oldFolder:Destroy()
end

local effects = Instance.new("Folder")
effects.Name = "ClientTycoonEffects"
effects.Parent = Workspace
local stopEvent = Instance.new("BindableEvent")
stopEvent.Name = "Stop"
stopEvent.Parent = effects

local alive = true
local pairsByStart = {}
local active = {}
local activeCount = 0
local connections = {}
local plots = nil

local function connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(connections, connection)
end

local function inspect(object)
	if object.Name ~= "DropletStart" or not object:IsA("BasePart") then
		return
	end
	local parent = object.Parent
	local ending = parent and parent:FindFirstChild("DropletEnd")
	if ending and ending:IsA("BasePart") then
		pairsByStart[object] = ending
	end
end

local function inspectAdded(object)
	inspect(object)
	if object.Name == "DropletEnd" and object:IsA("BasePart") and object.Parent then
		local start = object.Parent:FindFirstChild("DropletStart")
		if start then
			inspect(start)
		end
	end
end

local function bindPlots(folder)
	plots = folder
	table.clear(pairsByStart)
	for _, object in ipairs(folder:GetDescendants()) do
		inspect(object)
	end
	connect(folder.DescendantAdded, inspectAdded)
	connect(folder.DescendantRemoving, function(object)
		pairsByStart[object] = nil
		if object.Name == "DropletEnd" then
			for start, ending in pairs(pairsByStart) do
				if ending == object then
					pairsByStart[start] = nil
				end
			end
		end
	end)
end

local function removeDroplet(part)
	local entry = active[part]
	if not entry then
		return
	end
	active[part] = nil
	activeCount -= 1
	if entry.connection then
		entry.connection:Disconnect()
	end
	entry.tween:Cancel()
	part:Destroy()
end

local function emit(start, ending)
	if activeCount >= EFFECT_LIMIT then
		return
	end
	local part = Instance.new("Part")
	part.Name = "VisualDroplet"
	part.Size = Vector3.new(0.7, 0.7, 0.7)
	part.Shape = Enum.PartType.Ball
	part.Material = Enum.Material.Neon
	part.Color = start.Color
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.CFrame = start.CFrame
	part.Parent = effects
	local tween = TweenService:Create(part, TweenInfo.new(0.65, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		CFrame = ending.CFrame,
		Size = Vector3.new(0.25, 0.25, 0.25),
		Transparency = 0.45,
	})
	local entry = { tween = tween }
	active[part] = entry
	activeCount += 1
	entry.connection = tween.Completed:Connect(function()
		removeDroplet(part)
	end)
	tween:Play()
	-- Also clean up if the completion event is interrupted.
	task.delay(2, function()
		removeDroplet(part)
	end)
end

local function cleanup()
	if not alive then
		return
	end
	alive = false
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	for part in pairs(active) do
		removeDroplet(part)
	end
	table.clear(pairsByStart)
	effects:Destroy()
end
connect(stopEvent.Event, cleanup)
connect(script.Destroying, cleanup)

task.spawn(function()
	while alive do
		local currentPlots = Workspace:FindFirstChild("TycoonPlots")
		if currentPlots ~= plots then
			-- The world normally creates this folder once. Old signals are
			-- disconnected as well if it is rebuilt during a Studio test.
			for index = #connections, 3, -1 do
				connections[index]:Disconnect()
				table.remove(connections, index)
			end
			plots = nil
			table.clear(pairsByStart)
			if currentPlots then
				bindPlots(currentPlots)
			end
		end
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			for start, ending in pairs(pairsByStart) do
				if not start:IsDescendantOf(Workspace) or not ending:IsDescendantOf(Workspace) then
					pairsByStart[start] = nil
				elseif (start.Position - root.Position).Magnitude <= MAX_DISTANCE then
					emit(start, ending)
				end
			end
		end
		task.wait(DROPLET_INTERVAL)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="36">
        <Properties>
          <string name="Name">HeroControls</string>
          <string name="Source"><![CDATA[-- Только управление: сервер проверяет оружие, расстояние и перезарядку навыка.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")

local player = Players.LocalPlayer
local ACTION_NAME = "TycoonHeroSkill"
local AIM_DISTANCE = 250
local LOCAL_COOLDOWN = 0.15
local RUNTIME_NAME = "HeroControlsRuntime"

-- При повторном запуске сначала отключаем старые кнопки и обработчики.
local oldRuntime = script.Parent:FindFirstChild(RUNTIME_NAME)
if oldRuntime then
	local oldStop = oldRuntime:FindFirstChild("Stop")
	if oldStop and oldStop:IsA("BindableEvent") then
		oldStop:Fire()
	end
	oldRuntime:Destroy()
end

local runtime = Instance.new("Folder")
runtime.Name = RUNTIME_NAME
runtime.Parent = script.Parent
local stopEvent = Instance.new("BindableEvent")
stopEvent.Name = "Stop"
stopEvent.Parent = runtime

local alive = true
local skillRemote = nil
local character = nil
local equippedTool = nil
local actionBound = false
local lastRequest = -math.huge
local connections = {}
local characterConnections = {}
local tools = {}
local cameraConnection = nil

local function disconnectAll(list)
	for _, connection in ipairs(list) do
		connection:Disconnect()
	end
	table.clear(list)
end

local function isFiniteVector(value)
	if typeof(value) ~= "Vector3" then
		return false
	end
	for _, number in ipairs({ value.X, value.Y, value.Z }) do
		if number ~= number or math.abs(number) > 1000000 then
			return false
		end
	end
	return true
end

local function isHeroTool(tool)
	if not tool or not tool:IsA("Tool") then return false end
	local marker = tool:GetAttribute("HeroWeapon")
	-- Сервер помечает оружие строкой heroId или loot:weaponId.
	-- Это фильтр управления; владение и точный Tool проверяет сервер.
	return type(marker) == "string" and #marker > 0 and #marker <= 64
end

local function aimPosition(forceCenter)
	local camera = Workspace.CurrentCamera
	if not camera then
		return nil
	end
	local inputType = UserInputService:GetLastInputType()
	local useCenter = forceCenter
		or inputType == Enum.UserInputType.Touch
		or string.find(inputType.Name, "^Gamepad") ~= nil
		or not UserInputService.MouseEnabled
	local ray
	if useCenter then
		local center = camera.ViewportSize / 2
		ray = camera:ViewportPointToRay(center.X, center.Y)
	else
		-- ScreenPointToRay учитывает верхнюю панель Roblox.
		local mousePosition = UserInputService:GetMouseLocation()
		ray = camera:ScreenPointToRay(mousePosition.X, mousePosition.Y)
	end
	if not isFiniteVector(ray.Origin) or not isFiniteVector(ray.Direction) then
		return nil
	end
	local excluded = {}
	if character then
		table.insert(excluded, character)
	end
	for _, name in ipairs({ "ClientHeroEffects", "ClientTycoonEffects" }) do
		local folder = Workspace:FindFirstChild(name)
		if folder then
			table.insert(excluded, folder)
		end
	end
	local parameters = RaycastParams.new()
	parameters.FilterType = Enum.RaycastFilterType.Exclude
	parameters.FilterDescendantsInstances = excluded
	parameters.IgnoreWater = true
	parameters.RespectCanCollide = false -- Учитываем CanQuery, а не CanCollide.
	local direction = ray.Direction * AIM_DISTANCE
	local result = Workspace:Raycast(ray.Origin, direction, parameters)
	local position = result and result.Position or ray.Origin + direction
	return isFiniteVector(position) and position or nil
end

local function requestSkill(forceCenter)
	if not alive or not skillRemote or not skillRemote.Parent then
		return
	end
	if not isHeroTool(equippedTool) or equippedTool.Parent ~= character then
		return
	end
	-- Это удобство для управления. Настоящая защита работает на сервере.
	local now = os.clock()
	if now - lastRequest < LOCAL_COOLDOWN then
		return
	end
	local position = aimPosition(forceCenter)
	if not position then
		return
	end
	lastRequest = now
	skillRemote:FireServer(position) -- Только Vector3, без цели или размера награды.
end

local function positionAction()
	if not actionBound then return end
	local camera = Workspace.CurrentCamera
	local landscape = camera and camera.ViewportSize.X > camera.ViewportSize.Y
	-- Portrait: right of the admin button and above jump. Landscape:
	-- keep below the inventory button and left of jump.
	ContextActionService:SetPosition(ACTION_NAME, if landscape then UDim2.new(1, -140, 1, -110) else UDim2.new(1, -130, 1, -200))
end

local function refreshAction()
	equippedTool = nil
	for tool in pairs(tools) do
		if tool.Parent == character and isHeroTool(tool) then
			equippedTool = tool
			break
		end
	end
	local shouldBind = alive and equippedTool ~= nil and skillRemote ~= nil
	if shouldBind == actionBound then
		return
	end
	actionBound = shouldBind
	if not actionBound then
		ContextActionService:UnbindAction(ACTION_NAME)
		return
	end
	ContextActionService:BindAction(ACTION_NAME, function(_, inputState, inputObject)
		if inputState == Enum.UserInputState.Begin then
			local center = inputObject and (
				inputObject.UserInputType == Enum.UserInputType.Touch
				or string.find(inputObject.UserInputType.Name, "^Gamepad") ~= nil
			)
			requestSkill(center)
		end
		return Enum.ContextActionResult.Sink
	end, true, Enum.KeyCode.Q, Enum.KeyCode.ButtonX)
	ContextActionService:SetTitle(ACTION_NAME, "Навык")
	positionAction()
end

local function removeTool(tool)
	local toolConnections = tools[tool]
	if not toolConnections then
		return
	end
	disconnectAll(toolConnections)
	tools[tool] = nil
	refreshAction()
end

local function addTool(tool)
	if not alive or not tool:IsA("Tool") or tools[tool] then
		return
	end
	-- Один набор обработчиков на Tool; добавление других детей его не дублирует.
	local toolConnections = {}
	tools[tool] = toolConnections
	table.insert(toolConnections, tool.Activated:Connect(function()
		if tool == equippedTool then
			requestSkill(false)
		end
	end))
	table.insert(toolConnections, tool:GetAttributeChangedSignal("HeroWeapon"):Connect(refreshAction))
	refreshAction()
end

local function clearCharacter()
	disconnectAll(characterConnections)
	for _, toolConnections in pairs(tools) do
		disconnectAll(toolConnections)
	end
	table.clear(tools)
	character = nil
	refreshAction()
end

local function bindCharacter(newCharacter)
	if not alive or character == newCharacter then
		return
	end
	clearCharacter()
	character = newCharacter
	table.insert(characterConnections, newCharacter.ChildAdded:Connect(addTool))
	table.insert(characterConnections, newCharacter.ChildRemoved:Connect(removeTool))
	for _, child in ipairs(newCharacter:GetChildren()) do
		addTool(child)
	end
end

local function cleanup()
	if not alive then
		return
	end
	alive = false
	disconnectAll(connections)
	clearCharacter()
	skillRemote = nil
	if cameraConnection then cameraConnection:Disconnect() end
	runtime:Destroy()
end

table.insert(connections, stopEvent.Event:Connect(cleanup))
table.insert(connections, script.Destroying:Connect(cleanup))
table.insert(connections, runtime.Destroying:Connect(cleanup))
local function bindCamera()
	if cameraConnection then cameraConnection:Disconnect() end
	local camera = Workspace.CurrentCamera
	if camera then cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(positionAction) end
	positionAction()
end
table.insert(connections, Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera))
bindCamera()
table.insert(connections, player.CharacterAdded:Connect(bindCharacter))
table.insert(connections, player.CharacterRemoving:Connect(function(oldCharacter)
	if character == oldCharacter then
		clearCharacter()
	end
end))
if player.Character then
	bindCharacter(player.Character)
end

task.spawn(function()
	local remotes = ReplicatedStorage:WaitForChild("TycoonRemotes", 30)
	if not alive or not remotes then
		return
	end
	local remote = remotes:WaitForChild("SkillRequest", 30)
	if not alive or not remote or not remote:IsA("RemoteEvent") then
		return
	end
	skillRemote = remote
	refreshAction()
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="37">
        <Properties>
          <string name="Name">HeroEffects</string>
          <string name="Source"><![CDATA[-- Косметические эффекты. Здесь нет урона, наград или запросов боевых действий.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local EFFECT_LIMIT = 36
local VIEW_DISTANCE = 400
local MAX_SEGMENT_LENGTH = 500
local DEFAULT_COLOR = Color3.fromRGB(104, 224, 255)

local oldFolder = Workspace:FindFirstChild("ClientHeroEffects")
if oldFolder then
	local oldStop = oldFolder:FindFirstChild("Stop")
	if oldStop and oldStop:IsA("BindableEvent") then
		oldStop:Fire()
	end
	oldFolder:Destroy()
end

local effects = Instance.new("Folder")
effects.Name = "ClientHeroEffects"
effects.Parent = Workspace
local stopEvent = Instance.new("BindableEvent")
stopEvent.Name = "Stop"
stopEvent.Parent = effects

local alive = true
local activeCount = 0
local active = {}
local connections = {}

local function finite(number)
	return type(number) == "number" and number == number
		and number > -math.huge and number < math.huge
end

local function validVector(value)
	return typeof(value) == "Vector3"
		and finite(value.X) and finite(value.Y) and finite(value.Z)
		and math.abs(value.X) <= 1000000
		and math.abs(value.Y) <= 1000000
		and math.abs(value.Z) <= 1000000
end

local function effectColor(value)
	local r, g, b
	if typeof(value) == "Color3" then
		r, g, b = value.R, value.G, value.B
	elseif type(value) == "table" then
		r = value.r or value.R or value[1]
		g = value.g or value.G or value[2]
		b = value.b or value.B or value[3]
	end
	if not finite(r) or not finite(g) or not finite(b) then
		return DEFAULT_COLOR
	end
	-- Поддерживаем как {0..1, 0..1, 0..1}, так и обычные RGB 0..255.
	if type(value) == "table" and math.max(r, g, b) > 1 then
		r, g, b = r / 255, g / 255, b / 255
	end
	return Color3.new(math.clamp(r, 0, 1), math.clamp(g, 0, 1), math.clamp(b, 0, 1))
end

local function removeEffect(part)
	local entry = active[part]
	if not entry then
		return
	end
	active[part] = nil
	activeCount -= 1
	entry.connection:Disconnect()
	entry.tween:Cancel()
	part:Destroy()
end

local function animate(name, size, cframe, color, shape, duration, goals)
	if not alive or activeCount >= EFFECT_LIMIT then
		return
	end
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Shape = shape
	part.Material = Enum.Material.Neon
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Transparency = 0.15
	part.Parent = effects
	local tween = TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goals)
	local entry = { tween = tween }
	active[part] = entry
	activeCount += 1
	entry.connection = tween.Completed:Connect(function()
		removeEffect(part)
	end)
	tween:Play()
	-- Резервное удаление, если Tween был прерван.
	task.delay(duration + 0.2, function()
		removeEffect(part)
	end)
end

local function render(payload)
	if not alive or type(payload) ~= "table" or type(payload.kind) ~= "string" then
		return
	end
	local from, target = payload.from, payload.to
	if not validVector(from) or not validVector(target) then
		return
	end
	local displacement = target - from
	local distance = displacement.Magnitude
	if distance > MAX_SEGMENT_LENGTH then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local camera = Workspace.CurrentCamera
	local focus = root and root:IsA("BasePart") and root.Position or camera and camera.CFrame.Position
	if focus and (focus - from).Magnitude > VIEW_DISTANCE and (focus - target).Magnitude > VIEW_DISTANCE then
		return
	end
	local color = effectColor(payload.color)
	if payload.kind == "slam" then
		-- Пульс радиусом 12 studs не взаимодействует с игровым миром.
		animate("HeroSlamPulse", Vector3.new(2, 1, 2), CFrame.new(target), color, Enum.PartType.Ball, 0.45, {
			Size = Vector3.new(24, 2, 24),
			Transparency = 1,
		})
		return
	end
	if distance > 0.05 then
		local thickness = payload.kind == "web" and 0.18 or 0.35
		animate("HeroSkillBeam", Vector3.new(thickness, thickness, distance), CFrame.lookAt((from + target) / 2, target), color, Enum.PartType.Block, 0.24, {
			Transparency = 1,
		})
		if payload.kind == "projectile" or payload.kind == "blast" then
			animate("HeroProjectile", Vector3.new(1.3, 1.3, 1.3), CFrame.new(from), color, Enum.PartType.Ball, 0.22, {
				CFrame = CFrame.new(target),
				Size = Vector3.new(0.4, 0.4, 0.4),
				Transparency = 1,
			})
		end
	end
	animate("HeroImpact", Vector3.new(0.8, 0.8, 0.8), CFrame.new(target), color, Enum.PartType.Ball, 0.3, {
		Size = Vector3.new(3, 3, 3),
		Transparency = 1,
	})
end

local function cleanup()
	if not alive then
		return
	end
	alive = false
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	table.clear(connections)
	for part in pairs(active) do
		removeEffect(part)
	end
	effects:Destroy()
end

table.insert(connections, stopEvent.Event:Connect(cleanup))
table.insert(connections, script.Destroying:Connect(cleanup))
table.insert(connections, effects.Destroying:Connect(cleanup))

task.spawn(function()
	local remotes = ReplicatedStorage:WaitForChild("TycoonRemotes", 30)
	if not alive or not remotes then
		return
	end
	local remote = remotes:WaitForChild("Effect", 30)
	if not alive or not remote or not remote:IsA("RemoteEvent") then
		return
	end
	table.insert(connections, remote.OnClientEvent:Connect(render))
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="38">
        <Properties>
          <string name="Name">TycoonUI</string>
          <string name="Source"><![CDATA[-- HUD and shop guide. Purchases and rewards always belong to the server.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("TycoonConfig"))
local remotes = ReplicatedStorage:WaitForChild("TycoonRemotes")
local notice = remotes:WaitForChild("Notice")
local actionRequest = remotes:WaitForChild("ActionRequest")
local monetizationRequest = remotes:WaitForChild("MonetizationRequest")

local gui = playerGui:FindFirstChild("TycoonHUD")
if not gui then
	gui = Instance.new("ScreenGui")
	gui.Name = "TycoonHUD"
	gui.Parent = playerGui
end
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- A rerun asks the previous HUD to remove its listeners before rebuilding.
local oldRuntime = gui:FindFirstChild("TycoonUIRuntime")
if oldRuntime then
	local oldStop = oldRuntime:FindFirstChild("Stop")
	if oldStop and oldStop:IsA("BindableEvent") then
		oldStop:Fire()
	end
	oldRuntime:Destroy()
end

local runtime = Instance.new("Frame")
runtime.Name = "TycoonUIRuntime"
runtime.Size = UDim2.fromScale(1, 1)
runtime.BackgroundTransparency = 1
runtime.BorderSizePixel = 0
runtime.Parent = gui
local stopEvent = Instance.new("BindableEvent")
stopEvent.Name = "Stop"
stopEvent.Parent = runtime

local connections = {}
local statsConnections = {}
local alive = true
local function connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(connections, connection)
	return connection
end

local palette = {
	panel = Color3.fromRGB(24, 31, 44),
	card = Color3.fromRGB(37, 46, 62),
	text = Color3.fromRGB(243, 248, 255),
	muted = Color3.fromRGB(172, 189, 209),
	gold = Color3.fromRGB(255, 212, 104),
	teal = Color3.fromRGB(97, 231, 191),
	blue = Color3.fromRGB(118, 194, 255),
	red = Color3.fromRGB(255, 148, 148),
}

local function make(className, properties, parent)
	local object = Instance.new(className)
	for key, value in pairs(properties) do
		object[key] = value
	end
	object.Parent = parent
	return object
end

local function corner(object, radius)
	make("UICorner", { CornerRadius = UDim.new(0, radius) }, object)
end

local function label(parent, name, text, size, position, fontSize, color)
	return make("TextLabel", {
		Name = name,
		BackgroundTransparency = 1,
		Size = size,
		Position = position,
		Text = text,
		TextColor3 = color or palette.text,
		TextSize = fontSize,
		Font = Enum.Font.GothamMedium,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = true,
		ZIndex = 12,
	}, parent)
end

local hud = make("Frame", {
	Name = "Dashboard",
	BackgroundColor3 = palette.panel,
	BackgroundTransparency = 0.06,
	BorderSizePixel = 0,
	Position = UDim2.fromOffset(14, 12),
	Size = UDim2.fromOffset(340, 232),
}, runtime)
corner(hud, 18)
make("UIStroke", { Color = Color3.fromRGB(70, 89, 110), Transparency = 0.3 }, hud)
local hudScale = make("UIScale", { Scale = 1 }, hud)
label(hud, "Title", "БАЗА ГЕРОЯ", UDim2.fromOffset(206, 26), UDim2.fromOffset(16, 12), 17, palette.teal)
local shopButton = make("TextButton", {
	Name = "ShopButton",
	Size = UDim2.fromOffset(96, 40),
	Position = UDim2.fromOffset(228, 6),
	BackgroundColor3 = palette.teal,
	BorderSizePixel = 0,
	Text = "Меню",
	TextColor3 = palette.panel,
	TextSize = 14,
	Font = Enum.Font.GothamBold,
	AutoButtonColor = true,
	ZIndex = 13,
}, hud)
corner(shopButton, 10)
local coinsText = label(hud, "Coins", "Монеты: ...", UDim2.fromOffset(206, 30), UDim2.fromOffset(16, 48), 23, palette.gold)
coinsText.TextScaled = true
make("UITextSizeConstraint", { MinTextSize = 12, MaxTextSize = 23 }, coinsText)
local levelText = label(hud, "Level", "Уровень: ...", UDim2.fromOffset(110, 30), UDim2.fromOffset(218, 48), 14)
levelText.TextScaled = true
make("UITextSizeConstraint", { MinTextSize = 10, MaxTextSize = 14 }, levelText)
local xpText = label(hud, "XP", "XP: 0", UDim2.fromOffset(310, 20), UDim2.fromOffset(16, 80), 12, palette.muted)
make("Frame", {
	Name = "Divider",
	BorderSizePixel = 0,
	BackgroundColor3 = Color3.fromRGB(64, 77, 97),
	Size = UDim2.fromOffset(308, 1),
	Position = UDim2.fromOffset(16, 106),
}, hud)
local houseText = label(hud, "House", "Дом: нет участка", UDim2.fromOffset(306, 22), UDim2.fromOffset(16, 112), 14)
local bankText = label(hud, "Bank", "В кассе: 0  ·  Доход: 0/сек", UDim2.fromOffset(306, 24), UDim2.fromOffset(16, 138), 13, palette.blue)
local heroText = label(hud, "Hero", "Герой: не выбран", UDim2.fromOffset(306, 24), UDim2.fromOffset(16, 166), 12, palette.teal)
local saveText = label(hud, "SaveStatus", "Загрузка прогресса...", UDim2.fromOffset(306, 32), UDim2.fromOffset(16, 196), 11, palette.muted)

local guide = make("Frame", {
	Name = "Guide",
	BackgroundColor3 = palette.panel,
	BackgroundTransparency = 0.18,
	BorderSizePixel = 0,
	Position = UDim2.fromOffset(14, 256),
	Size = UDim2.fromOffset(340, 70),
}, runtime)
corner(guide, 12)
local guideScale = make("UIScale", { Scale = 1 }, guide)
local guideText = label(guide, "Instructions", "Займи участок: подойди к зелёной площадке и нажми E или кнопку на экране.", UDim2.new(1, -28, 1, -16), UDim2.fromOffset(14, 8), 12, palette.text)

local overlay = make("TextButton", {
	Name = "ShopBackdrop",
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = Color3.fromRGB(5, 11, 22),
	BackgroundTransparency = 0.25,
	Text = "",
	AutoButtonColor = false,
	Visible = false,
	ZIndex = 10,
}, runtime)

local shop = make("Frame", {
	Name = "ShopPanel",
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.5),
	Size = UDim2.fromOffset(500, 610),
	BackgroundColor3 = palette.panel,
	BorderSizePixel = 0,
	Visible = false,
	ZIndex = 11,
}, runtime)
corner(shop, 20)
local shopScale = make("UIScale", { Scale = 1 }, shop)
label(shop, "Title", "Твоя база. Твой герой.", UDim2.new(1, -84, 0, 30), UDim2.fromOffset(20, 16), 22, palette.teal)
local shopIntro = label(shop, "Intro", "Строй, открывай героев и побеждай тренировочных ботов.", UDim2.new(1, -40, 0, 32), UDim2.fromOffset(20, 50), 13, palette.muted)
local closeButton = make("TextButton", {
	Name = "Close",
	Size = UDim2.fromOffset(44, 44),
	Position = UDim2.new(1, -56, 0, 8),
	BackgroundColor3 = palette.card,
	Text = "×",
	TextSize = 26,
	Font = Enum.Font.GothamBold,
	TextColor3 = palette.text,
	BorderSizePixel = 0,
	ZIndex = 13,
}, shop)
corner(closeButton, 10)

local tabs = {}
local currentTab = "House"
local tabDefinitions = { { "House", "Дом" }, { "Heroes", "Герои" }, { "Progress", "Прогресс" }, { "Style", "Стиль" } }
for index, definition in ipairs(tabDefinitions) do
	local name, text = definition[1], definition[2]
	local button = make("TextButton", {
		Name = name .. "Tab", Size = UDim2.new(0.25, -16, 0, 42),
		Position = UDim2.new((index - 1) * 0.25, 20 - (index - 1) * 8, 0, 90),
		BackgroundColor3 = palette.card, BorderSizePixel = 0, Text = text,
		TextColor3 = palette.text, TextSize = 13, Font = Enum.Font.GothamBold, ZIndex = 13,
	}, shop)
	corner(button, 10)
	local list = make("ScrollingFrame", {
		Name = name .. "List", BackgroundTransparency = 1, BorderSizePixel = 0,
		Position = UDim2.fromOffset(20, 148), Size = UDim2.new(1, -40, 1, -208),
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y, ScrollBarThickness = 4,
		ScrollBarImageColor3 = palette.teal, Visible = name == currentTab, ZIndex = 12,
	}, shop)
	make("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	tabs[name] = { button = button, list = list }
end
local shopList = tabs.House.list

local function shopCard(name, order, height, parent)
	local card = make("Frame", {
		Name = name,
		Size = UDim2.new(1, -8, 0, height),
		BackgroundColor3 = palette.card,
		BorderSizePixel = 0,
		LayoutOrder = order,
		ZIndex = 12,
	}, parent or shopList)
	corner(card, 12)
	local title = label(card, "Title", "", UDim2.new(1, -28, 0, 26), UDim2.fromOffset(14, 10), 16, palette.gold)
	local detail = label(card, "Detail", "", UDim2.new(1, -28, 1, -44), UDim2.fromOffset(14, 38), 13, palette.text)
	return title, detail, card
end

local floorTitle, floorDetail = shopCard("FloorUpgrade", 1, 114)
local dropperTitle, dropperDetail = shopCard("GeneratorUpgrade", 2, 114)
local bonusTitle, bonusDetail = shopCard("ThirdFloorBonus", 3, 132)
local shopFooter = label(shop, "Footer", "Подойди к площадке: E на ПК, кнопка на телефоне.", UDim2.new(1, -40, 0, 38), UDim2.new(0, 20, 1, -48), 12, palette.muted)

local lastRequestAt = 0
local function request(command, id)
	if not player:GetAttribute("DataReady") or os.clock() - lastRequestAt < 0.4 then return end
	lastRequestAt = os.clock()
	actionRequest:FireServer(command, id)
end

local function actionButton(card, name, callback)
	local button = make("TextButton", {
		Name = name, Position = UDim2.new(0, 14, 1, -54), Size = UDim2.new(1, -28, 0, 42),
		BackgroundColor3 = palette.teal, BorderSizePixel = 0, Text = "...",
		TextColor3 = palette.panel, TextSize = 13, Font = Enum.Font.GothamBold, ZIndex = 13,
	}, card)
	corner(button, 9)
	connect(button.Activated, function()
		if button:GetAttribute("Enabled") then callback() end
	end)
	return button
end

local function setButton(button, text, enabled)
	button.Text = text
	button:SetAttribute("Enabled", enabled == true)
	button.Active = enabled == true
	button.AutoButtonColor = enabled == true
	button.BackgroundColor3 = if enabled then palette.teal else Color3.fromRGB(57, 69, 85)
	button.TextColor3 = if enabled then palette.panel else palette.muted
end

local heroCards = {}
for index, hero in ipairs(Config.Heroes or {}) do
	local title, detail, card = shopCard("Hero_" .. hero.Id, index, 192, tabs.Heroes.list)
	title.Text = hero.Name
	local color = hero.Color
	if type(color) == "table" then title.TextColor3 = Color3.fromRGB(color[1], color[2], color[3]) end
	detail.Size = UDim2.new(1, -28, 0, 90)
	detail.TextYAlignment = Enum.TextYAlignment.Top
	local button = actionButton(card, "Equip", function() request("EquipHero", hero.Id) end)
	table.insert(heroCards, { hero = hero, detail = detail, button = button })
end

local questCards = {}
local questDefinitions = Config.Quests or {}
local questState = {
	collector = { progress = "CollectedTotal", done = "QuestCollectorDone" },
	builder = { progress = "Floor", done = "QuestBuilderDone" },
	fighter = { progress = "EnemiesDefeated", done = "QuestFighterDone" },
}
local questOrder = 0
for key, quest in pairs(questDefinitions) do
	if type(quest) == "table" then
		local id = quest.Id or key
		local state = questState[id]
		if state then
			questOrder += 1
			local title, detail, card = shopCard("Quest_" .. id, questOrder, 162, tabs.Progress.list)
			title.Text = quest.Title
			detail.Size = UDim2.new(1, -28, 0, 62)
			local button = actionButton(card, "Claim", function() request("ClaimQuest", id) end)
			table.insert(questCards, { quest = quest, state = state, detail = detail, button = button })
		end
	end
end

local dailyTitle, dailyDetail, dailyCard = shopCard("DailyReward", 10, 164, tabs.Progress.list)
dailyTitle.Text = "Ежедневная награда"
dailyDetail.Size = UDim2.new(1, -28, 0, 64)
local dailyButton = actionButton(dailyCard, "ClaimDaily", function() request("ClaimDaily") end)
local rebirthTitle, rebirthDetail, rebirthCard = shopCard("Rebirth", 11, 208, tabs.Progress.list)
rebirthTitle.Text = "Перерождение"
rebirthDetail.Size = UDim2.new(1, -28, 0, 108)
local rebirthConfirmedUntil = 0
local rebirthButton
rebirthButton = actionButton(rebirthCard, "Rebirth", function()
	if os.clock() > rebirthConfirmedUntil then
		rebirthConfirmedUntil = os.clock() + 6
		rebirthButton.Text = "Подтверди сброс: нажми ещё раз"
	else
		rebirthConfirmedUntil = 0
		request("Rebirth")
	end
end)

local passCards = {}
for _, key in ipairs({ "VIP", "Neon" }) do
	local definition = Config.GamePasses and Config.GamePasses[key]
	-- Unconfigured purchases have no button or product entry in the game.
	if definition and type(definition.Id) == "number" and definition.Id > 0 then
		local title, detail, card = shopCard("Pass_" .. key, #passCards + 1, 180, tabs.Style.list)
		title.Text = definition.Name
		detail.Text = definition.Description
		detail.Size = UDim2.new(1, -28, 0, 76)
		local button = actionButton(card, "Purchase", function()
			if not player:GetAttribute("DataReady") or os.clock() - lastRequestAt < 0.4 then return end
			lastRequestAt = os.clock()
			monetizationRequest:FireServer(key)
		end)
		table.insert(passCards, { key = key, button = button })
	end
end
if #passCards == 0 then
	local title, detail = shopCard("StyleInfo", 1, 116, tabs.Style.list)
	title.Text = "Твой стиль — твой герой"
	detail.Text = "Меняй героев во вкладке «Герои». Их оружие и способности открываются через строительство и перерождения."
end

local toast = make("Frame", {
	Name = "Notification",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 16),
	Size = UDim2.fromOffset(380, 68),
	BackgroundColor3 = palette.panel,
	BorderSizePixel = 0,
	Visible = false,
	ZIndex = 20,
}, runtime)
corner(toast, 14)
local toastScale = make("UIScale", { Scale = 1 }, toast)
local toastStroke = make("UIStroke", { Color = palette.teal, Thickness = 2 }, toast)
local toastText = label(toast, "Message", "", UDim2.new(1, -28, 1, -16), UDim2.fromOffset(14, 8), 14)
toastText.ZIndex = 21

local function number(value)
	if type(value) ~= "number" or value ~= value then
		return 0
	end
	return math.max(0, math.floor(value))
end

local function format(value)
	local digits = tostring(number(value))
	local reversed = string.reverse(digits)
	local spaced = string.gsub(reversed, "(%d%d%d)", "%1 ")
	return string.reverse(spaced):gsub("^ ", "")
end

local function attribute(name)
	return number(player:GetAttribute(name))
end

local stats = nil
local function stat(name)
	local value = stats and stats:FindFirstChild(name)
	if value and (value:IsA("IntValue") or value:IsA("NumberValue")) then
		return number(value.Value)
	end
	return nil
end

local function update()
	if not alive then
		return
	end
	local floor = math.min(attribute("Floor"), #Config.Floors)
	local tier = math.min(attribute("DropperTier"), #Config.DropperCosts)
	local plotId = attribute("PlotId")
	local rebirths = attribute("Rebirths")
	local equippedId = player:GetAttribute("EquippedHero")
	local equippedWeapon = player:GetAttribute("EquippedWeapon")
	local equippedName = "не выбран"
	for _, hero in ipairs(Config.Heroes or {}) do
		if hero.Id == equippedId then equippedName = hero.Name; break end
	end
	local coins, level = stat("Coins"), stat("Level")
	coinsText.Text = coins and ("Монеты: " .. format(coins)) or "Монеты: ..."
	levelText.Text = level and ("Уровень: " .. format(level)) or "Уровень: ..."
	xpText.Text = "Опыт: " .. format(attribute("XP")) .. " XP · получай монеты, чтобы расти"
	houseText.Text = if plotId > 0 then ("Участок №" .. plotId .. "  ·  Этажи: " .. floor .. "/3") else "Дом: выбери свободный участок"
	bankText.Text = "В кассе: " .. format(attribute("Bank")) .. "  ·  Доход: " .. format(attribute("Income")) .. "/сек"
	heroText.Text = "Герой: " .. equippedName .. " · Перерождений: " .. format(rebirths)

	local mode = player:GetAttribute("PersistenceMode")
	local status = player:GetAttribute("PersistenceStatus")
	if status == "error" then
		saveText.Text = "Ошибка сохранения — дождись восстановления."
		saveText.TextColor3 = palette.red
	elseif mode == "session" or status == "session" then
		saveText.Text = "Сохранение недоступно: прогресс только в этой сессии."
		saveText.TextColor3 = palette.gold
	elseif not player:GetAttribute("DataReady") or status == "loading" then
		saveText.Text = "Загрузка прогресса..."
		saveText.TextColor3 = palette.muted
	elseif status == "saving" then
		saveText.Text = "Сохранение прогресса..."
		saveText.TextColor3 = palette.muted
	elseif status == "saved" then
		saveText.Text = "Автосохранение включено"
		saveText.TextColor3 = palette.teal
	else
		saveText.Text = "Состояние сохранения уточняется..."
		saveText.TextColor3 = palette.muted
	end

	if not player:GetAttribute("DataReady") then
		guideText.Text = "Подожди загрузки прогресса. Если появилась ошибка — смотри уведомление."
	elseif plotId == 0 then
		guideText.Text = "Займи участок: зелёная площадка → E на ПК или кнопка на телефоне."
	elseif floor == 0 then
		guideText.Text = "Построй первый этаж: подойди к синей площадке. Цена: " .. format(Config.Floors[1].Cost) .. " монет."
	elseif floor < 3 then
		guideText.Text = "Собирай зелёную кассу, строй этажи. В меню → «Герои» выбери героя и тренируйся на ботах."
	else
		guideText.Text = "Сундук на третьем этаже даёт бонусы. Меню → «Прогресс»: задания, награды и перерождения."
	end

	local nextFloor = Config.Floors[floor + 1]
	if nextFloor then
		floorTitle.Text = "Этаж " .. (floor + 1) .. " · " .. format(nextFloor.Cost) .. " монет"
		floorDetail.Text = "Новый этаж и генератор. Синяя площадка на твоём участке."
		if floor + 1 == 3 then
			floorDetail.Text ..= " Откроет золотую раздачу и ускорение."
		end
	else
		floorTitle.Text = "Все 3 этажа построены!"
		floorDetail.Text = "Золотой генератор работает. Улучшай его и забирай дополнительные награды."
	end

	local nextCost = Config.DropperCosts[tier + 1]
	if nextCost then
		dropperTitle.Text = "Генератор " .. (tier + 1) .. " · " .. format(nextCost) .. " монет"
		dropperDetail.Text = "Увеличивает доход всех этажей. Фиолетовая площадка на твоём участке."
		if floor == 0 then
			dropperDetail.Text = "Сначала построй первый этаж, затем улучшай генератор на фиолетовой площадке."
		end
	else
		dropperTitle.Text = "Генератор улучшен до максимума"
		dropperDetail.Text = "Твой дом получает максимальный доход. Не забывай собирать деньги из зелёной кассы."
	end

	bonusTitle.Text = "Плюшки третьего этажа"
	local bonusReadyAt = player:GetAttribute("BonusReadyAt")
	local seconds = if type(bonusReadyAt) == "number" then math.max(0, math.ceil(bonusReadyAt - Workspace:GetServerTimeNow())) else 0
	local bonusState = if floor < 3 then "Откроется после постройки третьего этажа." elseif seconds > 0 then ("Следующая раздача через " .. seconds .. " сек.") else "Раздача готова: открой сундук на третьем этаже!"
	bonusDetail.Text = "Золотой генератор, скорость " .. Config.ThirdFloorWalkSpeed .. " и +" .. format(Config.BonusCoins) .. " монет раз в " .. Config.BonusCooldown .. " сек.\n" .. bonusState

	local ready = player:GetAttribute("DataReady") == true
	local heroProfile = { Floor = floor, Rebirths = rebirths }
	for _, entry in ipairs(heroCards) do
		local hero = entry.hero
		local unlocked = Config.CanUseHero(heroProfile, hero)
		local required = "Этаж " .. hero.MinFloor
		if hero.MinRebirths > 0 then required ..= " · перерождений: " .. hero.MinRebirths end
		entry.detail.Text = hero.Description .. "\n" .. required .. " · урон: " .. hero.Damage .. "\nОружие: клик или Q; на телефоне — «Навык»."
		if equippedId == hero.Id and (equippedWeapon == nil or equippedWeapon == "") then
			setButton(entry.button, "Выбран", false)
		elseif not ready then
			setButton(entry.button, "Загрузка прогресса...", false)
		elseif not unlocked then
			setButton(entry.button, "Откроется: " .. required, false)
		else
			setButton(entry.button, "Выбрать героя", true)
		end
	end

	for _, entry in ipairs(questCards) do
		local progress = math.min(entry.quest.Target, attribute(entry.state.progress))
		if entry.quest.Id == "builder" and rebirths > 0 then progress = entry.quest.Target end
		local done = player:GetAttribute(entry.state.done) == true
		entry.detail.Text = "Прогресс: " .. format(progress) .. "/" .. format(entry.quest.Target) .. "\nНаграда: " .. format(entry.quest.RewardCoins) .. " монет"
		setButton(entry.button, if done then "Награда получена" elseif progress >= entry.quest.Target then "Забрать награду" else "Выполни задание", ready and not done and progress >= entry.quest.Target)
	end
	local dailySeconds = math.max(0, math.ceil(attribute("DailyReadyAt") - Workspace:GetServerTimeNow()))
	local remainingMinutes = math.ceil(dailySeconds / 60)
	local dailyHours = math.floor(remainingMinutes / 60)
	local dailyMinutes = remainingMinutes % 60
	dailyDetail.Text = "+" .. format(Config.DailyReward) .. " монет за возвращение в игру.\n" .. (if dailySeconds > 0 then ("Следующая награда через " .. dailyHours .. " ч " .. dailyMinutes .. " мин.") else "Награда готова!")
	setButton(dailyButton, if dailySeconds > 0 then "Возвращайся позже" else "Забрать ежедневную награду", ready and dailySeconds == 0)

	local rebirthCost = Config.RebirthCost(rebirths)
	rebirthDetail.Text = "Нужно: " .. Config.RebirthMinFloor .. " этажа, генератор " .. Config.RebirthMinTier .. " и " .. format(rebirthCost) .. " монет. Сбросятся монеты, этажи, генераторы и касса. Опыт, задания и открытые герои сохранятся. Бонус дохода: +" .. math.floor(Config.RebirthBonusStep * 100) .. "% за перерождение."
	local canRebirth = ready and floor >= Config.RebirthMinFloor and tier >= Config.RebirthMinTier and rebirths < Config.MaxRebirths and coins ~= nil and coins >= rebirthCost
	local rebirthText = if rebirths >= Config.MaxRebirths then "Достигнут максимум перерождений" elseif os.clock() <= rebirthConfirmedUntil then "Подтверди сброс: нажми ещё раз" else "Переродиться · " .. format(rebirthCost) .. " монет"
	setButton(rebirthButton, rebirthText, canRebirth)
	for _, entry in ipairs(passCards) do
		local owned = player:GetAttribute(if entry.key == "VIP" then "HasVIP" else "HasNeon") == true
		setButton(entry.button, if owned then "Уже принадлежит тебе" else "Открыть покупку за Robux", ready and not owned)
	end
end

local function bindStats(folder)
	for _, connection in ipairs(statsConnections) do
		connection:Disconnect()
	end
	table.clear(statsConnections)
	stats = folder
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			if (child.Name == "Coins" or child.Name == "Level") and (child:IsA("IntValue") or child:IsA("NumberValue")) then
				table.insert(statsConnections, child:GetPropertyChangedSignal("Value"):Connect(update))
			end
		end
		table.insert(statsConnections, folder.ChildAdded:Connect(function()
			bindStats(folder)
		end))
		table.insert(statsConnections, folder.ChildRemoved:Connect(function()
			bindStats(folder)
		end))
	end
	update()
end

local function setShopOpen(open)
	overlay.Visible = open
	shop.Visible = open
	update()
end
local function setTab(name)
	currentTab = name
	for tabName, tab in pairs(tabs) do
		tab.list.Visible = tabName == name
		tab.button.BackgroundColor3 = if tabName == name then palette.teal else palette.card
		tab.button.TextColor3 = if tabName == name then palette.panel else palette.text
	end
	if name == "House" then
		shopIntro.Text = "Покупай этажи и генераторы на площадках твоего участка."
		shopFooter.Text = "Подойди к площадке: E на ПК, кнопка на телефоне."
	elseif name == "Heroes" then
		shopIntro.Text = "Шесть оригинальных героев. Развивай базу, чтобы открыть их."
		shopFooter.Text = "Возьми оружие. Клик или Q на ПК; «Навык» на телефоне."
	elseif name == "Progress" then
		shopIntro.Text = "Выполняй задания, возвращайся за наградой и становись сильнее."
		shopFooter.Text = "Перед перерождением прочитай, какие улучшения сбросятся."
	else
		shopIntro.Text = "Дополнения для твоей базы и героя."
		shopFooter.Text = if #passCards > 0 then "Покупка подтверждается в стандартном окне Roblox." else "Все герои открываются через прогресс игры."
	end
	update()
end
for name, tab in pairs(tabs) do
	connect(tab.button.Activated, function() setTab(name) end)
end
setTab("House")
connect(shopButton.Activated, function()
	setShopOpen(not shop.Visible)
end)
connect(closeButton.Activated, function()
	setShopOpen(false)
end)
connect(overlay.Activated, function()
	setShopOpen(false)
end)

local watchedAttributes = {
	"Floor", "DropperTier", "Bank", "Income", "PlotId", "XP", "DataReady",
	"PersistenceMode", "PersistenceStatus", "BonusReadyAt", "Rebirths", "EquippedHero",
	"CollectedTotal", "EnemiesDefeated", "QuestCollectorDone", "QuestBuilderDone",
	"QuestFighterDone", "DailyReadyAt", "HasVIP", "HasNeon", "EquippedWeapon",
}
for _, name in ipairs(watchedAttributes) do
	connect(player:GetAttributeChangedSignal(name), update)
end
connect(player.ChildAdded, function(child)
	if child.Name == "leaderstats" then
		bindStats(child)
	end
end)
connect(player.ChildRemoved, function(child)
	if child == stats then
		bindStats(nil)
	end
end)
bindStats(player:FindFirstChild("leaderstats"))

local toastVersion = 0
local toastTween = nil
connect(notice.OnClientEvent, function(payload)
	if type(payload) ~= "table" or type(payload.text) ~= "string" then
		return
	end
	if payload.kind == "heroes" then
		setTab("Heroes")
		setShopOpen(true)
	end
	toastVersion += 1
	local version = toastVersion
	if toastTween then
		toastTween:Cancel()
	end
	toastText.Text = string.sub(payload.text, 1, 480)
	toastStroke.Color = if payload.kind == "error" then palette.red elseif payload.kind == "reward" then palette.gold else palette.teal
	toast.Visible = true
	toast.BackgroundTransparency = 0.03
	toastText.TextTransparency = 0
	task.delay(4.5, function()
		if not alive or version ~= toastVersion then
			return
		end
		toastTween = TweenService:Create(toast, TweenInfo.new(0.25), { BackgroundTransparency = 1 })
		toastTween:Play()
		task.wait(0.25)
		if alive and version == toastVersion then
			toast.Visible = false
		end
	end)
end)

local cameraConnection = nil
local function resize()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	local dashboardScale = math.min(1, math.max(0.1, (viewport.X - 28) / 340), math.max(0.1, (viewport.Y - 160) / 326))
	hudScale.Scale = dashboardScale
	guideScale.Scale = dashboardScale
	guide.Position = UDim2.fromOffset(14, 12 + 244 * dashboardScale)
	local modalScale = math.min(1, math.max(0.1, (viewport.X - 28) / 320))
	shopScale.Scale = modalScale
	-- On a phone in landscape, shorten the scrolling area instead of
	-- shrinking every label and touch target to an unreadable size.
	shop.Size = UDim2.fromOffset(math.min(500, (viewport.X - 28) / modalScale), math.min(610, math.max(250, (viewport.Y - 90) / modalScale)))
	toastScale.Scale = math.min(1, math.max(0.1, (viewport.X - 28) / 380))
	toast.Position = if viewport.X > 780 then UDim2.new(0.5, 0, 0, 16) else UDim2.new(0.5, 0, 0, 12 + 330 * dashboardScale)
end

local function bindCamera()
	if cameraConnection then
		cameraConnection:Disconnect()
	end
	local camera = Workspace.CurrentCamera
	if camera then
		cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(resize)
	end
	resize()
end
connect(Workspace:GetPropertyChangedSignal("CurrentCamera"), bindCamera)
bindCamera()

local function cleanup()
	if not alive then
		return
	end
	alive = false
	if toastTween then
		toastTween:Cancel()
	end
	if cameraConnection then
		cameraConnection:Disconnect()
	end
	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	for _, connection in ipairs(statsConnections) do
		connection:Disconnect()
	end
	runtime:Destroy()
end
connect(stopEvent.Event, cleanup)
connect(script.Destroying, cleanup)

-- The only timer updates the third-floor countdown; it never awards anything.
task.spawn(function()
	while alive do
		task.wait(1)
		if alive and shop.Visible then
			update()
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="39">
        <Properties>
          <string name="Name">WeaponInventory</string>
          <string name="Source"><![CDATA[-- Инвентарь показывает серверный профиль. Клиент лишь просит экипировать известное оружие.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local gui = playerGui:FindFirstChild("WeaponInventoryHUD")
if gui and not gui:IsA("ScreenGui") then
	warn("WeaponInventoryHUD должен быть ScreenGui.")
	return
end
if not gui then
	gui = Instance.new("ScreenGui")
	gui.Name = "WeaponInventoryHUD"
	gui.Parent = playerGui
end
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.DisplayOrder = 22
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- Повторный запуск останавливает старые анимации и обработчики.
local oldRuntime = gui:FindFirstChild("WeaponInventoryRuntime")
if oldRuntime then
	local oldStop = oldRuntime:FindFirstChild("Stop")
	if oldStop and oldStop:IsA("BindableEvent") then oldStop:Fire() end
	oldRuntime:Destroy()
end
local runtime = Instance.new("Frame")
runtime.Name = "WeaponInventoryRuntime"
runtime.Size = UDim2.fromScale(1, 1)
runtime.BackgroundTransparency = 1
runtime.Parent = gui
local stopEvent = Instance.new("BindableEvent")
stopEvent.Name = "Stop"
stopEvent.Parent = runtime

local alive = true
local connections = {}
local animationSerial = 0
local activeTween = nil
local pendingResult = nil
local actionRemote = nil
local inventory = {}
local cards = {}
local lastEquipRequest = -math.huge

local function connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(connections, connection)
	return connection
end

local function cancelAnimation()
	animationSerial += 1
	if activeTween then
		activeTween:Cancel()
		activeTween = nil
	end
end

local function cleanup()
	if not alive then return end
	alive = false
	cancelAnimation()
	pendingResult = nil
	for _, connection in ipairs(connections) do connection:Disconnect() end
	table.clear(connections)
	runtime:Destroy()
end
connect(stopEvent.Event, cleanup)
connect(script.Destroying, cleanup)
connect(runtime.Destroying, cleanup)

local shared = ReplicatedStorage:WaitForChild("Shared", 30)
if not alive then return end
local configModule = shared and shared:WaitForChild("TycoonConfig", 30)
if not alive then return end
if not configModule or not configModule:IsA("ModuleScript") then
	warn("Для инвентаря не найден Shared/TycoonConfig.")
	cleanup()
	return
end
local Config = require(configModule)
if not alive then return end

local palette = {
	panel = Color3.fromRGB(24, 31, 44),
	card = Color3.fromRGB(37, 46, 62),
	text = Color3.fromRGB(243, 248, 255),
	muted = Color3.fromRGB(172, 189, 209),
	teal = Color3.fromRGB(97, 231, 191),
}
local function make(className, properties, parent)
	local object = Instance.new(className)
	for key, value in pairs(properties) do object[key] = value end
	object.Parent = parent
	return object
end
local function corner(object, radius)
	make("UICorner", { CornerRadius = UDim.new(0, radius) }, object)
end
local function label(parent, name, text, size, position, textSize, color)
	return make("TextLabel", {
		Name = name, Size = size, Position = position, BackgroundTransparency = 1,
		Text = text, TextColor3 = color or palette.text, TextSize = textSize,
		Font = Enum.Font.GothamMedium, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = parent.ZIndex + 1,
	}, parent)
end
local function button(parent, name, text, size, position)
	local object = make("TextButton", {
		Name = name, Size = size, Position = position, BackgroundColor3 = palette.card,
		BorderSizePixel = 0, Text = text, TextColor3 = palette.text, TextSize = 15,
		Font = Enum.Font.GothamBold, AutoButtonColor = true, ZIndex = parent.ZIndex + 2,
	}, parent)
	corner(object, 10)
	return object
end
local function weaponColor(weapon)
	return Color3.fromRGB(weapon.Color[1], weapon.Color[2], weapon.Color[3])
end

local openButton = button(runtime, "InventoryButton", "Оружие", UDim2.fromOffset(122, 46), UDim2.new(1, -14, 0.58, 0))
openButton.AnchorPoint = Vector2.new(1, 0.5)
openButton.BackgroundColor3 = palette.panel
make("UIStroke", { Color = palette.teal, Transparency = 0.25 }, openButton)

local backdrop = button(runtime, "Backdrop", "", UDim2.fromScale(1, 1), UDim2.new())
backdrop.BackgroundColor3 = Color3.fromRGB(5, 11, 22)
backdrop.BackgroundTransparency = 0.25
backdrop.AutoButtonColor = false
backdrop.ZIndex = 10
backdrop.Visible = false

local panel = make("Frame", {
	Name = "InventoryPanel", Size = UDim2.fromOffset(360, 400),
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
	BackgroundColor3 = palette.panel, BorderSizePixel = 0, Visible = false, ZIndex = 11,
}, runtime)
corner(panel, 18)
label(panel, "Title", "АРСЕНАЛ", UDim2.new(1, -80, 0, 30), UDim2.fromOffset(16, 12), 20, palette.teal)
local closeButton = button(panel, "Close", "×", UDim2.fromOffset(44, 44), UDim2.new(1, -54, 0, 8))
closeButton.TextSize = 26
label(panel, "Explanation", "Ищи ящики на карте: оружие из них бесплатное.", UDim2.new(1, -32, 0, 38), UDim2.fromOffset(16, 48), 13, palette.muted)
local inventoryStatus = label(panel, "Status", "Загрузка коллекции…", UDim2.new(1, -32, 0, 26), UDim2.fromOffset(16, 87), 13, palette.teal)
local list = make("ScrollingFrame", {
	Name = "WeaponList", Position = UDim2.fromOffset(16, 122), Size = UDim2.new(1, -32, 1, -138),
	BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4,
	ScrollBarImageColor3 = palette.teal, ScrollingDirection = Enum.ScrollingDirection.Y,
	AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ZIndex = 12,
}, panel)
make("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, list)

for index, weapon in ipairs(Config.Weapons) do
	local color = weaponColor(weapon)
	local card = make("Frame", {
		Name = weapon.Id, Size = UDim2.new(1, -8, 0, 116), LayoutOrder = index,
		BackgroundColor3 = palette.card, BorderSizePixel = 0, ZIndex = 13,
	}, list)
	corner(card, 12)
	make("Frame", {
		Name = "RarityStripe", Size = UDim2.new(0, 4, 1, -22), Position = UDim2.fromOffset(8, 11),
		BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 14,
	}, card)
	label(card, "Name", weapon.Name, UDim2.new(1, -36, 0, 36), UDim2.fromOffset(20, 6), 15)
	label(card, "Rarity", weapon.Rarity, UDim2.new(1, -36, 0, 20), UDim2.fromOffset(20, 43), 12, color)
	local countLabel = label(card, "Count", "Ещё не найдено", UDim2.new(1, -154, 0, 38), UDim2.fromOffset(20, 68), 12, palette.muted)
	local equip = button(card, "Equip", "Надеть", UDim2.fromOffset(116, 40), UDim2.new(1, -128, 0, 69))
	equip.Visible = false
	cards[weapon.Id] = { count = countLabel, equip = equip, color = color }
	connect(equip.Activated, function()
		if not alive or player:GetAttribute("DataReady") ~= true or not actionRemote or not actionRemote.Parent then return end
		if (inventory[weapon.Id] or 0) < 1 or player:GetAttribute("EquippedWeapon") == weapon.Id then return end
		local now = os.clock()
		if now - lastEquipRequest < 0.4 then return end
		lastEquipRequest = now
		-- Цена, владение и реальные боевые свойства проверяются только сервером.
		actionRemote:FireServer("EquipWeapon", weapon.Id)
	end)
end

local loot = make("Frame", {
	Name = "LootReveal", Size = UDim2.fromOffset(360, 300),
	AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
	BackgroundColor3 = palette.panel, BorderSizePixel = 0, Visible = false, ZIndex = 20,
}, runtime)
corner(loot, 18)
make("UIStroke", { Color = palette.teal, Transparency = 0.35, Thickness = 2 }, loot)
label(loot, "Title", "БЕСПЛАТНАЯ НАХОДКА", UDim2.new(1, -32, 0, 30), UDim2.fromOffset(16, 12), 18, palette.teal)
local revealStatus = label(loot, "Status", "Открываем ящик…", UDim2.new(1, -32, 0, 28), UDim2.fromOffset(16, 46), 13, palette.muted)
local viewport = make("Frame", {
	Name = "CarouselWindow", Size = UDim2.new(1, -32, 0, 106), Position = UDim2.fromOffset(16, 82),
	BackgroundTransparency = 1, ClipsDescendants = true, BorderSizePixel = 0, ZIndex = 21,
}, loot)
local revealCard = make("Frame", {
	Name = "WeaponCard", Size = UDim2.fromScale(1, 1), BackgroundColor3 = palette.card,
	BorderSizePixel = 0, ZIndex = 22,
}, viewport)
corner(revealCard, 12)
local revealStroke = make("UIStroke", { Color = palette.teal, Thickness = 2, Transparency = 0.2 }, revealCard)
local revealName = label(revealCard, "Name", "", UDim2.new(1, -32, 0, 50), UDim2.fromOffset(16, 10), 20)
revealName.TextXAlignment = Enum.TextXAlignment.Center
local revealRarity = label(revealCard, "Rarity", "", UDim2.new(1, -32, 0, 28), UDim2.fromOffset(16, 65), 14)
revealRarity.TextXAlignment = Enum.TextXAlignment.Center
local resultDetail = label(loot, "ResultDetail", "Без оплаты и списания монет", UDim2.new(1, -32, 0, 38), UDim2.new(0, 16, 1, -98), 13, palette.muted)
local resultButton = button(loot, "Continue", "Показать результат", UDim2.new(1, -32, 0, 44), UDim2.new(0, 16, 1, -56))
resultButton.BackgroundColor3 = palette.teal
resultButton.TextColor3 = palette.panel

local function showWeapon(weapon)
	revealName.Text = weapon.Name
	revealRarity.Text = weapon.Rarity
	revealRarity.TextColor3 = weaponColor(weapon)
	revealStroke.Color = weaponColor(weapon)
end
local function displayWinner()
	if not alive or not pendingResult then return end
	cancelAnimation()
	revealCard.Position = UDim2.new()
	showWeapon(pendingResult.weapon)
	revealStatus.Text = if revealRarity.Visible then "Твоя находка!" else "Твоя находка! · " .. pendingResult.weapon.Rarity
	resultDetail.Text = (pendingResult.duplicate and "Повторная находка" or "Добавлено в коллекцию")
		.. " · в коллекции ×" .. tostring(pendingResult.count)
	if pendingResult.compensationCoins > 0 then
		resultDetail.Text ..= "\nКомпенсация: +" .. tostring(pendingResult.compensationCoins) .. " монет"
	end
	resultButton.Text = "Готово"
end
local function closePanels()
	cancelAnimation()
	pendingResult = nil
	panel.Visible = false
	loot.Visible = false
	backdrop.Visible = false
end
connect(closeButton.Activated, closePanels)
connect(backdrop.Activated, closePanels)
connect(openButton.Activated, function()
	if loot.Visible then return end
	panel.Visible = not panel.Visible
	backdrop.Visible = panel.Visible
end)
connect(resultButton.Activated, function()
	if resultButton.Text == "Готово" then closePanels() else displayWinner() end
end)

local function refreshInventory()
	if not alive then return end
	local encoded = player:GetAttribute("WeaponInventory")
	local decoded = nil
	if type(encoded) == "string" and #encoded <= 4096 then
		local ok, value = pcall(HttpService.JSONDecode, HttpService, encoded)
		if ok and type(value) == "table" then decoded = value end
	end
	local nextInventory = {}
	local owned = 0
	-- Только известные предметы и конечные целые количества из серверного атрибута.
	for _, weapon in ipairs(Config.Weapons) do
		local count = decoded and decoded[weapon.Id]
		if type(count) == "number" and count == count and count ~= math.huge
			and count >= 1 and count == math.floor(count) then
			nextInventory[weapon.Id] = math.min(count, Config.MaxWeaponCopies or 99)
			owned += 1
		end
	end
	inventory = nextInventory
	local ready = player:GetAttribute("DataReady") == true
	local equipped = player:GetAttribute("EquippedWeapon")
	for _, weapon in ipairs(Config.Weapons) do
		local card = cards[weapon.Id]
		local count = inventory[weapon.Id] or 0
		local selected = count > 0 and equipped == weapon.Id
		local canEquip = ready and actionRemote ~= nil and count > 0 and not selected
		card.count.Text = if count > 0 then "Урон: " .. tostring(weapon.Damage) .. " · ×" .. tostring(count) else "Ещё не найдено"
		card.equip.Visible = count > 0
		card.equip.Active = canEquip
		card.equip.Selectable = canEquip
		card.equip.AutoButtonColor = canEquip
		card.equip.Text = if selected then "Надето" elseif ready and actionRemote then "Надеть" else "Подождите"
		card.equip.BackgroundColor3 = if canEquip or selected then card.color else palette.panel
		card.equip.TextColor3 = if canEquip or selected then palette.panel else palette.muted
	end
	inventoryStatus.Text = if not ready then "Загрузка прогресса…" elseif owned == 0 then "Коллекция пуста — найди первую поставку!" else "Найдено видов: " .. tostring(owned) .. " / " .. tostring(#Config.Weapons)
	openButton.Text = "Оружие · " .. tostring(owned)
end
for _, name in ipairs({ "WeaponInventory", "EquippedWeapon", "DataReady" }) do
	connect(player:GetAttributeChangedSignal(name), refreshInventory)
end
refreshInventory()

local function refreshLayout()
	if not alive then return end
	local size = runtime.AbsoluteSize
	if size.X <= 0 or size.Y <= 0 then return end
	-- Меняем размеры панели, а не размер шрифта: мобильный текст остаётся читаемым.
	local width = math.min(360, math.max(180, size.X - 24))
	panel.Size = UDim2.fromOffset(width, math.min(400, math.max(190, size.Y - 24)))
	local lootHeight = math.min(300, math.max(230, size.Y - 24))
	loot.Size = UDim2.fromOffset(width, lootHeight)
	local carouselHeight = math.max(40, lootHeight - 194)
	viewport.Size = UDim2.new(1, -32, 0, carouselHeight)
	revealRarity.Visible = carouselHeight >= 90
	revealName.Size = UDim2.new(1, -32, 0, if revealRarity.Visible then 50 else carouselHeight - 4)
	revealName.Position = UDim2.fromOffset(16, if revealRarity.Visible then 10 else 2)
	revealName.TextSize = if revealRarity.Visible then 20 else 16
	-- Use the rendered guide bounds as well as screen size: safe insets on
	-- a small portrait phone must not move the button over the base guide.
	if size.Y > size.X then
		local centerY = size.Y * 0.58
		local mainGui = playerGui:FindFirstChild("TycoonHUD")
		local mainRuntime = mainGui and mainGui:FindFirstChild("TycoonUIRuntime")
		local guide = mainRuntime and mainRuntime:FindFirstChild("Guide")
		if guide and guide:IsA("GuiObject") then
			local guideBottom = guide.AbsolutePosition.Y + guide.AbsoluteSize.Y - runtime.AbsolutePosition.Y
			centerY = math.max(centerY, guideBottom + 32)
		end
		openButton.Position = UDim2.new(1, -14, 0, math.min(centerY, size.Y - 36))
	else
		openButton.Position = UDim2.new(1, -14, 0.45, 0)
	end
end
connect(runtime:GetPropertyChangedSignal("AbsoluteSize"), function() task.defer(refreshLayout) end)
refreshLayout()
task.defer(refreshLayout)

local function receiveLoot(payload)
	if not alive or type(payload) ~= "table" or type(payload.weaponId) ~= "string" then return end
	local weapon = Config.GetWeapon(payload.weaponId)
	local count = payload.count
	if not weapon or type(count) ~= "number" or count ~= count or count == math.huge
		or count < 1 or count ~= math.floor(count) or count > (Config.MaxWeaponCopies or 99) then return end
	-- Сервер уже выдал награду. Здесь нет запроса выпадения, оплаты или повторного броска.
	cancelAnimation()
	local compensation = payload.compensationCoins
	if type(compensation) ~= "number" or compensation ~= compensation or compensation == math.huge
		or compensation < 0 or compensation ~= math.floor(compensation) or compensation > Config.MaxCoins then
		compensation = 0
	end
	pendingResult = { weapon = weapon, count = count, duplicate = payload.duplicate == true, compensationCoins = compensation }
	local serial = animationSerial
	panel.Visible = false
	loot.Visible = true
	backdrop.Visible = true
	revealCard.Position = UDim2.new()
	revealStatus.Text = "Открываем ящик…"
	resultDetail.Text = "Без оплаты и списания монет"
	resultButton.Text = "Показать результат"
	showWeapon(Config.Weapons[1])
	task.spawn(function()
		-- Последовательность — лишь оформление. Победитель всегда приходит из LootResult.
		for step = 1, 9 do
			if not alive or animationSerial ~= serial then return end
			local duration = 0.06 + step * 0.011
			activeTween = TweenService:Create(revealCard, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.fromScale(-1.05, 0) })
			activeTween:Play()
			task.wait(duration)
			if not alive or animationSerial ~= serial then return end
			revealCard.Position = UDim2.fromScale(1.05, 0)
			showWeapon(Config.Weapons[(step % #Config.Weapons) + 1])
			activeTween = TweenService:Create(revealCard, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = UDim2.new() })
			activeTween:Play()
			task.wait(duration + 0.02)
		end
		if alive and animationSerial == serial then displayWinner() end
	end)
end

task.spawn(function()
	local remotes = ReplicatedStorage:WaitForChild("TycoonRemotes", 30)
	if not alive or not remotes then return end
	local request = remotes:WaitForChild("ActionRequest", 30)
	if not alive then return end
	if request and request:IsA("RemoteEvent") then
		actionRemote = request
		refreshInventory()
	end
	local lootResult = remotes:WaitForChild("LootResult", 30)
	if not alive then return end
	if lootResult and lootResult:IsA("RemoteEvent") then
		connect(lootResult.OnClientEvent, receiveLoot)
	else
		warn("Для находок не найден TycoonRemotes/LootResult.")
	end
end)
